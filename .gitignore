# ─── CONTROL v2 (servicios backend/ y frontend/) ───────────────────────────
# Dependencias
node_modules/

# Builds
backend/dist/
frontend/dist/

# Cliente Prisma generado (se regenera con `npm run db:generate` / prisma generate)
backend/src/datos/generated/

# Artefactos incrementales de TypeScript (tsc -b)
*.tsbuildinfo

# Variables de entorno (los .env reales nunca se versionan; sí los .example)
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# ─── Logs y temporales ─────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Editores / SO ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ─── Tests / cobertura ─────────────────────────────────────────────────────
coverage/
*/coverage/

# ─── Material temporal del intento viejo (no versionar todavía) ────────────
# control-v2/ = primer intento (monorepo pnpm). Es CANTERA: se reaprovecha
#   localmente en E2 y se ELIMINA en E5 (ver CLAUDE.md §8). No entra al repo.
control-v2/
# .github/ = CI viejo del monorepo (obsoleto). En E5 se quita esta línea y se
#   crea el CI nuevo para los 2 servicios dockerizados (backend/ y frontend/).
.github/
