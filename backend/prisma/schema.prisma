// CONTROL v2 — esquema de la fundación (F0) + catálogos sencillos (F1-E1).
// Dominios: empresas y configuración, usuarios/RBAC (A4) + tablas de better-auth,
// almacenes, secuencias de folios (A3), bitácora (A7), archivos R2 (A5/R6) y
// catálogos maestros globales (F1: Proveedor, Cortador, Temporada, EtiquetaMarca,
// Color — GLOBALES sin idEmpresa por ADR-0007/A9).
//
// Convenciones (plan maestro §4 y §8):
//  • Modelos y campos de dominio en español, sin acentos ni eñes.
//  • Tablas y columnas en BD en snake_case español vía @map/@@map.
//  • FKs reales con integridad referencial (A2); onDelete Restrict en dominio
//    (el borrado es suave: banderas `activo`), Cascade solo en tablas de sesión/auth.
//  • Auditoría uniforme en entidades de dominio: creadoEn/creadoPorId +
//    modificadoEn/modificadoPorId (A7). Los campos *PorId referencian usuarios SIN
//    constraint físico a propósito: los usuarios jamás se borran (solo se desactivan)
//    y un FK formal exigiría decenas de relaciones inversas en Usuario sin valor de
//    consulta. La Bitacora complementa con el historial de cambios.
//  • En las tablas exclusivas de better-auth (Sesion, Cuenta, Verificacion) los CAMPOS
//    conservan el nombre que better-auth espera (token, expiresAt, userId…) para que el
//    adapter del frontend (E3) no necesite field-mapping; las COLUMNAS sí van en español.
//
// Prisma 7: generator `prisma-client` (no `prisma-client-js`). El cliente se emite a
// `src/datos/generated/prisma` (gitignoreado; se regenera con `prisma generate`).
// `moduleFormat = esm` + `importFileExtension = js` para que el código generado use
// imports con extensión `.js`, compatibles con la resolución NodeNext del backend.
// El datasource NO lleva `url`: la conexión va por `@prisma/adapter-pg` (ver src/datos).

generator client {
  provider            = "prisma-client"
  output              = "../src/datos/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Empresas y configuración
// ─────────────────────────────────────────────────────────────────────────────

/// Empresa del grupo (multi-empresa explícito, A9). Equivale a la tabla `Empresas`
/// del sistema viejo (doc 10 §5): `favorita` reemplaza a `Importancia = 1`,
/// `paraIpt`/`paraEdr` conservan en qué procesos participa la empresa.
model Empresa {
  id            Int     @id @default(autoincrement())
  /// Nombre corto de uso diario (viejo: `Empresas.Empresa`). Único para evitar duplicados de captura.
  nombre        String  @unique
  razonSocial   String? @map("razon_social")
  /// Identificador corto usado en folios e impresos (viejo: `Identificador`).
  identificador String?
  /// Empresa propuesta por defecto al iniciar sesión (viejo: `Importancia = 1`).
  favorita      Boolean @default(false)
  /// Participa en el inventario de producto terminado (viejo: `ParaIPT`).
  paraIpt       Boolean @map("para_ipt")
  /// Participa en el estado de resultados (viejo: `ParaEdoRes`).
  paraEdr       Boolean @map("para_edr")
  /// Borrado suave (plan §4: patrón conservado del sistema viejo): las empresas no se eliminan, se desactivan.
  activa        Boolean @default(true)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  configuracion     ConfiguracionEmpresa?
  almacenes         Almacen[]
  secuencias        Secuencia[]
  /// Pedidos internos de esta empresa (F2-E1, A9 — folio por empresa). Restrict.
  pedidos           Pedido[]
  /// Órdenes de producción de esta empresa (F2-E2, A9 — folio por empresa). Restrict.
  ordenes           Orden[]
  /// Etapas de producción (corte/envío/recibo/entrega) de esta empresa (F3-E1, A9). Restrict.
  etapasMovimiento  EtapaMovimiento[]
  /// Movimientos de kardex de esta empresa (F3-E1, A9 — folio por empresa). Restrict.
  movimientos       Movimiento[]
  /// Cargos a maquileros (EsMa) de esta empresa (F3-E1, A9). Restrict.
  cargosEsMa        EsMaCargo[]
  /// Abonos a la cuenta de maquileros de esta empresa (EsMa, F6-E4, A9). Restrict.
  abonosMaquilero   AbonoMaquilero[]
  /// Descuentos a la cuenta de maquileros de esta empresa (EsMa, F6-E4, A9). Restrict.
  descuentosMaquilero DescuentoMaquilero[]
  /// Pagos a maquileros de esta empresa (EsMa, F6-E4, A9). Restrict.
  pagosMaquilero    PagoMaquilero[]
  /// Órdenes de compra de esta empresa (F4-E2, A9 — folio por empresa). Restrict.
  ordenesCompra     OrdenCompra[]
  /// Recepciones de compra de esta empresa (F4-E3, A9 — folio por empresa). Restrict.
  recepcionesCompra RecepcionCompra[]
  /// Eventos de dominio (outbox) de esta empresa (F4-E3, patrón outbox/pg-boss). Restrict.
  eventosOutbox     EventoOutbox[]
  /// Notas de salida de materiales a maquileros de esta empresa (F4-E5, A9 — folio por empresa). Restrict.
  notasSalida       NotaSalida[]
  /// Calendario laboral de la RC de esta empresa (F5-E2, 1:1). Restrict.
  calendario        CalendarioEmpresa?
  /// Días festivos de la RC de esta empresa (F5-E2). Restrict.
  diasFestivos      DiaFestivo[]
  /// Auditorías de calidad de esta empresa (F6-E2, A9 — folio por empresa). Restrict.
  auditorias        Auditoria[]
  /// Costos reales de órdenes de esta empresa (F7-E1, A9). Restrict.
  costosOrden       CostoOrden[]

  @@map("empresas")
}

/// Configuración POR EMPRESA (plan §4): sustituye a la tabla `Propiedades` del sistema
/// viejo (un solo registro global, doc 10 §5). Los parámetros que eran globales pasan a
/// ser parametrizables por empresa. `VersionDisponible` y `Mantenimiento` no se migran:
/// el deploy web (A10) y el modo mantenimiento se resuelven en infraestructura.
model ConfiguracionEmpresa {
  id        Int     @id @default(autoincrement())
  idEmpresa Int     @unique @map("id_empresa")
  empresa   Empresa @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)

  /// Utilidad sugerida para costeo (viejo: `UtilidadSujerida`).
  utilidadSugerida Decimal? @map("utilidad_sugerida") @db.Decimal(10, 4)
  /// Porcentaje base de regalías (viejo: `Regalias`).
  regaliasBase     Decimal? @map("regalias_base") @db.Decimal(10, 4)
  /// Días de colchón que la Ruta Crítica agrega a la costura (viejo: `ColchonCostura`).
  colchonCostura   Int?     @map("colchon_costura")

  /// Fecha del último inventario físico de telas (viejo: `InvFisico`).
  fechaInventarioTelas DateTime? @map("fecha_inventario_telas") @db.Date
  /// Fecha del último inventario físico de producto terminado (viejo: `InvFisicoPT`).
  fechaInventarioPt    DateTime? @map("fecha_inventario_pt") @db.Date

  /// Almacén de producto terminado por defecto (viejo: `IPT_Almacen_Default`).
  idAlmacenPtDefault Int?     @map("id_almacen_pt_default")
  almacenPtDefault   Almacen? @relation("ConfiguracionAlmacenPtDefault", fields: [idAlmacenPtDefault], references: [id], onDelete: Restrict)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("configuraciones_empresa")
}

// ─────────────────────────────────────────────────────────────────────────────
// Usuarios y autenticación (better-auth) — A4: un solo sistema de seguridad
// ─────────────────────────────────────────────────────────────────────────────

/// Usuario del sistema. Mapea el modelo `user` de better-auth (id String cuid es
/// requisito del adapter) y absorbe los campos de negocio de la tabla `Usuarios`
/// del sistema viejo (doc 10 §4): `bloqueado` + `intentosFallidos` reemplazan a
/// `CantBloq` (bloqueo a los 5 intentos, doc 00 §1.1), `esAuditor` se conserva.
/// La contraseña NO vive aquí: va hasheada en `Cuenta` (providerId "credential").
/// Mapping de better-auth (configurado en E3): name→nombre,
/// createdAt→creadoEn, updatedAt→modificadoEn.
model Usuario {
  id              String  @id @default(cuid())
  /// Nombre de usuario para login, normalizado a minúsculas (plugin username de better-auth).
  username        String  @unique
  /// Forma original del username tal como la escribió quien lo creó (requisito del plugin username).
  displayUsername String? @map("display_username")
  /// Nombre completo de la persona (better-auth: `name`).
  nombre          String
  /// better-auth exige email único; el negocio no lo usa, puede ser sintético `<username>@control.local`.
  email           String  @unique
  emailVerified   Boolean @default(false) @map("email_verificado")
  image           String? @map("imagen")

  /// Borrado suave (plan §4: patrón conservado del sistema viejo): un usuario que se va se desactiva, jamás se borra.
  activo           Boolean @default(true)
  /// Bloqueado por intentos fallidos (regla viejo sistema: 5 intentos, doc 00 §1.1).
  bloqueado        Boolean @default(false)
  intentosFallidos Int     @default(0) @map("intentos_fallidos")
  /// Bandera de auditor de calidad (viejo: `Usuarios.EsAuditor`).
  esAuditor        Boolean @default(false) @map("es_auditor")

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  sesiones Sesion[]
  cuentas  Cuenta[]
  roles    UsuarioRol[]

  @@map("usuarios")
}

/// Sesión de better-auth (tabla auth pura — campos con los nombres que better-auth
/// espera; columnas en español). Cascade: al borrar un usuario caen sus sesiones.
model Sesion {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime @map("expira_en")
  ipAddress String?  @map("direccion_ip")
  userAgent String?  @map("agente_usuario")
  userId    String   @map("id_usuario")
  usuario   Usuario  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("creado_en")
  updatedAt DateTime @updatedAt @map("modificado_en")

  @@index([userId])
  @@map("sesiones")
}

/// Cuenta de autenticación de better-auth. Para login con contraseña:
/// providerId = "credential", accountId = id del usuario y `password` = hash
/// (scrypt de better-auth/crypto). Tabla auth pura.
model Cuenta {
  id                    String    @id @default(cuid())
  accountId             String    @map("id_cuenta")
  providerId            String    @map("id_proveedor")
  userId                String    @map("id_usuario")
  usuario               Usuario   @relation(fields: [userId], references: [id], onDelete: Cascade)
  password              String?
  accessToken           String?   @map("token_acceso")
  refreshToken          String?   @map("token_refresco")
  idToken               String?   @map("token_id")
  accessTokenExpiresAt  DateTime? @map("token_acceso_expira_en")
  refreshTokenExpiresAt DateTime? @map("token_refresco_expira_en")
  scope                 String?
  createdAt             DateTime  @default(now()) @map("creado_en")
  updatedAt             DateTime  @updatedAt @map("modificado_en")

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("cuentas")
}

/// Verificaciones temporales de better-auth (tokens de un solo uso). Tabla auth pura.
model Verificacion {
  id         String   @id @default(cuid())
  identifier String   @map("identificador")
  value      String   @map("valor")
  expiresAt  DateTime @map("expira_en")
  createdAt  DateTime @default(now()) @map("creado_en")
  updatedAt  DateTime @updatedAt @map("modificado_en")

  @@index([identifier])
  @@map("verificaciones")
}

// ─────────────────────────────────────────────────────────────────────────────
// RBAC (A4): roles + permisos. El catálogo de permisos vive en src/contrato;
// la tabla `permisos` se sincroniza desde ahí por el seed (clave = ClavePermiso).
// ─────────────────────────────────────────────────────────────────────────────

/// Rol de usuario. Los roles con `esSistema = true` los crea el seed (absorben los
/// niveles del sistema viejo, doc 00 §2) y la UI no permite borrarlos ni renombrarlos.
model Rol {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique
  descripcion String
  esSistema   Boolean @default(false) @map("es_sistema")

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  permisos RolPermiso[]
  usuarios UsuarioRol[]

  /// Procesos de la Ruta Crítica de los que este rol es RESPONSABLE (F5-E1, D10/A4). Puente
  /// N:M sobre el RBAC único: NO hay catálogo de roles paralelo (los `RC_TipoUsuarios` del
  /// viejo se absorben como roles funcionales del seed). Restrict: un rol asignado a un proceso
  /// no se borra físico.
  procesos ProcesoDefRol[]

  @@map("roles")
}

/// Permiso granular (espejo en BD del catálogo tipado de src/contrato, que es la
/// fuente de verdad). `clave` es una ClavePermiso `modulo.accion`; el id numérico es
/// interno y NUNCA se usa para autorizar.
model Permiso {
  id          Int    @id @default(autoincrement())
  clave       String @unique
  descripcion String
  modulo      String

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  roles RolPermiso[]

  @@map("permisos")
}

/// Permisos otorgados a un rol.
model RolPermiso {
  idRol     Int     @map("id_rol")
  rol       Rol     @relation(fields: [idRol], references: [id], onDelete: Restrict)
  idPermiso Int     @map("id_permiso")
  permiso   Permiso @relation(fields: [idPermiso], references: [id], onDelete: Restrict)

  creadoEn    DateTime @default(now()) @map("creado_en")
  creadoPorId String?  @map("creado_por_id")

  @@id([idRol, idPermiso])
  @@index([idPermiso])
  @@map("roles_permisos")
}

/// Roles asignados a un usuario.
model UsuarioRol {
  idUsuario String  @map("id_usuario")
  usuario   Usuario @relation(fields: [idUsuario], references: [id], onDelete: Restrict)
  idRol     Int     @map("id_rol")
  rol       Rol     @relation(fields: [idRol], references: [id], onDelete: Restrict)

  creadoEn    DateTime @default(now()) @map("creado_en")
  creadoPorId String?  @map("creado_por_id")

  @@id([idUsuario, idRol])
  @@index([idRol])
  @@map("usuarios_roles")
}

// ─────────────────────────────────────────────────────────────────────────────
// Almacenes (base del kardex único D3) y secuencias de folios (A3)
// ─────────────────────────────────────────────────────────────────────────────

/// Tipo de almacén según el inventario que guarda (D3: un kardex para PT, telas y avíos).
enum TipoAlmacen {
  PT
  TELA
  AVIO

  @@map("tipo_almacen")
}

/// Almacén físico o lógico. Unifica `IPT_Almacenes` (PT) y `Almacenes` (telas) del
/// sistema viejo. `idEmpresa` opcional: hay almacenes de una empresa y compartidos (A9).
/// OJO: el unique compuesto NO cubre almacenes globales (Postgres trata los NULL como
/// distintos); el servicio de dominio valida el nombre duplicado cuando idEmpresa es null.
model Almacen {
  id        Int         @id @default(autoincrement())
  nombre    String
  tipo      TipoAlmacen
  /// Borrado suave (plan §4: patrón conservado del sistema viejo).
  activo    Boolean     @default(true)
  idEmpresa Int?        @map("id_empresa")
  empresa   Empresa?    @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  configuracionesPtDefault ConfiguracionEmpresa[] @relation("ConfiguracionAlmacenPtDefault")

  /// Movimientos de kardex en este almacén (F3-E1, D3). Restrict: un almacén con
  /// movimientos no se borra físico → se desactiva.
  movimientos Movimiento[]

  /// Recibos de maquila que mandan sus PRIMERAS a este almacén (F3-E4). Restrict.
  recibosAlmacenPrimeras EtapaMovimiento[] @relation("ReciboAlmacenPrimeras")
  /// Recibos de maquila que mandan sus SEGUNDAS a este almacén (F3-E4). Restrict.
  recibosAlmacenSegundas EtapaMovimiento[] @relation("ReciboAlmacenSegundas")

  /// Recepciones de compra cuyo material entra a este almacén destino (F4-E3). Restrict.
  recepcionesCompra RecepcionCompra[]

  /// Notas de salida cuyos avíos salen de este almacén origen (F4-E5, decisión (g)). Restrict.
  notasSalida NotaSalida[]

  @@unique([idEmpresa, nombre])
  @@map("almacenes")
}

/// Contador de folios de negocio POR EMPRESA y por tipo de documento (A3: los folios
/// salen de aquí con UPDATE atómico — nunca `Max()+1`). `clave` identifica el tipo de
/// folio (p. ej. "pedido", "orden", "nota-salida", "orden-compra").
model Secuencia {
  id        Int     @id @default(autoincrement())
  idEmpresa Int     @map("id_empresa")
  empresa   Empresa @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)
  clave     String
  valor     BigInt  @default(0)

  @@unique([idEmpresa, clave])
  @@map("secuencias")
}

// ─────────────────────────────────────────────────────────────────────────────
// Bitácora (A7) y archivos (A5/R6)
// ─────────────────────────────────────────────────────────────────────────────

/// Acción registrada en la bitácora. CANCELAR/DESACTIVAR son los "borrados" suaves;
/// OTRO cubre eventos que no son cambio de datos (p. ej. inicios de sesión).
enum AccionBitacora {
  CREAR
  MODIFICAR
  DESACTIVAR
  CANCELAR
  OTRO

  @@map("accion_bitacora")
}

/// Bitácora de cambios por entidad (A7). `entidad` + `idEntidad` apuntan al registro
/// afectado (idEntidad en texto para cubrir PKs Int y String); `datos` guarda el
/// detalle del cambio en JSON. `idUsuario` sin FK físico: es un log inmutable y los
/// usuarios nunca se borran.
model Bitacora {
  id        BigInt         @id @default(autoincrement())
  entidad   String
  idEntidad String         @map("id_entidad")
  accion    AccionBitacora
  datos     Json?
  idUsuario String?        @map("id_usuario")
  fecha     DateTime       @default(now())

  @@index([entidad, idEntidad])
  @@map("bitacora")
}

/// Archivo guardado en Cloudflare R2 (A5: nada de rutas `S:\`; R6: repositorio de
/// adjuntos). Los objetos se referencian SIEMPRE por esta tabla, nunca por convención
/// de nombre (plan §2). `subidoPorId` sin FK físico (mismo criterio que la auditoría).
model Archivo {
  id             String   @id @default(cuid())
  bucket         String
  key            String   @unique
  nombreOriginal String   @map("nombre_original")
  tipoMime       String   @map("tipo_mime")
  tamanoBytes    Int      @map("tamano_bytes")
  subidoPorId    String?  @map("subido_por_id")
  subidoEn       DateTime @default(now()) @map("subido_en")

  /// Adjunto de proveedor que apunta a este archivo (F1-E1B), si lo hay. Relación
  /// inversa exigida por Prisma; en la práctica es 0 o 1 (un archivo se adjunta una vez).
  proveedorArchivo ProveedorArchivo?
  /// Bordado cuya foto es este archivo (F1-E3), si lo hay. Inversa de `Bordado.archivoFoto`;
  /// 0 o 1 (un archivo es la foto de un solo bordado).
  bordado          Bordado?
  /// Foto de modelo que apunta a este archivo (F1-E4), si la hay. Inversa de
  /// `ModeloFoto.archivo`; 0 o 1 (un archivo es UNA foto de UN modelo — Cascade en ambos).
  modeloFoto       ModeloFoto?

  @@map("archivos")
}

// ─────────────────────────────────────────────────────────────────────────────
// Catálogos (F1) — maestros GLOBALES (sin idEmpresa): se capturan una vez y los
// comparten todas las empresas (ADR-0007, decisión A9). Unicidad de `nombre`
// GLOBAL (@unique). Mismo patrón que `Almacen`: borrado suave (`activo`) +
// auditoría uniforme (A7) creadoEn/creadoPorId + modificadoEn/modificadoPorId.
// onDelete Restrict no aplica aún (no hay relaciones entrantes en F1-E1; las
// agregan F1-E3/E4: AvioProveedor→Proveedor, TelaColor→Color, Modelo→Temporada).
// ─────────────────────────────────────────────────────────────────────────────

/// Clasificación del proveedor (doc funcional 03-Producción §Órdenes de Compra:
/// el campo `TipoProv` del viejo usaba H/T/S — habilitación/avíos, telas, servicios).
/// `SIN_CLASIFICAR` cubre los proveedores del viejo sin tipo capturado. El mapeo
/// H/T/S → este enum lo hace el ETL en F1-E6; aquí solo se define el enum nuevo.
enum TipoProveedor {
  TELAS
  AVIOS
  SERVICIOS
  SIN_CLASIFICAR

  @@map("tipo_proveedor")
}

/// Proveedor (catálogo global, F1-E1 + enriquecido F1-E1B). Equivale a la tabla
/// `Proveedores` del viejo (doc 03-Producción §Órdenes de Compra). Base de
/// `AvioProveedor` (F1-E3, R1) y, sobre todo, cimiento de las CxP de la futura
/// fase de Finanzas (F8, decisión D12, R15 — `Documentacion_MJD/PROPUESTA-Finanzas-y-Proveedores.md` §4).
///
/// F1-E1B agrega: roles/servicios multi-valor (relación `ProveedorRol`, que NO
/// reemplaza a `tipo` — este se conserva como clasificador rápido, acta de Gabriel
/// 13-jun-2026), campos fiscales para el CFDI, datos comerciales/de pago, lead time
/// para el MRP y adjuntos en R2 (`ProveedorArchivo`). TODOS los campos nuevos son
/// NULLABLE: los 443 proveedores que migran en F1-E6 no traen estos datos; se
/// capturan en altas/ediciones nuevas (la regla "factura ⇒ RFC" es de captura, no
/// rompe filas viejas).
///
/// FUSIÓN DE TERCEROS (D12/R15 — `Documentacion_MJD/PROPUESTA-Finanzas-y-Proveedores.md`
/// §4): este catálogo ABSORBE a los antiguos `Maquilero` y `Cortador` (eliminados). Un
/// tercero se da de alta UNA sola vez como Proveedor y marca sus servicios (maquila,
/// corte, estampado, bordado, lavado, aplicación, venta de telas/avíos…) con CASILLAS de
/// `RolProveedor`. Los atributos propios del maquilero se portaron como campos nullable
/// (`corto`, `asegurado`, `obsPago`, abajo).
model Proveedor {
  id          Int           @id @default(autoincrement())
  /// Nombre de uso diario. Único global (ADR-0007): un proveedor se da de alta una sola vez.
  nombre      String        @unique
  razonSocial String?       @map("razon_social")
  /// Clasificación rápida (telas/avíos/servicios); por defecto sin clasificar.
  /// F1-E1B: SE CONSERVA junto a los roles multi-valor (acta Gabriel 13-jun-2026).
  tipo        TipoProveedor @default(SIN_CLASIFICAR)
  telefono    String?
  contacto    String?
  /// Condiciones comerciales en texto libre (crédito, plazos…). Se conserva de E1;
  /// los datos comerciales estructurados (diasCredito, moneda…) los agrega E1B.
  condiciones String?

  // ── Fiscal (F1-E1B, R15 §4): lo que el CFDI necesita ───────────────────────
  /// ¿Emite CFDI? Define formal (true) vs informal (false/null). Si es true, la
  /// regla de captura exige `rfc` + `regimenFiscalSat` (relajada para migrados).
  factura                Boolean?
  /// RFC del tercero (persona física 13 / moral 12), validado en Zod si viene.
  rfc                    String?
  /// Régimen fiscal del SAT (clave de catálogo del SAT, p. ej. "601").
  regimenFiscalSat       String?  @map("regimen_fiscal_sat")
  /// Uso de CFDI habitual (clave del SAT, p. ej. "G03").
  usoCfdiHabitual        String?  @map("uso_cfdi_habitual")
  /// Código postal del lugar de expedición del comprobante.
  codigoPostalExpedicion String?  @map("codigo_postal_expedicion")
  /// Se le retiene IVA (común a personas físicas en maquila).
  retieneIva             Boolean? @map("retiene_iva")
  /// Se le retiene ISR.
  retieneIsr             Boolean? @map("retiene_isr")

  // ── Contacto (F1-E1B): el telefono/contacto de E1 se conservan arriba ──────
  /// Email para enviar la OC y recibir el XML del CFDI.
  email     String?
  direccion String?

  // ── Comercial / pago (F1-E1B, R15 §4) ─────────────────────────────────────
  /// Condición de pago: días de crédito. null o 0 = contado (ver TSDoc del dominio).
  diasCredito   Int?     @map("dias_credito")
  /// Moneda habitual: MXN o USD (validada en Zod).
  moneda        String?
  /// Forma de pago (transferencia/efectivo/cheque — clave o texto del SAT).
  formaPago     String?  @map("forma_pago")
  /// Método de pago del CFDI: PUE (una exhibición) o PPD (parcialidades/diferido).
  metodoPago    String?  @map("metodo_pago")
  banco         String?
  /// CLABE interbancaria (18 dígitos con dígito de control, validada en Zod).
  clabe         String?
  /// Límite de crédito (opcional), para alertas de CxP en F8.
  limiteCredito Decimal? @map("limite_credito") @db.Decimal(14, 2)

  // ── Operativo (F1-E1B): alimenta el MRP/Make-to-Order (R3/R7, F4) ─────────
  /// Tiempo de entrega típico en días (lead time).
  leadTimeDias Int?    @map("lead_time_dias")
  notas        String?

  // ── Maquila/corte (fusión de terceros, D12/R15) ───────────────────────────
  // Al consolidar Maquilero y Cortador en este único catálogo (un tercero se da de
  // alta UNA vez y marca sus servicios con casillas de `RolProveedor`), se portan los
  // atributos PROPIOS del maquilero que no tenían equivalente en Proveedor. Son
  // NULLABLE: los proveedores que ya existen (y los que migren en F1-E6) no los traen;
  // se capturan en altas/ediciones de talleres. El `nombre`/`telefono`/`direccion`/
  // `notas` del maquilero ya viven en los campos homónimos de arriba (no se duplican).
  // El `precioReferencia` del cortador NO se porta: el costo del corte se definirá en la
  // orden de producción (pendiente F2/F3).
  /// Clave corta de uso diario del taller (ex `Maquilero.corto`). Única global (nullable).
  corto     String?  @unique
  /// ¿Está asegurado? (ex `Maquilero.asegurado`). Nullable: solo aplica a talleres.
  asegurado Boolean?
  /// Observaciones específicas de pago (ex `Maquilero.obsPago`).
  obsPago   String?  @map("obs_pago")

  /// Modalidad de facturación del maquilero para su cuenta EsMa (F6-E4, decisión (h)):
  /// `solo_con` factura siempre, `solo_sin` nunca, `ambos` opera de las dos formas (y en
  /// ese caso su estado de cuenta se segmenta en dos, E5). NULLABLE: los proveedores ya
  /// migrados no lo traen (default sensato en el dominio: se deriva de `factura` en la UI;
  /// null se trata como "no definido" y exige elegir con-factura por movimiento). Ver enum.
  modalidadFacturacion ModalidadFacturacion? @map("modalidad_facturacion")

  /// Borrado suave (plan §4: patrón conservado del sistema viejo).
  activo Boolean @default(true)

  /// Roles/servicios multi-valor del proveedor (F1-E1B, N:N vía `ProveedorRol`).
  roles                   ProveedorRol[]
  /// Adjuntos del proveedor en R2 (F1-E1B: constancia, contrato…).
  archivos                ProveedorArchivo[]
  /// Avíos que surte este proveedor (F1-E3, R1, N:N vía `AvioProveedor`).
  avios                   AvioProveedor[]
  /// Órdenes de producción donde está asignado como maquilero (F2-E2, Restrict).
  ordenes                 Orden[]
  /// Etapas de producción donde es el TERCERO (cortador/maquilero/estampador) (F3-E1,
  /// fusión de terceros D12/R15: el tercero es un Proveedor con su rol de servicio). Restrict.
  etapasMovimiento        EtapaMovimiento[]
  /// Cargos a su cuenta de maquila (EsMa) como maquilero (F3-E1). Restrict.
  cargosEsMa              EsMaCargo[]
  /// Abonos a su cuenta de maquila (EsMa, F6-E4). Restrict.
  abonosMaquilero         AbonoMaquilero[]
  /// Descuentos a su cuenta de maquila (EsMa, F6-E4). Restrict.
  descuentosMaquilero     DescuentoMaquilero[]
  /// Pagos recibidos como maquilero (EsMa, F6-E4). Restrict.
  pagosMaquilero          PagoMaquilero[]
  /// Lotes de tela que este proveedor surtió (F4-E1, D5). Restrict.
  lotes                   Lote[]
  /// Órdenes de compra emitidas a este proveedor (F4-E2). Restrict.
  ordenesCompra           OrdenCompra[]
  /// Requerimientos de explosión MRP donde es el proveedor SUGERIDO (F4-E4, R1/R3). Restrict.
  requerimientosSugeridos RequerimientoOrden[] @relation("RequerimientoProveedorSugerido")
  /// Notas de salida donde este proveedor es el MAQUILERO destino del envío (F4-E5). Restrict.
  notasSalida             NotaSalida[]
  /// Auditorías de calidad donde este proveedor es el MAQUILERO auditado (F6-E2). Restrict.
  auditorias              Auditoria[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("proveedores")
}

/// Rol/servicio que un proveedor puede prestar (F1-E1B, R15 §4.1). Catálogo
/// administrable y GLOBAL (ADR-0007): un mismo proveedor puede maquilar Y cortar,
/// o vender avíos Y maquilar, sin duplicarse. Mismo patrón N:N que `MaquileroTipoProceso`
/// (F1-E2). El `origen` de cada movimiento (recibo vs factura) decide en qué vista
/// cae en F8 (EsMa vs CxP); el rol solo clasifica al proveedor.
model RolProveedor {
  id     Int     @id @default(autoincrement())
  /// Clave estable de negocio (kebab-case, p. ej. "maquila-costura"). Única global.
  codigo String  @unique
  /// Nombre legible para la UI (p. ej. "Maquila (costura)").
  nombre String
  /// Borrado suave (plan §4): un rol en uso se desactiva, no se borra (Restrict).
  activo Boolean @default(true)

  /// Proveedores que tienen este rol (N:N).
  proveedores ProveedorRol[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("roles_proveedor")
}

/// Puente N:N proveedor ↔ rol (F1-E1B). Un renglón por cada rol que presta el
/// proveedor. PK compuesta (sin id propio): el par (proveedor, rol) es único por
/// definición. `onDelete`:
///  • Cascade hacia `Proveedor`: los roles son configuración del proveedor; si el
///    proveedor se borrara físicamente (no pasa hoy: borrado suave), sus renglones
///    de rol se irían con él. Además permite reescribir el set de roles en la tx.
///  • Restrict hacia `RolProveedor`: un rol con proveedores asignados NO se puede
///    borrar físicamente (se desactiva con `activo`), para no dejar el par colgando.
model ProveedorRol {
  idProveedor    Int @map("id_proveedor")
  idRolProveedor Int @map("id_rol_proveedor")

  proveedor Proveedor    @relation(fields: [idProveedor], references: [id], onDelete: Cascade)
  rol       RolProveedor @relation(fields: [idRolProveedor], references: [id], onDelete: Restrict)

  creadoEn    DateTime @default(now()) @map("creado_en")
  creadoPorId String?  @map("creado_por_id")

  @@id([idProveedor, idRolProveedor])
  @@index([idRolProveedor])
  @@map("proveedor_rol")
}

/// Tipo de adjunto de un proveedor (F1-E1B, R15 §4: "adjuntos en R2 — constancia
/// de situación fiscal, contrato"). `OTRO` cubre cualquier otro documento.
enum TipoArchivoProveedor {
  CONSTANCIA
  CONTRATO
  OTRO

  @@map("tipo_archivo_proveedor")
}

/// Puente proveedor ↔ archivo R2 (F1-E1B). Liga un `Archivo` (registro del motor de
/// archivos de F0) a un proveedor con su tipo documental. `onDelete`:
///  • Cascade hacia `Proveedor`: los adjuntos son del proveedor.
///  • Cascade hacia `Archivo`: al quitar el adjunto se borra también su `Archivo`
///    (el objeto R2 huérfano es inofensivo — lo documenta `comun/archivos.ts`).
model ProveedorArchivo {
  id          Int                  @id @default(autoincrement())
  idProveedor Int                  @map("id_proveedor")
  idArchivo   String               @map("id_archivo")
  tipo        TipoArchivoProveedor @default(OTRO)

  proveedor Proveedor @relation(fields: [idProveedor], references: [id], onDelete: Cascade)
  archivo   Archivo   @relation(fields: [idArchivo], references: [id], onDelete: Cascade)

  creadoEn    DateTime @default(now()) @map("creado_en")
  creadoPorId String?  @map("creado_por_id")

  @@unique([idArchivo])
  @@index([idProveedor])
  @@map("proveedor_archivo")
}

// NOTA (fusión de terceros, D12/R15): el modelo `Cortador` se ELIMINÓ. El cortador es
// ahora un Proveedor con el rol `corte` (casilla de `RolProveedor`). Su `precioReferencia`
// NO se portó: el costo del corte se definirá en la orden de producción (pendiente F2/F3).

/// Temporada (catálogo global, F1-E1). Equivale a la tabla `Temporadas` del viejo
/// (doc 01-Modelos §2): clasifica los modelos por temporada comercial.
model Temporada {
  id     Int     @id @default(autoincrement())
  /// Nombre de la temporada. Único global (ADR-0007).
  nombre String  @unique
  /// Borrado suave (plan §4: patrón conservado del sistema viejo).
  activo Boolean @default(true)

  /// Modelos clasificados en esta temporada (F1-E4, FK nullable Restrict).
  modelos Modelo[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("temporadas")
}

/// Etiqueta de marca (catálogo global, F1-E1). Equivale a la tabla `EtiquetasM` del
/// viejo (doc 01-Modelos §2 y §6 punto 4): la marca/etiqueta del modelo, con su
/// porcentaje de `regalias` que alimenta el costeo (% del precio).
model EtiquetaMarca {
  id       Int     @id @default(autoincrement())
  /// Nombre de la etiqueta de marca. Único global (ADR-0007).
  nombre   String  @unique
  /// Porcentaje de regalías (0–100), validado en Zod y en el dominio. Alimenta el costeo (01-Modelos §6).
  regalias Decimal @default(0) @db.Decimal(5, 2)
  /// Borrado suave (plan §4: patrón conservado del sistema viejo).
  activo   Boolean @default(true)

  /// Órdenes de producción con esta etiqueta de marca (F2-E2, Restrict).
  ordenes Orden[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("etiquetas_marca")
}

/// Color (catálogo global, F1-E1). Motivado por `TelasColores.Color` (texto libre en
/// el viejo, doc 04-Inventarios §B.2): se normaliza a un catálogo único. La fusión de
/// duplicados (alias) llega en F1-E6; aquí solo unicidad por nombre + normalización
/// LIGERA (trim + colapsar espacios) en el dominio.
model Color {
  id     Int     @id @default(autoincrement())
  /// Nombre del color, normalizado. Único global (ADR-0007).
  nombre String  @unique
  /// Borrado suave (plan §4: patrón conservado del sistema viejo).
  activo Boolean @default(true)

  /// Telas que tienen este color con su precio (F1-E3, N:N vía `TelaColor`).
  telas                  TelaColor[]
  /// Renglones de matriz de órdenes en este color (F2-E2, Restrict).
  ordenLineas            OrdenLinea[]
  /// Renglones de etapas de producción (corte/envío/recibo/entrega) en este color (F3-E1, D4). Restrict.
  etapasMovimientoDet    EtapaMovimientoDet[]
  /// Renglones de kardex PT en este color (F3-E1, D4). Restrict.
  movimientosDetPt       MovimientoDetPt[]
  /// Lotes de tela teñidos en este color (F4-E1, D5: el lote define el teñido). Restrict.
  lotes                  Lote[]
  /// Cantidades de la matriz talla×color de renglones de OC en este color (F4-E2). Restrict.
  ordenCompraLineasTalla OrdenCompraLineaTalla[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("colores")
}

// ─────────────────────────────────────────────────────────────────────────────
// Catálogos ESTRUCTURADOS (F1-E2) — maestros GLOBALES (sin idEmpresa, ADR-0007/A9)
// con relaciones internas:
//  • Tipos de proceso: catálogo independiente (consumidor real: la Ruta Crítica, F5).
//    NOTA fusión de terceros (D12/R15): la "maquila unificada" (Maquilero+TipoProceso
//    N:N) se ELIMINÓ; un maquilero es ahora un Proveedor con roles de servicio.
//  • Tallas ilimitadas (D4, MEJORAS A6): Talla + CurvaTalla (maestro-detalle ordenado).
//  • Campos de referencia por cliente (D7): Cliente + ClienteCampo (definición; los
//    VALORES son de F2 vía OrdenReferencia).
// Mismo patrón de auditoría uniforme (A7) y borrado suave (`activo`) que F1-E1.
// onDelete: Restrict hacia los catálogos (en uso ⇒ se desactiva, no se borra físico);
// Cascade hacia el maestro padre en los puentes/detalles (permite reescribir el set
// en la transacción A2). Idéntico al patrón Proveedor↔RolProveedor de F1-E1B.
// ─────────────────────────────────────────────────────────────────────────────

/// Tipo de proceso (catálogo administrable y GLOBAL). Costura, estampado, bordado,
/// lavado, aplicación… En F5 cada tipo se liga a un proceso de la Ruta Crítica (su
/// consumidor real). SE CONSERVA como catálogo independiente: la fusión de terceros
/// (D12/R15) eliminó `Maquilero`/`MaquileroTipoProceso`, así que ya NO tiene relación
/// inversa hacia maquileros (los servicios de un taller se marcan ahora con casillas de
/// `RolProveedor` en el Proveedor; NO hay enlace Proveedor↔TipoProceso). Mismo patrón
/// que `RolProveedor` (se siembra; admin fina diferida).
model TipoProceso {
  id     Int     @id @default(autoincrement())
  /// Clave estable kebab-case (p. ej. "costura"). Única global.
  codigo String  @unique
  nombre String
  activo Boolean @default(true)

  /// ¿El RECIBO de este proceso deja PRENDA TERMINADA y por tanto genera ENTRADA al
  /// inventario PT? (F3-E1, decisión (e) — DECISIONES.md). Por DATO, no por código:
  /// el recibo de maquila (F3-E4) consulta esta bandera para decidir si crea un
  /// `Movimiento` de entrada al kardex PT. SOLO costura = `true`; estampado/aplicación,
  /// bordado y lavado = `false` (evidencia v1: `Recibos.Inventariado` existe solo en
  /// costura; `RecibosEst` NO la trae; `IPT_Movs` tiene 2,468 entradas tipo 2 'Entrada
  /// de Maquila' contra 3 del tipo 3 'Entrada de Aplicación'). Default `false` (lo
  /// SEGURO: un proceso nuevo no mete a PT salvo que se marque). El seed de F3-E1 pone
  /// `true` solo en costura. Cambiar el valor luego es DATO (UI de admin, F3-E1 Fase 2),
  /// NO migración. Editable solo por admin (A4).
  generaEntradaPt Boolean @default(false) @map("genera_entrada_pt")

  /// Etapas de envío/recibo de maquila de este proceso (F3, Restrict): un tipo de
  /// proceso en uso por una etapa no se borra físico → se desactiva.
  etapas     EtapaMovimiento[]
  /// Cargos a maquileros (EsMa) de este proceso (F3, Restrict).
  cargosEsMa EsMaCargo[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("tipos_proceso")
}

// NOTA (fusión de terceros, D12/R15): los modelos `Maquilero` y `MaquileroTipoProceso`
// se ELIMINARON. Un maquilero es ahora un Proveedor con sus roles de servicio (casillas
// de `RolProveedor`: maquila-costura, estampado, bordado, lavado, aplicación…). Sus
// atributos propios (corto/asegurado/obsPago) se portaron a `Proveedor`.

/// Talla individual (catálogo global, D4 — PLANMAESTRO §4; MEJORAS A6: anchos fijos
/// T1..T8 → catálogo). `orden` da el orden canónico de despliegue (NO único en BD;
/// lo gestiona el dominio).
model Talla {
  id       Int     @id @default(autoincrement())
  /// Etiqueta de la talla (XCH, CH, M, G, XG, 28, 30…). Única global.
  etiqueta String  @unique
  orden    Int     @default(0)
  activo   Boolean @default(true)

  curvas                 CurvaTallaItem[]
  /// Cantidades de matriz de órdenes en esta talla (F2-E2, Restrict).
  ordenLineasTalla       OrdenLineaTalla[]
  /// Renglones de etapas de producción en esta talla (F3-E1, D4). Restrict.
  etapasMovimientoDet    EtapaMovimientoDet[]
  /// Renglones de kardex PT en esta talla (F3-E1, D4). Restrict.
  movimientosDetPt       MovimientoDetPt[]
  /// Cantidades de la matriz talla×color de renglones de OC en esta talla (F4-E2). Restrict.
  ordenCompraLineasTalla OrdenCompraLineaTalla[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("tallas")
}

/// Curva de tallas (D4): conjunto ORDENADO de tallas (p. ej. "Caballero básica").
model CurvaTalla {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  activo Boolean @default(true)

  items   CurvaTallaItem[]
  /// Modelos que usan esta curva de tallas (F1-E4, D4 — FK nullable Restrict).
  modelos Modelo[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("curvas_talla")
}

/// Renglón de una curva (maestro-detalle ordenado). Una talla aparece UNA vez por
/// curva (PK compuesta); `posicion` da el orden dentro de la curva (lo asigna el
/// dominio; no único en BD para permitir reordenar en tx). Cascade hacia CurvaTalla
/// (permite reescribir el set en la tx), Restrict hacia Talla (una talla usada por
/// una curva no se borra físico → se desactiva, con mensaje claro).
model CurvaTallaItem {
  idCurva  Int @map("id_curva")
  idTalla  Int @map("id_talla")
  posicion Int

  curva CurvaTalla @relation(fields: [idCurva], references: [id], onDelete: Cascade)
  talla Talla      @relation(fields: [idTalla], references: [id], onDelete: Restrict)

  creadoEn    DateTime @default(now()) @map("creado_en")
  creadoPorId String?  @map("creado_por_id")

  @@id([idCurva, idTalla])
  @@index([idTalla])
  @@map("curva_talla_item")
}

/// Tipo de dato de un campo de referencia de cliente (D7). Para validar el VALOR en F2.
enum TipoCampoCliente {
  TEXTO
  NUMERO
  FECHA

  @@map("tipo_campo_cliente")
}

/// Cliente (catálogo global, F1-E2). El viejo solo tiene Id/Cliente/Activo
/// (doc 02-Pedidos §2); v2 agrega contacto básico. Los VALORES de los campos de
/// referencia (OrdenReferencia) son de F2; aquí: catálogo + DEFINICIÓN de campos (D7).
model Cliente {
  id        Int     @id @default(autoincrement())
  nombre    String  @unique
  contacto  String?
  telefono  String?
  email     String?
  direccion String?
  activo    Boolean @default(true)

  campos  ClienteCampo[]
  /// Pedidos internos del cliente (F2-E1, Restrict hacia el cliente).
  pedidos Pedido[]
  /// Órdenes de producción del cliente (F2-E2, Restrict hacia el cliente).
  ordenes Orden[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("clientes")
}

/// Definición de un campo de referencia POR cliente (D7 — PLANMAESTRO §4). Cada
/// cliente define SUS campos (p. ej. "No. de pedido del cliente", semilla del Monarch
/// viejo, D7). `etiqueta` única DENTRO del cliente. Borrado suave (`activo`). Los
/// valores se capturan por orden en F2 (OrdenReferencia): el dominio documenta YA que
/// un campo con valores NO se borrará físico (regla para F2). Cascade desde Cliente.
model ClienteCampo {
  id        Int              @id @default(autoincrement())
  idCliente Int              @map("id_cliente")
  etiqueta  String
  tipo      TipoCampoCliente @default(TEXTO)
  orden     Int              @default(0)
  activo    Boolean          @default(true)

  cliente          Cliente           @relation(fields: [idCliente], references: [id], onDelete: Cascade)
  /// Valores de este campo capturados en órdenes (F2-E2, D7 — Restrict: un campo con valores
  /// en órdenes no se borra físico → se desactiva).
  referenciasOrden OrdenReferencia[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idCliente, etiqueta])
  @@index([idCliente])
  @@map("cliente_campo")
}

// ─────────────────────────────────────────────────────────────────────────────
// Catálogos de MATERIALES (F1-E3) — los tres catálogos complejos que alimentan el
// BOM (docs/hoja-de-ruta/F1-etapas.md §F1-E3). Maestros GLOBALES (sin idEmpresa,
// ADR-0007/A9) con auditoría uniforme (A7) y borrado suave (`activo`):
//  • Telas UNIFICADAS (D5): una SOLA entidad `Tela` para BOM e inventario —corrige la
//    dualidad Telas/TelasDis del viejo— con su clasificación (`TelaCategoria`) y su grid
//    de colores con precio (`TelaColor`, N:N a Color). El mapeo Telas/TelasDis→Tela es
//    del ETL de E6, no aquí (ADR-0009).
//  • Avíos (R1): catálogo `Avio` (ex `Habilitacion`) con sus proveedores y precios
//    (`AvioProveedor`, N:N a Proveedor). `unidad`/`presentacion` NULLABLE (obligatorias
//    solo en altas nuevas por UI; relajadas para los 629 avíos migrados en E6 — ADR-0009).
//    `precioReferencia` es el fallback de precio cuando no hay proveedor mapeable (ADR-0009).
//  • Bordados (R2): `Bordado` (ex tabla con `BorEst` y `Foto`) con su foto en R2 (FK
//    directa al `Archivo` de F0; 1 bordado → 0..1 foto, sin tabla puente).
// onDelete: Restrict hacia los catálogos en uso (Color, Proveedor, TelaCategoria — se
// desactivan, no se borran físico); Cascade hacia el maestro padre en los puentes
// (Tela en TelaColor, Avio en AvioProveedor — permite reescribir el set en la tx A2);
// SetNull en Bordado→Archivo (quitar la foto no borra el bordado). Mismo patrón que
// F1-E1B (Proveedor↔RolProveedor) y F1-E2 (Maquilero↔TipoProceso).
// ─────────────────────────────────────────────────────────────────────────────

/// Tipo de componente de una tela dentro del lote (D5 — doc 04-Inventarios §B.1:
/// telas de dos componentes, p. ej. felpa + cardigan del mismo lote). `OTRO` cubre
/// acompañantes y telas de un solo componente. Sustituye la dualidad fija
/// ExTela1/ExTela2 del viejo (que F4 generaliza a N acompañantes por lote, D5).
enum TipoComponenteTela {
  CUERPO
  CARDIGAN
  OTRO

  @@map("tipo_componente_tela")
}

/// Tipo de un "bordado" (ex campo `BorEst` del viejo, doc 01-Modelos §2): distingue
/// bordado real de estampado/aplicación. En F4 el BOM del modelo los referencia igual.
enum TipoBordado {
  BORDADO
  ESTAMPADO

  @@map("tipo_bordado")
}

/// Categoría de tela (catálogo global, F1-E3). Equivale a `TelasCategorias` del viejo
/// (doc 04-Inventarios §B.2): agrupa las telas (Felpa, Jersey, Rib…). Sin permiso
/// propio: se gobierna con `telas.administrar` (ADR-0009). Borrado suave + auditoría A7.
model TelaCategoria {
  id     Int     @id @default(autoincrement())
  /// Nombre de la categoría. Único global (ADR-0007).
  nombre String  @unique
  /// Borrado suave (plan §4: patrón conservado del sistema viejo).
  activo Boolean @default(true)

  /// Telas clasificadas en esta categoría.
  telas Tela[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("telas_categorias")
}

/// Tela UNIFICADA (catálogo global, F1-E3, D5 — ADR-0009). UNA sola entidad que sirve
/// al BOM (doc 01-Modelos §2, TelasDis) Y al inventario (doc 04-Inventarios §B.2, Telas):
/// corrige la dualidad Telas/TelasDis del viejo. Diseñada para que Lote/LoteComponente
/// de F4 cuelguen de ella sin retocarla. El mapeo del par viejo → esta tabla lo hace el
/// ETL de E6. `idCategoria` OPCIONAL (no romper el ETL si la tela vieja no trae categoría).
model Tela {
  id             Int                @id @default(autoincrement())
  /// Nombre de la tela. Único global (ADR-0007).
  nombre         String             @unique
  descripcion    String?
  /// Categoría (opcional para no romper el ETL de E6). Restrict: una categoría en uso
  /// no se borra físico → se desactiva.
  idCategoria    Int?               @map("id_categoria")
  categoria      TelaCategoria?     @relation(fields: [idCategoria], references: [id], onDelete: Restrict)
  /// Unidad de medida de uso/compra (kg, m…). Texto libre (la UI sugiere una lista).
  unidadMedida   String?            @map("unidad_medida")
  /// Rol típico de la tela en el lote (D5: cuerpo/cardigan/otro). Default OTRO.
  tipoComponente TipoComponenteTela @default(OTRO) @map("tipo_componente")
  /// Tela de uso frecuente (preselección en la UI de captura).
  favorito       Boolean            @default(false)
  /// Precio de referencia por unidad (informativo; el costo real va por lote/orden).
  precioSugerido Decimal?           @map("precio_sugerido") @db.Decimal(12, 2)
  /// ¿Es tela de producción (vs. muestra/insumo no productivo)? Default true.
  paraProduccion Boolean            @default(true) @map("para_produccion")
  /// Borrado suave (plan §4: patrón conservado del sistema viejo).
  activo         Boolean            @default(true)

  /// Colores disponibles de esta tela con su precio (N:N a Color).
  colores            TelaColor[]
  /// Renglones del BOM de modelos que usan esta tela (F1-E4, Restrict hacia la tela).
  modelos            ModeloTela[]
  /// Órdenes de producción que disponen de esta tela (F2-E2, Restrict).
  ordenes            Orden[]
  /// Renglones de kardex de TELA de esta tela (dimensión tela×lote, D5). Las filas las
  /// ejercita F4 (el inventario de telas); la tabla nace en F3-E1 para fijar el motor
  /// genérico. Restrict.
  movimientosDetTela MovimientoDetTela[]
  /// Componentes de lote que usan esta tela (F4-E1, D5: un lote trae N telas). Restrict.
  loteComponentes    LoteComponente[]
  /// Renglones de orden de compra que piden esta tela (F4-E2). Restrict.
  ordenCompraLineas  OrdenCompraLinea[]
  /// Renglones de explosión MRP que requieren esta tela (F4-E4, R3). Restrict.
  requerimientos     RequerimientoOrden[]
  /// Renglones de nota de salida que envían esta tela a maquila (F4-E5). Restrict.
  notaSalidaLineas   NotaSalidaLinea[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("telas")
}

/// Puente N:N tela ↔ color con precio (F1-E3). Equivale a `TelasColores` del viejo
/// (doc 04-Inventarios §B.2). PK compuesta (idTela, idColor): un color aparece UNA vez
/// por tela. `onDelete`:
///  • Cascade hacia `Tela`: los colores son configuración de la tela; permite reescribir
///    el grid de colores en la transacción A2.
///  • Restrict hacia `Color`: un color usado por alguna tela no se borra físico (se
///    desactiva con `activo`, con mensaje claro), para no dejar el par colgando.
/// Auditoría COMPLETA: `precio` es editable (A7).
model TelaColor {
  idTela  Int      @map("id_tela")
  idColor Int      @map("id_color")
  /// Precio del metro/kg de esta tela en este color (informativo; el costo real va por lote).
  precio  Decimal? @db.Decimal(12, 2)

  tela  Tela  @relation(fields: [idTela], references: [id], onDelete: Cascade)
  color Color @relation(fields: [idColor], references: [id], onDelete: Restrict)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@id([idTela, idColor])
  @@index([idColor])
  @@map("telas_colores")
}

/// LOTE de tela (F4-E1, D5 — doc 04-Inventarios §B.1/§B.3). Un lote es una compra/teñido
/// concreto que ENTRA al inventario: define el COLOR (el teñido) y trae 1..N telas
/// acompañantes (cuerpo + cardigan + …) del MISMO lote y color, para que casen los colores
/// (D5 elimina el límite viejo de 2 componentes `ExTela1/ExTela2`). El lote es la dimensión de
/// trazabilidad del kardex de telas: la existencia es por tela × lote × almacén (Σ de
/// movimientos, D3). `proveedor`/`factura`/`fecha` son los datos de la entrada (el viejo los
/// llevaba en `Entradas`); en v2 la entrada-recepción (E3) crea el lote en la MISMA transacción
/// que el movimiento de kardex. GLOBAL (sin idEmpresa — catálogo de materiales, ADR-0007: el
/// inventario por empresa lo da `Movimiento.idEmpresa`). Auditoría A7.
model Lote {
  id            Int        @id @default(autoincrement())
  /// Clave de negocio del lote (estable, p. ej. número de lote/teñido del proveedor). Única
  /// global. Para el ETL de lotes legacy sintetizados (E6) se genera una clave determinista.
  clave         String     @unique
  /// Color (teñido) del lote: TODOS sus componentes comparten este color (D5). Restrict.
  idColor       Int        @map("id_color")
  color         Color      @relation(fields: [idColor], references: [id], onDelete: Restrict)
  /// Proveedor que surtió el lote (opcional: el histórico legacy puede no mapearlo). Restrict.
  idProveedor   Int?       @map("id_proveedor")
  proveedor     Proveedor? @relation(fields: [idProveedor], references: [id], onDelete: Restrict)
  /// Factura de la entrada del lote (texto del proveedor; opcional para el legacy).
  factura       String?
  /// Fecha de la entrada/teñido del lote (solo fecha).
  fecha         DateTime?  @db.Date
  observaciones String?    @db.Text

  /// Componentes (telas) que llegaron en este lote (1..N, mismo color — D5).
  componentes        LoteComponente[]
  /// Renglones de kardex de TELA ligados a este lote (existencia por tela×lote×almacén, D3).
  movimientosDetTela MovimientoDetTela[]
  /// Renglones de kardex de AVÍO ligados a este lote (opcional, R4 — pocos avíos por lote).
  movimientosDetAvio MovimientoDetAvio[]
  /// Renglones de recepción de compra que crearon/usaron este lote (F4-E3, D5). Restrict.
  recepcionLineas    RecepcionCompraLinea[]
  /// Renglones de nota de salida que envían tela de este lote a maquila (F4-E5, D5). Restrict.
  notaSalidaLineas   NotaSalidaLinea[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idColor])
  @@index([idProveedor])
  @@map("lotes")
}

/// COMPONENTE de un lote (F4-E1, D5): una tela concreta dentro del lote, con la cantidad y el
/// peso que llegaron. Reemplaza el par fijo `ExTela1/ExTela2` del viejo por N renglones (un
/// lote puede traer cuerpo + cardigan + más). PK compuesta (idLote, idTela): una tela aparece
/// UNA vez por lote. `onDelete`: Cascade hacia `Lote` (los componentes son parte del lote; se
/// reescriben en la transacción A2 de la recepción); Restrict hacia `Tela` (una tela en uso no
/// se borra físico). La EXISTENCIA NO vive aquí (sería un saldo editable, prohibido por D3):
/// `cantidad` es la cantidad ORIGINAL que entró (dato de la entrada); el saldo real es Σ de
/// `MovimientoDetTela` por tela×lote×almacén. Auditoría A7.
model LoteComponente {
  idLote   Int      @map("id_lote")
  lote     Lote     @relation(fields: [idLote], references: [id], onDelete: Cascade)
  idTela   Int      @map("id_tela")
  tela     Tela     @relation(fields: [idTela], references: [id], onDelete: Restrict)
  /// Cantidad de esta tela que ENTRÓ en el lote (dato de la entrada; NO es la existencia — D3).
  cantidad Decimal  @db.Decimal(14, 4)
  /// Peso de esta tela en el lote (kg), informativo (ex `Entradas...Peso`). Opcional.
  peso     Decimal? @db.Decimal(14, 4)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@id([idLote, idTela])
  @@index([idTela])
  @@map("lote_componentes")
}

/// Avío / habilitación (catálogo global, F1-E3, R1). Equivale a `Habilitacion` del viejo
/// (doc 01-Modelos §2, con Favorito/CantFav). `unidad` y `presentacion` son campos NUEVOS
/// que el viejo no tiene: NULLABLE en BD a propósito (obligatorios SOLO en altas nuevas por
/// UI, que valida el dominio/Zod del form) para que el ETL de E6 cargue los 629 avíos
/// históricos sin esos datos (ADR-0009). `precioReferencia` es el fallback de precio cuando
/// el proveedor del precio histórico no es mapeable (ADR-0009, insumo del costeo F7).
model Avio {
  id               Int      @id @default(autoincrement())
  /// Clave de negocio del avío (estable). Única global y clave de captura.
  clave            String   @unique
  descripcion      String
  /// Unidad de medida (pza, m, kg…). NULLABLE en BD; obligatoria en alta por UI (ADR-0009).
  unidad           String?
  /// Presentación/empaque (caja, rollo…). NULLABLE en BD; obligatoria en alta por UI (ADR-0009).
  presentacion     String?
  /// Avío de uso frecuente (preselección en la UI; si es favorito ⇒ `cantFav` obligatoria).
  favorito         Boolean  @default(false)
  /// Cantidad preestablecida cuando es favorito (la exige el dominio si `favorito`).
  cantFav          Decimal? @map("cant_fav") @db.Decimal(12, 2)
  /// Avío genérico de stock (R4 / Make-to-Order): no se compra por orden, se tiene en almacén.
  esGenerico       Boolean  @default(false) @map("es_generico")
  /// Precio de referencia (fallback de precio sin proveedor mapeable — ADR-0009).
  precioReferencia Decimal? @map("precio_referencia") @db.Decimal(12, 2)
  /// FACTOR de conversión por DEFECTO presentación→unidad de consumo (F4-E1, R1): cuántas
  /// `unidad` (m, pza…) trae una `presentacion` (rollo, caja…). Es el fallback cuando el
  /// `AvioProveedor` del precio no define su propio factor (un proveedor puede vender el mismo
  /// avío en presentaciones distintas — por eso el factor "fino" vive en `AvioProveedor`). Lo
  /// usa el motor de conversión (`comun/conversion.ts`) para convertir CANTIDADES y PRECIOS
  /// (E3: costo por unidad = precio por presentación ÷ factor). NULL = sin conversión (1:1).
  /// Debe ser > 0 si viene (lo valida el dominio/Zod). NO se compra para stock con mínimos (R4).
  factorConversion Decimal? @map("factor_conversion") @db.Decimal(14, 6)
  /// Borrado suave (plan §4: patrón conservado del sistema viejo).
  activo           Boolean  @default(true)

  /// Proveedores que surten este avío con su precio (N:N a Proveedor).
  proveedores        AvioProveedor[]
  /// Renglones del BOM de modelos que usan este avío (F1-E4, Restrict hacia el avío).
  modelos            ModeloAvio[]
  /// Renglones de kardex de AVÍO de este avío (dimensión avío×lote opcional + esGenerico,
  /// R4). Las filas las ejercita F4 (el inventario de avíos); la tabla nace en F3-E1 para
  /// fijar el motor genérico. Restrict.
  movimientosDetAvio MovimientoDetAvio[]
  /// Renglones de orden de compra que piden este avío (F4-E2). Restrict.
  ordenCompraLineas  OrdenCompraLinea[]
  /// Renglones de explosión MRP que requieren este avío (F4-E4, R3). Restrict.
  requerimientos     RequerimientoOrden[]
  /// Renglones de nota de salida que descuentan este avío al confirmar (F4-E5, R4). Restrict.
  notaSalidaLineas   NotaSalidaLinea[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("avios")
}

/// Puente N:N avío ↔ proveedor con precio y condiciones (F1-E3, R1 — insight del dueño:
/// el mismo avío se compra a varios proveedores a precios distintos; base de R3/R7 en F4).
/// PK compuesta (idAvio, idProveedor): un proveedor aparece UNA vez por avío. `onDelete`:
///  • Cascade hacia `Avio`: los proveedores son configuración del avío; permite reescribir
///    el set en la transacción A2.
///  • Restrict hacia `Proveedor`: un proveedor con avíos asignados no se borra físico (se
///    desactiva), para no dejar el par colgando.
/// Auditoría COMPLETA: `precio`/`condiciones` son editables (A7).
model AvioProveedor {
  idAvio           Int      @map("id_avio")
  idProveedor      Int      @map("id_proveedor")
  /// Precio al que ESTE proveedor surte el avío (por PRESENTACIÓN de compra — p. ej. por rollo).
  precio           Decimal? @db.Decimal(12, 2)
  /// FACTOR de conversión presentación→unidad de consumo PARA ESTE PROVEEDOR (F4-E1, R1):
  /// cuántas unidades del BOM (m, pza…) trae UNA presentación de compra de este proveedor
  /// (p. ej. 50 = un rollo de 50 m). Vive aquí porque el mismo avío se compra a varios
  /// proveedores en presentaciones distintas (R1, insight del dueño). Si es NULL, el motor de
  /// conversión cae al `Avio.factorConversion` por defecto, y si ese también es NULL, asume 1:1.
  /// El motor lo usa para convertir CANTIDADES y PRECIOS: la recepción (E3) calcula el costo por
  /// unidad de consumo = `precio` ÷ factor (precio por rollo ÷ m por rollo = costo por metro).
  /// Debe ser > 0 si viene (lo valida el dominio/Zod).
  factorConversion Decimal? @map("factor_conversion") @db.Decimal(14, 6)
  /// Condiciones comerciales de este proveedor para este avío (texto libre).
  condiciones      String?

  avio      Avio      @relation(fields: [idAvio], references: [id], onDelete: Cascade)
  proveedor Proveedor @relation(fields: [idProveedor], references: [id], onDelete: Restrict)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@id([idAvio, idProveedor])
  @@index([idProveedor])
  @@map("avio_proveedor")
}

/// Bordado / estampado (catálogo global, F1-E3, R2). Equivale a la tabla del viejo con
/// `BorEst` y `Foto` (doc 01-Modelos §2). La foto vive en R2: FK DIRECTA al `Archivo` de
/// F0 (1 bordado → 0..1 foto, sin tabla puente). `onDelete: SetNull` en la foto: quitar/
/// borrar el archivo NO borra el bordado, solo lo deja sin foto (placeholder NoFoto en UI).
/// `nombre` @unique = catálogo limpio en v2; si el viejo trae homónimos, el ETL de E6 los
/// desambigua o los manda a reporte (ADR-0009, riesgo menor anotado).
model Bordado {
  id            Int         @id @default(autoincrement())
  /// Nombre del bordado/estampado. Único global (ADR-0007 / catálogo limpio v2).
  nombre        String      @unique
  descripcion   String?
  /// Número de puntadas (informativo, alimenta el costeo del bordado).
  puntadas      Int?
  /// Precio de referencia del bordado/estampado.
  precio        Decimal?    @db.Decimal(12, 2)
  /// Bordado real vs. estampado/aplicación (ex `BorEst`). Default BORDADO.
  tipo          TipoBordado @default(BORDADO)
  /// Foto del bordado en R2 (opcional). FK directa al `Archivo` de F0; SetNull al borrar.
  /// @unique: la relación con Archivo es 1:1 (un archivo es la foto de un solo bordado),
  /// por eso el lado que define la FK debe ser único (mismo patrón que ProveedorArchivo).
  idArchivoFoto String?     @unique @map("id_archivo_foto")
  archivoFoto   Archivo?    @relation(fields: [idArchivoFoto], references: [id], onDelete: SetNull)
  /// Borrado suave (plan §4: patrón conservado del sistema viejo).
  activo        Boolean     @default(true)

  /// Renglones del BOM de modelos que usan este bordado (F1-E4, Restrict hacia el bordado).
  modelos ModeloBordado[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("bordados")
}

// ─────────────────────────────────────────────────────────────────────────────
// Modelos (Módulo 2, F1-E4) — el catálogo de productos y su RECETA/BOM completa,
// más sus fotos en R2 (doc `Documentacion_MJD/01-Modelos.md`). GLOBAL (sin idEmpresa,
// ADR-0007/A9) con auditoría uniforme (A7) y borrado suave (`activo` = descontinuar).
//
// Un `Modelo` (ex tabla `Modelos`) lleva su BOM en tres tablas de enlace —espejo de
// `ModelosTela`/`ModelosHab`/`ModelosBor` del viejo (doc 01-Modelos §2)—:
//  • `ModeloTela`  (telas) y `ModeloAvio` (avíos): cada renglón con `consumoPorPrenda` y
//    las TRES banderas de uso 🔑 `paraPreCosto`/`paraProduccion`/`paraCosto` (doc 01-Modelos
//    §2: un componente puede costear sin listarse en producción y viceversa — se CONSERVA).
//  • `ModeloBordado` (bordados/estampados): uno o varios, SIN cantidad y SIN banderas, pero
//    CON `precio` por renglón (decisión cerrada con Gabriel). `precio` es nullable en BD
//    para que el ETL de E7 cargue históricos rellenando desde `Bordado.precio`; en la
//    captura por UI es REQUERIDO y se pre-llena con `Bordado.precio` (editable). Misma
//    relajación-para-ETL que `Avio.unidad/presentacion` en E3 (ADR-0009).
// Las fotos (`ModeloFoto`, N por modelo) viven en R2: tabla puente al `Archivo` de F0
// (A5: nunca por convención de nombre, corrige las fotos en `S:\` del viejo, doc 01-Modelos §6).
//
// onDelete (igual que el resto del esquema, F1-E2/E3): Restrict hacia los catálogos en uso
// (Temporada/CurvaTalla/Genero, y Tela/Avio/Bordado en los renglones del BOM — se desactivan,
// no se borran físico); Cascade del BOM y las fotos hacia el `Modelo` padre (permite reescribir
// el set en la transacción A2 y arrastra todo al descontinuar físico —que no pasa: borrado
// suave—); Cascade en `ModeloFoto`→`Archivo` (mismo criterio que `ProveedorArchivo` de E1B:
// el objeto R2 huérfano es inofensivo).
// ─────────────────────────────────────────────────────────────────────────────

/// Género del modelo (catálogo global, F1-E4). Sembrado con los 8 del sistema viejo
/// (Caballero, Dama, Niño/Niña Infantil/Juvenil, Bebo, Beba). Mismo patrón que
/// `RolProveedor`/`TipoProceso`: se siembra + se expone SOLO un selector
/// (`GET /api/generos` bajo `modelos.ver`); el ABM fino se DIFIERE. Borrado suave + A7.
model Genero {
  id     Int     @id @default(autoincrement())
  /// Nombre del género. Único global (ADR-0007).
  nombre String  @unique
  /// Borrado suave (plan §4: patrón conservado del sistema viejo).
  activo Boolean @default(true)

  /// Modelos de este género (F1-E4, FK nullable Restrict).
  modelos Modelo[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("generos")
}

/// Modelo / producto (catálogo global, F1-E4 — ex tabla `Modelos`, doc 01-Modelos §2).
/// `codigo` es la clave de negocio (única global). `maquilaBase` es el costo de maquila base
/// que heredan las órdenes (doc 01-Modelos §4 punto 4). `idTemporada`/`idCurvaTalla`/`idGenero`
/// son FK NULLABLE: el ETL de E7 las poblará y no todos los modelos viejos las traen; la curva
/// vive en el modelo (D4). NO lleva `idEtiquetaMarca` (se difiere a F7/Costos).
model Modelo {
  id          Int      @id @default(autoincrement())
  /// Código/clave de negocio del modelo. Único global (ADR-0007).
  codigo      String   @unique
  descripcion String?
  /// Costo de maquila base que heredan las órdenes (doc 01-Modelos §4).
  maquilaBase Decimal? @map("maquila_base") @db.Decimal(12, 2)

  /// Temporada (opcional). Restrict: una temporada en uso no se borra físico → se desactiva.
  idTemporada    Int?          @map("id_temporada")
  temporada      Temporada?    @relation(fields: [idTemporada], references: [id], onDelete: Restrict)
  /// Curva de tallas del modelo (D4, opcional). Restrict (igual que temporada).
  idCurvaTalla   Int?          @map("id_curva_talla")
  curvaTalla     CurvaTalla?   @relation(fields: [idCurvaTalla], references: [id], onDelete: Restrict)
  /// Género (opcional; se poblará en el ETL E7). Restrict (igual que temporada).
  idGenero       Int?          @map("id_genero")
  genero         Genero?       @relation(fields: [idGenero], references: [id], onDelete: Restrict)
  /// Tipo de producto para Calidad (F6-E1, decisión (d)): la auditoría hereda este tipo del
  /// modelo para filtrar los defectos aplicables. NULLABLE y sin default (no rompe los modelos
  /// existentes; se asigna desde la pantalla de Modelos). Restrict (igual que temporada/género).
  idTipoProducto Int?          @map("id_tipo_producto")
  tipoProducto   TipoProducto? @relation(fields: [idTipoProducto], references: [id], onDelete: Restrict)

  /// Borrado suave = descontinuar (plan §4: patrón conservado del sistema viejo).
  activo Boolean @default(true)

  /// Fotos del modelo en R2 (N por modelo).
  fotos            ModeloFoto[]
  /// BOM — telas del modelo (N:N a Tela con consumo + banderas).
  telas            ModeloTela[]
  /// BOM — avíos del modelo (N:N a Avio con consumo + banderas).
  avios            ModeloAvio[]
  /// BOM — bordados/estampados del modelo (N:N a Bordado con precio).
  bordados         ModeloBordado[]
  /// Renglones de pedidos internos que piden este modelo (F2-E1, Restrict hacia el modelo).
  pedidoLineas     PedidoLinea[]
  /// Órdenes de producción de este modelo (F2-E2, Restrict hacia el modelo).
  ordenes          Orden[]
  /// Renglones de kardex PT de este modelo (F3-E1, D4 — dimensión PT: modelo×color×talla). Restrict.
  movimientosDetPt MovimientoDetPt[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("modelos")
}

/// Tipo de foto del modelo (F1-E4): frente, espalda u otra. `orden` da el orden de
/// despliegue del carrusel (lo gestiona el dominio; no único en BD).
enum TipoFotoModelo {
  FRENTE
  ESPALDA
  OTRO

  @@map("tipo_foto_modelo")
}

/// Foto de un modelo en R2 (F1-E4, R2 — doc 01-Modelos §6: corrige las fotos por nombre en
/// `S:\` del viejo). Liga un `Archivo` (motor de F0) a un modelo con su tipo y orden. N por
/// modelo. `onDelete`:
///  • Cascade hacia `Modelo`: las fotos son del modelo.
///  • Cascade hacia `Archivo`: al quitar la foto se borra también su `Archivo` (el objeto R2
///    huérfano es inofensivo — lo documenta `comun/archivos.ts`). Mismo criterio que
///    `ProveedorArchivo` de E1B.
model ModeloFoto {
  id        Int            @id @default(autoincrement())
  idModelo  Int            @map("id_modelo")
  idArchivo String         @map("id_archivo")
  tipo      TipoFotoModelo @default(OTRO)
  orden     Int            @default(0)

  modelo  Modelo  @relation(fields: [idModelo], references: [id], onDelete: Cascade)
  archivo Archivo @relation(fields: [idArchivo], references: [id], onDelete: Cascade)

  creadoEn    DateTime @default(now()) @map("creado_en")
  creadoPorId String?  @map("creado_por_id")

  @@unique([idArchivo])
  @@index([idModelo])
  @@map("modelo_foto")
}

/// Puente BOM modelo ↔ tela (F1-E4 — ex `ModelosTela`, doc 01-Modelos §2). PK compuesta
/// (idModelo, idTela): una tela aparece UNA vez por modelo. `consumoPorPrenda` = consumo de
/// tela por prenda; las TRES banderas 🔑 marcan para qué propósitos cuenta el renglón
/// (`paraPreCosto`/`paraProduccion`/`paraCosto`, doc 01-Modelos §2 — se conservan). `onDelete`:
/// Cascade hacia `Modelo` (permite reescribir el BOM en la tx A2); Restrict hacia `Tela` (una
/// tela usada por un modelo no se borra físico → se desactiva). Auditoría COMPLETA: los
/// campos son editables (A7).
model ModeloTela {
  idModelo         Int     @map("id_modelo")
  idTela           Int     @map("id_tela")
  /// Consumo de tela por prenda (doc 01-Modelos §2: `CantTela`).
  consumoPorPrenda Decimal @map("consumo_por_prenda") @db.Decimal(12, 4)
  /// 🔑 Entra en el PRE-costeo (estimación antes de producir).
  paraPreCosto     Boolean @default(true) @map("para_pre_costo")
  /// 🔑 Se considera al PRODUCIR (lo que realmente se manda pedir/usar).
  paraProduccion   Boolean @default(true) @map("para_produccion")
  /// 🔑 Entra en el COSTEO real de la orden.
  paraCosto        Boolean @default(true) @map("para_costo")

  modelo Modelo @relation(fields: [idModelo], references: [id], onDelete: Cascade)
  tela   Tela   @relation(fields: [idTela], references: [id], onDelete: Restrict)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@id([idModelo, idTela])
  @@index([idTela])
  @@map("modelo_tela")
}

/// Puente BOM modelo ↔ avío (F1-E4 — ex `ModelosHab`, doc 01-Modelos §2). Misma forma que
/// `ModeloTela` (consumo + 3 banderas 🔑), referenciando `Avio`. PK compuesta (idModelo,
/// idAvio): un avío aparece UNA vez por modelo. Cascade hacia `Modelo`, Restrict hacia `Avio`.
model ModeloAvio {
  idModelo         Int     @map("id_modelo")
  idAvio           Int     @map("id_avio")
  /// Consumo de avío por prenda (doc 01-Modelos §2: `CantHab`).
  consumoPorPrenda Decimal @map("consumo_por_prenda") @db.Decimal(12, 4)
  /// 🔑 Entra en el PRE-costeo.
  paraPreCosto     Boolean @default(true) @map("para_pre_costo")
  /// 🔑 Se considera al PRODUCIR.
  paraProduccion   Boolean @default(true) @map("para_produccion")
  /// 🔑 Entra en el COSTEO real.
  paraCosto        Boolean @default(true) @map("para_costo")

  modelo Modelo @relation(fields: [idModelo], references: [id], onDelete: Cascade)
  avio   Avio   @relation(fields: [idAvio], references: [id], onDelete: Restrict)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@id([idModelo, idAvio])
  @@index([idAvio])
  @@map("modelo_avio")
}

/// Puente BOM modelo ↔ bordado/estampado (F1-E4 — ex `ModelosBor`, doc 01-Modelos §2). Un
/// modelo lleva UNO o VARIOS bordados, SIN cantidad y SIN banderas, pero CON `precio` por
/// renglón (decisión cerrada con Gabriel). PK compuesta (idModelo, idBordado): un bordado
/// aparece UNA vez por modelo. `precio` es NULLABLE en BD (relajado para que el ETL de E7
/// cargue históricos rellenando desde `Bordado.precio`); en la captura por UI es REQUERIDO y
/// se pre-llena con `Bordado.precio` (editable). Cascade hacia `Modelo`, Restrict hacia
/// `Bordado`. Auditoría COMPLETA: `precio` editable (A7).
model ModeloBordado {
  idModelo  Int      @map("id_modelo")
  idBordado Int      @map("id_bordado")
  /// Precio del bordado/estampado en este modelo (nullable en BD para el ETL; requerido en UI).
  precio    Decimal? @db.Decimal(12, 2)

  modelo  Modelo  @relation(fields: [idModelo], references: [id], onDelete: Cascade)
  bordado Bordado @relation(fields: [idBordado], references: [id], onDelete: Restrict)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@id([idModelo, idBordado])
  @@index([idBordado])
  @@map("modelo_bordado")
}

// ─────────────────────────────────────────────────────────────────────────────
// Migración del sistema viejo (F1-E6, ETL) — tabla de MAPEO clave-vieja → id-nuevo
// ─────────────────────────────────────────────────────────────────────────────

/// Mapeo PERSISTIDO entre la clave de un registro del sistema viejo (Access) y el id
/// de la entidad nueva que lo reemplaza (F1-E6, ETL de catálogos). Es un entregable
/// CLAVE del ETL: lo reutilizan los ETLs de fases futuras (E7 modelos, F2 pedidos, F4
/// inventarios, F9 finanzas) para traducir las FKs viejas (p. ej. `OrdenesDet.IdOrdenes`,
/// `Modelos.IdTemporadas`) sin re-derivar la correspondencia.
///
/// Diseño GENÉRICO (una sola tabla para todas las correspondencias) en vez de una columna
/// `legacyId` por entidad:
///  • `entidad`     — qué clase de cosa se mapea, en el nombre del modelo nuevo más un
///                    sufijo de fuente cuando una entidad nueva absorbe varias viejas. Claves
///                    estables usadas por el ETL (ver `migracion/comun/mapeo.ts`):
///                    "Color" (texto→idColor), "Tela:IdTelas" y "Tela:IdTelasDis"
///                    (las DOS tablas viejas que se unifican en `Tela`), "Proveedor:IdProveedor",
///                    "Proveedor:IdMaquileros", "Proveedor:IdEstampadores", "Proveedor:IdCortadores"
///                    (la fusión de terceros), "Cliente", "EtiquetaMarca", "Bordado", "Avio",
///                    "Genero", "Almacen:IPT" / "Almacen:Tela", "TelaCategoria", "Empresa", etc.
///  • `claveVieja`  — el id (o texto, p. ej. el nombre de color) del sistema viejo, SIEMPRE
///                    como texto (las PKs viejas son Int; el color es texto libre). Único por
///                    `(entidad, claveVieja)`.
///  • `idNuevo`     — id de la entidad nueva, como texto (cubre PKs Int y, a futuro, String).
///  • `datos`       — JSON opcional con contexto de la decisión (p. ej. el nombre original,
///                    si hubo dedup/fusión, el sufijo de desambiguación aplicado…). Auditable.
///
/// IDEMPOTENCIA (§7): el ETL hace upsert por `(entidad, claveVieja)`, así re-ejecutarlo no
/// duplica filas ni rompe el mapeo. No lleva auditoría A7 (es metadato técnico de migración,
/// no una entidad de negocio): solo `creadoEn`/`modificadoEn`.
model MapeoMigracion {
  id         Int    @id @default(autoincrement())
  /// Clase de correspondencia (nombre del modelo nuevo + sufijo de fuente). Ver TSDoc.
  entidad    String
  /// Clave del registro viejo (id Int o texto), SIEMPRE como texto.
  claveVieja String @map("clave_vieja")
  /// Id del registro nuevo, como texto (cubre PKs Int y String).
  idNuevo    String @map("id_nuevo")
  /// Contexto de la decisión (nombre original, dedup/fusión, sufijo…), opcional.
  datos      Json?

  creadoEn     DateTime @default(now()) @map("creado_en")
  modificadoEn DateTime @updatedAt @map("modificado_en")

  @@unique([entidad, claveVieja])
  @@index([entidad, idNuevo])
  @@map("mapeo_migracion")
}

// ─────────────────────────────────────────────────────────────────────────────
// Pedidos (Módulo PEDIDOS, F2-E1) — el segundo paso de la secuencia MODELOS →
// PEDIDOS → PRODUCCIÓN (doc `Documentacion_MJD/02-Pedidos.md`). Dos niveles:
//  • Pedido interno (`Pedido` + `PedidoLinea`, ex `Pedidos`/`PedidosDet`): la
//    planeación/compromiso con el cliente (qué modelos, cuánto y a qué precio).
//    Multi-empresa (A9): `idEmpresa` + folio POR EMPRESA desde la secuencia
//    atómica "pedido" (A3 — nunca Max()+1, corrige el `AumentarNumPed` del viejo).
//  • Pedido Real (`PedidoReal` + `PedidoRealLinea`, ex `PedidosReales`/
//    `PedidosRealesDet`): cada LIBERACIÓN real del cliente contra ese pedido, con
//    su CEDIS, fechas y cantidades pedida/enviada/entregada (doc 02 §1 y §4.4).
//
// onDelete (igual que el resto del esquema): Restrict hacia los catálogos en uso
// (Cliente, Modelo, Empresa — se desactivan, no se borran físico); Cascade del
// detalle hacia su encabezado (PedidoLinea→Pedido, PedidoRealLinea→PedidoReal —
// permite reescribir el set de renglones en la transacción A2). Auditoría
// uniforme (A7) + borrado SUAVE de PEDIDO INTERNO (`pedCancelado`, cancelación
// suave del viejo `CancelarPed_Click`; el pedido sigue consultable).
//
// SNAPSHOTS MIGRADOS de SOLO LECTURA (sufijo `V1`): campos que en el viejo eran
// saldos derivados (`PedidosDet.EntregadoParcial`/`CantFalt`) o FKs a tablas que
// aún no existen en v2 (`Pedidos.IdOrdCompra`). NO son saldo vivo (espíritu D3:
// existencias/saldos = suma de movimientos): los puebla el ETL de E5 y NINGÚN
// endpoint de F2 los escribe. La derivación real (desde EntregasCliente) llega en
// F3 y los reemplaza.
// ─────────────────────────────────────────────────────────────────────────────

/// Pedido interno (F2-E1 — ex `Pedidos`, doc 02-Pedidos §2). El compromiso con el
/// cliente del que salen las órdenes de producción (F3). `folio` sale de la secuencia
/// atómica "pedido" POR EMPRESA (A3/A9 — sustituye el `NumeroPed` por Max()+1 del viejo,
/// doc 02 §6.1). Cancelación SUAVE (`pedCancelado`): el pedido nunca se borra (doc 02 §4.2).
model Pedido {
  id        Int     @id @default(autoincrement())
  /// Folio del pedido, consecutivo POR EMPRESA (A3/A9 — viejo: `NumeroPed`).
  folio     BigInt
  /// Empresa dueña del pedido y de su numeración (A9 — viejo: `IdEmpresas`).
  idEmpresa Int     @map("id_empresa")
  empresa   Empresa @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)
  /// Cliente del pedido (viejo: `IdClientes`). Restrict: un cliente con pedidos no se borra físico.
  idCliente Int     @map("id_cliente")
  cliente   Cliente @relation(fields: [idCliente], references: [id], onDelete: Restrict)

  /// Fecha del pedido (viejo: `FechaPedido`).
  fechaPedido      DateTime? @map("fecha_pedido") @db.Date
  /// Ventana de entrega comprometida — desde (viejo: `FechaDe`).
  fechaDe          DateTime? @map("fecha_de") @db.Date
  /// Ventana de entrega comprometida — hasta (viejo: `FechaHasta`).
  fechaHasta       DateTime? @map("fecha_hasta") @db.Date
  /// Fecha de tela (viejo: `FechaTela`).
  fechaTela        DateTime? @map("fecha_tela") @db.Date
  /// Fecha de elaboración (viejo: `FechaElaboracion`).
  fechaElaboracion DateTime? @map("fecha_elaboracion") @db.Date

  /// Marca de entregado a tienda (viejo: `EntregadoTienda`).
  entregadoTienda Boolean @default(false) @map("entregado_tienda")
  /// Marcado para no producir (viejo: `NoProducir`).
  noProducir      Boolean @default(false) @map("no_producir")
  /// Pedido cancelado — cancelación SUAVE, sigue consultable (viejo: `PedCancelado`).
  pedCancelado    Boolean @default(false) @map("ped_cancelado")

  /// SNAPSHOT MIGRADO de SOLO LECTURA (viejo: `Pedidos.IdOrdCompra` "Orden de compra
  /// ligada", presente en 233 de 1,529 pedidos). SIN FK hasta que OrdCompra exista en F4
  /// (entonces se promueve a relación real). Lo puebla el ETL de E5; NINGÚN endpoint de F2
  /// lo escribe.
  idOrdCompraV1 Int? @map("id_ord_compra_v1")

  lineas PedidoLinea[]
  reales PedidoReal[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idEmpresa, folio])
  @@index([idCliente])
  @@map("pedidos")
}

/// Renglón de un pedido interno (F2-E1 — ex `PedidosDet`, doc 02-Pedidos §2). Un modelo
/// del catálogo con su cantidad pedida y el `precio` pactado (SNAPSHOT al momento del
/// pedido). PK propia `id` (a diferencia de los puentes del BOM): un mismo modelo puede
/// repetirse en el pedido y, sobre todo, el Pedido Real referencia el renglón por su id
/// (viejo: `PedidosRealesDet.IdPedidosDet`). Cascade hacia `Pedido` (reescribir el set en
/// la tx A2); Restrict hacia `Modelo`.
model PedidoLinea {
  id       Int    @id @default(autoincrement())
  idPedido Int    @map("id_pedido")
  pedido   Pedido @relation(fields: [idPedido], references: [id], onDelete: Cascade)
  idModelo Int    @map("id_modelo")
  modelo   Modelo @relation(fields: [idModelo], references: [id], onDelete: Restrict)

  /// Cantidad pedida (viejo: `CantPed`).
  cantidadPedida Int     @map("cantidad_pedida")
  /// Precio pactado por prenda — SNAPSHOT al momento del pedido (viejo: `Precio`). Editable (A7).
  precio         Decimal @db.Decimal(12, 2)

  /// SNAPSHOT MIGRADO de SOLO LECTURA (viejo: `PedidosDet.EntregadoParcial` — cantidad ya
  /// entregada). NO es saldo vivo (espíritu D3: el saldo real se deriva de EntregasCliente
  /// en F3, que lo reemplaza). Lo puebla el ETL de E5; NINGÚN endpoint de F2 lo escribe.
  entregadoParcialV1 Int? @map("entregado_parcial_v1")
  /// SNAPSHOT MIGRADO de SOLO LECTURA (viejo: `PedidosDet.CantFalt` — cantidad faltante).
  /// Mismo trato que `entregadoParcialV1`: NO es saldo vivo, lo puebla el ETL de E5, ningún
  /// endpoint lo escribe.
  cantFaltanteV1     Int? @map("cant_faltante_v1")

  realLineas PedidoRealLinea[]
  /// Órdenes de producción que salen de este renglón (F2-E2, N órdenes por renglón). Restrict.
  ordenes    Orden[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idPedido])
  @@index([idModelo])
  @@map("pedido_linea")
}

/// Pedido Real (F2-E1 — ex `PedidosReales`, doc 02-Pedidos §2 y §4.4): una LIBERACIÓN
/// real del cliente contra un pedido interno, con su CEDIS, apertura y fechas. Un pedido
/// interno tiene VARIOS pedidos reales en el tiempo. Se identifica de cara al cliente por
/// `numPedReal` (su número de pedido); NO lleva folio interno por secuencia (el viejo solo
/// usa `IdPedidosReales` autonumérico — la PK `id` cumple ese rol). NOTA F2-E1: la
/// cancelación del Pedido Real queda DIFERIDA (sin campo `cancelado`) — pendiente de
/// decisión de Daniel.
model PedidoReal {
  id       Int    @id @default(autoincrement())
  idPedido Int    @map("id_pedido")
  pedido   Pedido @relation(fields: [idPedido], references: [id], onDelete: Restrict)

  /// Número del pedido real del cliente (viejo: `NumPedReal`, texto libre).
  numPedReal         String?   @map("num_ped_real")
  /// Centro de distribución destino (viejo: `Cedis`, texto libre).
  cedis              String?
  /// Apertura/temporada (viejo: `Apertura`, texto libre en F2).
  apertura           String?
  /// Fecha del pedido real (viejo: `FechaPedPR`).
  fechaPedPR         DateTime? @map("fecha_ped_pr") @db.Date
  /// Ventana de entrega del pedido real — inicio (viejo: `FechaInicioPR`).
  fechaInicio        DateTime? @map("fecha_inicio") @db.Date
  /// Ventana de entrega del pedido real — fin (viejo: `FechaFinPR`).
  fechaFin           DateTime? @map("fecha_fin") @db.Date
  /// Fecha en que se entregó (viejo: `FechaEntregadaReal`).
  fechaEntregadaReal DateTime? @map("fecha_entregada_real") @db.Date

  lineas PedidoRealLinea[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idPedido])
  @@map("pedido_real")
}

/// Renglón de un pedido real (F2-E1 — ex `PedidosRealesDet`, doc 02-Pedidos §2). Liga al
/// renglón del pedido interno (`idPedidoLinea` → el modelo/precio) y captura las cantidades
/// pedida/enviada/entregada de ESTA liberación. La réplica automática (un renglón por cada
/// `PedidoLinea` del pedido interno) la hace el dominio en una transacción (doc 02 §4.4).
/// Cascade hacia `PedidoReal`; Restrict hacia `PedidoLinea`.
model PedidoRealLinea {
  id            Int         @id @default(autoincrement())
  idPedidoReal  Int         @map("id_pedido_real")
  pedidoReal    PedidoReal  @relation(fields: [idPedidoReal], references: [id], onDelete: Cascade)
  /// Renglón del pedido interno del que cuelga (viejo: `IdPedidosDet`). Restrict.
  idPedidoLinea Int         @map("id_pedido_linea")
  pedidoLinea   PedidoLinea @relation(fields: [idPedidoLinea], references: [id], onDelete: Restrict)

  /// Cantidad del pedido real (viejo: `CantidadPR`).
  cantidadPR            Int @default(0) @map("cantidad_pr")
  /// Cantidad enviada — captura manual en F2 (viejo: `CantidadEnviada`).
  cantidadEnviada       Int @default(0) @map("cantidad_enviada")
  /// Cantidad realmente entregada/aceptada — captura manual en F2 (viejo: `CantidadEntregadaReal`).
  cantidadEntregadaReal Int @default(0) @map("cantidad_entregada_real")
  /// Empaques (viejo: `Empaques`).
  empaques              Int @default(0)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idPedidoReal])
  @@index([idPedidoLinea])
  @@map("pedido_real_linea")
}

// ─────────────────────────────────────────────────────────────────────────────
// Órdenes de producción (Módulo ÓRDENES, F2-E2) — doc `Documentacion_MJD/03-Produccion.md`
// y `02-Pedidos.md`. La orden es el documento con el que se MANDA A PRODUCIR un renglón de
// un pedido (ex `Ordenes`/`OrdenesDet`). 5 tablas + 1 enum.
//
// Mapeo de columnas v1→v2 (el contrato del ETL futuro; el detalle vive en el TSDoc de
// `src/dominio/produccion/ordenes.ts`). Ninguna columna con datos se tira en silencio (plan §7):
//  • Folio por empresa (A3/A9): `ordenes` lleva un unique (id_empresa, folio); el valor sale de
//    la secuencia atómica "orden". Reemplaza el `AumentarNumOrd`/Max()+1 del viejo.
//  • Snapshots/datos conservados de v1 SIN motor (catálogos RC/finanzas aún no existen): columnas
//    escalares nullable SIN FK (idTipoArticuloRC, idRcAplicaciones, idRcTipoTelas, fechas RC,
//    enRiesgo, siRC, rcViva = F5; maquilaOrd, aplicacionOrd, pagada = F3/F6; tallasV1 = cadena
//    cruda de trazabilidad). Mismo espíritu que `idOrdCompraV1`. El `upc` (códigos de barra) fue
//    ELIMINADO (decisión Gabriel 16-jun-2026).
//  • Orden sin pedido = SOLO HISTÓRICO: `idPedidoLinea` es NULLABLE (el ETL migra ~26 casos
//    huérfanos del viejo), pero el servicio `crearOrden` EXIGE un renglón de pedido válido y
//    rechaza la captura nueva sin pedido.
// ─────────────────────────────────────────────────────────────────────────────

/// Estado de la orden de producción (F2-E2). NO editable por el usuario: lo DERIVAN los
/// servicios. `capturada` = recién abierta sin matriz; `completa` = ya tiene su matriz de
/// colores/tallas (paridad con `Ordenes.FechaDet` del viejo, que se sellaba al meter el
/// primer renglón del detalle); `cancelada` = cancelación suave (`Ordenes.OrdCancelada`).
enum EstadoOrden {
  capturada
  completa
  cancelada

  @@map("estado_orden")
}

/// Orden de producción (F2-E2 — ex `Ordenes`, doc 03-Produccion §Orden). Documento con el
/// que se manda a producir un renglón de un pedido. Folio consecutivo POR EMPRESA (A3/A9).
/// AUTORELLENO al crear desde un renglón de pedido: modelo/cliente/empresa derivan del
/// renglón→pedido (comportamiento `IdPedidosDet_AfterUpdate` del viejo). Ver el mapeo de las
/// 34 columnas v1 en el TSDoc de `src/dominio/produccion/ordenes.ts`.
model Orden {
  id        Int     @id @default(autoincrement())
  /// Folio consecutivo POR EMPRESA (A3/A9 — viejo: `Ordenes.Numero`).
  folio     BigInt
  /// Empresa dueña de la orden y de su numeración (A9 — viejo: `IdEmpresas`).
  idEmpresa Int     @map("id_empresa")
  empresa   Empresa @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)

  /// Renglón del pedido del que sale la orden (viejo: `IdPedidosDet`). NULLABLE en el esquema
  /// para que el ETL migre las órdenes huérfanas del viejo (~26 casos); pero la captura NUEVA
  /// lo EXIGE (orden sin pedido = solo histórico). N órdenes por renglón (resurtidos). Restrict.
  idPedidoLinea Int?         @map("id_pedido_linea")
  pedidoLinea   PedidoLinea? @relation(fields: [idPedidoLinea], references: [id], onDelete: Restrict)

  /// Modelo a producir (viejo: `IdModelos`). Autorrellenado del renglón de pedido. Restrict.
  idModelo  Int     @map("id_modelo")
  modelo    Modelo  @relation(fields: [idModelo], references: [id], onDelete: Restrict)
  /// Cliente de la orden (viejo: `IdClientes`). Autorrellenado del pedido. Restrict.
  idCliente Int     @map("id_cliente")
  cliente   Cliente @relation(fields: [idCliente], references: [id], onDelete: Restrict)

  /// Maquilero asignado (viejo: `IdMaquileros`). El maquilero es un Proveedor con rol de maquila
  /// tras la fusión de terceros (D12/R15); en F2 es SOLO asignación (no se valida el rol).
  /// Nullable (en datos viejos hay 0 = sin asignar). Restrict.
  idMaquilero     Int?           @map("id_maquilero")
  maquilero       Proveedor?     @relation(fields: [idMaquilero], references: [id], onDelete: Restrict)
  /// Etiqueta de marca de la orden (viejo: `IdEtiquetasM`). Nullable (hay nulos en datos). Restrict.
  idEtiquetaMarca Int?           @map("id_etiqueta_marca")
  etiquetaMarca   EtiquetaMarca? @relation(fields: [idEtiquetaMarca], references: [id], onDelete: Restrict)
  /// Tela dispuesta para la orden (viejo: `IdTelasDis`). Nullable. Restrict.
  idTela          Int?           @map("id_tela")
  tela            Tela?          @relation(fields: [idTela], references: [id], onDelete: Restrict)

  /// Fecha de la orden (viejo: `Fecha`).
  fecha         DateTime? @db.Date
  /// Fecha de entrega comprometida (viejo: `FechaEntrega`).
  fechaEntrega  DateTime? @map("fecha_entrega") @db.Date
  /// Observaciones generales (viejo: `Observaciones`).
  observaciones String?   @db.Text

  /// CADENA CRUDA de tallas del viejo (viejo: `Tallas`, p. ej. "CHM G EX"). De SOLO LECTURA, se
  /// conserva para trazabilidad; el despivote a `OrdenLineaTalla` (matriz real) lo hace el ETL.
  tallasV1 String? @map("tallas_v1")

  /// Costo de maquila de la orden (viejo: `MaquilaOrd`). DATO conservado de v1; su motor (costeo)
  /// llega en F3/F6 — sin lógica en F2.
  maquilaOrd    Decimal? @map("maquila_ord") @db.Decimal(12, 2)
  /// Costo de aplicación/estampado (viejo: `AplicacionOrd`). DATO de v1; motor en F3/F6.
  aplicacionOrd Decimal? @map("aplicacion_ord") @db.Decimal(12, 2)
  /// No costear esta orden (viejo: `NoCost`). Bandera conservada (consumidor real: el costeo, F6).
  noCostear     Boolean  @default(false) @map("no_costear")
  /// Composición textil (viejo: `Composicion`).
  composicion   String?  @db.Text
  /// Composición forzada (viejo: `CompForzada`): la composición se capturó a mano, no derivó del BOM.
  compForzada   Boolean  @default(false) @map("comp_forzada")
  /// Observaciones de maquila (viejo: `ObsMaquila`).
  obsMaquila    String?  @map("obs_maquila") @db.Text
  /// Maquila ya pagada (viejo: `Pagada`). En F6-E4 es un estado DERIVADO (D3): la orden queda
  /// pagada cuando TODOS sus cargos EsMa pagables (validados, no sin-costo) están pagados. NO se
  /// edita a mano salvo el override `pagadaForzada`; lo recalcula el dominio al aplicar un pago.
  pagada        Boolean? @map("pagada")
  /// Override MANUAL AUDITADO de `pagada` (F6-E4, decisión (f)): si viene (true/false) fuerza el
  /// estatus y la derivación deja de pisarlo; null = derivación automática. Se registra en bitácora.
  pagadaForzada Boolean? @map("pagada_forzada")

  /// Estado DERIVADO (no editable): capturada/completa/cancelada (ver enum `EstadoOrden`).
  estado          EstadoOrden @default(capturada)
  /// Fecha en que la orden quedó COMPLETA — se sella al primer guardado de matriz con líneas
  /// (paridad con `Ordenes.FechaDet` del viejo, sellado en el primer renglón del detalle). De ahí
  /// deriva `estado='completa'`. NO se re-sella en guardados posteriores.
  fechaCompletada DateTime?   @map("fecha_completada")
  /// Motivo de la cancelación suave (viejo: `MotivoCancelada`; `OrdCancelada` → estado=cancelada).
  motivoCancelada String?     @map("motivo_cancelada") @db.Text

  // El código de barra de la orden (viejo: `UPC`) fue ELIMINADO (decisión Gabriel 16-jun-2026):
  // los códigos de barra están en retiro; la columna no se conserva ni se migra.

  // ── Datos de Ruta Crítica (F5) — conservados de v1 SIN FK ni motor (los catálogos RC aún no
  //    existen). Columnas escalares nullable; su lógica/relaciones llegan en F5.
  /// viejo: `IdCP_Articulos` (tipo de artículo RC). Sin FK hasta F5.
  idTipoArticuloRC Int?      @map("id_tipo_articulo_rc")
  /// viejo: `IdRC_Aplicaciones`. Sin FK hasta F5.
  idRcAplicaciones Int?      @map("id_rc_aplicaciones")
  /// viejo: `IdRC_TipoTelas`. Sin FK hasta F5.
  idRcTipoTelas    Int?      @map("id_rc_tipo_telas")
  /// viejo: `FechaInicioRC`. Dato RC (F5).
  fechaInicioRC    DateTime? @map("fecha_inicio_rc")
  /// viejo: `FechaEntregaRC`. Dato RC (F5).
  fechaEntregaRC   DateTime? @map("fecha_entrega_rc")
  /// viejo: `FechaProg`. Dato RC (F5).
  fechaProg        DateTime? @map("fecha_prog")
  /// viejo: `EnRiesgo`. Dato RC (F5).
  enRiesgo         Boolean?  @map("en_riesgo")
  /// viejo: `SI_RC`. Dato RC (F5).
  siRC             Boolean?  @map("si_rc")
  /// viejo: `RC_Viva`. Dato RC (F5).
  rcViva           Boolean?  @map("rc_viva")

  // ── Programación de la Ruta Crítica (F5-E3, motor pt1) — campos NUEVOS de v2 ──────────────
  //    Los escalares legacy de arriba (idTipoArticuloRC/idRcAplicaciones/idRcTipoTelas/…) se
  //    conservan SIN tocar (datos ETL de v1); la programación de v2 usa estos campos aditivos,
  //    con FK a los catálogos de E2. Todos nullable: prueba ya tiene órdenes ETL sin RC.
  /// ¿La RC de la orden está GENERADA y vigente? (v2, F5-E3). Distinto de `rcViva` (dato legado de v1).
  rcActiva             Boolean?               @map("rc_activa")
  /// Cuándo se PROGRAMÓ la RC de esta orden (v2; sello al generar). Paralelo al legado `fechaProg`.
  fechaProgramada      DateTime?              @map("fecha_programada")
  /// ¿La orden se programó como RESURTIDO? (v2). Los procesos `esResurtido` quedan en duración 0.
  esResurtidoRC        Boolean?               @map("es_resurtido_rc")
  /// Artículo RC elegido para la programación de v2 (FK al catálogo de E2). Restrict, nullable.
  idArticuloRcProg     Int?                   @map("id_articulo_rc_prog")
  articuloRcProg       ArticuloRC?            @relation(fields: [idArticuloRcProg], references: [id], onDelete: Restrict)
  /// Tipo de tela elegido para la programación de v2 (FK a DuracionPorTipoTela). Restrict, nullable.
  idDuracionTela       Int?                   @map("id_duracion_tela")
  duracionTela         DuracionPorTipoTela?   @relation(fields: [idDuracionTela], references: [id], onDelete: Restrict)
  /// Aplicación elegida para la programación de v2 (FK a DuracionPorAplicacion). Restrict, nullable.
  idDuracionAplicacion Int?                   @map("id_duracion_aplicacion")
  duracionAplicacion   DuracionPorAplicacion? @relation(fields: [idDuracionAplicacion], references: [id], onDelete: Restrict)
  /// Renglones de la RUTA VIVA de esta orden (un proceso por renglón) (F5-E3, D11). Cascade.
  rutaProcesos         RutaOrden[]

  lineas            OrdenLinea[]
  referencias       OrdenReferencia[]
  comentarios       OrdenComentario[]
  /// Etapas de producción de esta orden (corte/envío/recibo/entrega) (F3-E1, D4). Restrict.
  etapasMovimiento  EtapaMovimiento[]
  /// Cargos a maquileros (EsMa) derivados de los recibos de esta orden (F3-E1). Restrict.
  cargosEsMa        EsMaCargo[]
  /// Renglones de orden de compra ligados a esta orden de producción (F4-E2, R7: la
  /// liga es POR LÍNEA para cruzar gasto↔producción sin prorrateos). Restrict.
  ordenCompraLineas OrdenCompraLinea[]
  /// Ligas N:N (a nivel encabezado) entre esta orden de producción y sus OC (F4-E2). Restrict.
  ordenesCompra     OrdenCompraOrden[]
  /// Snapshot de explosión MRP de esta orden (F4-E4, R3). Se reemplaza al regenerar. Cascade.
  requerimientos    RequerimientoOrden[]
  /// Renglones de nota de salida (avíos/telas enviados a maquila) ligados a esta orden (F4-E5). Restrict.
  notaSalidaLineas  NotaSalidaLinea[]
  /// Auditorías de calidad de esta orden (F6-E2). Restrict (una orden con auditorías no se borra).
  auditorias        Auditoria[]
  /// Renglones de kardex PT que PERTENECEN a esta orden (F6-E2 "PT por orden"). Restrict.
  movimientosDetPt  MovimientoDetPt[]
  /// Costo real de la orden (F7-E1, 1:1 opcional). Cascade: el costeo pertenece a la orden.
  costoOrden        CostoOrden?

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idEmpresa, folio])
  @@index([idPedidoLinea])
  @@index([idModelo])
  @@index([idCliente])
  @@index([idMaquilero])
  @@index([estado])
  @@map("ordenes")
}

/// Renglón de la matriz de una orden = un COLOR (F2-E2 — ex `OrdenesDet`, doc 03-Produccion).
/// En v1 el color era texto libre; en v2 es FK al catálogo `Color` (F1). Color ÚNICO por orden
/// (@@unique). Las cantidades por talla cuelgan en `OrdenLineaTalla` (NUNCA una columna `total`:
/// el total se deriva por suma, D4 + espíritu D3). Cascade hacia `Orden`; Restrict hacia `Color`.
model OrdenLinea {
  id      Int   @id @default(autoincrement())
  idOrden Int   @map("id_orden")
  orden   Orden @relation(fields: [idOrden], references: [id], onDelete: Cascade)
  idColor Int   @map("id_color")
  color   Color @relation(fields: [idColor], references: [id], onDelete: Restrict)

  tallas OrdenLineaTalla[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idOrden, idColor])
  @@index([idOrden])
  @@index([idColor])
  @@map("orden_linea")
}

/// Cantidad de una talla dentro de un renglón (color) de la matriz (F2-E2 — despivota las
/// columnas fijas `T1..T8` del viejo, D4: tallas ilimitadas por catálogo). Una talla aparece UNA
/// vez por renglón (@@unique). `cantidad` entera ≥0. NUNCA hay un `total` persistido: el total se
/// deriva por suma (D4 + espíritu D3). Cascade hacia `OrdenLinea`; Restrict hacia `Talla`.
model OrdenLineaTalla {
  id           Int        @id @default(autoincrement())
  idOrdenLinea Int        @map("id_orden_linea")
  ordenLinea   OrdenLinea @relation(fields: [idOrdenLinea], references: [id], onDelete: Cascade)
  idTalla      Int        @map("id_talla")
  talla        Talla      @relation(fields: [idTalla], references: [id], onDelete: Restrict)

  /// Cantidad de prendas de esta talla en este color (viejo: `T1..T8`). Entera ≥0.
  cantidad Int

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idOrdenLinea, idTalla])
  @@index([idOrdenLinea])
  @@index([idTalla])
  @@map("orden_linea_talla")
}

/// Valor de un campo de referencia del cliente en una orden (F2-E2, D7 — generaliza el
/// `Monarch` del viejo a campos por cliente). Cada valor corresponde a un `ClienteCampo` (la
/// DEFINICIÓN está en F1-E2) ACTIVO del cliente de la orden. Índice dedicado sobre `valor` para
/// la búsqueda GLOBAL de órdenes por referencia (D7). Cascade hacia `Orden`; Restrict hacia
/// `ClienteCampo`. Un campo se llena UNA vez por orden (@@unique).
model OrdenReferencia {
  id             Int          @id @default(autoincrement())
  idOrden        Int          @map("id_orden")
  orden          Orden        @relation(fields: [idOrden], references: [id], onDelete: Cascade)
  idClienteCampo Int          @map("id_cliente_campo")
  clienteCampo   ClienteCampo @relation(fields: [idClienteCampo], references: [id], onDelete: Restrict)
  /// Valor capturado para ese campo en esta orden (texto; el tipo lo valida el dominio según
  /// `ClienteCampo.tipo`). Indexado para búsqueda global por referencia (D7).
  valor          String

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idOrden, idClienteCampo])
  @@index([idOrden])
  @@index([valor])
  @@index([idClienteCampo, valor])
  @@map("orden_referencia")
}

/// Comentario INMUTABLE de una orden (F2-E2 — ex `ComentaOrd`, doc 03-Produccion). Cada
/// comentario lleva su autor y su fecha; una vez puesto NO se edita ni se borra (es un hilo de
/// bitácora del usuario). Cascade hacia `Orden`. `idUsuario` sin FK físico (mismo criterio que
/// la bitácora: log inmutable, los usuarios no se borran).
model OrdenComentario {
  id         Int      @id @default(autoincrement())
  idOrden    Int      @map("id_orden")
  orden      Orden    @relation(fields: [idOrden], references: [id], onDelete: Cascade)
  /// Usuario que escribió el comentario (viejo: `IdUsuarios`). Sin FK físico (log inmutable).
  idUsuario  String?  @map("id_usuario")
  /// Texto del comentario (viejo: `Comentario`). Inmutable.
  comentario String   @db.Text
  /// Fecha del comentario (viejo: `FechaComen`).
  fecha      DateTime @default(now())

  @@index([idOrden])
  @@map("orden_comentario")
}

// ═════════════════════════════════════════════════════════════════════════════
// PRODUCCIÓN / WIP + MOTOR KARDEX (F3-E1) — modelo de datos de TODA F3 en una
// migración. Diseño en docs/arquitectura/ADR-0010-motor-kardex-produccion.md.
//
// Dos planos que NO se mezclan (ADR-0010):
//  • PLANO WIP (avance de la orden): `EtapaMovimiento` + `EtapaMovimientoDet`. Captura
//    corte/envío/recibo/entrega por color×talla (D4). Los pendientes del WIP (por cortar,
//    cortado por enviar, por recibir…) son DERIVADOS de estas filas — sin acumuladores.
//  • PLANO INVENTARIO (kardex genérico, D3): `Movimiento` (encabezado) + un detalle POR
//    TIPO de artículo (`MovimientoDetPt`/`MovimientoDetTela`/`MovimientoDetAvio`). La
//    existencia es SIEMPRE Σ del detalle — NUNCA una columna/tabla editable (D3).
//
// MECANISMO DE EXTENSIBILIDAD (ADR-0010 §2): un detalle por tipo de artículo (NO columnas
// nullable+CHECKs en una tabla gorda). En F3 solo se ejercita la dimensión PT; las tablas
// de tela y avío nacen aquí VACÍAS para que F4 las ejercite SIN migrar filas existentes ni
// tocar el núcleo de `kardex.ts` (que opera sobre el encabezado `Movimiento` y delega el
// detalle por tipo). La única ALTER que F4 hará es agregar la FK `id_lote → Lote` (modelo
// que nace en F4): es aditiva y segura, no migra filas. Criterio verificable contra D5/R4.
//
// costoUnit: NULLABLE y SIEMPRE NULL en F3 (D1/D2 — la valuación a costo actual llega en
// F7). Política fijada en ADR-0010 §4, con test en Fase 2.
//
// Auditoría A7 + idEmpresa A9 + folio por secuencia atómica A3 ("etapa-mov", "movimiento")
// + borrado/cancelación SUAVE (canceladoEn/canceladoPor/motivoCancelacion). FKs Restrict
// hacia catálogos en uso; Cascade hacia el encabezado en los detalles (reescribir el set
// en la tx A2). El despachador de eventos de dominio vive en src/comun/eventos.ts (Fase 2,
// solo el gancho — ADR-0010 §6).
// ═════════════════════════════════════════════════════════════════════════════

/// Tipo de etapa del WIP de una orden (D4 — PLANMAESTRO §4). La maquila es UNIFICADA: el
/// envío/recibo NO distinguen costura vs estampado en el enum, lo distingue `idTipoProceso`
/// (D8 — "maquila unificada parametrizada por TipoProceso"). El `corte` y la `entrega_cliente`
/// no llevan proceso. El estampado pre/post-costura se modela como envío/recibo de su
/// TipoProceso (WIP+cargo) y, para su va-y-ven de inventario, con los tipos 6/3 del kardex (E3).
enum TipoEtapaMovimiento {
  corte
  envio_maquila
  recibo_maquila
  entrega_cliente

  @@map("tipo_etapa_movimiento")
}

/// Dirección de un tipo de movimiento de inventario (ex `IPT_TiposMov.TipoEnSa`: 1/2/3).
/// `entrada` suma (+1), `salida` resta (−1). El detalle guarda `cantidad` SIEMPRE positiva; el
/// SIGNO de la existencia lo deriva el kardex de esta dirección.
///
/// `traspaso` es una ETIQUETA DE CATÁLOGO (el tipo viejo 9 'Transferencia entre almacenes',
/// `TipoEnSa=3`): NO es una dirección que la vista de existencia interprete con un signo plano.
/// Resolución del nit #1 del reviewer (ADR-0010 §1/§5): un traspaso se MATERIALIZA como DOS
/// `Movimiento` —salida del almacén origen + entrada del almacén destino, cada uno con un
/// `TipoMovimientoInventario` de dirección EFECTIVA `salida`/`entrada`— en UNA transacción (A2).
/// Así la vista `existencia_pt` solo ve patas `entrada`/`salida` y la existencia TOTAL no cambia
/// (la cantidad pasa de origen a destino). La vista mapea `entrada→+1`, `salida→−1` y cualquier
/// otra (incluido `traspaso`, que NO debería aparecer en el detalle) a `0` (defensivo): un
/// encabezado con dirección `traspaso` jamás lleva detalle de existencia, no la infla.
enum DireccionMovimiento {
  entrada
  salida
  traspaso

  @@map("direccion_movimiento")
}

/// Estado del cargo a un maquilero (EsMa). Nace `propuesto` al registrar el recibo (F3-E4);
/// el admin lo `validado` (ajusta cantidad/precio real, doc 07-EsMa §2 — punto de control
/// humano CONSERVADO sin recapturar); `cancelado` si el recibo se cancela antes de validar.
enum EstadoCargoEsMa {
  propuesto
  validado
  cancelado

  @@map("estado_cargo_esma")
}

/// Etapa del WIP de una orden (F3-E1 — PLANO WIP; D4 §PLANMAESTRO §4, doc 03-Produccion).
/// Es el encabezado de cada CAPTURA de corte/envío/recibo/entrega; el detalle color×talla
/// cuelga en `EtapaMovimientoDet`. NO es el kardex: el kardex PT (entrada/salida real de
/// existencia) lo genera SOLO el recibo de costura (`TipoProceso.generaEntradaPt`) y la
/// entrega, vía un `Movimiento` aparte (F3-E4/E5). Aquí los pendientes del WIP se DERIVAN
/// por suma (sin acumuladores). Folio por secuencia atómica (A3, clave "etapa-mov") POR
/// EMPRESA (A9). Cancelación SUAVE + motivo + Bitácora (A7). Liga recibo↔envío AGREGADA por
/// orden+proceso, con `idEtapaEnvio` OPCIONAL (decisión (d), ADR-0010 §7: reversible).
model EtapaMovimiento {
  id        Int     @id @default(autoincrement())
  /// Folio consecutivo POR EMPRESA (A3 — secuencia "etapa-mov"; en el ETL conserva el
  /// `Consecutivo` histórico de v1).
  folio     BigInt
  /// Empresa dueña de la etapa y de su numeración (A9).
  idEmpresa Int     @map("id_empresa")
  empresa   Empresa @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)

  /// Orden a la que pertenece la etapa (doc 03-Produccion). Restrict.
  idOrden Int   @map("id_orden")
  orden   Orden @relation(fields: [idOrden], references: [id], onDelete: Restrict)

  /// Qué etapa es (corte/envío/recibo/entrega). Ver enum `TipoEtapaMovimiento`.
  tipo TipoEtapaMovimiento

  /// Tipo de proceso de maquila (costura/estampado/bordado/lavado). OBLIGATORIO en
  /// envío/recibo de maquila, NULL en corte y entrega a cliente (lo valida el dominio —
  /// el esquema lo deja nullable porque no todas las etapas lo llevan). Restrict.
  idTipoProceso Int?         @map("id_tipo_proceso")
  tipoProceso   TipoProceso? @relation(fields: [idTipoProceso], references: [id], onDelete: Restrict)

  /// Tercero de la etapa: cortador (corte) o maquilero/estampador (envío/recibo). Es un
  /// `Proveedor` con su rol de servicio (fusión de terceros D12/R15). NULL en entrega a
  /// cliente y en datos viejos sin asignar. Restrict.
  idTercero Int?       @map("id_tercero")
  tercero   Proveedor? @relation(fields: [idTercero], references: [id], onDelete: Restrict)

  /// Fecha de la etapa (captura o compromiso, según el tipo — el dominio lo precisa).
  fecha           DateTime  @db.Date
  /// Fecha compromiso del maquilero en los envíos (doc 03-Produccion Paso 4). Nullable.
  fechaCompromiso DateTime? @map("fecha_compromiso") @db.Date
  /// Precio pactado de maquila para envíos (doc 03 — `PrecioPactado`); base del cargo EsMa
  /// del recibo. Nullable: 1,309 envíos viejos no lo traen (por eso la validación del cargo
  /// en F3-E4 es obligatoria). Decimal.
  precioPactado   Decimal?  @map("precio_pactado") @db.Decimal(12, 2)
  observaciones   String?   @db.Text

  /// LIGA recibo↔envío (decisión (d), ADR-0010 §7): en un recibo apunta OPCIONALMENTE al
  /// envío que se está recibiendo. Hoy el WIP cuadra por AGREGADO orden+proceso (la liga
  /// puede quedar NULL); se deja para que, si Daniel pide amarre estricto por envío, sea
  /// dato y no migración. Autorreferencia Restrict (no borrar un envío con recibos ligados).
  idEtapaEnvio Int?              @map("id_etapa_envio")
  etapaEnvio   EtapaMovimiento?  @relation("ReciboDeEnvio", fields: [idEtapaEnvio], references: [id], onDelete: Restrict)
  recibos      EtapaMovimiento[] @relation("ReciboDeEnvio")

  /// Almacén destino de las PRIMERAS de un RECIBO de costura (F3-E4). Solo se usa cuando el
  /// recibo genera entrada a PT (`TipoProceso.generaEntradaPt`); NULL en corte/envío y en los
  /// recibos de procesos que NO meten a PT (estampado/bordado/lavado). La CALIDAD (primeras/
  /// segundas) se captura SEPARADA del almacén destino (decisión Gabriel F3-E4): lo bueno va a
  /// "Primeras", lo defectuoso a "Segundas". Restrict.
  idAlmacenPrimeras Int?     @map("id_almacen_primeras")
  almacenPrimeras   Almacen? @relation("ReciboAlmacenPrimeras", fields: [idAlmacenPrimeras], references: [id], onDelete: Restrict)
  /// Almacén destino de las SEGUNDAS de un RECIBO de costura (F3-E4). NULL si el recibo no
  /// reportó segundas o no genera entrada a PT. Restrict.
  idAlmacenSegundas Int?     @map("id_almacen_segundas")
  almacenSegundas   Almacen? @relation("ReciboAlmacenSegundas", fields: [idAlmacenSegundas], references: [id], onDelete: Restrict)

  /// Cancelación SUAVE (plan §4): la etapa nunca se borra ni se edita; se cancela con motivo
  /// y queda en el historial (A7). El kardex/efectos se revierten con movimiento inverso (E4/E5).
  canceladoEn       DateTime? @map("cancelado_en")
  /// Usuario que canceló (sin FK físico, mismo criterio que la auditoría — ADR-0005).
  canceladoPorId    String?   @map("cancelado_por_id")
  motivoCancelacion String?   @map("motivo_cancelacion") @db.Text

  /// Detalle color×talla de la etapa (SIEMPRE, D4). Cascade (reescribir el set en la tx A2).
  detalles   EtapaMovimientoDet[]
  /// Cargo(s) EsMa derivados de esta etapa cuando es un recibo (F3-E4). Restrict.
  cargosEsMa EsMaCargo[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idEmpresa, folio])
  @@index([idOrden])
  @@index([idOrden, tipo, idTipoProceso])
  @@index([idTipoProceso])
  @@index([idTercero])
  @@index([idEtapaEnvio])
  @@index([idAlmacenPrimeras])
  @@index([idAlmacenSegundas])
  @@map("etapa_movimiento")
}

/// Renglón color×talla de una etapa del WIP (F3-E1, D4 — despivota T1..T8/TC1..TC8 del viejo
/// a FILAS, MEJORAS A6). Una talla aparece UNA vez por color por etapa (@@unique). `cantidad`
/// entera ≥0; NUNCA hay un `total` persistido (se deriva por suma, D4 + espíritu D3). Cascade
/// hacia la etapa (reescribir el set en la tx); Restrict hacia Color/Talla (en uso ⇒ se desactiva).
/// NO lleva `idEmpresa`: la empresa SE DERIVA del encabezado `EtapaMovimiento.idEmpresa` (A9 —
/// el detalle nunca se consulta ni escribe fuera de su encabezado).
model EtapaMovimientoDet {
  id         Int             @id @default(autoincrement())
  idEtapaMov Int             @map("id_etapa_mov")
  etapaMov   EtapaMovimiento @relation(fields: [idEtapaMov], references: [id], onDelete: Cascade)
  idColor    Int             @map("id_color")
  color      Color           @relation(fields: [idColor], references: [id], onDelete: Restrict)
  idTalla    Int             @map("id_talla")
  talla      Talla           @relation(fields: [idTalla], references: [id], onDelete: Restrict)

  /// Cantidad de prendas de esta talla en este color para la etapa. Entera ≥0. En un RECIBO
  /// de maquila es el TOTAL recibido (= primeras + segundas); en corte/envío es la cantidad
  /// cortada/enviada (sin desglose de calidad).
  cantidad Int

  /// CALIDAD del recibo (F3-E4, decisión Gabriel): cuántas de las `cantidad` recibidas son
  /// PRIMERAS (buenas) y cuántas SEGUNDAS (defectuosas). Solo se llenan en recibos; NULL en
  /// corte/envío. Cuando ambas vienen, `cantidadPrimeras + cantidadSegundas = cantidad` (lo
  /// valida el dominio). La calidad es DATO del WIP, SEPARADA del almacén destino (que vive en
  /// el encabezado). El kardex de costura mete las primeras al almacén de primeras y las
  /// segundas al de segundas (F3-E4).
  cantidadPrimeras Int? @map("cantidad_primeras")
  cantidadSegundas Int? @map("cantidad_segundas")

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idEtapaMov, idColor, idTalla])
  @@index([idEtapaMov])
  @@index([idColor])
  @@index([idTalla])
  @@map("etapa_movimiento_det")
}

/// Catálogo de tipos de movimiento de inventario (F3-E1 — ex `IPT_TiposMov`, doc 04-Inventarios
/// §A.2). 19 tipos en el seed (Fase 2): Inventario Inicial, Entrada de Maquila, Entrega a
/// Cliente, Transferencia, Ajustes… Cada tipo lleva su `direccion` (entrada/salida/traspaso, ex
/// `TipoEnSa` 1/2/3) que el kardex usa para el signo. GLOBAL (catálogo, sin idEmpresa — ADR-0007).
/// `codigo` estable kebab-case para referenciarlo en código/seed sin atarlo al texto. Borrado
/// suave (los tipos en desuso se desactivan, no se borran). Solo lectura por API en F3-E1.
model TipoMovimientoInventario {
  id        Int                 @id @default(autoincrement())
  /// Clave estable kebab-case (p. ej. "entrada-maquila", "entrega-cliente"). Única global.
  codigo    String              @unique
  /// Nombre para mostrar (ex `IPT_TiposMov.TipoMov`).
  nombre    String
  /// Dirección del movimiento (ex `TipoEnSa`): entrada suma, salida resta, traspaso mueve.
  direccion DireccionMovimiento
  activo    Boolean             @default(true)

  /// Movimientos de kardex de este tipo (F3). Restrict: un tipo en uso no se borra físico.
  movimientos Movimiento[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("tipos_movimiento_inventario")
}

/// Encabezado de un movimiento del KARDEX único (F3-E1 — PLANO INVENTARIO; D3, PLANMAESTRO §4).
/// GENÉRICO para PT/tela/avío: el encabezado es el mismo; el detalle es POR TIPO de artículo
/// (`detallesPt`/`detallesTela`/`detallesAvio` — ADR-0010 §2). En F3 SOLO se ejercita PT. La
/// existencia es SIEMPRE Σ del detalle (D3) — NO hay columna/tabla de existencia editable; la
/// vista `ExistenciaPt` (CREATE VIEW en la migración) es solo para CONSULTA. Las validaciones
/// transaccionales (no entregar lo que no existe) suman el detalle DIRECTO bajo bloqueo, NUNCA
/// la vista (ADR-0010 §3). Referencia polimórfica al ORIGEN (`origenTipo`+`origenId`, ADR-0010
/// §1): qué hecho generó el movimiento (recibo, entrega, movimiento manual, traspaso…). Folio
/// por secuencia atómica (A3, "movimiento") POR EMPRESA (A9). Cancelación = movimiento INVERSO
/// auditado, NUNCA edición/borrado (D3/A7) — `idMovimientoInverso` enlaza el par.
model Movimiento {
  id        Int     @id @default(autoincrement())
  /// Folio consecutivo POR EMPRESA (A3 — secuencia "movimiento").
  folio     BigInt
  /// Empresa dueña del movimiento y de su numeración (A9).
  idEmpresa Int     @map("id_empresa")
  empresa   Empresa @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)

  /// Tipo de movimiento (entrada/salida/traspaso vía su `direccion`). Restrict.
  idTipoMov Int                      @map("id_tipo_mov")
  tipoMov   TipoMovimientoInventario @relation(fields: [idTipoMov], references: [id], onDelete: Restrict)

  /// Almacén afectado (D4: existencia por …×almacén). En un traspaso, cada pata del par
  /// (salida-origen / entrada-destino) es un `Movimiento` con su propio almacén. Restrict.
  idAlmacen Int     @map("id_almacen")
  almacen   Almacen @relation(fields: [idAlmacen], references: [id], onDelete: Restrict)

  fecha DateTime @db.Date

  /// REFERENCIA POLIMÓRFICA al origen (ADR-0010 §1): `origenTipo` discrimina (p. ej.
  /// "recibo-maquila", "entrega-cliente", "movimiento-manual", "traspaso", "ajuste") y
  /// `origenId` es el id de esa fila (texto, para cubrir PKs Int/String). SIN FK física (el
  /// origen es de varias tablas; el dominio garantiza la consistencia, mismo criterio que la
  /// Bitácora — ADR-0005). Permite trazar el movimiento a su hecho sin acoplar el kardex a
  /// cada tabla de origen.
  origenTipo String? @map("origen_tipo")
  origenId   String? @map("origen_id")

  /// Usuario que registró el movimiento (sin FK física — ADR-0005, log de inventario).
  idUsuario String? @map("id_usuario")

  /// Movimiento que ANULA a otro (cancelación = inverso auditado, NUNCA borrado — D3/A7).
  /// En el inverso apunta al original; el original referencia al inverso por la relación
  /// inversa `anuladoPor`. Autorreferencia Restrict.
  idMovimientoInverso Int?         @map("id_movimiento_inverso")
  movimientoOriginal  Movimiento?  @relation("MovimientoInverso", fields: [idMovimientoInverso], references: [id], onDelete: Restrict)
  anuladoPor          Movimiento[] @relation("MovimientoInverso")

  observaciones String? @db.Text

  /// Detalle por TIPO de artículo (ADR-0010 §2). En F3 solo se llena `detallesPt`; tela/avío
  /// nacen vacías para F4 (sin migrar filas ni tocar el núcleo). Cascade (reescribir set en tx).
  detallesPt   MovimientoDetPt[]
  detallesTela MovimientoDetTela[]
  detallesAvio MovimientoDetAvio[]

  /// Renglones de recepción de compra que GENERARON este movimiento de entrada (F4-E3): traza
  /// del movimiento de kardex a su renglón de recepción. SetNull al borrar el movimiento (que
  /// nunca pasa — D3: los movimientos no se borran). Relación inversa informativa.
  recepcionLineas RecepcionCompraLinea[]

  /// Renglones de nota de salida de TELA que REFERENCIAN este movimiento `salida-tela-orden` como
  /// documento de envío (F4-E5, decisión (e): la nota no descuenta tela, la referencia). Inversa.
  notaLineasSalidaTela NotaSalidaLinea[] @relation("NotaLineaSalidaTela")
  /// Renglones de nota de salida de AVÍO cuyo descuento (`salida-por-nota`) GENERÓ este movimiento
  /// al confirmar la nota (F4-E5, R4). Inversa informativa.
  notaLineasAvio       NotaSalidaLinea[] @relation("NotaLineaAvio")

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idEmpresa, folio])
  @@index([idTipoMov])
  @@index([idAlmacen])
  @@index([origenTipo, origenId])
  @@index([idMovimientoInverso])
  @@map("movimientos")
}

/// Detalle de kardex para PRODUCTO TERMINADO (F3-E1, D4 — dimensión PT: modelo×color×talla).
/// La existencia PT es Σ(cantidad·signo) por modelo×color×talla×almacén (D3). `cantidad`
/// SIEMPRE positiva (el signo lo da `Movimiento.tipoMov.direccion`); el dominio lo valida.
/// `costoUnit` NULLABLE y SIEMPRE NULL en F3 (D1/D2 — valuación en F7; ADR-0010 §4). Cascade
/// hacia `Movimiento`; Restrict hacia Modelo/Color/Talla. La empresa y el almacén SE DERIVAN
/// del encabezado `Movimiento` (A9 — el detalle no se consulta fuera de él). NO hay @@unique:
/// un movimiento PUEDE repetir el mismo artículo en líneas distintas (nit #3 del reviewer — la
/// vista suma todas las líneas; la unicidad operativa, si aplica, la cuida el dominio).
model MovimientoDetPt {
  id           Int        @id @default(autoincrement())
  idMovimiento Int        @map("id_movimiento")
  movimiento   Movimiento @relation(fields: [idMovimiento], references: [id], onDelete: Cascade)
  idModelo     Int        @map("id_modelo")
  modelo       Modelo     @relation(fields: [idModelo], references: [id], onDelete: Restrict)
  idColor      Int        @map("id_color")
  color        Color      @relation(fields: [idColor], references: [id], onDelete: Restrict)
  idTalla      Int        @map("id_talla")
  talla        Talla      @relation(fields: [idTalla], references: [id], onDelete: Restrict)

  /// ORDEN de producción a la que PERTENECEN estas prendas (F6-E2 "PT por orden" — restaura el
  /// `IPT_Modelos.IdOrdenes` de v1; ver ADR-0014, enmienda de ADR-0010). NULLABLE: el histórico
  /// migrado (`origenTipo='migracion'`) y los movimientos manuales/traspasos NO la traen (bucket
  /// "sin orden"). Con esta columna la existencia PT pasa a ser por modelo×color×talla×ORDEN×almacén;
  /// la suma directa y el advisory lock casan el NULL con `IS NOT DISTINCT FROM`. Restrict (una
  /// orden con PT en el kardex no se borra físico).
  idOrden Int?   @map("id_orden")
  orden   Orden? @relation(fields: [idOrden], references: [id], onDelete: Restrict)

  /// Cantidad de prendas (positiva; el signo lo da la dirección del tipo de movimiento).
  cantidad  Int
  /// Costo unitario al momento del movimiento. NULLABLE y NULL en toda F3 (D1/D2 — ADR-0010 §4).
  costoUnit Decimal? @map("costo_unit") @db.Decimal(12, 4)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idMovimiento])
  @@index([idModelo, idColor, idTalla])
  @@index([idOrden])
  @@index([idOrden, idModelo, idColor, idTalla])
  @@map("movimiento_det_pt")
}

/// Detalle de kardex para TELA (dimensión tela×lote, D5). NACE VACÍA en F3-E1 para fijar el
/// motor genérico (ADR-0010 §2); las filas las ejercita F4 (inventario de telas). `idLote` es
/// ESCALAR NULLABLE SIN FK en F3: el modelo `Lote` nace en F4 y entonces se agrega la FK
/// `id_lote → Lote` con un ALTER aditivo y seguro (no migra filas ni toca el núcleo de
/// kardex.ts). `cantidad` Decimal (telas se miden en kg/m). `costoUnit` NULL en F3 (D1/D2).
/// Cascade hacia `Movimiento`; Restrict hacia `Tela`. La empresa y el almacén SE DERIVAN del
/// encabezado `Movimiento` (A9 — el detalle no se consulta fuera de él).
model MovimientoDetTela {
  id           Int        @id @default(autoincrement())
  idMovimiento Int        @map("id_movimiento")
  movimiento   Movimiento @relation(fields: [idMovimiento], references: [id], onDelete: Cascade)
  idTela       Int        @map("id_tela")
  tela         Tela       @relation(fields: [idTela], references: [id], onDelete: Restrict)
  /// Lote de la tela (D5). En F4-E1 se agrega la FK `→ Lote` (ALTER aditivo): el lote es la
  /// dimensión de trazabilidad de la existencia (tela×lote×almacén). NULLABLE: un ajuste
  /// inicial sin lote conocido puede no traerlo (el dominio decide). Restrict.
  idLote       Int?       @map("id_lote")
  lote         Lote?      @relation(fields: [idLote], references: [id], onDelete: Restrict)

  /// Cantidad de tela (positiva; el signo lo da la dirección del tipo de movimiento). Decimal.
  cantidad  Decimal  @db.Decimal(14, 4)
  /// Costo unitario. NULLABLE y NULL en F3 (D1/D2 — ADR-0010 §4).
  costoUnit Decimal? @map("costo_unit") @db.Decimal(12, 4)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idMovimiento])
  @@index([idTela, idLote])
  @@map("movimiento_det_tela")
}

/// Detalle de kardex para AVÍO (dimensión avío×lote opcional, R4). NACE VACÍA en F3-E1 para
/// fijar el motor genérico (ADR-0010 §2); las filas las ejercita F4 (inventario de avíos).
/// `esGenerico` se DERIVA del catálogo `Avio.esGenerico` (R4 — pocos avíos de stock); se copia
/// aquí para consultas de kardex sin join. `idLote` ESCALAR NULLABLE SIN FK en F3 (igual que
/// tela: la FK `→ Lote` la agrega F4). `cantidad` Decimal. `costoUnit` NULL en F3 (D1/D2).
/// Cascade hacia `Movimiento`; Restrict hacia `Avio`. La empresa y el almacén SE DERIVAN del
/// encabezado `Movimiento` (A9 — el detalle no se consulta fuera de él).
model MovimientoDetAvio {
  id           Int        @id @default(autoincrement())
  idMovimiento Int        @map("id_movimiento")
  movimiento   Movimiento @relation(fields: [idMovimiento], references: [id], onDelete: Cascade)
  idAvio       Int        @map("id_avio")
  avio         Avio       @relation(fields: [idAvio], references: [id], onDelete: Restrict)
  /// Lote del avío (opcional, R4 — pocos avíos se manejan por lote). En F4-E1 se agrega la FK
  /// `→ Lote` (ALTER aditivo). NULLABLE: el inventario de avíos suele ser por avío×almacén sin
  /// lote (la vista `ExistenciaAvio` agrega por avío×almacén). Restrict.
  idLote       Int?       @map("id_lote")
  lote         Lote?      @relation(fields: [idLote], references: [id], onDelete: Restrict)
  /// Avío genérico de stock (R4 — copiado de `Avio.esGenerico` para consultas sin join).
  esGenerico   Boolean    @default(false) @map("es_generico")

  /// Cantidad de avío (positiva; el signo lo da la dirección del tipo de movimiento). Decimal.
  cantidad  Decimal  @db.Decimal(14, 4)
  /// Costo unitario. NULLABLE y NULL en F3 (D1/D2 — ADR-0010 §4).
  costoUnit Decimal? @map("costo_unit") @db.Decimal(12, 4)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idMovimiento])
  @@index([idAvio, idLote])
  @@map("movimiento_det_avio")
}

/// Cargo a la cuenta corriente de un maquilero (EsMa) — F3-E1 SOLO el esquema; el flujo
/// (propuesto→validado) llega en F3-E4 (doc 07-EsMa). Nace al registrar un recibo de maquila
/// para TODO proceso (costura Y estampado — `EsMa_Recibos.EsEstampado` lo confirma), con
/// cantidad×precio del envío. `idEtapaRecibo` NULLABLE: la captura nueva la liga al recibo,
/// pero el ETL (F3-E6) migra 7,401 cargos históricos SIN FK formal al recibo (la liga nace en
/// v2). `estado` propuesto/validado/cancelado (el admin valida ajustando cantidad/precio real,
/// punto de control humano CONSERVADO). `cantidadReal`/`precioReal` los fija la validación
/// (nullables hasta entonces). Auditoría A7 + idEmpresa A9. EsMa es la semilla de la cuenta
/// corriente de terceros que F8 generaliza (R10/D12).
model EsMaCargo {
  id        Int     @id @default(autoincrement())
  /// Empresa dueña del cargo (A9). Restrict.
  idEmpresa Int     @map("id_empresa")
  empresa   Empresa @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)

  /// Recibo de maquila que originó el cargo (F3-E4). NULLABLE para el histórico migrado
  /// (F3-E6: cargos viejos sin liga formal). Restrict.
  idEtapaRecibo Int?             @map("id_etapa_recibo")
  etapaRecibo   EtapaMovimiento? @relation(fields: [idEtapaRecibo], references: [id], onDelete: Restrict)

  /// Maquilero al que se le carga (Proveedor con rol de maquila — fusión D12/R15). Restrict.
  idMaquilero Int       @map("id_maquilero")
  maquilero   Proveedor @relation(fields: [idMaquilero], references: [id], onDelete: Restrict)

  /// Orden a la que pertenece el cargo (para el estado de cuenta por orden). Restrict.
  idOrden Int   @map("id_orden")
  orden   Orden @relation(fields: [idOrden], references: [id], onDelete: Restrict)

  /// Proceso de maquila del cargo (costura/estampado…). Restrict.
  idTipoProceso Int         @map("id_tipo_proceso")
  tipoProceso   TipoProceso @relation(fields: [idTipoProceso], references: [id], onDelete: Restrict)

  /// Cantidad real validada por el admin (F3-E4). NULL mientras esté `propuesto`. Decimal.
  cantidadReal Decimal? @map("cantidad_real") @db.Decimal(14, 2)
  /// Precio real validado por el admin (F3-E4). NULL mientras esté `propuesto`. Decimal.
  precioReal   Decimal? @map("precio_real") @db.Decimal(12, 2)

  /// Prendas de este cargo YA PAGADAS (F6-E4, decisión (g) — "prendas por pagar"). Suma de las
  /// `PagoAplicacion.cantidad` que consumió este cargo; se actualiza bajo lock por maquilero al
  /// aplicar un pago. El "pagado" se DERIVA (cantidadPagada ≥ cantidadReal): no hay bandera editable.
  cantidadPagada Decimal @default(0) @map("cantidad_pagada") @db.Decimal(14, 2)
  /// Segundas SIN COSTO (F6-E4, decisión (f)): prenda reclasificada a 2ª que NO se le paga al
  /// maquilero. Un cargo `sinCosto` se EXCLUYE del saldo y del pago (importe 0). Default false.
  sinCosto       Boolean @default(false) @map("sin_costo")
  /// Modalidad de facturación de ESTE movimiento (F6-E4, decisión (h)): true con factura, false sin
  /// factura, null sin definir. Se fija al VALIDAR según la `modalidadFacturacion` del proveedor.
  conFactura     Boolean? @map("con_factura")

  /// Estado del cargo (propuesto/validado/cancelado). Ver enum `EstadoCargoEsMa`. NOTA (F6-E4): los
  /// 3 estados de conciliación "capturado/revisado/pagado" NO se persisten aparte — se PROYECTAN de
  /// `estado` (propuesto=capturado, validado=revisado) + `cantidadPagada` (pagado). No hay columna
  /// redundante `estadoConciliacion` (D3: un solo dato de verdad).
  estado        EstadoCargoEsMa @default(propuesto)
  observaciones String?         @db.Text

  /// Validación: quién y cuándo (sin FK física — ADR-0005).
  validadoEn    DateTime? @map("validado_en")
  validadoPorId String?   @map("validado_por_id")

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  /// Pagos aplicados a este cargo (F6-E4, puente N:N; decisión (g)). Restrict (no borrar un cargo
  /// con pagos aplicados).
  aplicacionesPago PagoAplicacion[]

  @@index([idEmpresa])
  @@index([idEtapaRecibo])
  @@index([idMaquilero])
  @@index([idOrden])
  @@index([idTipoProceso])
  @@index([estado])
  @@map("esma_cargo")
}

// ─────────────────────────────────────────────────────────────────────────────
// EsMa — MOVIMIENTOS de la cuenta corriente de maquileros (F6-E4, doc
// `Documentacion_MJD/07-EsMa-Estados-de-Cuenta-Maquileros.md`; DECISIONES.md §F6 (e)–(h)).
// Corazón contable: los 3 conceptos PLANOS que completan el ciclo junto al cargo (nacido en
// F3). "Planos" = sin encabezado EsMa; el maquilero + la fecha + las observaciones viven en
// CADA movimiento (mejora sobre el viejo, que llevaba un encabezado por maquilero). Todos con
// `idEmpresa` (A9, Restrict), `idMaquilero`→Proveedor (Restrict), `monto` Decimal(14,2), `fecha`,
// `conFactura` (decisión h), `estadoRevision` (asteriscos Rev del viejo → E5) y auditoría A7.
// El SALDO NUNCA se persiste: es la suma derivada (D3) `Σcargos + Σabonos − Σpagos − Σdescuentos`.
// ─────────────────────────────────────────────────────────────────────────────

/// Modalidad de facturación de un maquilero/movimiento EsMa (F6-E4, decisión (h), R15). `ambos`
/// obliga a elegir con/sin factura por movimiento (y su estado de cuenta se segmenta en dos, E5).
enum ModalidadFacturacion {
  solo_con
  solo_sin
  ambos

  @@map("modalidad_facturacion")
}

/// Estado de revisión de un movimiento EsMa (F6-E4; ex asteriscos `Rev` del `EsMa_EdoCta` viejo).
/// `capturado` recién metido; `revisado` confirmado por quien supervisa (la transición fina la
/// opera E5). Default `capturado`.
enum EstadoRevisionEsMa {
  capturado
  revisado

  @@map("estado_revision_esma")
}

/// ABONO a la cuenta de un maquilero (F6-E4; ex `EsMaAbonos`). Movimiento plano.
model AbonoMaquilero {
  id        Int     @id @default(autoincrement())
  /// Empresa dueña del movimiento (A9). Restrict.
  idEmpresa Int     @map("id_empresa")
  empresa   Empresa @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)
  /// Maquilero (Proveedor) al que se le abona. Restrict.
  idMaquilero Int       @map("id_maquilero")
  maquilero   Proveedor @relation(fields: [idMaquilero], references: [id], onDelete: Restrict)

  /// Importe del abono (positivo). Decimal.
  monto          Decimal            @db.Decimal(14, 2)
  /// Fecha del movimiento (date-only).
  fecha          DateTime           @db.Date
  /// Con/sin factura (decisión h). Null = sin definir. Se resuelve del proveedor al capturar.
  conFactura     Boolean?           @map("con_factura")
  observaciones  String?            @db.Text
  estadoRevision EstadoRevisionEsMa @default(capturado) @map("estado_revision")

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idEmpresa])
  @@index([idMaquilero])
  @@map("abono_maquilero")
}

/// DESCUENTO a la cuenta de un maquilero (F6-E4; ex `EsMaDescuentos`). Movimiento plano.
model DescuentoMaquilero {
  id        Int     @id @default(autoincrement())
  /// Empresa dueña del movimiento (A9). Restrict.
  idEmpresa Int     @map("id_empresa")
  empresa   Empresa @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)
  /// Maquilero (Proveedor) al que se le descuenta. Restrict.
  idMaquilero Int       @map("id_maquilero")
  maquilero   Proveedor @relation(fields: [idMaquilero], references: [id], onDelete: Restrict)

  /// Importe del descuento (positivo). Decimal.
  monto          Decimal            @db.Decimal(14, 2)
  /// Fecha del movimiento (date-only).
  fecha          DateTime           @db.Date
  conFactura     Boolean?           @map("con_factura")
  observaciones  String?            @db.Text
  estadoRevision EstadoRevisionEsMa @default(capturado) @map("estado_revision")

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idEmpresa])
  @@index([idMaquilero])
  @@map("descuento_maquilero")
}

/// PAGO a un maquilero (F6-E4; ex `EsMaPagos`). Movimiento plano LIGADO a cargos (decisión (g)):
/// el pago se aplica a uno o más cargos consumiendo sus "prendas por pagar". `monto` = Σ importes
/// aplicados (se sella al capturar). El recibo de pago (R9) se imprime de este registro.
model PagoMaquilero {
  id        Int     @id @default(autoincrement())
  /// Empresa dueña del movimiento (A9). Restrict.
  idEmpresa Int     @map("id_empresa")
  empresa   Empresa @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)
  /// Maquilero (Proveedor) al que se le paga. Restrict.
  idMaquilero Int       @map("id_maquilero")
  maquilero   Proveedor @relation(fields: [idMaquilero], references: [id], onDelete: Restrict)

  /// Importe total del pago (= Σ `aplicaciones.importe`). Decimal.
  monto          Decimal            @db.Decimal(14, 2)
  /// Fecha del pago (date-only).
  fecha          DateTime           @db.Date
  conFactura     Boolean?           @map("con_factura")
  observaciones  String?            @db.Text
  estadoRevision EstadoRevisionEsMa @default(capturado) @map("estado_revision")

  /// Aplicaciones del pago a cargos concretos (decisión (g)). Cascade (el detalle vive con el pago).
  aplicaciones PagoAplicacion[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idEmpresa])
  @@index([idMaquilero])
  @@map("pago_maquilero")
}

/// Aplicación de un PAGO a un CARGO (F6-E4, puente decisión (g)): cuántas prendas de ese cargo se
/// pagaron y por qué importe. El saldo "por pagar" de un cargo = `cantidadReal − Σ cantidad` de sus
/// aplicaciones; pagar de más se BLOQUEA en el dominio (anti-doble-pago duro). PK (idPago, idCargo).
model PagoAplicacion {
  idPago Int           @map("id_pago")
  pago   PagoMaquilero @relation(fields: [idPago], references: [id], onDelete: Cascade)
  idCargo Int       @map("id_cargo")
  cargo   EsMaCargo @relation(fields: [idCargo], references: [id], onDelete: Restrict)

  /// Prendas de este cargo cubiertas por el pago (>0, ≤ prendas por pagar del cargo). Decimal.
  cantidad Decimal @db.Decimal(14, 2)
  /// Importe aplicado (= cantidad × precioReal del cargo). Decimal.
  importe  Decimal @db.Decimal(14, 2)

  @@id([idPago, idCargo])
  @@index([idCargo])
  @@map("pago_aplicacion")
}

// ─────────────────────────────────────────────────────────────────────────────
// Órdenes de COMPRA (Módulo 3, F4-E2 — doc `Documentacion_MJD/03-Produccion.md` §OC).
// El documento con el que se COMPRA material (telas/avíos) a un proveedor. Folio
// consecutivo POR EMPRESA (A3/A9). Documento por empresa (A9), catálogos globales.
// E2 captura/autoriza/cancela/duplica la OC; E3 conectará la RECEPCIÓN al kardex de
// telas/avíos (aquí NO se mueve inventario todavía, D3). Decisiones cerradas con el
// dueño (DECISIONES.md §"Decisiones de diseño F4"):
//  • (a) Una OC AUTORIZADA queda bloqueada para el usuario normal (el admin sí la edita,
//    cada cambio a Bitácora). "Duplicar a nueva OC" (todos) copia a un `borrador` nuevo.
//  • (c) Se ELIMINA el Excel: el renglón que lo requiera lleva matriz talla×color NATIVA
//    (análoga a OrdenLineaTalla de F2); la suma de la matriz = cantidad del renglón.
//    Renglones que no la necesiten = cantidad simple.
// Totales NO se persisten: se derivan por suma (Σ cantidad×precio) al proyectar (D3).
// onDelete: Restrict hacia empresa/proveedor/tela/avío/orden y los catálogos en uso
// (Color/Talla en la matriz). Cascade del detalle (líneas, matriz, ligas N:N) hacia su
// OC padre (permite reescribir el set completo en la transacción A2, igual que F2).
// ─────────────────────────────────────────────────────────────────────────────

/// Estatus de la orden de compra (F4-E2). `borrador` recién capturada (editable);
/// `pendiente_autorizacion` lista para revisión; `autorizada` aprobada y bloqueada para
/// el usuario normal (decisión (a)); `recibida_parcial`/`recibida_total` los pondrá la
/// RECEPCIÓN de E3 (aquí solo se declaran); `cancelada` = cancelación suave con motivo.
enum EstatusOrdenCompra {
  borrador
  pendiente_autorizacion
  autorizada
  recibida_parcial
  recibida_total
  cancelada

  @@map("estatus_orden_compra")
}

/// Orden de compra (F4-E2 — ex `OrdCompra`, doc 03-Produccion §OC). Encabezado del
/// documento de compra de material a un proveedor. Folio `numCompra` consecutivo POR
/// EMPRESA (A3/A9, secuencia "orden-compra"). El TOTAL no se almacena: se deriva de las
/// líneas (Σ cantidad×precio). El ETL de E6 llenará `facturasAmparadasLegacy` (solo
/// lectura; en v2 lo supera la factura por recepción).
model OrdenCompra {
  id        Int     @id @default(autoincrement())
  /// Folio consecutivo POR EMPRESA (A3/A9 — viejo: `OrdCompra.NumCompra`).
  numCompra BigInt  @map("num_compra")
  /// Empresa dueña de la OC y de su numeración (A9). Restrict.
  idEmpresa Int     @map("id_empresa")
  empresa   Empresa @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)

  /// Proveedor al que se le compra. Restrict.
  idProveedor Int       @map("id_proveedor")
  proveedor   Proveedor @relation(fields: [idProveedor], references: [id], onDelete: Restrict)

  /// Fecha de emisión de la OC.
  fecha        DateTime? @db.Date
  /// Fecha de entrega esperada del material.
  fechaEntrega DateTime? @map("fecha_entrega") @db.Date
  /// Dónde se entrega el material (texto libre).
  entregaEn    String?   @map("entrega_en")

  /// Estatus del documento (ver enum). DERIVADO/controlado por los servicios; default borrador.
  estatus EstatusOrdenCompra @default(borrador)

  /// Autorización (decisión (a)): quién y cuándo autorizó. NULL mientras no se autorice.
  /// SIN FK física al usuario (mismo criterio que EsMaCargo.validadoPorId — ADR-0005).
  idUsuAutorizado String?   @map("id_usu_autorizado")
  fechaAutorizado DateTime? @map("fecha_autorizado")

  /// Cancelación suave: cuándo, quién y por qué. NULL si no está cancelada. Motivo obligatorio
  /// al cancelar (lo exige el dominio). SIN FK física al usuario (ADR-0005).
  canceladaEn       DateTime? @map("cancelada_en")
  canceladaPorId    String?   @map("cancelada_por_id")
  motivoCancelacion String?   @map("motivo_cancelacion") @db.Text

  observaciones           String? @db.Text
  /// A qué corresponde la compra (texto libre; viejo: `OrdCompra.CorrespondeA`).
  correspondeA            String? @map("corresponde_a")
  /// Facturas que amparaba la OC en v1 (viejo: texto). SOLO LECTURA, lo llena el ETL de E6;
  /// en v2 lo supera la factura por recepción (E3+). No se captura por UI.
  facturasAmparadasLegacy String? @map("facturas_amparadas_legacy") @db.Text

  lineas         OrdenCompraLinea[]
  /// Ligas N:N (a nivel encabezado) a las órdenes de producción de la OC (F4-E2). Cascade.
  ordenesLigadas OrdenCompraOrden[]
  /// Recepciones de material contra esta OC (F4-E3, R7). Restrict: una OC con recepciones
  /// no se borra; la cancelación de la OC se bloquea si hay recepciones activas (decisión b).
  recepciones    RecepcionCompra[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idEmpresa, numCompra])
  @@index([idProveedor])
  @@index([estatus])
  @@index([fecha])
  @@map("ordenes_compra")
}

/// Renglón de una orden de compra (F4-E2 — ex `OrdCompraDet`). Un material a comprar:
/// de catálogo (`idTela` XOR `idAvio`) o LIBRE (`descripcionLibre`, fallback para
/// servicios/no-catalogados — esas líneas NO cruzan en R7). EXACTAMENTE una de las tres
/// (lo valida el dominio). El `precio` es el unitario de la línea (D1: precio actual);
/// `idAvioProveedor` se conserva para trazar el origen del precio R1 (es el idAvio del
/// `AvioProveedor` cuyo proveedor = el de la OC). La liga `idOrden` (orden de PRODUCCIÓN)
/// es POR LÍNEA para que R7 cruce gasto↔producción sin prorrateos. Cascade hacia la OC;
/// Restrict hacia tela/avío/orden.
model OrdenCompraLinea {
  id            Int         @id @default(autoincrement())
  idOrdenCompra Int         @map("id_orden_compra")
  ordenCompra   OrdenCompra @relation(fields: [idOrdenCompra], references: [id], onDelete: Cascade)

  /// Tela pedida (catálogo). XOR con `idAvio`/`descripcionLibre`. Restrict.
  idTela          Int?  @map("id_tela")
  tela            Tela? @relation(fields: [idTela], references: [id], onDelete: Restrict)
  /// Avío pedido (catálogo). XOR con `idTela`/`descripcionLibre`. Restrict.
  idAvio          Int?  @map("id_avio")
  avio            Avio? @relation(fields: [idAvio], references: [id], onDelete: Restrict)
  /// Avío del `AvioProveedor` que da el precio R1 (traza el origen del precio). Solo se
  /// guarda cuando la línea es de avío; el proveedor es el de la OC. SIN FK (el par vive
  /// en `AvioProveedor` con PK compuesta; aquí basta el idAvio para reconstruir el par).
  idAvioProveedor Int?  @map("id_avio_proveedor")

  /// Cantidad a comprar (en `unidad`). Decimal. Si la línea usa matriz, = Σ de la matriz.
  cantidad Decimal @db.Decimal(14, 2)
  /// Unidad/presentación de compra (texto: rollo, m, pza…).
  unidad   String?
  /// Precio unitario de la línea (D1: precio actual). Decimal.
  precio   Decimal @db.Decimal(12, 2)

  /// Orden de PRODUCCIÓN a la que se liga este renglón (R7, liga por línea). NULLABLE
  /// (compras genéricas/stock no ligan). Restrict.
  idOrden Int?   @map("id_orden")
  orden   Orden? @relation(fields: [idOrden], references: [id], onDelete: Restrict)

  /// Descripción libre (SOLO si la línea NO es de catálogo: servicios/no-catalogados).
  /// Cuando viene, `idTela`/`idAvio` van NULL (XOR validado en dominio). No cruza en R7.
  descripcionLibre String? @map("descripcion_libre")

  /// Matriz talla×color OPCIONAL del renglón (decisión (c)). Cuando se usa, `cantidad` = Σ.
  tallas          OrdenCompraLineaTalla[]
  /// Renglones de recepción que recibieron (parcial o total) contra este renglón de OC
  /// (F4-E3, R7). Restrict hacia la línea de OC. La suma de lo recibido por esta línea define
  /// el estatus de la OC (parcial/total).
  recepcionLineas RecepcionCompraLinea[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idOrdenCompra])
  @@index([idTela])
  @@index([idAvio])
  @@index([idOrden])
  @@map("orden_compra_linea")
}

/// Cantidad de una talla×color dentro de un renglón de OC (F4-E2, decisión (c) —
/// análoga a `OrdenLineaTalla` de F2 pero con color EN la misma fila, porque el renglón
/// de OC ya es de un material, no de un color). El par (color, talla) aparece UNA vez
/// por renglón (@@unique). `cantidad` entera ≥0. Cascade hacia el renglón; Restrict hacia
/// Color/Talla. La suma de la matriz = `cantidad` del renglón (lo valida el dominio).
model OrdenCompraLineaTalla {
  id                 Int              @id @default(autoincrement())
  idOrdenCompraLinea Int              @map("id_orden_compra_linea")
  ordenCompraLinea   OrdenCompraLinea @relation(fields: [idOrdenCompraLinea], references: [id], onDelete: Cascade)
  idColor            Int              @map("id_color")
  color              Color            @relation(fields: [idColor], references: [id], onDelete: Restrict)
  idTalla            Int              @map("id_talla")
  talla              Talla            @relation(fields: [idTalla], references: [id], onDelete: Restrict)

  /// Cantidad de esta talla×color. Entera ≥0.
  cantidad Int

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idOrdenCompraLinea, idColor, idTalla])
  @@index([idOrdenCompraLinea])
  @@index([idColor])
  @@index([idTalla])
  @@map("orden_compra_linea_talla")
}

/// Liga N:N (a nivel ENCABEZADO) entre una orden de compra y una orden de producción
/// (F4-E2 — ex `OrdCom-Ord`). Informativo/derivado: se deriva de los `idOrden` de las
/// líneas pero se persiste a nivel encabezado (la ficha lo pide). Una orden de producción
/// aparece UNA vez por OC (@@unique). Cascade hacia la OC; Restrict hacia la orden.
model OrdenCompraOrden {
  id            Int         @id @default(autoincrement())
  idOrdenCompra Int         @map("id_orden_compra")
  ordenCompra   OrdenCompra @relation(fields: [idOrdenCompra], references: [id], onDelete: Cascade)
  idOrden       Int         @map("id_orden")
  orden         Orden       @relation(fields: [idOrden], references: [id], onDelete: Restrict)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idOrdenCompra, idOrden])
  @@index([idOrdenCompra])
  @@index([idOrden])
  @@map("orden_compra_orden")
}

// ─────────────────────────────────────────────────────────────────────────────
// RECEPCIÓN de compras (Módulo 3, F4-E3 — doc `Documentacion_MJD/03-Produccion.md` §OC;
// R7 — REQUISITOS-NUEVOS.md). La recepción es el HECHO que conecta la OC con el kardex de
// materiales: recibe (parcial o total) el material de una OC AUTORIZADA, crea el lote de la
// tela (D5), registra la ENTRADA al kardex (`entrada-recepcion`) con cantidad y costo YA
// convertidos a unidad de consumo (R1: factor presentación→consumo, costo ÷ factor, D1), y
// recalcula el estatus de la OC (parcial/total, R7). Decisión (b) cerrada con Daniel: SOLO se
// recibe contra una OC `autorizada`/`recibida_parcial` (server-side, A4). Reverso SUAVE: nada
// se borra (D3) — la reversión genera el movimiento INVERSO de kardex y marca la recepción
// como reversada (A7). Folio por empresa (A3/A9, secuencia "recepcion-compra").
// ─────────────────────────────────────────────────────────────────────────────

/// Recepción de material contra una orden de compra (F4-E3, R7). Encabezado del documento de
/// entrada: factura del proveedor, fecha, almacén DESTINO y empresa (A9). Folio `folio`
/// consecutivo POR EMPRESA (A3/A9). SIEMPRE ligada a una OC (`idOrdenCompra` obligatorio: las
/// recepciones de v2 nacen de una OC, no hay entrada "suelta"). Reverso suave (`reversadaEn`):
/// la recepción reversada sigue consultable; sus movimientos de kardex se neutralizan con su
/// inverso (D3). Auditoría A7.
model RecepcionCompra {
  id        Int     @id @default(autoincrement())
  /// Folio consecutivo POR EMPRESA (A3/A9 — secuencia "recepcion-compra").
  folio     BigInt
  /// Empresa dueña de la recepción y de su numeración (A9). Restrict.
  idEmpresa Int     @map("id_empresa")
  empresa   Empresa @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)

  /// Orden de compra que se recibe (OBLIGATORIO — recepciones v2 siempre ligadas a OC). Restrict.
  idOrdenCompra Int         @map("id_orden_compra")
  ordenCompra   OrdenCompra @relation(fields: [idOrdenCompra], references: [id], onDelete: Restrict)

  /// Almacén DESTINO al que entra el material recibido (D4: existencia por …×almacén). Restrict.
  idAlmacen Int     @map("id_almacen")
  almacen   Almacen @relation(fields: [idAlmacen], references: [id], onDelete: Restrict)

  /// Factura del proveedor de esta recepción (texto; opcional). El lote de tela también la guarda.
  factura String?
  /// Fecha de la recepción (solo fecha).
  fecha   DateTime @db.Date

  observaciones String? @db.Text

  /// Reverso SUAVE (D3): cuándo, quién y por qué se reversó. NULL si está activa. Al reversar se
  /// genera el movimiento INVERSO de kardex (la recepción NO se borra). SIN FK física al usuario
  /// (mismo criterio que OrdenCompra.canceladaPorId — ADR-0005).
  reversadaEn    DateTime? @map("reversada_en")
  reversadaPorId String?   @map("reversada_por_id")
  motivoReverso  String?   @map("motivo_reverso") @db.Text

  /// Renglones recibidos (uno por renglón de OC recibido, parcial o total).
  lineas RecepcionCompraLinea[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idEmpresa, folio])
  @@index([idOrdenCompra])
  @@index([idAlmacen])
  @@index([reversadaEn])
  @@map("recepciones_compra")
}

/// Renglón de una recepción (F4-E3): cuánto se recibió contra un renglón de OC. `cantidadRecibida`
/// está en UNIDAD DE CONSUMO ya convertida (R1: cantidad × factor) — es la que cuenta para el
/// estatus de la OC y la que entró al kardex. `idLote` (telas) = el lote creado en esta recepción;
/// `idMovimiento` = el movimiento de kardex de ENTRADA que generó (traza). Las líneas LIBRES de la
/// OC (sin tela/avío) se registran con cantidad pero SIN lote ni movimiento (no inventarían).
/// Cascade hacia la recepción; Restrict hacia la línea de OC/lote; SetNull hacia el movimiento (que
/// nunca se borra — D3). `costoUnit` = costo por unidad de consumo (precio ÷ factor, D1).
model RecepcionCompraLinea {
  id                Int             @id @default(autoincrement())
  idRecepcionCompra Int             @map("id_recepcion_compra")
  recepcionCompra   RecepcionCompra @relation(fields: [idRecepcionCompra], references: [id], onDelete: Cascade)

  /// Renglón de la OC que se recibe (R7). Restrict.
  idOrdenCompraLinea Int              @map("id_orden_compra_linea")
  ordenCompraLinea   OrdenCompraLinea @relation(fields: [idOrdenCompraLinea], references: [id], onDelete: Restrict)

  /// Cantidad recibida en UNIDAD DE CONSUMO (ya convertida: cantidadPresentación × factor, R1).
  /// Para líneas de catálogo es lo que entró al kardex; para líneas libres es informativa.
  cantidadRecibida Decimal  @map("cantidad_recibida") @db.Decimal(14, 4)
  /// Costo por unidad de consumo (precioPresentación ÷ factor, D1). NULL en líneas libres.
  costoUnit        Decimal? @map("costo_unit") @db.Decimal(12, 4)

  /// Lote creado/usado para esta línea de TELA (D5). NULL en avío/libre. Restrict.
  idLote Int?  @map("id_lote")
  lote   Lote? @relation(fields: [idLote], references: [id], onDelete: Restrict)

  /// Movimiento de kardex de ENTRADA que generó esta línea (tela/avío). NULL en líneas libres y
  /// tras un reverso conceptual (el movimiento sigue existiendo; aquí se conserva la traza).
  /// SetNull: los movimientos nunca se borran (D3), pero el FK es defensivo.
  idMovimiento Int?        @map("id_movimiento")
  movimiento   Movimiento? @relation(fields: [idMovimiento], references: [id], onDelete: SetNull)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idRecepcionCompra])
  @@index([idOrdenCompraLinea])
  @@index([idLote])
  @@index([idMovimiento])
  @@map("recepcion_compra_linea")
}

// ─────────────────────────────────────────────────────────────────────────────
// OUTBOX de eventos de dominio (F4-E3 — ADR-0011: patrón outbox transaccional + pg-boss).
// La fila se inserta DENTRO de la transacción de negocio (atómica con la recepción): el evento
// NUNCA se pierde aunque el proceso muera tras el commit. Un relay (`comun/cola-eventos.ts`)
// publica las filas pendientes a pg-boss (sobre el MISMO Postgres) y marca `publicadoEn`; un
// barrido periódico reintenta las no publicadas (durabilidad). El consumidor de negocio es de
// F5 (RC/MRP) — aquí SOLO se publica.
// ─────────────────────────────────────────────────────────────────────────────

/// Evento de dominio pendiente de publicar (F4-E3, ADR-0011 — patrón OUTBOX). Se escribe en la
/// MISMA transacción que el hecho de negocio (atómico); el relay lo publica a la cola pg-boss y
/// marca `publicadoEn`. `tipo` = nombre del evento (p. ej. "material-recibido"); `version` =
/// versión del contrato del payload; `payload` = la carga JSON versionada. `intentos`/`error`
/// registran los reintentos del relay. GLOBAL por empresa (A9: `idEmpresa` para trazar/segmentar).
model EventoOutbox {
  id          Int       @id @default(autoincrement())
  /// Nombre del evento (contrato versionado, p. ej. "material-recibido"). Ver ADR-0011.
  tipo        String
  /// Versión del contrato del payload (para evolucionar el evento sin romper consumidores).
  version     Int       @default(1)
  /// Empresa dueña del hecho (A9). Restrict.
  idEmpresa   Int       @map("id_empresa")
  empresa     Empresa   @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)
  /// Carga del evento (JSON). Lo MÍNIMO para que el consumidor reaccione (ids + material).
  payload     Json
  /// Cuándo se publicó a la cola (NULL = pendiente). El relay lo sella tras encolar.
  publicadoEn DateTime? @map("publicado_en")
  /// Número de intentos de publicación (el barrido lo incrementa al reintentar).
  intentos    Int       @default(0)
  /// Último error de publicación (texto), si lo hubo. NULL si nunca falló.
  error       String?   @db.Text

  creadoEn DateTime @default(now()) @map("creado_en")

  @@index([publicadoEn])
  @@index([idEmpresa])
  @@map("eventos_outbox")
}

// ─────────────────────────────────────────────────────────────────────────────
// EXPLOSIÓN MRP / requerimiento de materiales por orden (F4-E4 — REQUISITOS-NUEVOS.md
// §R3/R7 + principio Make-to-Order; doc `Documentacion_MJD/01-Modelos.md §2`). La explosión
// cruza el BOM del modelo (telas+avíos `paraProduccion`) contra las cantidades color×talla de
// la orden para obtener QUÉ y CUÁNTO material hace falta comprar. El resultado se PERSISTE como
// un SNAPSHOT regenerable: congela lo requerido aunque el BOM cambie después (R3 — el cálculo
// que originó la compra queda trazable). Regenerar = borrar el snapshot anterior de la orden y
// reescribirlo en una transacción (D3: nada se edita en sitio). El cruce con OC/recepciones (R7)
// es on-demand (no se materializa aquí).
// ─────────────────────────────────────────────────────────────────────────────

/// Renglón del SNAPSHOT de explosión de una orden (F4-E4, R3). Un material (tela XOR avío) con la
/// cantidad requerida YA en unidad de consumo del BOM (consumoPorPrenda × Σ piezas color×talla de
/// la orden). `idProveedorSugerido` viene del `AvioProveedor` más barato para avíos (R1); para
/// telas es NULL (no hay liga directa tela→proveedor en v2 — el proveedor se decide al comprar el
/// lote, D5). `esGenerico`/`cubiertoPorStock`/`cantidadAComprar` registran el NETEO contra el
/// kardex de avíos genéricos (decisión (d) de Daniel): un genérico solo manda a compra el faltante.
/// El snapshot se REEMPLAZA al regenerar (se borra y reescribe en la misma tx, A2/D3). Auditoría A7.
model RequerimientoOrden {
  id      Int   @id @default(autoincrement())
  /// Orden de producción a la que pertenece este requerimiento (R3). Cascade: el snapshot es
  /// configuración derivada de la orden; al borrar la orden se va con ella.
  idOrden Int   @map("id_orden")
  orden   Orden @relation(fields: [idOrden], references: [id], onDelete: Cascade)

  /// Tela requerida (catálogo). XOR con `idAvio`. Restrict. NULL si el renglón es de avío.
  idTela Int?  @map("id_tela")
  tela   Tela? @relation(fields: [idTela], references: [id], onDelete: Restrict)
  /// Avío requerido (catálogo). XOR con `idTela`. Restrict. NULL si el renglón es de tela.
  idAvio Int?  @map("id_avio")
  avio   Avio? @relation(fields: [idAvio], references: [id], onDelete: Restrict)

  /// Cantidad requerida en UNIDAD DE CONSUMO del BOM (consumoPorPrenda × piezas de la orden, R3).
  cantidadRequerida Decimal @map("cantidad_requerida") @db.Decimal(14, 4)
  /// Unidad de consumo del material (m, kg, pza…), copiada del catálogo para mostrar sin join.
  unidad            String?

  /// ¿El avío es genérico (de stock, R4)? Copiado de `Avio.esGenerico`. FALSE para telas.
  esGenerico       Boolean @default(false) @map("es_generico")
  /// Existencia REAL del kardex de avíos (Σ de movimientos, D3) al momento del snapshot — solo se
  /// llena para genéricos (decisión (d)); 0 para el resto. Informativa (el neteo ya se aplicó).
  existenciaStock  Decimal @default(0) @map("existencia_stock") @db.Decimal(14, 4)
  /// Cantidad que realmente va a COMPRA = requerida − existencia (solo genéricos netean; el resto
  /// va completo). NUNCA negativa. Es la base de la generación de OC y del cruce R7.
  cantidadAComprar Decimal @map("cantidad_a_comprar") @db.Decimal(14, 4)

  /// Proveedor SUGERIDO para comprar este material (avíos: el `AvioProveedor` más barato, R1).
  /// NULL para telas (sin liga directa tela→proveedor) o si el avío no tiene proveedor mapeado.
  /// SIN FK de relación inversa nombrada al revés: Restrict para no perder la sugerencia.
  idProveedorSugerido Int?       @map("id_proveedor_sugerido")
  proveedorSugerido   Proveedor? @relation("RequerimientoProveedorSugerido", fields: [idProveedorSugerido], references: [id], onDelete: Restrict)

  /// Precio unitario sugerido (por unidad de consumo) del proveedor sugerido (R1: precio ÷ factor),
  /// para pre-llenar la OC. NULL si no hay proveedor/precio mapeado.
  precioSugerido Decimal? @map("precio_sugerido") @db.Decimal(12, 4)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idOrden])
  @@index([idTela])
  @@index([idAvio])
  @@index([idProveedorSugerido])
  @@map("requerimiento_orden")
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTAS DE SALIDA estructuradas (Módulo 5, F4-E5 — doc `Documentacion_MJD/03-Produccion.md`
// §"Submódulo — Notas de Salida (Menú 3.4)"; 04-Inventarios.md §"Cómo conecta"; MEJORAS §03;
// R4/R9). Una nota de salida documenta el ENVÍO de materiales a un maquilero contra una orden de
// producción. Sustituye las notas de TEXTO LIBRE del viejo (`Notas`/`NotasDet`, 11,459 renglones)
// por renglones ESTRUCTURADOS contra catálogo, ligados a la orden. Dos tipos de renglón:
//  • AVÍO: al CONFIRMAR la nota descuenta el kardex de avíos con un movimiento `salida-por-nota`
//    (R4 — el consumo de avíos va ligado a las notas).
//  • TELA: la tela YA se descontó UNA sola vez con `registrarSalidaTelaAOrden` (E1, traza
//    `origenTipo=salida-tela-orden`, `origenId=idOrden`). La nota solo REFERENCIA ese movimiento
//    como documento de envío y NO genera segundo movimiento de kardex (DECISIÓN (e) de Daniel).
// Folio `NumNota` por secuencia atómica por empresa (A3/A9, clave "nota-salida"). Cancelación
// suave (D3): reversa SOLO los movimientos de avíos que la nota generó; la tela no se toca.
// ─────────────────────────────────────────────────────────────────────────────

/// Estatus de una nota de salida. Nace `borrador` (capturable/editable); al CONFIRMAR pasa a
/// `confirmada` y se descuentan los avíos del kardex (A2). `cancelada` = cancelación suave
/// (reverso auditado de los avíos, D3). Mismo patrón de enum que `EstatusOrdenCompra`.
enum EstatusNotaSalida {
  borrador
  confirmada
  cancelada

  @@map("estatus_nota_salida")
}

/// Nota de salida de materiales a un maquilero (F4-E5, R4/R9). Encabezado del documento de envío:
/// el maquilero (un Proveedor/tercero — fusión D12/R15), fechas de elaboración y envío, empresa
/// (A9) y folio `numNota` consecutivo POR EMPRESA (A3/A9, secuencia "nota-salida"). El consumo
/// real (descuento de avíos) sucede al CONFIRMAR (`estatus=confirmada`); la cancelación es SUAVE
/// (`canceladaEn` + reverso auditado de los avíos, D3 — nada se borra). Auditoría A7.
model NotaSalida {
  id        Int     @id @default(autoincrement())
  /// Folio consecutivo POR EMPRESA (A3/A9 — viejo: `Notas.NumNota`). Secuencia "nota-salida".
  numNota   BigInt  @map("num_nota")
  /// Empresa dueña de la nota y de su numeración (A9). Restrict.
  idEmpresa Int     @map("id_empresa")
  empresa   Empresa @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)

  /// Maquilero al que se le envían los materiales (un Proveedor/tercero — fusión D12/R15). Restrict.
  idMaquilero Int       @map("id_maquilero")
  maquilero   Proveedor @relation(fields: [idMaquilero], references: [id], onDelete: Restrict)

  /// Almacén ORIGEN del que salen los avíos al CONFIRMAR la nota (un almacén por nota, en el
  /// ENCABEZADO — decisión (g) de Daniel, espejo de la recepción de compra; la tela no descuenta,
  /// decisión (e)). El inventario de avíos es multi-almacén (R4). Restrict.
  idAlmacen Int     @map("id_almacen")
  almacen   Almacen @relation(fields: [idAlmacen], references: [id], onDelete: Restrict)

  /// Fecha de elaboración de la nota (solo fecha).
  fechaElaboracion DateTime  @map("fecha_elaboracion") @db.Date
  /// Fecha de envío real de los materiales (solo fecha; opcional hasta que salga el envío).
  fechaEnvio       DateTime? @map("fecha_envio") @db.Date

  /// Estatus del documento (ver enum). Controlado por el dominio; default borrador.
  estatus EstatusNotaSalida @default(borrador)

  observaciones String? @db.Text

  /// Confirmación: cuándo se confirmó (se descontaron los avíos). NULL mientras esté en borrador.
  /// SIN FK física al usuario (mismo criterio que OrdenCompra.idUsuAutorizado — ADR-0005).
  confirmadaEn    DateTime? @map("confirmada_en")
  confirmadaPorId String?   @map("confirmada_por_id")

  /// Cancelación SUAVE (D3): cuándo, quién y por qué. NULL si no está cancelada. Motivo obligatorio
  /// al cancelar (lo exige el dominio). SIN FK física al usuario (ADR-0005). Al cancelar una nota
  /// confirmada se generan los movimientos INVERSOS de los avíos (la tela NO se toca).
  canceladaEn       DateTime? @map("cancelada_en")
  canceladaPorId    String?   @map("cancelada_por_id")
  motivoCancelacion String?   @map("motivo_cancelacion") @db.Text

  /// Renglones de la nota (avío que descuenta O tela que referencia su salida-a-orden).
  lineas NotaSalidaLinea[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idEmpresa, numNota])
  @@index([idMaquilero])
  @@index([idAlmacen])
  @@index([estatus])
  @@index([fechaElaboracion])
  @@map("notas_salida")
}

/// Renglón de una nota de salida (F4-E5). XOR de material: AVÍO (`idAvio`, del catálogo) o TELA
/// (`idTela` + `idLote` + `idMovimientoSalidaTela` → liga al movimiento `salida-tela-orden` de E1).
/// SIEMPRE ligado a una `idOrden` de producción destino (R7/04-Inventarios §"Cómo conecta").
///  • AVÍO: al confirmar la nota, el dominio crea el movimiento `salida-por-nota` y lo guarda en
///    `idMovimientoAvio` (traza del descuento; NULL en borrador y para renglones de tela).
///  • TELA: `idMovimientoSalidaTela` apunta al movimiento de salida-a-orden YA registrado (E1) —
///    la base del ANTI-DOBLE-DESCUENTO (la nota REFERENCIA, no descuenta otra vez; decisión (e)).
/// `descripcionLegacy` es SOLO para el texto libre que migrará E6 (la captura nueva no la usa).
/// Cascade hacia la nota; Restrict hacia avío/tela/lote/orden; SetNull hacia los movimientos (que
/// nunca se borran — D3). Auditoría A7.
model NotaSalidaLinea {
  id           Int        @id @default(autoincrement())
  idNotaSalida Int        @map("id_nota_salida")
  notaSalida   NotaSalida @relation(fields: [idNotaSalida], references: [id], onDelete: Cascade)

  /// Orden de PRODUCCIÓN destino del envío (R7). Restrict.
  idOrden Int   @map("id_orden")
  orden   Orden @relation(fields: [idOrden], references: [id], onDelete: Restrict)

  /// Avío enviado (catálogo). XOR con `idTela`. Restrict. NULL si el renglón es de tela.
  idAvio Int?  @map("id_avio")
  avio   Avio? @relation(fields: [idAvio], references: [id], onDelete: Restrict)

  /// Tela enviada (catálogo). XOR con `idAvio`. Restrict. NULL si el renglón es de avío.
  idTela Int?  @map("id_tela")
  tela   Tela? @relation(fields: [idTela], references: [id], onDelete: Restrict)
  /// Lote de la tela enviada (D5). Obligatorio (dominio) en renglones de tela; NULL en avío. Restrict.
  idLote Int?  @map("id_lote")
  lote   Lote? @relation(fields: [idLote], references: [id], onDelete: Restrict)

  /// Movimiento `salida-tela-orden` de E1 que esta línea de TELA referencia (decisión (e): la nota
  /// NO descuenta tela; documenta el envío de una salida YA registrada). NULL en renglones de avío.
  /// SetNull: el movimiento nunca se borra (D3); el FK es defensivo.
  idMovimientoSalidaTela Int?        @map("id_movimiento_salida_tela")
  movimientoSalidaTela   Movimiento? @relation("NotaLineaSalidaTela", fields: [idMovimientoSalidaTela], references: [id], onDelete: SetNull)

  /// Movimiento `salida-por-nota` que el descuento de AVÍO de esta línea generó al CONFIRMAR la
  /// nota (R4). NULL en borrador y en renglones de tela. SetNull (el movimiento no se borra — D3).
  idMovimientoAvio Int?        @map("id_movimiento_avio")
  movimientoAvio   Movimiento? @relation("NotaLineaAvio", fields: [idMovimientoAvio], references: [id], onDelete: SetNull)

  /// Cantidad enviada (en `unidad`). Decimal (avíos en pza; telas en kg/m).
  cantidad Decimal @db.Decimal(14, 4)
  /// Unidad de medida del renglón (texto: pza, m, kg…), copiada del catálogo para mostrar sin join.
  unidad   String?

  /// Texto libre del renglón en v1 — SOLO para lo que migrará E6 (la captura nueva NO la usa).
  descripcionLegacy String? @map("descripcion_legacy") @db.Text

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idNotaSalida])
  @@index([idOrden])
  @@index([idAvio])
  @@index([idTela])
  @@index([idLote])
  @@index([idMovimientoSalidaTela])
  @@index([idMovimientoAvio])
  @@map("nota_salida_linea")
}

// ─────────────────────────────────────────────────────────────────────────────
// RUTA CRÍTICA — catálogo configurable de procesos (Módulo 8, F5-E1; doc
// 08-Ruta-Critica.md; D10/D11). El "corazón configurable" del motor de workflow:
// el catálogo de procesos como DATOS (`ProcesoDef`), sus roles responsables N:M
// sobre el RBAC único (`ProcesoDefRol`, A4 — sin catálogo de roles paralelo), el
// grafo (DAG) de dependencias genéricas (`ProcesoDep`, con rechazo de ciclos en
// el dominio) y los checklists configurables (`ProcesoChecklist`). El MOTOR (las
// instancias por orden con fechas/semáforos) y las plantillas llegan en E2+.
//
// Origen v1: `CP_Procesos` (26 procesos), `RC_TipoUsuarios` (roles funcionales) y
// `RC_ProcUsua` (asignaciones proceso×rol). El ETL formal con cuadre es E7; aquí
// el seed de desarrollo siembra los 26 procesos reales (datos bakeados, sin
// depender del CSV en runtime de deploy).
// ─────────────────────────────────────────────────────────────────────────────

/// ¿Bajo qué condición APLICA un proceso a una orden? (F5-E1). TIPADO SIMPLE (no es
/// un motor de expresiones): `ninguna` = siempre aplica; `soloSiLlevaAplicacion` =
/// solo si la orden lleva estampado/aplicación (ex `CP_Procesos.NoLlevaProceso`, que
/// marcaba los procesos saltables cuando no hay arte/aplicación). El motor de E2+
/// evaluará esta bandera al instanciar la RC de cada orden.
enum CondicionAplicabilidad {
  ninguna
  soloSiLlevaAplicacion

  @@map("condicion_aplicabilidad")
}

/// Tipo de EVENTO de negocio que un proceso de la RC representa (F5-E1). Liga el
/// proceso configurable con los hechos reales de v2 (recepción de tela, corte,
/// envío/recibo de costura/estampado, auditoría, autorización de arte, entrega a
/// cliente). El motor de E2+ podrá auto-completar el cumplimiento de un proceso a
/// partir del evento de dominio correspondiente (gancho RC, F3-E1). `manual` = el
/// proceso no tiene evento del sistema y se cumple a mano.
enum TipoEventoProceso {
  recepcionTela
  corte
  envioCostura
  reciboCostura
  envioEstampado
  reciboEstampado
  auditoria
  autorizacionArte
  entregaCliente
  manual

  @@map("tipo_evento_proceso")
}

/// Cómo se calcula la DURACIÓN estimada de un proceso (F5-E1). TIPADO SIMPLE: `fija`
/// (días fijos), `porCantidad` (escala con las piezas — ex `CP_Procesos.Variable`),
/// `porTipoTela` o `porAplicacion`. El cálculo concreto (la fórmula y los parámetros
/// por proceso) lo definirá el motor de E2+; aquí solo se clasifica.
enum TipoDuracionProceso {
  fija
  porCantidad
  porTipoTela
  porAplicacion

  @@map("tipo_duracion_proceso")
}

/// Definición de un PROCESO de la Ruta Crítica (catálogo configurable y GLOBAL — sin
/// idEmpresa, como TipoProceso/ADR-0007). Es la pieza-DATO del CPM hecho a mano del
/// viejo (doc 08): cada proceso tiene su criticidad, condición de aplicabilidad,
/// tipo de evento y de duración, sus roles responsables (N:M) y sus antecesores
/// (DAG). Borrado SUAVE (`activo`). Auditoría uniforme (A7).
model ProcesoDef {
  id     Int    @id @default(autoincrement())
  /// Clave estable kebab-case (p. ej. "corte", "recepcion-tela"). Única global.
  codigo String @unique
  nombre String

  /// ¿Es un proceso CRÍTICO de la ruta? (ex `CP_Procesos.Critico`). Marca los procesos
  /// que entran al cálculo de la ruta crítica / KPIs (doc 08).
  critico       Boolean @default(false)
  /// ¿Es el ÚLTIMO proceso (checkpoint final de la orden)? (ex `CP_Procesos.UltimoProceso`).
  /// El motor de E2+ lo usa para cerrar la RC de la orden.
  ultimoProceso Boolean @default(false) @map("ultimo_proceso")
  /// ¿Aplica también en órdenes de RESURTIDO? (ex `CP_Procesos.EsResurtido`).
  esResurtido   Boolean @default(false) @map("es_resurtido")

  /// Condición de aplicabilidad del proceso a una orden (TIPADO, no motor de expresiones).
  condicionAplicabilidad CondicionAplicabilidad @default(ninguna) @map("condicion_aplicabilidad")
  /// Evento de negocio que el proceso representa (gancho con los hechos reales de v2).
  tipoEvento             TipoEventoProceso      @default(manual) @map("tipo_evento")
  /// Cómo se estima la duración del proceso (TIPADO; la fórmula la pone el motor de E2+).
  tipoDuracion           TipoDuracionProceso    @default(fija) @map("tipo_duracion")

  /// Borrado SUAVE (plan §4): un proceso en uso por la RC nunca se borra físico → se desactiva.
  activo Boolean @default(true)

  /// Roles RESPONSABLES del proceso (N:M sobre el RBAC único, A4).
  roles        ProcesoDefRol[]
  /// Dependencias en las que ESTE proceso es el sucesor (sus antecesores).
  antecesores  ProcesoDep[]           @relation("ProcesoComoSucesor")
  /// Dependencias en las que ESTE proceso es el antecesor (sus sucesores).
  sucesores    ProcesoDep[]           @relation("ProcesoComoAntecesor")
  /// Ítems de checklist configurable del proceso.
  checklist    ProcesoChecklist[]
  /// Renglones de plantilla de ruta que usan este proceso (F5-E2). Restrict.
  enPlantillas PlantillaRutaProceso[]
  /// Renglones de ruta viva (por orden) que usan este proceso (F5-E3). Restrict.
  enRutas      RutaOrden[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("proceso_def")
}

/// Puente N:M `ProcesoDef` × `Rol` — el/los rol(es) RESPONSABLE(s) de un proceso de la RC
/// (F5-E1, A4: sobre el RBAC único, sin catálogo de roles paralelo). PK compuesta; solo
/// auditoría de creación (las puentes no se "modifican": se crean/borran al re-set de roles).
model ProcesoDefRol {
  idProcesoDef Int        @map("id_proceso_def")
  procesoDef   ProcesoDef @relation(fields: [idProcesoDef], references: [id], onDelete: Cascade)
  idRol        Int        @map("id_rol")
  rol          Rol        @relation(fields: [idRol], references: [id], onDelete: Restrict)

  creadoEn    DateTime @default(now()) @map("creado_en")
  creadoPorId String?  @map("creado_por_id")

  @@id([idProcesoDef, idRol])
  @@index([idRol])
  @@map("proceso_def_rol")
}

/// Arista del DAG de dependencias genéricas entre procesos de la RC (F5-E1): `idAntecesor`
/// DEBE ocurrir antes que `idProceso`. Self-relation con dos nombres de relación distintos.
/// El RECHAZO DE CICLOS vive en el dominio (`definirDependencias`): el grafo siempre acíclico.
/// PK compuesta `[idProceso, idAntecesor]`; Restrict (un proceso con dependencias no se borra
/// físico). Solo auditoría de creación (las aristas se crean/borran al re-set de dependencias).
model ProcesoDep {
  idProceso   Int        @map("id_proceso")
  proceso     ProcesoDef @relation("ProcesoComoSucesor", fields: [idProceso], references: [id], onDelete: Restrict)
  idAntecesor Int        @map("id_antecesor")
  antecesor   ProcesoDef @relation("ProcesoComoAntecesor", fields: [idAntecesor], references: [id], onDelete: Restrict)

  creadoEn    DateTime @default(now()) @map("creado_en")
  creadoPorId String?  @map("creado_por_id")

  @@id([idProceso, idAntecesor])
  @@index([idAntecesor])
  @@map("proceso_dep")
}

/// Ítem de CHECKLIST configurable de un proceso de la RC (F5-E1). Lista ordenada de puntos a
/// verificar por proceso (doc 08: la RC del viejo llevaba comprobaciones manuales). Borrado
/// SUAVE (`activo`): al re-set del checklist, los ítems quitados se desactivan (no se borran).
model ProcesoChecklist {
  id           Int        @id @default(autoincrement())
  idProcesoDef Int        @map("id_proceso_def")
  procesoDef   ProcesoDef @relation(fields: [idProcesoDef], references: [id], onDelete: Cascade)
  descripcion  String
  /// Orden de despliegue del ítem dentro del checklist (lo gestiona el dominio).
  orden        Int        @default(0)
  /// Borrado suave: un ítem quitado del checklist se desactiva (conserva historial).
  activo       Boolean    @default(true)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idProcesoDef])
  @@map("proceso_checklist")
}

// ─────────────────────────────────────────────────────────────────────────────
// RUTA CRÍTICA · F5-E2 — Plantillas de ruta, reglas de duración y calendario
// ─────────────────────────────────────────────────────────────────────────────

/// Familia de artículos de la Ruta Crítica (ex `CP_Familia`). Agrupa los `ArticuloRC`
/// (tipos de artículo del CPM). Catálogo GLOBAL, borrado SUAVE (`activo`), auditoría A7.
model FamiliaArticulo {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  activo Boolean @default(true)

  /// Artículos RC de esta familia (Restrict: una familia con artículos no se borra física).
  articulos ArticuloRC[]

  creadoEn        DateTime        @default(now()) @map("creado_en")
  creadoPorId     String?         @map("creado_por_id")
  modificadoEn    DateTime        @updatedAt @map("modificado_en")
  modificadoPorId String?         @map("modificado_por_id")
  plantillaRutas  PlantillaRuta[]

  @@map("familia_articulo")
}

/// Tipo de artículo de la Ruta Crítica (ex `CP_Articulos`, viejo `IdCP_Articulos`). Es la
/// dimensión por la que el CPM viejo variaba sus tiempos (p. ej. "SENCILLO 1/6", "DIFICIL 6/6").
/// Pertenece a una `FamiliaArticulo`. NO se conecta por FK desde `Orden` en esta etapa: la orden
/// guarda `idTipoArticuloRC` como escalar nullable sin FK (prueba ya tiene órdenes ETL con valores
/// ahí; el enganche formal llega cuando el motor lo necesite). Catálogo GLOBAL, borrado SUAVE.
model ArticuloRC {
  id                Int             @id @default(autoincrement())
  nombre            String
  idFamiliaArticulo Int             @map("id_familia_articulo")
  familia           FamiliaArticulo @relation(fields: [idFamiliaArticulo], references: [id], onDelete: Restrict)
  activo            Boolean         @default(true)

  /// Plantillas de ruta que aplican específicamente a este artículo (Restrict).
  plantillas PlantillaRuta[]
  /// Órdenes programadas con este artículo RC (F5-E3). Restrict.
  ordenes    Orden[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idFamiliaArticulo])
  @@map("articulo_rc")
}

/// PLANTILLA de ruta: qué procesos lleva un artículo/familia, con qué tiempo estándar y con qué
/// ENCADENAMIENTO PROPIO (puede diferir del DAG genérico de `ProcesoDep`, porque el viejo
/// `CP_Tiempos.Antecesor` se capturaba por artículo). Identifica a qué aplica por familia y/o
/// artículo (ambos opcionales: una plantilla puede ser de toda una familia o de un artículo
/// concreto). Catálogo GLOBAL, borrado SUAVE, auditoría A7.
model PlantillaRuta {
  id     Int    @id @default(autoincrement())
  nombre String

  /// Familia a la que aplica (opcional). Restrict.
  idFamiliaArticulo Int?             @map("id_familia_articulo")
  familia           FamiliaArticulo? @relation(fields: [idFamiliaArticulo], references: [id], onDelete: Restrict)
  /// Artículo concreto al que aplica (opcional). Restrict.
  idArticuloRC      Int?             @map("id_articulo_rc")
  articulo          ArticuloRC?      @relation(fields: [idArticuloRC], references: [id], onDelete: Restrict)

  activo Boolean @default(true)

  /// Procesos de la plantilla (su tiempo estándar + posición). Cascade: al borrar la plantilla.
  procesos PlantillaRutaProceso[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idFamiliaArticulo])
  @@index([idArticuloRC])
  @@map("plantilla_ruta")
}

/// Renglón de una `PlantillaRuta`: un proceso del catálogo con su TIEMPO ESTÁNDAR (días) y su
/// posición (`orden`) dentro de la plantilla (ex `CP_Tiempos`). El encadenamiento PROPIO de la
/// plantilla se modela aparte en `PlantillaRutaDep` (un renglón puede tener antecesores distintos
/// a los del DAG genérico). Cascade desde la plantilla; Restrict hacia el `ProcesoDef`.
model PlantillaRutaProceso {
  id              Int           @id @default(autoincrement())
  idPlantillaRuta Int           @map("id_plantilla_ruta")
  plantilla       PlantillaRuta @relation(fields: [idPlantillaRuta], references: [id], onDelete: Cascade)
  idProcesoDef    Int           @map("id_proceso_def")
  procesoDef      ProcesoDef    @relation(fields: [idProcesoDef], references: [id], onDelete: Restrict)

  /// Tiempo estándar del proceso en esta plantilla, en días (ex `CP_Tiempos.Tiempo`).
  tiempoEstandar Int @map("tiempo_estandar")
  /// Posición del renglón dentro de la plantilla (lo gestiona el dominio).
  orden          Int @default(0)

  /// Dependencias en las que ESTE renglón es el sucesor (sus antecesores en la plantilla).
  antecesores PlantillaRutaDep[] @relation("PlantillaProcesoComoSucesor")
  /// Dependencias en las que ESTE renglón es el antecesor (sus sucesores en la plantilla).
  sucesores   PlantillaRutaDep[] @relation("PlantillaProcesoComoAntecesor")

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idPlantillaRuta, idProcesoDef])
  @@index([idProcesoDef])
  @@map("plantilla_ruta_proceso")
}

/// Arista del DAG de encadenamiento PROPIO de una plantilla: `idAntecesor` (renglón de la plantilla)
/// debe ocurrir antes que `idPlantillaRutaProceso` (otro renglón de la MISMA plantilla). Se valida
/// acíclico en el dominio (reusa `grafo.ts`). Ambos extremos Cascade desde sus renglones (al borrar
/// la plantilla caen sus renglones y con ellos sus aristas). Solo auditoría de creación.
model PlantillaRutaDep {
  idPlantillaRutaProceso Int                  @map("id_plantilla_ruta_proceso")
  proceso                PlantillaRutaProceso @relation("PlantillaProcesoComoSucesor", fields: [idPlantillaRutaProceso], references: [id], onDelete: Cascade)
  idAntecesor            Int                  @map("id_antecesor")
  antecesor              PlantillaRutaProceso @relation("PlantillaProcesoComoAntecesor", fields: [idAntecesor], references: [id], onDelete: Cascade)

  creadoEn    DateTime @default(now()) @map("creado_en")
  creadoPorId String?  @map("creado_por_id")

  @@id([idPlantillaRutaProceso, idAntecesor])
  @@index([idAntecesor])
  @@map("plantilla_ruta_dep")
}

/// Factor de duración POR CANTIDAD de piezas (ex `CP_Cant`, 11 rangos). El motor de E4 multiplica
/// el tiempo base por el `factor` del rango `[deCant, aCant]` en el que cae la cantidad de la orden.
/// Catálogo GLOBAL, borrado SUAVE, auditoría A7.
model FactorCantidad {
  id     Int     @id @default(autoincrement())
  /// Límite inferior del rango (inclusive) (ex `CP_Cant.DeCant`).
  deCant Int     @map("de_cant")
  /// Límite superior del rango (inclusive) (ex `CP_Cant.ACant`).
  aCant  Int     @map("a_cant")
  /// Factor multiplicador para ese rango (ex `CP_Cant.FactorCant`).
  factor Decimal @db.Decimal(10, 4)
  activo Boolean @default(true)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([deCant, aCant])
  @@map("factor_cantidad")
}

/// Duración (días de espera) POR TIPO DE TELA (ex `RC_TipoTelas`, 7). El `factorTela` se guarda
/// aunque el viejo NO lo aplicaba (decisión (b)): queda disponible para el motor de E4. Catálogo
/// GLOBAL, borrado SUAVE, auditoría A7.
model DuracionPorTipoTela {
  id         Int     @id @default(autoincrement())
  /// Nombre del tipo de tela (ex `RC_TipoTelas.TipoTela`). Único.
  nombre     String  @unique
  /// Días de espera que suma este tipo de tela (ex `RC_TipoTelas.Dias`).
  dias       Int
  /// Factor de la tela (ex `RC_TipoTelas.FactorTela`). Se conserva aunque el viejo no lo aplicara.
  factorTela Decimal @map("factor_tela") @db.Decimal(10, 4)
  activo     Boolean @default(true)

  /// Órdenes programadas con este tipo de tela (F5-E3). Restrict.
  ordenes Orden[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("duracion_tipo_tela")
}

/// Duración (días de espera) POR APLICACIÓN/estampado (ex `RC_Aplicaciones`, 9). El origen NO trae
/// factor (solo `Dias`): `factor` queda OPCIONAL (decisión (b)) para el motor de E4. Catálogo
/// GLOBAL, borrado SUAVE, auditoría A7.
model DuracionPorAplicacion {
  id     Int      @id @default(autoincrement())
  /// Nombre de la aplicación (ex `RC_Aplicaciones.TipoAplicacion`). Único.
  nombre String   @unique
  /// Clave corta de la aplicación (ex `RC_Aplicaciones.ClaveAplicacion`, p. ej. "A1").
  clave  String?
  /// Días de espera que suma esta aplicación (ex `RC_Aplicaciones.Dias`).
  dias   Int
  /// Factor (no existe en el origen; opcional para el motor de E4, decisión (b)).
  factor Decimal? @db.Decimal(10, 4)
  activo Boolean  @default(true)

  /// Órdenes programadas con esta aplicación (F5-E3). Restrict.
  ordenes Orden[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("duracion_aplicacion")
}

/// CALENDARIO LABORAL por empresa (decisión (a)): qué días de la semana son hábiles. Un registro
/// por empresa (1:1). Los 7 booleanos default L–V hábiles, sáb/dom no. Las funciones puras de
/// `díasHábiles` lo consultan junto con los `DiaFestivo`. Auditoría A7.
model CalendarioEmpresa {
  id        Int     @id @default(autoincrement())
  idEmpresa Int     @unique @map("id_empresa")
  empresa   Empresa @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)

  lunes     Boolean @default(true)
  martes    Boolean @default(true)
  miercoles Boolean @default(true)
  jueves    Boolean @default(true)
  viernes   Boolean @default(true)
  sabado    Boolean @default(false)
  domingo   Boolean @default(false)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("calendario_empresa")
}

/// DÍA FESTIVO (no laborable) de una empresa (decisión (a)). Fecha + descripción. El motor de E4 lo
/// salta al contar días hábiles. Único por empresa+fecha. Borrado SUAVE, auditoría A7.
model DiaFestivo {
  id          Int      @id @default(autoincrement())
  idEmpresa   Int      @map("id_empresa")
  empresa     Empresa  @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)
  fecha       DateTime @db.Date
  descripcion String
  activo      Boolean  @default(true)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idEmpresa, fecha])
  @@index([idEmpresa])
  @@map("dia_festivo")
}

// ─────────────────────────────────────────────────────────────────────────────
// RUTA CRÍTICA · F5-E3 — Ruta viva por orden (motor pt1: generación + duraciones)
// ─────────────────────────────────────────────────────────────────────────────

/// Estado de un proceso dentro de la RUTA VIVA de una orden (F5-E3). El SEMÁFORO de
/// cumplimiento (a tiempo / en riesgo / atrasado) es de E4 y NO se modela aquí: aquí solo el
/// avance simple del proceso. `pendiente` (sin capturar), `activo` (en curso), `completado`
/// (cumplido — su `fechaReal` ya se capturó o se auto-completó por duración 0).
enum EstadoProcesoRuta {
  pendiente
  activo
  completado

  @@map("estado_proceso_ruta")
}

/// CÓMO se capturó el cumplimiento de un proceso de la ruta viva (F5-E3). `manual` (un usuario
/// lo marcó), `evento` (lo auto-completó el sistema: un evento de dominio o la duración 0 al
/// generar). Nullable: queda en null mientras el proceso no se ha completado.
enum OrigenCaptura {
  manual
  evento

  @@map("origen_captura")
}

/// RENGLÓN de la RUTA VIVA de UNA orden (F5-E3): un proceso de la ruta de esa orden, con su
/// duración estimada, sus fechas (planeadas/reales) y su estado. Pensado para explotación
/// analítica (D11): una fila por proceso×orden. Se GENERA desde la plantilla aplicable
/// (`generarRutaOrden`); el snapshot de banderas (`critico`, `ultimoProceso`, `esResurtido`,
/// `condicionAplicabilidad`) congela cómo estaba el proceso AL GENERAR (la plantilla puede cambiar
/// luego sin alterar rutas ya generadas). Las dependencias propias de la orden viven en
/// `RutaOrdenDep` (editables sin tocar la plantilla, D10). Las fechas planeadas las calcula el CPM
/// de E4 (aquí quedan en null salvo los procesos de duración 0 auto-completados). Auditoría A7.
model RutaOrden {
  id           Int        @id @default(autoincrement())
  idOrden      Int        @map("id_orden")
  orden        Orden      @relation(fields: [idOrden], references: [id], onDelete: Restrict)
  idProcesoDef Int        @map("id_proceso_def")
  procesoDef   ProcesoDef @relation(fields: [idProcesoDef], references: [id], onDelete: Restrict)

  /// Posición del proceso en la ruta de la orden (lo gestiona el dominio al generar).
  secuencia Int @default(0)

  // ── Snapshot de las banderas del proceso AL GENERAR (no se re-leen del catálogo) ──
  /// ¿Era CRÍTICO al generar? (snapshot de `ProcesoDef.critico`).
  critico                Boolean                @default(false)
  /// ¿Era el ÚLTIMO proceso al generar? (snapshot de `ProcesoDef.ultimoProceso`).
  ultimoProceso          Boolean                @default(false) @map("ultimo_proceso")
  /// ¿Aplicaba en resurtido al generar? (snapshot de `ProcesoDef.esResurtido`).
  esResurtido            Boolean                @default(false) @map("es_resurtido")
  /// Condición de aplicabilidad al generar (snapshot de `ProcesoDef.condicionAplicabilidad`).
  condicionAplicabilidad CondicionAplicabilidad @default(ninguna) @map("condicion_aplicabilidad")

  /// Duración estimada del proceso en DÍAS (la calcula `calcularDuracion` al generar, F5-E3).
  duracionDias  Int  @map("duracion_dias")
  /// Días acumulados hasta este proceso (lo llena el CPM de E4; null en E3).
  acumuladoDias Int? @map("acumulado_dias")

  /// Fecha planeada ORIGINAL (primer cálculo del CPM, E4). Null en E3 (pendiente de cálculo).
  fechaPlaneadaOriginal DateTime? @map("fecha_planeada_original")
  /// Fecha planeada VIGENTE (se recalcula al ajustar la ruta, E4). Null en E3.
  fechaPlaneadaVigente  DateTime? @map("fecha_planeada_vigente")
  /// Fecha REAL de cumplimiento del proceso (capturada o auto-completada por duración 0).
  fechaReal             DateTime? @map("fecha_real")

  /// Estado del proceso en la ruta (avance simple; el semáforo es E4).
  estado EstadoProcesoRuta @default(pendiente)

  /// ¿Hay una entrada PARCIAL en curso para este proceso? (F5-E6, decisión (d)). El auto-avance la
  /// enciende cuando un evento (recibo de maquila, recepción de tela, entrega…) cubre SOLO una parte
  /// de la cantidad pedida color×talla, y la apaga cuando se completa (proceso `completado`) o se
  /// des-completa por una cancelación (decisión (f)). Es una MARCA visible "parcial en curso"; el
  /// proceso solo se marca `completado` cuando llega la cantidad COMPLETA.
  parcialEnCurso Boolean @default(false) @map("parcial_en_curso")

  /// Quién capturó el cumplimiento (null mientras no se complete).
  capturadoPorId String?        @map("capturado_por_id")
  /// Cuándo se capturó el cumplimiento (null mientras no se complete).
  capturadoEn    DateTime?      @map("capturado_en")
  /// Cómo se capturó (manual / evento del sistema). Null mientras no se complete.
  origenCaptura  OrigenCaptura? @map("origen_captura")

  /// Dependencias de la ruta de ESTA orden en las que este renglón es el sucesor (sus antecesores).
  antecesores RutaOrdenDep[]       @relation("RutaProcesoComoSucesor")
  /// Dependencias de la ruta de ESTA orden en las que este renglón es el antecesor (sus sucesores).
  sucesores   RutaOrdenDep[]       @relation("RutaProcesoComoAntecesor")
  /// Ítems de checklist (snapshot del proceso al generar) de este renglón.
  checklist   RutaOrdenChecklist[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idOrden, idProcesoDef])
  @@index([idOrden])
  @@index([idProcesoDef])
  @@map("ruta_orden")
}

/// Arista del DAG de dependencias de la RUTA VIVA de UNA orden (F5-E3): `idAntecesor` debe ocurrir
/// antes que `idRutaOrden`, AMBOS renglones de la MISMA orden. Es un SNAPSHOT editable sin tocar la
/// plantilla (D10: `ajustarRutaOrden` cambia estas aristas, no `PlantillaRutaDep`). Se valida
/// acíclico en el dominio (reusa `grafo.ts`). Ambos extremos Cascade desde sus renglones.
model RutaOrdenDep {
  idRutaOrden Int       @map("id_ruta_orden")
  rutaOrden   RutaOrden @relation("RutaProcesoComoSucesor", fields: [idRutaOrden], references: [id], onDelete: Cascade)
  idAntecesor Int       @map("id_antecesor")
  antecesor   RutaOrden @relation("RutaProcesoComoAntecesor", fields: [idAntecesor], references: [id], onDelete: Cascade)

  creadoEn    DateTime @default(now()) @map("creado_en")
  creadoPorId String?  @map("creado_por_id")

  @@id([idRutaOrden, idAntecesor])
  @@index([idAntecesor])
  @@map("ruta_orden_dep")
}

/// Ítem de CHECKLIST de un proceso de la ruta viva de una orden (F5-E3). Snapshot de
/// `ProcesoChecklist` al generar la ruta; se marca `hecho` por orden (no toca el catálogo).
/// Cascade desde su renglón de ruta. Auditoría A7.
model RutaOrdenChecklist {
  id          Int       @id @default(autoincrement())
  idRutaOrden Int       @map("id_ruta_orden")
  rutaOrden   RutaOrden @relation(fields: [idRutaOrden], references: [id], onDelete: Cascade)
  descripcion String
  /// Posición del ítem dentro del checklist (snapshot del orden del catálogo).
  orden       Int       @default(0)
  /// ¿Ya se verificó este punto en esta orden?
  hecho       Boolean   @default(false)
  /// Cuándo se marcó como hecho (null si no se ha hecho).
  fechaHecho  DateTime? @map("fecha_hecho")
  /// Quién lo marcó (null si no se ha hecho).
  hechoPorId  String?   @map("hecho_por_id")

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idRutaOrden])
  @@map("ruta_orden_checklist")
}

// ═════════════════════════════════════════════════════════════════════════════
// CALIDAD (F6-E1) — Control de calidad: catálogo de defectos enriquecido + tipos de
// producto + motor de planes de muestreo AQL como DATOS (no código). doc funcional
// `09-Control-de-Calidad.md` §2/§5; MEJORAS 09; DECISIONES.md §F6 (a)–(d). El núcleo
// transaccional de auditorías llega en F6-E2 (este E1 es solo la base configurable).
// ═════════════════════════════════════════════════════════════════════════════

/// Severidad del defecto (doc 09 §5.4: categorías/severidad para el catálogo). Es METADATO
/// INFORMATIVO (categorización + KPIs de F7): NO entra en ningún veredicto de auditoría
/// (decisión (a) — el resultado lo decide el auditor a mano en E2). Por eso vive como enum
/// libre, sin pesos ni números de aceptación.
enum SeveridadDefecto {
  critico
  mayor
  menor

  @@map("severidad_defecto")
}

/// Tipo de producto (F6-E1, decisión (d) — DECISIONES.md §F6). Catálogo CORTO y editable que
/// clasifica los modelos (playera, pantalón, sudadera…) para FILTRAR qué defectos aplican a una
/// auditoría (NO para el plan AQL: hay un solo plan para todos, decisión (c)). El tipo se hereda
/// del modelo (`Modelo.tipoProductoId`) y en el alta de auditoría se puede sobre-escribir (E2).
/// GLOBAL como los catálogos de F1 (sin idEmpresa); borrado suave + auditoría A7.
model TipoProducto {
  id     Int     @id @default(autoincrement())
  /// Nombre del tipo (único global, insensible a mayúsculas lo valida el dominio).
  nombre String  @unique
  activo Boolean @default(true)

  /// Modelos clasificados con este tipo (F1, Restrict: un tipo en uso por un modelo no se borra
  /// físico → se desactiva).
  modelos         Modelo[]
  /// Defectos etiquetados con este tipo (M:N por `DefectoTipoProducto`). Cascade desde el puente.
  defectosLigados DefectoTipoProducto[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("tipos_producto")
}

/// Defecto del catálogo de calidad (F6-E1 — ex `CC_Catalogo`, doc 09 §2). `nivelAQL` numérico
/// (1.0 / 2.5 / 10 — el AQL al que pertenece el defecto, doc 09 §2: la columna AQL del viejo trae
/// '1'/'2.5'/'10' limpios). `favorito` = se pre-carga en toda auditoría nueva (ex `Favorito`,
/// E2). `severidad` es METADATO (no veredicto, decisión (a)). `aplicaGeneral=true` → el defecto
/// aplica a TODOS los tipos de producto sin importar las ligas de `DefectoTipoProducto` (decisión
/// (d)). GLOBAL (sin idEmpresa — catálogo maestro como F1); borrado suave (un defecto con
/// auditorías históricas NO se borra físico, solo se inactiva); auditoría A7.
model DefectoCatalogo {
  id            Int              @id @default(autoincrement())
  /// Clave de negocio del defecto (ex `CC_Catalogo.Clave`). Única global.
  clave         String           @unique
  descripcion   String
  /// Página/referencia del manual de calidad donde se ilustra (ex `Pag`). Opcional.
  pag           String?
  /// Nivel AQL al que pertenece el defecto (1.0 / 2.5 / 10). Numérico para agrupar por nivel en E2.
  nivelAQL      Decimal          @map("nivel_aql") @db.Decimal(4, 2)
  /// Se pre-carga en toda auditoría nueva (ex `CC_Catalogo.Favorito` — hoy 33 favoritos).
  favorito      Boolean          @default(false)
  /// Categoría libre para agrupar defectos (doc 09 §5.4). Opcional.
  categoria     String?
  /// Severidad informativa (NO entra en el veredicto, decisión (a)).
  severidad     SeveridadDefecto @default(menor)
  /// ¿Aplica a TODOS los tipos de producto? (decisión (d)). Si es `true`, las ligas de
  /// `DefectoTipoProducto` se ignoran (el defecto es universal).
  aplicaGeneral Boolean          @default(false) @map("aplica_general")
  activo        Boolean          @default(true)

  /// Tipos de producto a los que aplica este defecto (M:N por `DefectoTipoProducto`). Cuando
  /// `aplicaGeneral=true` estas ligas no importan (aplica a todos).
  tiposLigados      DefectoTipoProducto[]
  /// Renglones de auditoría que cuentan fallas de este defecto (F6-E2). Restrict (en uso ⇒ se desactiva).
  auditoriaDefectos AuditoriaDefecto[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("defectos_catalogo")
}

/// Puente M:N defecto ↔ tipo de producto (F6-E1, decisión (d)). Un defecto aplica a los tipos
/// ligados aquí (salvo que `DefectoCatalogo.aplicaGeneral=true`, que lo hace universal). PK
/// compuesta: una liga única por par. Cascade desde ambos extremos (reescribir las ligas de un
/// defecto en la tx; quitar un tipo arrastra sus ligas).
model DefectoTipoProducto {
  idDefecto      Int @map("id_defecto")
  idTipoProducto Int @map("id_tipo_producto")

  defecto      DefectoCatalogo @relation(fields: [idDefecto], references: [id], onDelete: Cascade)
  tipoProducto TipoProducto    @relation(fields: [idTipoProducto], references: [id], onDelete: Cascade)

  @@id([idDefecto, idTipoProducto])
  @@index([idTipoProducto])
  @@map("defecto_tipo_producto")
}

/// Plan de muestreo AQL (F6-E1 — doc 09 §5.2; ISO 2859 nivel general II, AQL 1.0/2.5/10). Es la
/// tabla de muestreo COMO DATOS (no motor estadístico — "no sobre-diseñar"). Decisión (c): hay UN
/// solo plan default activo para todos (sin asignación por cliente ni tipo de producto). El plan
/// sirve para la MUESTRA (decisión (b)); el límite acepta/rechaza queda como referencia (el
/// veredicto lo decide el auditor a mano en E2, decisión (a)). GLOBAL; auditoría A7.
model PlanMuestreoAQL {
  id     Int     @id @default(autoincrement())
  /// Nombre del plan (único global). Ej. "ISO 2859 — Nivel general II".
  nombre String  @unique
  /// Solo un plan default es el activo que el resolver usa (decisión (c)). Borrado suave.
  activo Boolean @default(true)

  /// Renglones por rango de tamaño de lote (Cascade: reescribir el plan en la tx A2).
  renglones PlanMuestreoRenglon[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("planes_muestreo_aql")
}

/// Renglón del plan AQL por RANGO de tamaño de lote → tamaño de muestra (F6-E1, doc 09 §5.2). El
/// resolver elige el renglón cuyo [loteMin, loteMax] contiene el tamaño del lote y devuelve
/// `tamanoMuestra` (decisión (b): la muestra es lo vinculante). `loteMax` null = "en adelante"
/// (último rango abierto). Cascade desde el plan.
model PlanMuestreoRenglon {
  id            Int             @id @default(autoincrement())
  idPlan        Int             @map("id_plan")
  plan          PlanMuestreoAQL @relation(fields: [idPlan], references: [id], onDelete: Cascade)
  /// Tamaño de lote mínimo del rango (inclusivo).
  loteMin       Int             @map("lote_min")
  /// Tamaño de lote máximo del rango (inclusivo); null = sin tope (último rango abierto).
  loteMax       Int?            @map("lote_max")
  /// Tamaño de muestra para este rango (cuántas piezas se inspeccionan).
  tamanoMuestra Int             @map("tamano_muestra")

  /// Límites acepta/rechaza por nivel AQL de este renglón (Cascade).
  limites PlanMuestreoLimite[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idPlan])
  @@map("plan_muestreo_renglon")
}

/// Límite acepta/rechaza de un renglón del plan POR NIVEL AQL (F6-E1, doc 09 §2: en ISO 2859 cada
/// nivel AQL tiene su PROPIO número de aceptación/rechazo). El resolver, dado (lote, nivel),
/// localiza el renglón por lote y este límite por `nivelAQL`. `aceptar` = máximo de defectos para
/// APROBAR; `rechazar` = mínimo para RECHAZAR (normalmente aceptar+1). Es REFERENCIA (el veredicto
/// es manual en E2, decisión (a)). Un nivel único por renglón.
model PlanMuestreoLimite {
  id        Int                 @id @default(autoincrement())
  idRenglon Int                 @map("id_renglon")
  renglon   PlanMuestreoRenglon @relation(fields: [idRenglon], references: [id], onDelete: Cascade)
  /// Nivel AQL al que aplica el límite (1.0 / 2.5 / 10).
  nivelAQL  Decimal             @map("nivel_aql") @db.Decimal(4, 2)
  /// Número de aceptación (Ac): hasta este número de defectos, se ACEPTA.
  aceptar   Int
  /// Número de rechazo (Re): a partir de este número de defectos, se RECHAZA.
  rechazar  Int

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idRenglon, nivelAQL])
  @@map("plan_muestreo_limite")
}

// ═════════════════════════════════════════════════════════════════════════════
// AUDITORÍAS DE CALIDAD (F6-E2) — núcleo transaccional del Control de calidad. doc
// funcional `09-Control-de-Calidad.md` §1/§2/§4; DECISIONES.md §F6 (a)/(b). Una
// auditoría inspecciona una MUESTRA de prendas de una orden (recibidas de un
// maquilero), cuenta las fallas por defecto y deja un RESULTADO que el auditor
// decide A MANO (decisión (a) — el cálculo por nivel AQL es solo sugerencia
// informativa, NO vinculante; la severidad del defecto NO entra en el veredicto).
// ═════════════════════════════════════════════════════════════════════════════

/// Resultado de una auditoría de calidad (doc 09 §2). Lo decide el auditor A MANO
/// (decisión (a)); el cálculo por nivel AQL del plan es solo SUGERENCIA. `no_calificado`
/// es el estado inicial (capturada sin veredicto). Una auditoría FINAL `aprobado`
/// auto-completa el proceso de RC "auditoría" de la orden (F5/F6 integración).
enum ResultadoAuditoria {
  aprobado
  reprobado
  no_calificado

  @@map("resultado_auditoria")
}

/// Tipo de auditoría (doc 09 §1: en piso durante la producción, o final al recibir).
/// `no_definida` para los casos viejos/sin clasificar. Solo una auditoría `final`
/// `aprobado` gatilla el auto-avance de la RC (la de piso es un control intermedio).
enum TipoAuditoria {
  en_piso
  final
  no_definida

  @@map("tipo_auditoria")
}

/// Auditoría de calidad de una orden (F6-E2 — ex `CC_Auditorias`, doc 09 §2). Folio
/// `numAuditoria` por SECUENCIA ATÓMICA por empresa (A3 — reemplaza el `Max()+1` del
/// viejo `AumentarNumAudit`). `idMaquilero` es el `Proveedor` con rol de maquila al que
/// se le audita la prenda (NO existe tabla Maquilero — fusión de terceros D12/R15); se
/// PROPONE desde las entregas reales de la orden y se puede ELEGIR. Doble responsable:
/// `elaboroPorId` (quien la dio de alta) + `auditorPorId` (quien la auditó) — referencias
/// de usuario SIN FK físico, mismo criterio que la Bitácora (ADR-0005). `tamanoMuestra`
/// se propone del plan AQL default según la cantidad de la orden (decisión (b), vinculante)
/// y solo se cambia a mano con permiso (`muestraManual`). `resultado` se persiste MANUAL
/// (decisión (a)). Cancelación = borrado SUAVE (la auditoría nunca se borra; A7). A9.
model Auditoria {
  id           Int        @id @default(autoincrement())
  /// Folio consecutivo POR EMPRESA (A3 — secuencia "auditoria"; viejo: `CC_Auditorias.NumAudit`).
  numAuditoria BigInt     @map("num_auditoria")
  /// Empresa dueña de la auditoría y de su numeración (A9).
  idEmpresa    Int        @map("id_empresa")
  empresa      Empresa    @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)
  /// Orden auditada (doc 09 §2 — `CC_Auditorias.IdOrdenes`). Restrict.
  idOrden      Int        @map("id_orden")
  orden        Orden      @relation(fields: [idOrden], references: [id], onDelete: Restrict)
  /// Maquilero auditado (Proveedor con rol maquila; D12/R15). Propuesto de las entregas
  /// reales de la orden. Nullable (puede no haberse asignado). Restrict.
  idMaquilero  Int?       @map("id_maquilero")
  maquilero    Proveedor? @relation(fields: [idMaquilero], references: [id], onDelete: Restrict)

  /// Fecha en que se ELABORÓ la auditoría (alta). `@db.Date`.
  fechaElaboracion DateTime @map("fecha_elaboracion") @db.Date
  /// Fecha en que se AUDITÓ físicamente la prenda. `@db.Date`. Es la fecha que se escribe
  /// como `fechaReal` del proceso de RC si la auditoría final aprobada lo auto-completa.
  fechaAuditoria   DateTime @map("fecha_auditoria") @db.Date

  /// Quién dio de alta la auditoría (usuario de sesión). Sin FK físico (ADR-0005).
  elaboroPorId String? @map("elaboro_por_id")
  /// Quién auditó (responsable de calidad). Sin FK físico (ADR-0005).
  auditorPorId String? @map("auditor_por_id")

  /// Tamaño de muestra inspeccionado. Se PROPONE del plan AQL default por la cantidad de la
  /// orden (decisión (b)); cambiarlo a mano exige permiso y enciende `muestraManual`.
  tamanoMuestra Int     @map("tamano_muestra")
  /// `true` si el `tamanoMuestra` se sobre-escribió a mano (decisión (b) — gate por permiso).
  muestraManual Boolean @default(false) @map("muestra_manual")

  /// Veredicto MANUAL del auditor (decisión (a)). `no_calificado` mientras no se captura.
  resultado       ResultadoAuditoria @default(no_calificado)
  /// Siempre `true` en v2: el resultado lo decide el humano (la sugerencia AQL NO es vinculante).
  /// Se conserva como bandera para el ETL del histórico y para KPIs de F7.
  resultadoManual Boolean            @default(true) @map("resultado_manual")
  /// Tipo de auditoría (en piso / final / no definida). Solo `final` + `aprobado` gatilla la RC.
  tipoAuditoria   TipoAuditoria      @default(no_definida) @map("tipo_auditoria")

  /// Observaciones del auditor (justifica el veredicto manual). Nullable.
  observaciones String? @db.Text

  /// Cancelación SUAVE (borrado lógico, A7): la auditoría nunca se borra ni se edita destructivo.
  /// La MODIFICACIÓN/cancelación es F6-E3; aquí solo el esquema. NULL = viva.
  cancelada         Boolean   @default(false)
  canceladaEn       DateTime? @map("cancelada_en")
  /// Usuario que canceló (sin FK físico, ADR-0005).
  canceladaPorId    String?   @map("cancelada_por_id")
  motivoCancelacion String?   @map("motivo_cancelacion") @db.Text

  /// Renglones defecto → nº de fallas (todos los favoritos se pre-cargan al alta). Cascade.
  defectos AuditoriaDefecto[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idEmpresa, numAuditoria])
  @@index([idEmpresa])
  @@index([idOrden])
  @@index([idMaquilero])
  @@map("auditorias")
}

/// Renglón defecto → nº de fallas de una auditoría (F6-E2 — ex `CC_AuditoriasDet`, doc 09 §2).
/// Al dar de alta una auditoría se PRE-CARGAN todos los defectos favoritos activos con
/// `numFallas = 0` (ex `InsertarFav`); el auditor captura cuántas fallas vio de cada uno. Un
/// defecto aparece UNA vez por auditoría (@@unique). El nivel AQL para la sugerencia se lee del
/// `DefectoCatalogo` (NO se snapshotea). Cascade desde la auditoría; Restrict hacia el defecto
/// (un defecto con auditorías históricas no se borra físico — se desactiva).
model AuditoriaDefecto {
  id          Int             @id @default(autoincrement())
  idAuditoria Int             @map("id_auditoria")
  auditoria   Auditoria       @relation(fields: [idAuditoria], references: [id], onDelete: Cascade)
  idDefecto   Int             @map("id_defecto")
  defecto     DefectoCatalogo @relation(fields: [idDefecto], references: [id], onDelete: Restrict)

  /// Número de prendas con este defecto en la muestra. Entero ≥ 0.
  numFallas Int @default(0) @map("num_fallas")

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idAuditoria, idDefecto])
  @@index([idDefecto])
  @@map("auditoria_defecto")
}

// ─────────────────────────────────────────────────────────────────────────────
// COSTOS (Módulo 6, F7-E1) — costo REAL por orden (doc 06-Costos-y-EDR §3; D1/D2).
// El PRE-COSTO por modelo NO es tabla: es cálculo de dominio sobre la receta
// (receta paraPreCosto × precios de catálogo + maquila — verificado: `PreCostos`
// no era tabla en el viejo). El EDR (F7-E2) referenciará `CostoOrden`. Auditoría
// A7 + Bitácora (módulo financiero). Valuación a costo ACTUAL (D1): sin CostoViejo.
// ─────────────────────────────────────────────────────────────────────────────

/// Base de prorrateo del costo unitario de la orden (D2): sobre qué cantidad se
/// divide el `costoTotal` para obtener el costo por prenda. `cortado` (DEFAULT,
/// confirmado por Daniel: tela ÷ prendas cortadas = `CantCorte` del viejo);
/// `recibido` = piezas recibidas de costura (prenda terminada, `generaEntradaPt`);
/// `vendido` = piezas entregadas a cliente. Las tres se DERIVAN por suma directa de
/// `EtapaMovimientoDet` (nunca un acumulador — D3/D4).
enum BaseProrrateo {
  cortado
  recibido
  vendido

  @@map("base_prorrateo")
}

/// Costo REAL por orden (F7-E1 — ex `CostoOrd`, doc 06-Costos-y-EDR §3). 1:1 con la
/// orden (`idOrden` @unique). Componentes en DOBLE juego (doc 06 §3):
///  • `*Calc` = TEÓRICOS, snapshot de la receta × precios vigentes al momento de
///    guardar (se recalculan en vivo para comparar, pero también se congelan aquí);
///  • `*Cost` = los GUARDADOS (el usuario confirma o AJUSTA los teóricos).
/// `costoTotal` se ARMA con los guardados: `telaCost + procesosCost + aviosCost +
/// otros` (doc 06 §3). La REGALÍA NO es componente del costo (D2, 2026-07-02): va
/// sobre la VENTA (lista de precios) — por eso NO hay `regaliasCalc/regaliasCost`.
/// `procesos` = maquila + estampado + otros procesos; `avios` = habilitación de
/// costura + empaque. `otros`/`descOtros` dan flexibilidad. Todo NULLABLE (un
/// componente sin capturar cuenta como 0 en el total — patrón ceronulo). Valuación
/// a costo ACTUAL (D1). Auditoría A7. Cascade hacia `Orden`; Restrict hacia `Empresa`.
model CostoOrden {
  id        Int     @id @default(autoincrement())
  idOrden   Int     @unique @map("id_orden")
  orden     Orden   @relation(fields: [idOrden], references: [id], onDelete: Cascade)
  /// Empresa dueña (A9). Se persiste para acotar las consultas/reportes por empresa activa.
  idEmpresa Int     @map("id_empresa")
  empresa   Empresa @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)

  /// Tela — teórico (receta paraCosto × precio × base) y GUARDADO (ex `TelaCost`).
  telaCalc     Decimal? @map("tela_calc") @db.Decimal(14, 2)
  telaCost     Decimal? @map("tela_cost") @db.Decimal(14, 2)
  /// Procesos: maquila + estampado + otros procesos — teórico y GUARDADO (ex `MaquilaCost`+`BordCost`).
  procesosCalc Decimal? @map("procesos_calc") @db.Decimal(14, 2)
  procesosCost Decimal? @map("procesos_cost") @db.Decimal(14, 2)
  /// Avíos: habilitación de costura + empaque — teórico y GUARDADO (ex `HabCost`).
  aviosCalc    Decimal? @map("avios_calc") @db.Decimal(14, 2)
  aviosCost    Decimal? @map("avios_cost") @db.Decimal(14, 2)
  /// Otros costos + su descripción (ex `CostoOrd.Otros`/`DescOtros`), para flexibilidad.
  otros        Decimal? @db.Decimal(14, 2)
  descOtros    String?  @map("desc_otros")

  /// Costo TOTAL de la orden = Σ de los GUARDADOS (doc 06 §3). Lo ARMA el dominio al
  /// guardar (nunca se edita a mano ni suma los teóricos). NULLABLE hasta el primer guardado.
  costoTotal   Decimal? @map("costo_total") @db.Decimal(14, 2)

  /// Base de prorrateo del costo unitario (D2). Default `cortado` (= `CantCorte`).
  baseProrrateo BaseProrrateo @default(cortado) @map("base_prorrateo")

  observaciones String? @db.Text

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idEmpresa])
  @@map("costo_orden")
}
