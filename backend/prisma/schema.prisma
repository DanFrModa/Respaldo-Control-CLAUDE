// CONTROL v2 — esquema de la fundación (F0) + catálogos sencillos (F1-E1).
// Dominios: empresas y configuración, usuarios/RBAC (A4) + tablas de better-auth,
// almacenes, secuencias de folios (A3), bitácora (A7), archivos R2 (A5/R6) y
// catálogos maestros globales (F1: Proveedor, Cortador, Temporada, EtiquetaMarca,
// Color — GLOBALES sin idEmpresa por ADR-0007/A9).
//
// Convenciones (plan maestro §4 y §8):
//  • Modelos y campos de dominio en español, sin acentos ni eñes.
//  • Tablas y columnas en BD en snake_case español vía @map/@@map.
//  • FKs reales con integridad referencial (A2); onDelete Restrict en dominio
//    (el borrado es suave: banderas `activo`), Cascade solo en tablas de sesión/auth.
//  • Auditoría uniforme en entidades de dominio: creadoEn/creadoPorId +
//    modificadoEn/modificadoPorId (A7). Los campos *PorId referencian usuarios SIN
//    constraint físico a propósito: los usuarios jamás se borran (solo se desactivan)
//    y un FK formal exigiría decenas de relaciones inversas en Usuario sin valor de
//    consulta. La Bitacora complementa con el historial de cambios.
//  • En las tablas exclusivas de better-auth (Sesion, Cuenta, Verificacion) los CAMPOS
//    conservan el nombre que better-auth espera (token, expiresAt, userId…) para que el
//    adapter del frontend (E3) no necesite field-mapping; las COLUMNAS sí van en español.
//
// Prisma 7: generator `prisma-client` (no `prisma-client-js`). El cliente se emite a
// `src/datos/generated/prisma` (gitignoreado; se regenera con `prisma generate`).
// `moduleFormat = esm` + `importFileExtension = js` para que el código generado use
// imports con extensión `.js`, compatibles con la resolución NodeNext del backend.
// El datasource NO lleva `url`: la conexión va por `@prisma/adapter-pg` (ver src/datos).

generator client {
  provider            = "prisma-client"
  output              = "../src/datos/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Empresas y configuración
// ─────────────────────────────────────────────────────────────────────────────

/// Empresa del grupo (multi-empresa explícito, A9). Equivale a la tabla `Empresas`
/// del sistema viejo (doc 10 §5): `favorita` reemplaza a `Importancia = 1`,
/// `paraIpt`/`paraEdr` conservan en qué procesos participa la empresa.
model Empresa {
  id            Int     @id @default(autoincrement())
  /// Nombre corto de uso diario (viejo: `Empresas.Empresa`). Único para evitar duplicados de captura.
  nombre        String  @unique
  razonSocial   String? @map("razon_social")
  /// RFC fiscal de la empresa. Se usa para validar que el RECEPTOR de un CFDI de proveedor importado
  /// sea esta empresa (F9-E3, A9) y como EMISOR en los CFDI de ventas (F9-E4). Validado en Zod si
  /// viene (forma del RFC mexicano). NULL si no se ha capturado (la validación del receptor entonces
  /// solo AVISA, no rechaza).
  rfc           String?
  /// Identificador corto usado en folios e impresos (viejo: `Identificador`).
  identificador String?
  /// Empresa propuesta por defecto al iniciar sesión (viejo: `Importancia = 1`).
  favorita      Boolean @default(false)
  /// Participa en el inventario de producto terminado (viejo: `ParaIPT`).
  paraIpt       Boolean @map("para_ipt")
  /// Participa en el estado de resultados (viejo: `ParaEdoRes`).
  paraEdr       Boolean @map("para_edr")
  /// Borrado suave (plan §4: patrón conservado del sistema viejo): las empresas no se eliminan, se desactivan.
  activa        Boolean @default(true)

  /// LOGO de la empresa (post-F9, petición de Daniel 25-jul-2026): un solo archivo en R2 que
  /// brandea TODO — los 23 impresos PDF (vía `EncabezadoDocumento`) y la app (riel + login).
  /// Cambiarlo aquí actualiza todo sin desplegar. NULL = se usa el logo empaquetado en el repo.
  /// Mismo patrón que `ModeloFoto.archivo`: @unique (un archivo es el logo de UNA empresa) y
  /// SetNull al borrar el `Archivo` (quitar el logo = borrar su archivo, sin dejar huérfano).
  idArchivoLogo String?  @unique @map("id_archivo_logo")
  archivoLogo   Archivo? @relation(fields: [idArchivoLogo], references: [id], onDelete: SetNull)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  configuracion          ConfiguracionEmpresa?
  almacenes              Almacen[]
  secuencias             Secuencia[]
  /// Pedidos internos de esta empresa (F2-E1, A9 — folio por empresa). Restrict.
  pedidos                Pedido[]
  /// Órdenes de producción de esta empresa (F2-E2, A9 — folio por empresa). Restrict.
  ordenes                Orden[]
  /// Etapas de producción (corte/envío/recibo/entrega) de esta empresa (F3-E1, A9). Restrict.
  etapasMovimiento       EtapaMovimiento[]
  /// Movimientos de kardex de esta empresa (F3-E1, A9 — folio por empresa). Restrict.
  movimientos            Movimiento[]
  /// Partidas de tela (entradas del inventario nuevo por color, A2 §Post-F9.11; folio por empresa). Restrict.
  partidasTela           PartidaTela[]
  /// Documentos de ENTRADA de tela por factura/remisión SIN orden de compra (B1; folio por empresa). Restrict.
  entradasTela           EntradaTela[]
  /// Cargos a maquileros (EsMa) de esta empresa (F3-E1, A9). Restrict.
  cargosEsMa             EsMaCargo[]
  /// Abonos a la cuenta de maquileros de esta empresa (EsMa, F6-E4, A9). Restrict.
  abonosMaquilero        AbonoMaquilero[]
  /// Descuentos a la cuenta de maquileros de esta empresa (EsMa, F6-E4, A9). Restrict.
  descuentosMaquilero    DescuentoMaquilero[]
  /// Pagos a maquileros de esta empresa (EsMa, F6-E4, A9). Restrict.
  pagosMaquilero         PagoMaquilero[]
  /// Órdenes de compra de esta empresa (F4-E2, A9 — folio por empresa). Restrict.
  ordenesCompra          OrdenCompra[]
  /// Recepciones de compra de esta empresa (F4-E3, A9 — folio por empresa). Restrict.
  recepcionesCompra      RecepcionCompra[]
  /// Eventos de dominio (outbox) de esta empresa (F4-E3, patrón outbox/pg-boss). Restrict.
  eventosOutbox          EventoOutbox[]
  /// Notas de salida de materiales a maquileros de esta empresa (F4-E5, A9 — folio por empresa). Restrict.
  notasSalida            NotaSalida[]
  /// Calendario laboral de la RC de esta empresa (F5-E2, 1:1). Restrict.
  calendario             CalendarioEmpresa?
  /// Días festivos de la RC de esta empresa (F5-E2). Restrict.
  diasFestivos           DiaFestivo[]
  /// Auditorías de calidad de esta empresa (F6-E2, A9 — folio por empresa). Restrict.
  auditorias             Auditoria[]
  /// Costos reales de órdenes de esta empresa (F7-E1, A9). Restrict.
  costosOrden            CostoOrden[]
  /// Renglones del Estado de Resultados (EDR) de esta empresa (F7-E2, D2 #6). El EDR es GLOBAL
  /// (encabezado por mes, sin empresa); solo las líneas se sellan por empresa para el corte. Restrict.
  edrLineas              EdrLinea[]
  /// Registros de productividad (IP/almacén) de esta empresa (F7-E4, A9). Restrict.
  registrosProductividad RegistroProductividad[]
  /// Verificaciones de confiabilidad de fichas técnicas por orden de esta empresa (F7-E4, A9). Restrict.
  fichasVerificacion     FichaVerificacion[]
  /// Muestrarios pendientes de esta empresa (F7-E4, A9). Restrict.
  muestrarios            Muestrario[]
  /// Inventarios cíclicos de esta empresa (F7-E5, A9). Restrict.
  inventariosCiclicos    InventarioCiclico[]
  /// Proyectos de desarrollo de esta empresa (F8-E1/E2, A9 — folio por empresa). Restrict.
  proyectos              Proyecto[]
  /// Listas de precios por cliente de esta empresa (F8-E1/E4, A9 — folio por empresa). Restrict.
  listasPrecios          ListaPrecios[]
  /// Cotizaciones emitidas por esta empresa (V1-E7c, A9 — folio por empresa). Restrict.
  cotizaciones           Cotizacion[]
  /// Movimientos de cuenta corriente de terceros (CxC/CxP, F9-E1, A9 — folio por empresa). Restrict.
  movimientosTerceros    MovimientoTercero[]
  /// Hitos de orden capturados en esta empresa (post-F9, A9). Restrict.
  hitosOrden             HitoOrden[]

  /// Archivo histórico de órdenes del sistema viejo (§Post-F9.26, solo consulta).
  historicoOrdenesV1 HistoricoOrdenV1[]

  @@map("empresas")
}

/// Configuración POR EMPRESA (plan §4): sustituye a la tabla `Propiedades` del sistema
/// viejo (un solo registro global, doc 10 §5). Los parámetros que eran globales pasan a
/// ser parametrizables por empresa. `VersionDisponible` y `Mantenimiento` no se migran:
/// el deploy web (A10) y el modo mantenimiento se resuelven en infraestructura.
model ConfiguracionEmpresa {
  id        Int     @id @default(autoincrement())
  idEmpresa Int     @unique @map("id_empresa")
  empresa   Empresa @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)

  /// Utilidad sugerida para costeo (viejo: `UtilidadSujerida`).
  utilidadSugerida   Decimal? @map("utilidad_sugerida") @db.Decimal(10, 4)
  /// Porcentaje base de regalías (viejo: `Regalias`).
  regaliasBase       Decimal? @map("regalias_base") @db.Decimal(10, 4)
  /// Días de colchón que la Ruta Crítica agrega a la costura (viejo: `ColchonCostura`).
  colchonCostura     Int?     @map("colchon_costura")
  /// Jornada base (horas/día) del ALMACÉN para el índice de productividad (F7-E4; viejo:
  /// constante `HorasBaseAlm = 9`, doc 05 §B.1). Antes era una constante hardcodeada en la
  /// consulta `Ind_Alm_Productividad`; en v2 es parámetro por empresa. Default 9 (el valor
  /// histórico); el backfill de la migración lo fija en las filas ya sembradas.
  jornadaBaseAlmacen Int      @default(9) @map("jornada_base_almacen")

  /// Fin de la primera cubeta de antigüedad de saldos (aging, F9-E5/D15d): días de atraso ≤ este
  /// valor caen en "1–N". Antes era la constante 30 (`LIMITES_AGING_*`); en v2 es parámetro por
  /// empresa. Default 30 (el valor histórico); el `ADD COLUMN … DEFAULT` rellena las filas ya
  /// sembradas. CxP y CxC (bandejas) leen los límites de aquí; `agingLimite1 < agingLimite2`.
  agingLimite1 Int @default(30) @map("aging_limite1")
  /// Fin de la segunda cubeta de antigüedad de saldos (aging, F9-E5/D15d): días de atraso ≤ este
  /// valor caen en "1er límite+1 – N"; más allá, en "+N". Antes era la constante 60. Default 60.
  agingLimite2 Int @default(60) @map("aging_limite2")

  /// ⭐ V1-E3u (§Post-F9.89(a)) — DESVÍO TOLERADO al capturar cuánto se compra, en PORCENTAJE
  /// entero sobre lo que el sistema propuso. Daniel: *"el sistema debería de validar que las
  /// cantidades no excedan un porcentaje… si encuentra algún desvío grande que le notifique a la
  /// persona que va a autorizar la OC"* — y dejó el número por fijar (*"arranca con un default y
  /// se ajusta con el uso"*). **NO bloquea nada**: pasado el umbral, el renglón viaja marcado a la
  /// bandeja de autorización (§Post-F9.64, *guía no jaula*). Default 10: el doble de la banda del
  /// 5% que el negocio ya reconoce como variación normal (§Post-F9.19), así que redondear al rollo
  /// o al mínimo del proveedor no cría alarmas de mentira, pero comprar un rollo entero de más sí
  /// llega a quien autoriza. Vive por EMPRESA para que Daniel lo mueva sin un deploy.
  pctDesvioCompra Int @default(10) @map("pct_desvio_compra")

  /// Fecha del último inventario físico de telas (viejo: `InvFisico`).
  fechaInventarioTelas DateTime? @map("fecha_inventario_telas") @db.Date
  /// Fecha del último inventario físico de producto terminado (viejo: `InvFisicoPT`).
  fechaInventarioPt    DateTime? @map("fecha_inventario_pt") @db.Date

  /// Almacén de producto terminado por defecto (viejo: `IPT_Almacen_Default`).
  idAlmacenPtDefault Int?     @map("id_almacen_pt_default")
  almacenPtDefault   Almacen? @relation("ConfiguracionAlmacenPtDefault", fields: [idAlmacenPtDefault], references: [id], onDelete: Restrict)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("configuraciones_empresa")
}

// ─────────────────────────────────────────────────────────────────────────────
// Usuarios y autenticación (better-auth) — A4: un solo sistema de seguridad
// ─────────────────────────────────────────────────────────────────────────────

/// Usuario del sistema. Mapea el modelo `user` de better-auth (id String cuid es
/// requisito del adapter) y absorbe los campos de negocio de la tabla `Usuarios`
/// del sistema viejo (doc 10 §4): `bloqueado` + `intentosFallidos` reemplazan a
/// `CantBloq` (bloqueo a los 5 intentos, doc 00 §1.1), `esAuditor` se conserva.
/// La contraseña NO vive aquí: va hasheada en `Cuenta` (providerId "credential").
/// Mapping de better-auth (configurado en E3): name→nombre,
/// createdAt→creadoEn, updatedAt→modificadoEn.
model Usuario {
  id              String  @id @default(cuid())
  /// Nombre de usuario para login, normalizado a minúsculas (plugin username de better-auth).
  username        String  @unique
  /// Forma original del username tal como la escribió quien lo creó (requisito del plugin username).
  displayUsername String? @map("display_username")
  /// Nombre completo de la persona (better-auth: `name`).
  nombre          String
  /// better-auth exige email único; el negocio no lo usa, puede ser sintético `<username>@control.local`.
  email           String  @unique
  emailVerified   Boolean @default(false) @map("email_verificado")
  image           String? @map("imagen")

  /// Borrado suave (plan §4: patrón conservado del sistema viejo): un usuario que se va se desactiva, jamás se borra.
  activo           Boolean @default(true)
  /// Bloqueado por intentos fallidos (regla viejo sistema: 5 intentos, doc 00 §1.1).
  bloqueado        Boolean @default(false)
  intentosFallidos Int     @default(0) @map("intentos_fallidos")
  /// Bandera de auditor de calidad (viejo: `Usuarios.EsAuditor`).
  esAuditor        Boolean @default(false) @map("es_auditor")

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  sesiones Sesion[]
  cuentas  Cuenta[]
  roles    UsuarioRol[]

  /// ⭐ V1-E7d — Versiones de modelo cuya REVISIÓN firmó esta persona (§Post-F9.110). Pata inversa
  /// de `Modelo.revisadoPor`; existe sólo porque Prisma exige las dos patas de toda relación.
  modelosRevisados Modelo[] @relation("ModeloRevisadoPor")

  @@map("usuarios")
}

/// Sesión de better-auth (tabla auth pura — campos con los nombres que better-auth
/// espera; columnas en español). Cascade: al borrar un usuario caen sus sesiones.
model Sesion {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime @map("expira_en")
  ipAddress String?  @map("direccion_ip")
  userAgent String?  @map("agente_usuario")
  userId    String   @map("id_usuario")
  usuario   Usuario  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("creado_en")
  updatedAt DateTime @updatedAt @map("modificado_en")

  @@index([userId])
  @@map("sesiones")
}

/// Cuenta de autenticación de better-auth. Para login con contraseña:
/// providerId = "credential", accountId = id del usuario y `password` = hash
/// (scrypt de better-auth/crypto). Tabla auth pura.
model Cuenta {
  id                    String    @id @default(cuid())
  accountId             String    @map("id_cuenta")
  providerId            String    @map("id_proveedor")
  userId                String    @map("id_usuario")
  usuario               Usuario   @relation(fields: [userId], references: [id], onDelete: Cascade)
  password              String?
  accessToken           String?   @map("token_acceso")
  refreshToken          String?   @map("token_refresco")
  idToken               String?   @map("token_id")
  accessTokenExpiresAt  DateTime? @map("token_acceso_expira_en")
  refreshTokenExpiresAt DateTime? @map("token_refresco_expira_en")
  scope                 String?
  createdAt             DateTime  @default(now()) @map("creado_en")
  updatedAt             DateTime  @updatedAt @map("modificado_en")

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("cuentas")
}

/// Verificaciones temporales de better-auth (tokens de un solo uso). Tabla auth pura.
model Verificacion {
  id         String   @id @default(cuid())
  identifier String   @map("identificador")
  value      String   @map("valor")
  expiresAt  DateTime @map("expira_en")
  createdAt  DateTime @default(now()) @map("creado_en")
  updatedAt  DateTime @updatedAt @map("modificado_en")

  @@index([identifier])
  @@map("verificaciones")
}

// ─────────────────────────────────────────────────────────────────────────────
// RBAC (A4): roles + permisos. El catálogo de permisos vive en src/contrato;
// la tabla `permisos` se sincroniza desde ahí por el seed (clave = ClavePermiso).
// ─────────────────────────────────────────────────────────────────────────────

/// Rol de usuario. Los roles con `esSistema = true` los crea el seed (absorben los
/// niveles del sistema viejo, doc 00 §2) y la UI no permite borrarlos ni renombrarlos.
model Rol {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique
  descripcion String
  esSistema   Boolean @default(false) @map("es_sistema")

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  permisos RolPermiso[]
  usuarios UsuarioRol[]

  /// Procesos de la Ruta Crítica de los que este rol es RESPONSABLE (F5-E1, D10/A4). Puente
  /// N:M sobre el RBAC único: NO hay catálogo de roles paralelo (los `RC_TipoUsuarios` del
  /// viejo se absorben como roles funcionales del seed). Restrict: un rol asignado a un proceso
  /// no se borra físico.
  procesos ProcesoDefRol[]

  @@map("roles")
}

/// Permiso granular (espejo en BD del catálogo tipado de src/contrato, que es la
/// fuente de verdad). `clave` es una ClavePermiso `modulo.accion`; el id numérico es
/// interno y NUNCA se usa para autorizar.
model Permiso {
  id          Int    @id @default(autoincrement())
  clave       String @unique
  descripcion String
  modulo      String

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  roles RolPermiso[]

  @@map("permisos")
}

/// Permisos otorgados a un rol.
model RolPermiso {
  idRol     Int     @map("id_rol")
  rol       Rol     @relation(fields: [idRol], references: [id], onDelete: Restrict)
  idPermiso Int     @map("id_permiso")
  permiso   Permiso @relation(fields: [idPermiso], references: [id], onDelete: Restrict)

  creadoEn    DateTime @default(now()) @map("creado_en")
  creadoPorId String?  @map("creado_por_id")

  @@id([idRol, idPermiso])
  @@index([idPermiso])
  @@map("roles_permisos")
}

/// Roles asignados a un usuario.
model UsuarioRol {
  idUsuario String  @map("id_usuario")
  usuario   Usuario @relation(fields: [idUsuario], references: [id], onDelete: Restrict)
  idRol     Int     @map("id_rol")
  rol       Rol     @relation(fields: [idRol], references: [id], onDelete: Restrict)

  creadoEn    DateTime @default(now()) @map("creado_en")
  creadoPorId String?  @map("creado_por_id")

  @@id([idUsuario, idRol])
  @@index([idRol])
  @@map("usuarios_roles")
}

// ─────────────────────────────────────────────────────────────────────────────
// Almacenes (base del kardex único D3) y secuencias de folios (A3)
// ─────────────────────────────────────────────────────────────────────────────

/// Tipo de almacén según el inventario que guarda (D3: un kardex para PT, telas y avíos).
enum TipoAlmacen {
  PT
  TELA
  AVIO

  @@map("tipo_almacen")
}

/// Almacén físico o lógico. Unifica `IPT_Almacenes` (PT) y `Almacenes` (telas) del
/// sistema viejo. `idEmpresa` opcional: hay almacenes de una empresa y compartidos (A9).
/// OJO: el unique compuesto NO cubre almacenes globales (Postgres trata los NULL como
/// distintos); el servicio de dominio valida el nombre duplicado cuando idEmpresa es null.
model Almacen {
  id        Int         @id @default(autoincrement())
  nombre    String
  tipo      TipoAlmacen
  /// Borrado suave (plan §4: patrón conservado del sistema viejo).
  activo    Boolean     @default(true)
  idEmpresa Int?        @map("id_empresa")
  empresa   Empresa?    @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)

  /// CORTADOR dueño del almacén (§Post-F9.13, petición de Daniel 7-ago-2026): liga OPCIONAL de un
  /// almacén de TELA con el taller de corte que lo usa. Sirve para que, al capturar el corte con
  /// ese cortador, la descarga de tela salga por default de SU almacén, y para que el traspaso
  /// "Naucalpan → taller" se encuentre solo. Es un `Proveedor` con rol `corte` (lo valida el
  /// dominio, no la BD). **ÚNICO a propósito**: un cortador tiene a lo más UN almacén — con dos, la
  /// pregunta "¿cuál es el almacén de este cortador?" no tendría respuesta y el default sería una
  /// moneda al aire. Restrict: un proveedor con almacén ligado no se borra físico.
  idCortador Int?       @unique @map("id_cortador")
  cortador   Proveedor? @relation("AlmacenCortador", fields: [idCortador], references: [id], onDelete: Restrict)

  /// ALMACÉN DE TRÁNSITO A PROCESO EXTERNO (V1-E4b, §Post-F9.61). Marca el almacén de PT donde
  /// viven las prendas TERMINADAS mientras están físicamente en el taller de un tercero
  /// (estampado/bordado/lavado DESPUÉS de costura). El envío de prendas ya terminadas las SACA
  /// de su almacén y las mete aquí; el recibo las devuelve a Primeras/Segundas. Lo que no vuelve
  /// se queda AQUÍ, vivo, hasta que llegue o se dé de baja con un movimiento manual (D3: nunca
  /// se absorbe en silencio).
  ///
  /// Es una BANDERA y no un id en `ConfiguracionEmpresa` porque el almacén ya existía en el
  /// catálogo desde F3-E1 ("Tránsito", heredado de `IPT_Almacenes`): marcarlo no pide pantalla de
  /// configuración nueva, lo hace el seed. El dominio exige que haya EXACTAMENTE uno usable por la
  /// empresa (global o propio) y lo resuelve por esta bandera, nunca por el nombre.
  esTransitoProceso Boolean @default(false) @map("es_transito_proceso")

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  configuracionesPtDefault ConfiguracionEmpresa[] @relation("ConfiguracionAlmacenPtDefault")

  /// Movimientos de kardex en este almacén (F3-E1, D3). Restrict: un almacén con
  /// movimientos no se borra físico → se desactiva.
  movimientos Movimiento[]

  /// Recibos de maquila que mandan sus PRIMERAS a este almacén (F3-E4). Restrict.
  recibosAlmacenPrimeras EtapaMovimiento[] @relation("ReciboAlmacenPrimeras")
  /// Recibos de maquila que mandan sus SEGUNDAS a este almacén (F3-E4). Restrict.
  recibosAlmacenSegundas EtapaMovimiento[] @relation("ReciboAlmacenSegundas")
  /// Envíos de prendas YA TERMINADAS que salen de este almacén hacia el tránsito (V1-E4b). Restrict.
  enviosAlmacenOrigen    EtapaMovimiento[] @relation("EnvioAlmacenOrigen")

  /// Recepciones de compra cuyo material entra a este almacén destino (F4-E3). Restrict.
  recepcionesCompra RecepcionCompra[]

  /// Documentos de entrada de tela por factura/remisión cuyo material entra a este almacén (B1). Restrict.
  entradasTela EntradaTela[]

  /// Notas de salida cuyos avíos salen de este almacén origen (F4-E5, decisión (g)). Restrict.
  notasSalida NotaSalida[]

  /// Inventarios cíclicos que cuentan este almacén (F7-E5). Restrict.
  inventariosCiclicos InventarioCiclico[]

  @@unique([idEmpresa, nombre])
  @@map("almacenes")
}

/// Contador de folios de negocio POR EMPRESA y por tipo de documento (A3: los folios
/// salen de aquí con UPDATE atómico — nunca `Max()+1`). `clave` identifica el tipo de
/// folio (p. ej. "pedido", "orden", "nota-salida", "orden-compra").
model Secuencia {
  id        Int     @id @default(autoincrement())
  idEmpresa Int     @map("id_empresa")
  empresa   Empresa @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)
  clave     String
  valor     BigInt  @default(0)

  @@unique([idEmpresa, clave])
  @@map("secuencias")
}

/// Contador GLOBAL (sin empresa) para las numeraciones de los CATÁLOGOS GLOBALES (ADR-0007),
/// que por definición no pueden colgar de una empresa: si dos empresas desarrollaran para el
/// mismo cliente, dos secuencias por empresa darían el MISMO código de desarrollo y chocarían
/// contra el unique global de `Modelo.codigoDesarrollo`. Misma mecánica atómica que `Secuencia`
/// (A3: `INSERT … ON CONFLICT … DO UPDATE … RETURNING`, jamás `Max()+1`), sin `idEmpresa`.
/// `clave` identifica la serie (p. ej. `modelo-desarrollo-<idCliente>-<año>`).
model SecuenciaGlobal {
  id    Int    @id @default(autoincrement())
  clave String @unique
  valor BigInt @default(0)

  @@map("secuencias_globales")
}

// ─────────────────────────────────────────────────────────────────────────────
// Bitácora (A7) y archivos (A5/R6)
// ─────────────────────────────────────────────────────────────────────────────

/// Acción registrada en la bitácora. CANCELAR/DESACTIVAR son los "borrados" suaves;
/// OTRO cubre eventos que no son cambio de datos (p. ej. inicios de sesión).
enum AccionBitacora {
  CREAR
  MODIFICAR
  DESACTIVAR
  CANCELAR
  OTRO

  @@map("accion_bitacora")
}

/// Bitácora de cambios por entidad (A7). `entidad` + `idEntidad` apuntan al registro
/// afectado (idEntidad en texto para cubrir PKs Int y String); `datos` guarda el
/// detalle del cambio en JSON. `idUsuario` sin FK físico: es un log inmutable y los
/// usuarios nunca se borran.
model Bitacora {
  id        BigInt         @id @default(autoincrement())
  entidad   String
  idEntidad String         @map("id_entidad")
  accion    AccionBitacora
  datos     Json?
  idUsuario String?        @map("id_usuario")
  fecha     DateTime       @default(now())

  @@index([entidad, idEntidad])
  @@map("bitacora")
}

/// Archivo guardado en Cloudflare R2 (A5: nada de rutas `S:\`; R6: repositorio de
/// adjuntos). Los objetos se referencian SIEMPRE por esta tabla, nunca por convención
/// de nombre (plan §2). `subidoPorId` sin FK físico (mismo criterio que la auditoría).
model Archivo {
  id             String   @id @default(cuid())
  bucket         String
  key            String   @unique
  nombreOriginal String   @map("nombre_original")
  tipoMime       String   @map("tipo_mime")
  tamanoBytes    Int      @map("tamano_bytes")
  subidoPorId    String?  @map("subido_por_id")
  subidoEn       DateTime @default(now()) @map("subido_en")

  /// Adjunto de proveedor que apunta a este archivo (F1-E1B), si lo hay. Relación
  /// inversa exigida por Prisma; en la práctica es 0 o 1 (un archivo se adjunta una vez).
  proveedorArchivo       ProveedorArchivo?
  /// Fotos de arte que apuntan a este archivo (V1-E3f). Inversa de `ModeloArteFoto.archivo`.
  /// Es una LISTA, no 0..1: al sacar el arte del catálogo (§Post-F9.35) los artes compartidos
  /// por varios modelos se DUPLICAN, y las copias comparten la MISMA foto (el objeto de R2 no
  /// se puede duplicar desde una migración SQL, y `archivos.key` es único). Por eso quitar la
  /// foto de un arte solo borra el `Archivo` cuando ninguna otra foto de arte lo referencia
  /// (`dominio/modelos/arte-modelo.ts`).
  modeloArteFotos        ModeloArteFoto[]
  /// Empresa cuyo LOGO es este archivo (post-F9), si la hay. Inversa de `Empresa.archivoLogo`;
  /// 0 o 1 (un archivo es el logo de una sola empresa).
  empresaLogo            Empresa?
  /// Foto de modelo que apunta a este archivo (F1-E4), si la hay. Inversa de
  /// `ModeloFoto.archivo`; 0 o 1 (un archivo es UNA foto de UN modelo — Cascade en ambos).
  modeloFoto             ModeloFoto?
  /// Adjunto de orden de producción que apunta a este archivo (F8-E6, R6), si lo hay. Inversa de
  /// `OrdenArchivo.archivo`; 0 o 1 (un archivo se adjunta a UNA sola orden — Cascade en ambos).
  ordenArchivo           OrdenArchivo?
  /// Adjunto de pedido interno que apunta a este archivo (rediseño R3, B3), si lo hay. Inversa de
  /// `PedidoArchivo.archivo`; 0 o 1 (un archivo se adjunta a UN solo pedido — Cascade en ambos).
  pedidoArchivo          PedidoArchivo?
  /// Adjunto de desarrollo (tech pack) que apunta a este archivo (rediseño R5, B16), si lo hay.
  /// Inversa de `DesarrolloArchivo.archivo`; 0 o 1 (un archivo se adjunta a UN solo desarrollo).
  desarrolloArchivo      DesarrolloArchivo?
  /// Movimientos de terceros cuyo CFDI (XML/PDF) es este archivo (F9-E1), si los hay. Inversa de
  /// `MovimientoTercero.archivoCfdi`; Restrict — no se borra el XML de un movimiento vivo.
  movimientosTerceroCfdi MovimientoTercero[]
  /// Adjunto de una entrada de tela (el PDF de la factura/remisión, B1), si lo hay. Inversa de
  /// `EntradaTelaArchivo.archivo`; 0 o 1 (un archivo se adjunta a UNA entrada — Cascade en ambos).
  entradaTelaArchivo     EntradaTelaArchivo?
  /// Entradas de tela cuyo CFDI es este XML (§Post-F9.21: respalda el cargo fiscal de CxP).
  entradasTelaCfdi       EntradaTela[]       @relation("EntradaTelaCfdi")

  @@map("archivos")
}

// ─────────────────────────────────────────────────────────────────────────────
// Catálogos (F1) — maestros GLOBALES (sin idEmpresa): se capturan una vez y los
// comparten todas las empresas (ADR-0007, decisión A9). Unicidad de `nombre`
// GLOBAL (@unique). Mismo patrón que `Almacen`: borrado suave (`activo`) +
// auditoría uniforme (A7) creadoEn/creadoPorId + modificadoEn/modificadoPorId.
// onDelete Restrict no aplica aún (no hay relaciones entrantes en F1-E1; las
// agregan F1-E3/E4: AvioProveedor→Proveedor, TelaColor→Color, Modelo→Temporada).
// ─────────────────────────────────────────────────────────────────────────────

/// Proveedor (catálogo global, F1-E1 + enriquecido F1-E1B). Equivale a la tabla
/// `Proveedores` del viejo (doc 03-Producción §Órdenes de Compra). Base de
/// `AvioProveedor` (F1-E3, R1) y, sobre todo, cimiento de las CxP de la futura
/// fase de Finanzas (F8, decisión D12, R15 — `Documentacion_MJD/PROPUESTA-Finanzas-y-Proveedores.md` §4).
///
/// F1-E1B agrega: roles/servicios multi-valor (relación `ProveedorRol`),
/// campos fiscales para el CFDI, datos comerciales/de pago, lead time
/// para el MRP y adjuntos en R2 (`ProveedorArchivo`). TODOS los campos nuevos son
/// NULLABLE: los 443 proveedores que migran en F1-E6 no traen estos datos; se
/// capturan en altas/ediciones nuevas (la regla "factura ⇒ RFC" es de captura, no
/// rompe filas viejas).
///
/// FUSIÓN DE TERCEROS (D12/R15 — `Documentacion_MJD/PROPUESTA-Finanzas-y-Proveedores.md`
/// §4): este catálogo ABSORBE a los antiguos `Maquilero` y `Cortador` (eliminados). Un
/// tercero se da de alta UNA sola vez como Proveedor y marca sus servicios (maquila,
/// corte, estampado, bordado, lavado, aplicación, venta de telas/avíos…) con CASILLAS de
/// `RolProveedor`. Los atributos propios del maquilero se portaron como campos nullable
/// (`asegurado`, `obsPago`, abajo; su `corto` vive hoy en `nombreCorto`).
///
/// V1-E3f pieza B (§Post-F9.56/.57/.58, Daniel 16-ago-2026) lo deja como Daniel lo usa:
///  • **Fuera `tipo`** (enum `TipoProveedor`). Daniel: *"tienes un campo de TIPO y aparte
///    tienes el rol (que pueden ser más de uno)… creo que el de tipo sale sobrando. Y es
///    importante poner todo lo que puede hacer un proveedor, porque puede hasta llegar a
///    vender telas y ser maquilero"*. Los roles N:N ya cubren ese caso; el tipo ÚNICO no.
///    La migración TRADUCE el valor viejo a rol (TELAS→`vende-telas`, AVIOS→`vende-avios`,
///    SERVICIOS→`otros-servicios`, SIN_CLASIFICAR→sin rol) de forma ADITIVA.
///  • **Un solo campo corto** (`nombreCorto`), ÚNICO: absorbe al `corto` del taller.
///  • **Fuera `contacto`** (un solo nombre suelto): los contactos son ahora N filas de
///    `ProveedorContacto`, con el puesto en TEXTO LIBRE.
model Proveedor {
  id          Int     @id @default(autoincrement())
  /// Nombre de uso diario. Único global (ADR-0007): un proveedor se da de alta una sola vez.
  nombre      String  @unique
  /// Nombre CORTO de uso diario — el ÚNICO campo corto del proveedor (V1-E3f pieza B,
  /// §Post-F9.57 punto 2 + §Post-F9.58 punto 1). Nació como display para armar el nombre
  /// compuesto de la tela ("Bloom" para BLOOM TEXTIL, A1.1) y ABSORBIÓ la clave corta del
  /// taller (`corto`, ex `Maquilero.corto`): Daniel — *"tanto para proveedores como para
  /// talleres necesitamos el campo corto. Podría ser el mismo campo"* y *"sí debe de ser
  /// único"*. Por eso es `@unique` global (nullable: los NULL no chocan entre sí en Postgres,
  /// así que los cientos de proveedores sin clave corta conviven sin problema).
  ///
  /// ⚠️ Este `@unique` es EXACTO y por sí solo dejaría convivir "TCD" y "tcd". La unicidad que
  /// pidió Daniel es la que usa la gente —sin distinguir mayúsculas—, así que la migración
  /// `20260818140000_proveedores_como_daniel_los_usa` crea ADEMÁS un índice funcional
  /// `unique(lower(nombre_corto))`, que Prisma no sabe declarar aquí. Los dos conviven: éste
  /// documenta el campo, el otro cierra la carrera concurrente con distinta caja.
  nombreCorto String? @unique @map("nombre_corto")
  razonSocial String? @map("razon_social")
  telefono    String?
  /// Condiciones comerciales en texto libre (crédito, plazos…). Se conserva de E1;
  /// los datos comerciales estructurados (diasCredito, moneda…) los agrega E1B.
  condiciones String?

  // ── Fiscal (F1-E1B, R15 §4): lo que el CFDI necesita ───────────────────────
  /// ¿Emite CFDI? Define formal (true) vs informal (false/null). Si es true, la
  /// regla de captura exige `rfc` + `regimenFiscalSat` (relajada para migrados).
  factura                Boolean?
  /// RFC del tercero (persona física 13 / moral 12), validado en Zod si viene.
  rfc                    String?
  /// Régimen fiscal del SAT (clave de catálogo del SAT, p. ej. "601").
  regimenFiscalSat       String?  @map("regimen_fiscal_sat")
  /// Uso de CFDI habitual (clave del SAT, p. ej. "G03").
  usoCfdiHabitual        String?  @map("uso_cfdi_habitual")
  /// Código postal del lugar de expedición del comprobante.
  codigoPostalExpedicion String?  @map("codigo_postal_expedicion")
  /// Se le retiene IVA (común a personas físicas en maquila).
  retieneIva             Boolean? @map("retiene_iva")
  /// Se le retiene ISR.
  retieneIsr             Boolean? @map("retiene_isr")

  // ── Contacto (F1-E1B): el telefono/contacto de E1 se conservan arriba ──────
  /// Email para enviar la OC y recibir el XML del CFDI.
  email     String?
  direccion String?

  // ── Comercial / pago (F1-E1B, R15 §4) ─────────────────────────────────────
  /// Condición de pago: días de crédito. null o 0 = contado (ver TSDoc del dominio).
  diasCredito   Int?     @map("dias_credito")
  /// Moneda habitual: MXN o USD (validada en Zod).
  moneda        String?
  /// Forma de pago (transferencia/efectivo/cheque — clave o texto del SAT).
  formaPago     String?  @map("forma_pago")
  /// Método de pago del CFDI: PUE (una exhibición) o PPD (parcialidades/diferido).
  metodoPago    String?  @map("metodo_pago")
  banco         String?
  /// CLABE interbancaria (18 dígitos con dígito de control, validada en Zod).
  clabe         String?
  /// Límite de crédito (opcional), para alertas de CxP en F8.
  limiteCredito Decimal? @map("limite_credito") @db.Decimal(14, 2)

  // ── Operativo (F1-E1B): alimenta el MRP/Make-to-Order (R3/R7, F4) ─────────
  /// Tiempo de entrega típico en días (lead time).
  leadTimeDias Int?    @map("lead_time_dias")
  notas        String?

  // ── Maquila/corte (fusión de terceros, D12/R15) ───────────────────────────
  // Al consolidar Maquilero y Cortador en este único catálogo (un tercero se da de
  // alta UNA vez y marca sus servicios con casillas de `RolProveedor`), se portan los
  // atributos PROPIOS del maquilero que no tenían equivalente en Proveedor. Son
  // NULLABLE: los proveedores que ya existen (y los que migren en F1-E6) no los traen;
  // se capturan en altas/ediciones de talleres. El `nombre`/`telefono`/`direccion`/
  // `notas` del maquilero ya viven en los campos homónimos de arriba (no se duplican).
  // El `precioReferencia` del cortador NO se porta: el costo del corte se definirá en la
  // orden de producción (pendiente F2/F3).
  // La clave corta del taller (`corto`) se FUSIONÓ con `nombreCorto` (arriba) en V1-E3f
  // pieza B: un solo campo corto, único, para el proveedor comercial y para el taller.
  /// ¿Está asegurado? (ex `Maquilero.asegurado`). Nullable: solo aplica a talleres — la
  /// pantalla solo lo muestra cuando el proveedor tiene algún rol de servicio (§Post-F9.56 punto 7).
  asegurado Boolean?
  /// Observaciones específicas de pago (ex `Maquilero.obsPago`).
  obsPago   String?  @map("obs_pago")

  /// Modalidad de facturación del maquilero para su cuenta EsMa (F6-E4, decisión (h)):
  /// `solo_con` factura siempre, `solo_sin` nunca, `ambos` opera de las dos formas (y en
  /// ese caso su estado de cuenta se segmenta en dos, E5). NULLABLE: los proveedores ya
  /// migrados no lo traen (default sensato en el dominio: se deriva de `factura` en la UI;
  /// null se trata como "no definido" y exige elegir con-factura por movimiento). Ver enum.
  modalidadFacturacion ModalidadFacturacion? @map("modalidad_facturacion")

  /// Borrado suave (plan §4: patrón conservado del sistema viejo).
  activo Boolean @default(true)

  /// Roles/servicios multi-valor del proveedor (F1-E1B, N:N vía `ProveedorRol`).
  roles                   ProveedorRol[]
  /// Contactos del proveedor (V1-E3f pieza B, §Post-F9.56 punto 1): N personas por proveedor.
  contactos               ProveedorContacto[]
  /// Adjuntos del proveedor en R2 (F1-E1B: constancia, contrato…).
  archivos                ProveedorArchivo[]
  /// Avíos que surte este proveedor (F1-E3, R1, N:N vía `AvioProveedor`).
  avios                   AvioProveedor[]
  /// Artes de modelo que hace este proveedor (V1-E3d, §Post-F9.35). Restrict.
  artesModelo             ModeloArte[]
  /// Artes de la RECETA CONGELADA de órdenes que hace este proveedor (V1-E3d). Restrict.
  artesOrden              OrdenArte[]
  /// Órdenes de producción donde está asignado como maquilero (F2-E2, Restrict).
  ordenes                 Orden[]
  /// Etapas de producción donde es el TERCERO (cortador/maquilero/estampador) (F3-E1,
  /// fusión de terceros D12/R15: el tercero es un Proveedor con su rol de servicio). Restrict.
  etapasMovimiento        EtapaMovimiento[]
  /// Cargos a su cuenta de maquila (EsMa) como maquilero (F3-E1). Restrict.
  cargosEsMa              EsMaCargo[]
  /// Abonos a su cuenta de maquila (EsMa, F6-E4). Restrict.
  abonosMaquilero         AbonoMaquilero[]
  /// Descuentos a su cuenta de maquila (EsMa, F6-E4). Restrict.
  descuentosMaquilero     DescuentoMaquilero[]
  /// Pagos recibidos como maquilero (EsMa, F6-E4). Restrict.
  pagosMaquilero          PagoMaquilero[]
  /// Lotes de tela que este proveedor surtió (F4-E1, D5). Restrict.
  lotes                   Lote[]
  /// Órdenes de compra emitidas a este proveedor (F4-E2). Restrict.
  ordenesCompra           OrdenCompra[]
  /// Entradas de tela por factura/remisión SIN OC surtidas por este proveedor (B1). Restrict.
  entradasTela            EntradaTela[]
  /// Requerimientos de explosión MRP donde es el proveedor SUGERIDO (F4-E4, R1/R3). Restrict.
  requerimientosSugeridos RequerimientoOrden[] @relation("RequerimientoProveedorSugerido")
  /// Notas de salida donde este proveedor es el MAQUILERO destino del envío (F4-E5). Restrict.
  notasSalida             NotaSalida[]
  /// Auditorías de calidad donde este proveedor es el MAQUILERO auditado (F6-E2). Restrict.
  auditorias              Auditoria[]
  /// Precios de telas que surte este proveedor (F8-E1, D13/R17 — espejo de AvioProveedor). Restrict.
  telaProveedores         TelaProveedor[]
  /// Eventos de precio de orden donde es el proveedor con quien se NEGOCIÓ (rediseño R2). Restrict.
  ordenPrecioEventos      OrdenPrecioEvento[]
  /// Modelos que lo cotizaron como MAQUILERO de costura en su desarrollo (rediseño R5, B9). Restrict.
  modelosCotizados        Modelo[]             @relation("ModeloMaquileroCotizado")
  /// Movimientos de cuenta corriente (CxP/EsMa) de este proveedor (F9-E1). Restrict.
  movimientosTerceros     MovimientoTercero[]

  /// Telas de las que este proveedor es el DUEÑO del artículo (§Post-F9.11). Restrict.
  telasComoDueno Tela[] @relation("TelaProveedorDueno")

  /// Renglones de receta de ORDEN donde COMPRAS lo asignó para desatorar esa OP (V1-E3m,
  /// §Post-F9.82). La asignación vive en la orden, nunca en el catálogo. Restrict.
  ordenTelasAsignadas OrdenTela[] @relation("OrdenTelaProveedorCompra")
  ordenAviosAsignados OrdenAvio[] @relation("OrdenAvioProveedorCompra")

  /// Almacén de TELA ligado a este tercero como CORTADOR (§Post-F9.13). Es 0..1: el almacén
  /// declara a su cortador y la liga es única, para que "el almacén de este cortador" nunca
  /// sea ambiguo.
  almacenComoCortador Almacen? @relation("AlmacenCortador")

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("proveedores")
}

/// CONTACTO de un proveedor (V1-E3f pieza B — §Post-F9.56 punto 1 y §Post-F9.57 punto 1).
///
/// Antes había UN solo campo `Proveedor.contacto` (un nombre suelto). Daniel: *"A veces es
/// importante ir registrando al vendedor, a la de crédito y cobranza, al encargado del taller,
/// a la supervisora… Depende qué tipo de proveedor y qué tipo de puestos se requieren."*
///
/// El **puesto es TEXTO LIBRE, no catálogo** — Daniel, cerrando la pregunta: *"O sea, sí un
/// catálogo de contactos, pero deja el campo abierto qué rol tiene cada persona."* Mismo criterio
/// que la posición del arte (§Post-F9.52 punto 2): abierto donde la realidad es variada.
///
/// El `contacto` viejo NO se pierde (D3): la migración lo convierte en el primer contacto de su
/// proveedor (con el puesto vacío, porque nadie lo capturó) antes de tirar la columna.
///
/// `onDelete: Cascade` hacia `Proveedor`: los contactos son datos DEL proveedor (mismo criterio
/// que `ProveedorArchivo`/`ProveedorRol`). Hoy el proveedor no se borra físicamente (borrado
/// suave con `activo`), así que en la práctica no se dispara.
model ProveedorContacto {
  id          Int       @id @default(autoincrement())
  idProveedor Int       @map("id_proveedor")
  proveedor   Proveedor @relation(fields: [idProveedor], references: [id], onDelete: Cascade)

  /// Nombre de la persona. Es lo único obligatorio: un contacto sin nombre no sirve para nada.
  nombre   String
  /// Qué hace esa persona, en TEXTO LIBRE ("vendedor", "crédito y cobranza", "encargado del
  /// taller", "supervisora"…). NO es catálogo, por decisión de Daniel.
  puesto   String?
  telefono String?
  email    String?
  notas    String?

  /// Borrado SUAVE (plan §4, D3): un contacto que se fue se desactiva, no se borra — su nombre
  /// puede seguir apareciendo en documentos viejos.
  activo Boolean @default(true)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idProveedor])
  @@map("proveedor_contacto")
}

/// Rol/servicio que un proveedor puede prestar (F1-E1B, R15 §4.1). Catálogo
/// administrable y GLOBAL (ADR-0007): un mismo proveedor puede maquilar Y cortar,
/// o vender avíos Y maquilar, sin duplicarse. Mismo patrón N:N que `MaquileroTipoProceso`
/// (F1-E2). El `origen` de cada movimiento (recibo vs factura) decide en qué vista
/// cae en F8 (EsMa vs CxP); el rol solo clasifica al proveedor.
model RolProveedor {
  id     Int     @id @default(autoincrement())
  /// Clave estable de negocio (kebab-case, p. ej. "maquila-costura"). Única global.
  codigo String  @unique
  /// Nombre legible para la UI (p. ej. "Maquila (costura)").
  nombre String
  /// Borrado suave (plan §4): un rol en uso se desactiva, no se borra (Restrict).
  activo Boolean @default(true)

  /// Proveedores que tienen este rol (N:N).
  proveedores ProveedorRol[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("roles_proveedor")
}

/// Puente N:N proveedor ↔ rol (F1-E1B). Un renglón por cada rol que presta el
/// proveedor. PK compuesta (sin id propio): el par (proveedor, rol) es único por
/// definición. `onDelete`:
///  • Cascade hacia `Proveedor`: los roles son configuración del proveedor; si el
///    proveedor se borrara físicamente (no pasa hoy: borrado suave), sus renglones
///    de rol se irían con él. Además permite reescribir el set de roles en la tx.
///  • Restrict hacia `RolProveedor`: un rol con proveedores asignados NO se puede
///    borrar físicamente (se desactiva con `activo`), para no dejar el par colgando.
model ProveedorRol {
  idProveedor    Int @map("id_proveedor")
  idRolProveedor Int @map("id_rol_proveedor")

  proveedor Proveedor    @relation(fields: [idProveedor], references: [id], onDelete: Cascade)
  rol       RolProveedor @relation(fields: [idRolProveedor], references: [id], onDelete: Restrict)

  creadoEn    DateTime @default(now()) @map("creado_en")
  creadoPorId String?  @map("creado_por_id")

  @@id([idProveedor, idRolProveedor])
  @@index([idRolProveedor])
  @@map("proveedor_rol")
}

/// Tipo de adjunto de un proveedor (F1-E1B, R15 §4: "adjuntos en R2 — constancia
/// de situación fiscal, contrato"). `OTRO` cubre cualquier otro documento.
enum TipoArchivoProveedor {
  CONSTANCIA
  CONTRATO
  OTRO

  @@map("tipo_archivo_proveedor")
}

/// Puente proveedor ↔ archivo R2 (F1-E1B). Liga un `Archivo` (registro del motor de
/// archivos de F0) a un proveedor con su tipo documental. `onDelete`:
///  • Cascade hacia `Proveedor`: los adjuntos son del proveedor.
///  • Cascade hacia `Archivo`: al quitar el adjunto se borra también su `Archivo`
///    (el objeto R2 huérfano es inofensivo — lo documenta `comun/archivos.ts`).
model ProveedorArchivo {
  id          Int                  @id @default(autoincrement())
  idProveedor Int                  @map("id_proveedor")
  idArchivo   String               @map("id_archivo")
  tipo        TipoArchivoProveedor @default(OTRO)

  proveedor Proveedor @relation(fields: [idProveedor], references: [id], onDelete: Cascade)
  archivo   Archivo   @relation(fields: [idArchivo], references: [id], onDelete: Cascade)

  creadoEn    DateTime @default(now()) @map("creado_en")
  creadoPorId String?  @map("creado_por_id")

  @@unique([idArchivo])
  @@index([idProveedor])
  @@map("proveedor_archivo")
}

// NOTA (fusión de terceros, D12/R15): el modelo `Cortador` se ELIMINÓ. El cortador es
// ahora un Proveedor con el rol `corte` (casilla de `RolProveedor`). Su `precioReferencia`
// NO se portó: el costo del corte se definirá en la orden de producción (pendiente F2/F3).

/// Temporada (catálogo global, F1-E1). Equivale a la tabla `Temporadas` del viejo
/// (doc 01-Modelos §2): clasifica los modelos por temporada comercial.
model Temporada {
  id     Int     @id @default(autoincrement())
  /// Nombre de la temporada. Único global (ADR-0007).
  nombre String  @unique
  /// Borrado suave (plan §4: patrón conservado del sistema viejo).
  activo Boolean @default(true)

  /// Modelos clasificados en esta temporada (F1-E4, FK nullable Restrict).
  modelos     Modelo[]
  /// Muestrarios pendientes de esta temporada (F7-E4, FK nullable Restrict).
  muestrarios Muestrario[]
  /// Proyectos de desarrollo clasificados en esta temporada (F8-E2, FK nullable Restrict).
  proyectos   Proyecto[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("temporadas")
}

/// Etiqueta de marca (catálogo global, F1-E1). Equivale a la tabla `EtiquetasM` del
/// viejo (doc 01-Modelos §2 y §6 punto 4): la marca/etiqueta del modelo, con su
/// porcentaje de `regalias` que alimenta el costeo (% del precio).
model EtiquetaMarca {
  id       Int     @id @default(autoincrement())
  /// Nombre de la etiqueta de marca. Único global (ADR-0007).
  nombre   String  @unique
  /// Porcentaje de regalías (0–100), validado en Zod y en el dominio. Alimenta el costeo (01-Modelos §6).
  regalias Decimal @default(0) @db.Decimal(5, 2)
  /// Borrado suave (plan §4: patrón conservado del sistema viejo).
  activo   Boolean @default(true)

  /// Órdenes de producción con esta etiqueta de marca (F2-E2, Restrict).
  ordenes Orden[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("etiquetas_marca")
}

/// Color (catálogo global, F1-E1). Motivado por `TelasColores.Color` (texto libre en
/// el viejo, doc 04-Inventarios §B.2): se normaliza a un catálogo único. La fusión de
/// duplicados (alias) llega en F1-E6; aquí solo unicidad por nombre + normalización
/// LIGERA (trim + colapsar espacios) en el dominio.
model Color {
  id     Int     @id @default(autoincrement())
  /// Nombre del color, normalizado. Único global (ADR-0007).
  nombre String  @unique
  /// Borrado suave (plan §4: patrón conservado del sistema viejo).
  activo Boolean @default(true)

  /// LEGACY §Post-F9.11: colores de tela MIGRADOS que conservan su liga a este color de prenda
  /// (`TelaColor.idColor` nullable). Los colores de tela nuevos ya NO cuelgan de aquí.
  telas                  TelaColor[]
  /// Renglones de matriz de órdenes en este color (F2-E2, Restrict).
  ordenLineas            OrdenLinea[]
  /// Renglones de etapas de producción (corte/envío/recibo/entrega) en este color (F3-E1, D4). Restrict.
  etapasMovimientoDet    EtapaMovimientoDet[]
  /// Renglones de kardex PT en este color (F3-E1, D4). Restrict.
  movimientosDetPt       MovimientoDetPt[]
  /// Lotes de tela teñidos en este color (F4-E1, D5: el lote define el teñido). Restrict.
  lotes                  Lote[]
  /// Cantidades de la matriz talla×color de renglones de OC en este color (F4-E2). Restrict.
  ordenCompraLineasTalla OrdenCompraLineaTalla[]
  /// Renglones de inventario cíclico en este color (F7-E5). Restrict.
  inventarioCiclicoDet   InventarioCiclicoDet[]
  /// Precios por color de un proveedor de tela (F8-E1, D13). Restrict.
  telaProveedorColores   TelaProveedorColor[]
  /// ⭐ V1-E3u (§Post-F9.89): las recetas de orden que amarran ESTE color de prenda a un color de tela.
  ordenTelaColores       OrdenTelaColor[]
  /// ⭐⭐ V1-E8c (§Post-F9.126): renglones de explosión de AVÍO que se compran para ESTE color de
  /// prenda. El avío no tiene catálogo de color propio (decisión de Daniel): el color que parte el
  /// renglón es el de la prenda que lo lleva. Restrict.
  requerimientosAvio     RequerimientoOrden[]
  /// ⭐⭐ V1-E8c (§Post-F9.126): renglones de OC de AVÍO pedidos para ESTE color de prenda. Restrict.
  ordenCompraLineasAvio  OrdenCompraLinea[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("colores")
}

// ─────────────────────────────────────────────────────────────────────────────
// Catálogos ESTRUCTURADOS (F1-E2) — maestros GLOBALES (sin idEmpresa, ADR-0007/A9)
// con relaciones internas:
//  • Tipos de proceso: catálogo independiente (consumidor real: la Ruta Crítica, F5).
//    NOTA fusión de terceros (D12/R15): la "maquila unificada" (Maquilero+TipoProceso
//    N:N) se ELIMINÓ; un maquilero es ahora un Proveedor con roles de servicio.
//  • Tallas ilimitadas (D4, MEJORAS A6): Talla + CurvaTalla (maestro-detalle ordenado).
//  • Campos de referencia por cliente (D7): Cliente + ClienteCampo (definición; los
//    VALORES son de F2 vía OrdenReferencia).
// Mismo patrón de auditoría uniforme (A7) y borrado suave (`activo`) que F1-E1.
// onDelete: Restrict hacia los catálogos (en uso ⇒ se desactiva, no se borra físico);
// Cascade hacia el maestro padre en los puentes/detalles (permite reescribir el set
// en la transacción A2). Idéntico al patrón Proveedor↔RolProveedor de F1-E1B.
// ─────────────────────────────────────────────────────────────────────────────

/// Tipo de proceso (catálogo administrable y GLOBAL). Costura, estampado, bordado,
/// lavado, aplicación… En F5 cada tipo se liga a un proceso de la Ruta Crítica (su
/// consumidor real). SE CONSERVA como catálogo independiente: la fusión de terceros
/// (D12/R15) eliminó `Maquilero`/`MaquileroTipoProceso`, así que ya NO tiene relación
/// inversa hacia maquileros (los servicios de un taller se marcan ahora con casillas de
/// `RolProveedor` en el Proveedor; NO hay enlace Proveedor↔TipoProceso). Mismo patrón
/// que `RolProveedor` (se siembra; admin fina diferida).
model TipoProceso {
  id     Int     @id @default(autoincrement())
  /// Clave estable kebab-case (p. ej. "costura"). Única global.
  codigo String  @unique
  nombre String
  activo Boolean @default(true)

  /// ¿El RECIBO de este proceso deja PRENDA TERMINADA y por tanto genera ENTRADA al
  /// inventario PT? (F3-E1, decisión (e) — DECISIONES.md). Por DATO, no por código:
  /// el recibo de maquila (F3-E4) consulta esta bandera para decidir si crea un
  /// `Movimiento` de entrada al kardex PT. SOLO costura = `true`; estampado/aplicación,
  /// bordado y lavado = `false` (evidencia v1: `Recibos.Inventariado` existe solo en
  /// costura; `RecibosEst` NO la trae; `IPT_Movs` tiene 2,468 entradas tipo 2 'Entrada
  /// de Maquila' contra 3 del tipo 3 'Entrada de Aplicación'). Default `false` (lo
  /// SEGURO: un proceso nuevo no mete a PT salvo que se marque). El seed de F3-E1 pone
  /// `true` solo en costura. Cambiar el valor luego es DATO (UI de admin, F3-E1 Fase 2),
  /// NO migración. Editable solo por admin (A4).
  generaEntradaPt Boolean @default(false) @map("genera_entrada_pt")

  /// ⭐ ¿Este proceso se puede usar como TIPO DE ARTE? (V1-E3f, §Post-F9.58/.59 — Daniel:
  /// *"De acuerdo. Y un solo catálogo."*). Antes convivían DOS listas casi idénticas: este
  /// catálogo (costura/estampado/bordado/lavado/aplicación) y un enum fijo `TipoArte`
  /// (BORDADO/ESTAMPADO). Se fusionaron: `ModeloArte.idTipoArte` y `OrdenArte.idTipoArte`
  /// apuntan AQUÍ, y esta bandera dice cuáles de los procesos son ofrecibles como arte.
  /// Seed: `true` en bordado, estampado, aplicación (*"Aplicación también es arte"*, Daniel)
  /// y lavado; `false` en costura — la única diferencia real entre las dos listas viejas.
  /// Un proceso raro («embosado») se da de alta UNA vez y sirve para las dos cosas
  /// (§Post-F9.54, principio del "proceso raro"). Default `false`: un proceso nuevo NO se
  /// ofrece como arte salvo que se marque.
  ///
  /// ⚠️ NO confundir con `generaEntradaPt`: esa bandera está en el nivel EQUIVOCADO (la
  /// posición del proceso respecto de la costura la lleva `EtapaMovimiento.prendaTerminada`
  /// desde V1-E4b, no el tipo). `esArte` SÍ es propiedad del tipo: un bordado es arte
  /// siempre, vaya antes o después de coser.
  esArte Boolean @default(false) @map("es_arte")

  /// ¿El arte de este tipo lleva PUNTADAS? (V1-E3f, §Post-F9.52 punto 6 — Daniel:
  /// *"Las puntadas solo aplica para bordados"*, y sobre atarlo al tipo: *"Ok como tú lo
  /// dices."*). El campo `puntadas` NO se borró (tirarlo destruiría el dato de los bordados
  /// existentes, D3): se OCULTA cuando el tipo no lo usa. Por DATO y no por código, para que
  /// un tipo nuevo tipo-bordado lo prenda sin tocar el programa. Seed: `true` solo en bordado.
  usaPuntadas Boolean @default(false) @map("usa_puntadas")

  /// Etapas de envío/recibo de maquila de este proceso (F3, Restrict): un tipo de
  /// proceso en uso por una etapa no se borra físico → se desactiva.
  etapas      EtapaMovimiento[]
  /// Cargos a maquileros (EsMa) de este proceso (F3, Restrict).
  cargosEsMa  EsMaCargo[]
  /// Artes del MODELO de este tipo (V1-E3f, Restrict): un tipo en uso no se borra físico.
  artesModelo ModeloArte[]
  /// Artes congelados en ÓRDENES de este tipo (V1-E3f, Restrict).
  artesOrden  OrdenArte[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("tipos_proceso")
}

// NOTA (fusión de terceros, D12/R15): los modelos `Maquilero` y `MaquileroTipoProceso`
// se ELIMINARON. Un maquilero es ahora un Proveedor con sus roles de servicio (casillas
// de `RolProveedor`: maquila-costura, estampado, bordado, lavado, aplicación…). Sus
// atributos propios (corto/asegurado/obsPago) se portaron a `Proveedor`.

/// Talla individual (catálogo global, D4 — PLANMAESTRO §4; MEJORAS A6: anchos fijos
/// T1..T8 → catálogo). `orden` da el orden canónico de despliegue (NO único en BD;
/// lo gestiona el dominio).
model Talla {
  id       Int     @id @default(autoincrement())
  /// Etiqueta de la talla (XCH, CH, M, G, XG, 28, 30…). Única global.
  etiqueta String  @unique
  orden    Int     @default(0)
  activo   Boolean @default(true)

  curvas                 CurvaTallaItem[]
  /// Cantidades de matriz de órdenes en esta talla (F2-E2, Restrict).
  ordenLineasTalla       OrdenLineaTalla[]
  /// Renglones de etapas de producción en esta talla (F3-E1, D4). Restrict.
  etapasMovimientoDet    EtapaMovimientoDet[]
  /// Renglones de kardex PT en esta talla (F3-E1, D4). Restrict.
  movimientosDetPt       MovimientoDetPt[]
  /// Cantidades de la matriz talla×color de renglones de OC en esta talla (F4-E2). Restrict.
  ordenCompraLineasTalla OrdenCompraLineaTalla[]
  /// Renglones de inventario cíclico en esta talla (F7-E5). Restrict.
  inventarioCiclicoDet   InventarioCiclicoDet[]
  /// Medidas por talla de avíos del BOM (F8-E1, R18). Restrict.
  modeloAvioTallas       ModeloAvioTalla[]
  /// Medidas por talla de avíos de la RECETA DE LA ORDEN (V1-E3d, R18). Restrict.
  ordenAvioTallas        OrdenAvioTalla[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("tallas")
}

/// Curva de tallas (D4): conjunto ORDENADO de tallas (p. ej. "Caballero básica").
model CurvaTalla {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  activo Boolean @default(true)

  items   CurvaTallaItem[]
  /// Modelos que usan esta curva de tallas (F1-E4, D4 — FK nullable Restrict).
  modelos Modelo[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("curvas_talla")
}

/// Renglón de una curva (maestro-detalle ordenado). Una talla aparece UNA vez por
/// curva (PK compuesta); `posicion` da el orden dentro de la curva (lo asigna el
/// dominio; no único en BD para permitir reordenar en tx). Cascade hacia CurvaTalla
/// (permite reescribir el set en la tx), Restrict hacia Talla (una talla usada por
/// una curva no se borra físico → se desactiva, con mensaje claro).
model CurvaTallaItem {
  idCurva  Int @map("id_curva")
  idTalla  Int @map("id_talla")
  posicion Int

  curva CurvaTalla @relation(fields: [idCurva], references: [id], onDelete: Cascade)
  talla Talla      @relation(fields: [idTalla], references: [id], onDelete: Restrict)

  creadoEn    DateTime @default(now()) @map("creado_en")
  creadoPorId String?  @map("creado_por_id")

  @@id([idCurva, idTalla])
  @@index([idTalla])
  @@map("curva_talla_item")
}

/// Tipo de dato de un campo de referencia de cliente (D7). Para validar el VALOR en F2.
enum TipoCampoCliente {
  TEXTO
  NUMERO
  FECHA

  @@map("tipo_campo_cliente")
}

/// Cliente (catálogo global, F1-E2). El viejo solo tiene Id/Cliente/Activo
/// (doc 02-Pedidos §2); v2 agrega contacto básico. Los VALORES de los campos de
/// referencia (OrdenReferencia) son de F2; aquí: catálogo + DEFINICIÓN de campos (D7).
model Cliente {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique
  /// Razón social (nombre legal para la factura si difiere del comercial). Opcional; espejo de
  /// `Proveedor.razonSocial`. Se usará al conciliar el receptor de un CFDI de venta (F9).
  razonSocial String? @map("razon_social")
  /// ABREVIATURA del cliente — el `CYA` de un código de DESARROLLO `CYA-26-71-001` (§Post-F9.34,
  /// V1-E3n). Única entre clientes; NULL mientras no se capture (y sin ella el cliente no puede
  /// estrenar modelos de desarrollo: el código no se puede armar). Cambiarla NO renumera los
  /// códigos ya emitidos: quedaron congelados.
  /// ⚠️ Desde V1-E7b la CAPTURA exige **3 letras A–Z** (Daniel lo especificó así las dos veces que
  /// tocó el tema; con longitud variable el código deja de alinearse). La columna sigue siendo
  /// TEXT libre A PROPÓSITO: la regla es de escritura, y un valor viejo de otra longitud tiene que
  /// poder LEERSE (D3). El Zod de entrada la aplica; el de salida no.
  abreviatura String? @unique
  contacto    String?
  telefono    String?
  email       String?
  direccion   String?
  /// RFC fiscal del cliente (F9-E4, R12). Se usa para conciliar el RECEPTOR de un CFDI de VENTA
  /// importado con el cliente al que se le carga. Validado en Zod si viene (forma del RFC mexicano).
  /// NULL si no se ha capturado (el match del cliente entonces va por elección manual).
  rfc         String?
  /// Días de crédito del cliente (F9-E4, D15d): base del aging de CxC (fecha de la venta + días de
  /// crédito = vencimiento). NULL o 0 = contado. Espejo de `Proveedor.diasCredito` para CxP.
  diasCredito Int?    @map("dias_credito")
  activo      Boolean @default(true)

  campos                 ClienteCampo[]
  /// Pedidos internos del cliente (F2-E1, Restrict hacia el cliente).
  pedidos                Pedido[]
  /// Órdenes de producción del cliente (F2-E2, Restrict hacia el cliente).
  ordenes                Orden[]
  /// Renglones del EDR asociados a este cliente (F7-E2, corte por cliente). Restrict.
  edrLineas              EdrLinea[]
  /// Registros de productividad de almacén ligados a este cliente (F7-E4, opcional). Restrict.
  registrosProductividad RegistroProductividad[]
  /// Muestrarios pendientes de este cliente (F7-E4). Restrict.
  muestrarios            Muestrario[]
  /// Departamentos del cliente (F8-E1, D13 — ej. NIÑOS/DAMAS). Cascade (config del cliente).
  departamentos          ClienteDepartamento[]
  /// Factores de lista de precios del cliente (F8-E1/E4, con override por departamento). Cascade.
  factores               ClienteFactores[]
  /// Proyectos de desarrollo de este cliente (F8-E2). Restrict.
  proyectos              Proyecto[]
  /// Listas de precios de este cliente (F8-E4). Restrict.
  listasPrecios          ListaPrecios[]
  /// Cotizaciones que se le han mandado a este cliente (V1-E7c). Restrict: el documento nombra
  /// a su destinatario, así que un cliente con cotizaciones no se borra.
  cotizaciones           Cotizacion[]
  /// Plantillas de importación del pedido del cliente (rediseño R8, B15 — mapeo de su Excel). Restrict.
  plantillasImportacion  PlantillaImportacion[]
  /// Ligas APRENDIDAS modelo-del-cliente → nuestro modelo (importador de OC por PDF). Cascade.
  modeloLigas            ClienteModeloLiga[]
  /// Movimientos de cuenta corriente (CxC) de este cliente (F9-E1). Restrict.
  movimientosTerceros    MovimientoTercero[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("clientes")
}

/// Plantilla de IMPORTACIÓN del pedido del cliente (rediseño R8, B15 — proto §4.1 "Etapa 3"): el
/// cliente manda su Orden de Compra en SU formato (Excel); aquí se guarda, POR CLIENTE, cómo mapear
/// cada columna de su archivo (uno de: modelo del cliente / color / talla / cantidad / precio /
/// ignorar) para que las siguientes veces se importe solo. VERSIONADA e INMUTABLE por versión:
/// "guardar cambios" crea una versión NUEVA (no edita la vieja); a lo más UNA `vigente` por cliente
/// (regla de dominio bajo transacción, como el borrador único de `Precosto`). `mapeo` es JSON: por
/// cada columna, su índice + encabezado + rol. Restrict hacia Cliente (una plantilla no se borra al
/// borrar el cliente — igual que proyectos/listas). Auditoría uniforme (A7).
model PlantillaImportacion {
  id                  Int     @id @default(autoincrement())
  idCliente           Int     @map("id_cliente")
  cliente             Cliente @relation(fields: [idCliente], references: [id], onDelete: Restrict)
  /// Nombre descriptivo del formato (p. ej. "OC C&A — hoja Estilos").
  nombre              String
  /// Nº de versión (1, 2, …) DENTRO del cliente. Guardar cambios = versión nueva; la vieja se conserva.
  version             Int
  /// La versión que se aplica hoy. A lo más UNA `true` por cliente (lo garantiza el dominio en tx).
  vigente             Boolean @default(true)
  /// FORMATO del archivo del cliente (importador de OC, petición Daniel): `excel` = OC en Excel con
  /// mapeo de columnas (R8, el histórico); `pdf-cya` = OC en PDF de C&A, parseada por un extractor EN
  /// CÓDIGO (por anclas de etiqueta) — ahí `mapeo` va vacío y la config viva vive en `camposVariables`.
  /// Default `excel` (las plantillas R8 existentes lo son). Nuevos formatos por cliente = nuevo valor
  /// aquí + su extractor, sin migración.
  formato             String  @default("excel")
  /// Mapeo de columnas: `[{ indice, columna, rol }]` — `rol` ∈ modeloCliente|color|talla|cantidad|precio|ignorar.
  /// Sólo para `formato='excel'`; en `pdf-cya` es `[]` (el extractor es por-cliente en código).
  mapeo               Json
  /// CAMPOS VARIABLES por cliente (Daniel: "poder poner más variables por cliente" sin migración):
  /// `[{ campo, etiqueta }]` — qué campo del PDF (p. ej. `subDivision`, `semanaCliente`) se captura como
  /// REFERENCIA del cliente (D7) en cada OP, y con qué etiqueta. NULL en `excel`. JSON para crecer sin migrar.
  camposVariables     Json?   @map("campos_variables")
  /// % ADICIONAL de producción por cliente (petición Daniel): C&A acepta entregar hasta 5% de más;
  /// Daniel fabrica ese 5% + 2% de merma → ~7% arriba. Al importar, la MATRIZ de cada OP se genera con
  /// `ceil(cantidad_cliente × (1 + pct/100))` por talla; el RENGLÓN del pedido conserva la cantidad
  /// ORIGINAL (lo contractual) y el precio unitario NO cambia. Default 0 (sin adicional). C&A queda en 7.
  porcentajeAdicional Decimal @default(0) @map("porcentaje_adicional") @db.Decimal(5, 2)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idCliente, version])
  @@index([idCliente])
  @@map("plantilla_importacion")
}

/// Liga APRENDIDA modelo-del-cliente → nuestro modelo (importador de OC por PDF, petición Daniel): el
/// "Modelo ID" que trae la OC del cliente (p. ej. C&A `3138277`) NO es nuestro código de modelo; la
/// PRIMERA vez el usuario lo liga a mano en la vista previa, y aquí queda GUARDADO para que la próxima
/// importación lo proponga solo. Clave de negocio = `(idCliente, modeloCliente)` (@@unique). Cascade
/// hacia Cliente (config del cliente); Restrict hacia Modelo (un modelo ligado no se borra físico).
/// `modeloCliente` se guarda tal cual viene en el PDF; la comparación normaliza (trim/minúsculas) en
/// el dominio. Auditoría uniforme (A7).
model ClienteModeloLiga {
  id            Int     @id @default(autoincrement())
  idCliente     Int     @map("id_cliente")
  cliente       Cliente @relation(fields: [idCliente], references: [id], onDelete: Cascade)
  /// Identificador del modelo TAL COMO viene en la OC del cliente (C&A: "Modelo ID").
  modeloCliente String  @map("modelo_cliente")
  idModelo      Int     @map("id_modelo")
  modelo        Modelo  @relation(fields: [idModelo], references: [id], onDelete: Restrict)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idCliente, modeloCliente])
  @@index([idModelo])
  @@map("cliente_modelo_liga")
}

/// Definición de un campo de referencia POR cliente (D7 — PLANMAESTRO §4). Cada
/// cliente define SUS campos (p. ej. "No. de pedido del cliente", semilla del Monarch
/// viejo, D7). `etiqueta` única DENTRO del cliente. Borrado suave (`activo`). Los
/// valores se capturan por orden en F2 (OrdenReferencia): el dominio documenta YA que
/// un campo con valores NO se borrará físico (regla para F2). Cascade desde Cliente.
model ClienteCampo {
  id        Int              @id @default(autoincrement())
  idCliente Int              @map("id_cliente")
  etiqueta  String
  tipo      TipoCampoCliente @default(TEXTO)
  orden     Int              @default(0)
  activo    Boolean          @default(true)

  cliente          Cliente           @relation(fields: [idCliente], references: [id], onDelete: Cascade)
  /// Valores de este campo capturados en órdenes (F2-E2, D7 — Restrict: un campo con valores
  /// en órdenes no se borra físico → se desactiva).
  referenciasOrden OrdenReferencia[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idCliente, etiqueta])
  @@index([idCliente])
  @@map("cliente_campo")
}

// ─────────────────────────────────────────────────────────────────────────────
// Catálogos de MATERIALES (F1-E3) — los tres catálogos complejos que alimentan el
// BOM (docs/hoja-de-ruta/F1-etapas.md §F1-E3). Maestros GLOBALES (sin idEmpresa,
// ADR-0007/A9) con auditoría uniforme (A7) y borrado suave (`activo`):
//  • Telas UNIFICADAS (D5): una SOLA entidad `Tela` para BOM e inventario —corrige la
//    dualidad Telas/TelasDis del viejo— con su clasificación (`TelaCategoria`) y su grid
//    de colores con precio (`TelaColor`, N:N a Color). El mapeo Telas/TelasDis→Tela es
//    del ETL de E6, no aquí (ADR-0009).
//  • Avíos (R1): catálogo `Avio` (ex `Habilitacion`) con sus proveedores y precios
//    (`AvioProveedor`, N:N a Proveedor). `unidad`/`presentacion` NULLABLE (obligatorias
//    solo en altas nuevas por UI; relajadas para los 629 avíos migrados en E6 — ADR-0009).
//    `precioReferencia` es el fallback de precio cuando no hay proveedor mapeable (ADR-0009).
//  • Bordados (R2): existió como catálogo `Bordado` hasta V1-E3d; hoy el arte vive
//    DENTRO del modelo (`ModeloArte`, §Post-F9.35) — aquí ya no hay catálogo de arte.
// onDelete: Restrict hacia los catálogos en uso (Color, Proveedor, TelaCategoria — se
// desactivan, no se borran físico); Cascade hacia el maestro padre en los puentes
// (Tela en TelaColor, Avio en AvioProveedor — permite reescribir el set en la tx A2).
// Mismo patrón que F1-E1B (Proveedor↔RolProveedor) y F1-E2 (Maquilero↔TipoProceso).
// ─────────────────────────────────────────────────────────────────────────────

/// Unidad en que se compra Y se consume una tela (Daniel, 30-jul-2026: *"todo lo que se compra en
/// kilos se consume en kilos y lo que se compra en metros se consume en metros"*). Son las DOS que
/// existen — el sistema viejo ya lo llevaba así (`Telas.Medida`: -1 = Kilos, 0 = Metros).
enum UnidadTela {
  KG
  M

  @@map("unidad_tela")
}

/// Tipo de componente de una tela dentro del lote (D5 — doc 04-Inventarios §B.1:
/// telas de dos componentes, p. ej. felpa + cardigan del mismo lote). `OTRO` cubre
/// acompañantes y telas de un solo componente. Sustituye la dualidad fija
/// ExTela1/ExTela2 del viejo (que F4 generaliza a N acompañantes por lote, D5).
enum TipoComponenteTela {
  CUERPO
  CARDIGAN
  OTRO

  @@map("tipo_componente_tela")
}

// NOTA (V1-E3f, §Post-F9.58/.59): el enum `TipoArte` (BORDADO/ESTAMPADO) se ELIMINÓ. El tipo
// del arte ya no es una lista fija en el programa: es una FK al catálogo administrable
// `TipoProceso` marcado con `esArte` — un solo catálogo para el proceso y para el arte,
// aprobado por Daniel (*"De acuerdo. Y un solo catálogo."*). La migración tradujo
// BORDADO→"bordado" y ESTAMPADO→"estampado" sin perder ninguna fila.

/// Composición de una tela ("50% Algodón, 50% Poliéster") como CATÁLOGO, no texto libre
/// (Daniel, 6-ago-2026 §Post-F9.11: *"de un catálogo de composiciones para mantener misma
/// congruencia"*). Única global (ADR-0007); borrado suave (una composición en uso no se borra).
model ComposicionTela {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  activo Boolean @default(true)

  /// Telas con esta composición. Restrict: en uso no se borra físico.
  telas Tela[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("composiciones_tela")
}

/// Categoría de tela (catálogo global, F1-E3; en la UI se lee "Tipo de tela", §Post-F9.11).
/// Equivale a `TelasCategorias` del viejo (doc 04-Inventarios §B.2): agrupa las telas (Felpa,
/// Jersey, Rib…). Sin permiso propio: se gobierna con `telas.administrar` (ADR-0009). Borrado
/// suave + auditoría A7.
model TelaCategoria {
  id     Int     @id @default(autoincrement())
  /// Nombre de la categoría. Único global (ADR-0007).
  nombre String  @unique
  /// Borrado suave (plan §4: patrón conservado del sistema viejo).
  activo Boolean @default(true)

  /// Telas clasificadas en esta categoría.
  telas Tela[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("telas_categorias")
}

/// Tela UNIFICADA (catálogo global, F1-E3, D5 — ADR-0009). UNA sola entidad que sirve
/// al BOM (doc 01-Modelos §2, TelasDis) Y al inventario (doc 04-Inventarios §B.2, Telas):
/// corrige la dualidad Telas/TelasDis del viejo. Diseñada para que Lote/LoteComponente
/// de F4 cuelguen de ella sin retocarla. El mapeo del par viejo → esta tabla lo hace el
/// ETL de E6. `idCategoria` OPCIONAL (no romper el ETL si la tela vieja no trae categoría).
model Tela {
  id           Int            @id @default(autoincrement())
  /// Nombre de la tela. Único global (ADR-0007).
  nombre       String         @unique
  descripcion  String?
  /// Categoría (opcional para no romper el ETL de E6). Restrict: una categoría en uso
  /// no se borra físico → se desactiva.
  idCategoria  Int?           @map("id_categoria")
  categoria    TelaCategoria? @relation(fields: [idCategoria], references: [id], onDelete: Restrict)
  /// Unidad en que se compra y se consume (kg o m). OBLIGATORIA: de ella depende que el stock, el
  /// consumo y el costo por prenda signifiquen algo. Era texto libre y venía NULL en todas las
  /// telas — se cerró a enum el 30-jul-2026 (ver {@link UnidadTela}).
  unidadMedida UnidadTela     @default(KG) @map("unidad_medida")

  // ── Identidad en 4 datos (Daniel, 6-ago-2026 §Post-F9.11): tipo (= la categoría de arriba) ·
  // composición · proveedor dueño · nombre del proveedor. Se lee "Felpa · Alsatex · Felpa Suiza". ──

  /// Composición ("50% Algodón, 50% Poliéster"), del catálogo. Opcional en las 877 migradas
  /// (el viejo no la traía); la UI la pide en telas nuevas. Restrict.
  idComposicion   Int?             @map("id_composicion")
  composicion     ComposicionTela? @relation(fields: [idComposicion], references: [id], onDelete: Restrict)
  /// Proveedor DUEÑO del artículo: la felpa de Alsatex y la de otro proveedor son telas DISTINTAS
  /// (no son el mismo rollo y no se revuelven en inventario). OBLIGATORIO en telas nuevas (lo exige
  /// el contrato, no la base): en las migradas viene NULL porque el viejo lo embebía en el nombre
  /// ("FelpaAlsa") y se va llenando al depurar. Restrict.
  idProveedor     Int?             @map("id_proveedor")
  proveedor       Proveedor?       @relation("TelaProveedorDueno", fields: [idProveedor], references: [id], onDelete: Restrict)
  /// Cómo le llama el proveedor a esta tela ("Felpa Suiza"). Buscable.
  nombreProveedor String?          @map("nombre_proveedor")

  // ── El COMPLEMENTO es PARTE de la misma tela (Daniel: *"es como parte de la misma tela para el
  // manejo de todo… mismo color, mismo pantone"*). Una tela = cuerpo + complemento OPCIONAL, nunca
  // más de uno; entradas y salidas van SIEMPRE juntas (un renglón, dos cantidades — el viejo ya lo
  // hacía: ExTela1/ExTela2). Comprar solo complemento = entrada con el cuerpo en 0. ──

  /// Nombre del componente CUERPO ("Felpa", "Terry"; viejo: `Texto1`). Null = sin nombre especial.
  nombreCuerpo      String?            @map("nombre_cuerpo")
  /// Nombre del COMPLEMENTO ("Cardigan"; viejo: `Texto2`). NULL = esta tela NO lleva complemento —
  /// esa es la bandera: se define desde el alta, como pidió Daniel.
  nombreComplemento String?            @map("nombre_complemento")
  /// Rol típico de la tela en el lote (D5: cuerpo/cardigan/otro). Default OTRO.
  /// LEGADO desde A1.1 (Daniel, 6-ago-2026): redundante con nombreCuerpo/nombreComplemento;
  /// la UI ya no lo captura ni lo muestra. La columna se conserva (sin migración de borrado).
  tipoComponente    TipoComponenteTela @default(OTRO) @map("tipo_componente")
  /// Peso de la tela en gramos por metro cuadrado (A1.1, Daniel 6-ago-2026). Informativo, opcional.
  peso              Decimal?           @db.Decimal(8, 2)
  /// Ancho de la tela en metros (A1.1). Informativo, opcional.
  ancho             Decimal?           @db.Decimal(8, 2)
  /// Tela de uso frecuente (preselección en la UI de captura).
  favorito          Boolean            @default(false)
  /// Precio de referencia por unidad (informativo; el costo real va por lote/orden).
  precioSugerido    Decimal?           @map("precio_sugerido") @db.Decimal(12, 2)
  /// ¿Es tela de producción (vs. muestra/insumo no productivo)? Default true.
  /// LEGADO desde A1.1 (Daniel, 6-ago-2026): la casilla salió de la UI (ya no se captura ni
  /// se muestra); el dato se conserva con su default server-side. La columna NO se borra.
  paraProduccion    Boolean            @default(true) @map("para_produccion")
  /// Borrado suave (plan §4: patrón conservado del sistema viejo).
  activo            Boolean            @default(true)

  /// Colores disponibles de esta tela con su precio (N:N a Color).
  colores            TelaColor[]
  /// Renglones del BOM de modelos que usan esta tela (F1-E4, Restrict hacia la tela).
  modelos            ModeloTela[]
  /// Renglones de la RECETA CONGELADA de órdenes que usan esta tela (V1-E3d, Restrict).
  ordenTelas         OrdenTela[]
  /// Órdenes de producción que disponen de esta tela (F2-E2, Restrict).
  ordenes            Orden[]
  /// Renglones de kardex de TELA de esta tela (dimensión tela×lote, D5). Las filas las
  /// ejercita F4 (el inventario de telas); la tabla nace en F3-E1 para fijar el motor
  /// genérico. Restrict.
  movimientosDetTela MovimientoDetTela[]
  /// Componentes de lote que usan esta tela (F4-E1, D5: un lote trae N telas). Restrict.
  loteComponentes    LoteComponente[]
  /// Renglones de orden de compra que piden esta tela (F4-E2). Restrict.
  ordenCompraLineas  OrdenCompraLinea[]
  /// Renglones de explosión MRP que requieren esta tela (F4-E4, R3). Restrict.
  requerimientos     RequerimientoOrden[]
  /// Renglones de nota de salida que envían esta tela a maquila (F4-E5). Restrict.
  notaSalidaLineas   NotaSalidaLinea[]
  /// Precios de esta tela por proveedor (F8-E1, D13/R17 — espejo de AvioProveedor). Cascade (config de la tela).
  proveedoresPrecio  TelaProveedor[]
  /// Renglones de precosto que valúan esta tela (F8-E3, traza del amarre). Restrict.
  precostoLineas     PrecostoLinea[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("telas")
}

/// Puente N:N tela ↔ color con precio (F1-E3). Equivale a `TelasColores` del viejo
/// (doc 04-Inventarios §B.2). PK compuesta (idTela, idColor): un color aparece UNA vez
/// por tela. `onDelete`:
///  • Cascade hacia `Tela`: los colores son configuración de la tela; permite reescribir
///    el grid de colores en la transacción A2.
///  • Restrict hacia `Color`: un color usado por alguna tela no se borra físico (se
///    desactiva con `activo`, con mensaje claro), para no dejar el par colgando.
/// Auditoría COMPLETA: `precio` es editable (A7).
/// COLOR DE TELA — HIJO de la tela, NO catálogo global (Daniel, 6-ago-2026 §Post-F9.11 punto 3:
/// nombre LIBRE + pantone + dos precios; *"para no fragmentar, el campo sugiere los colores que
/// ESA tela ya tiene"*). El catálogo global `Color` es SOLO el color de la PRENDA (matriz de la
/// OP / WIP) y NO se toca: dar de alta "Marino Alsa 3040" en una tela NO debe meterlo al
/// catálogo de prenda. Unicidad del nombre POR TELA (el dominio la valida insensible a
/// mayúsculas; el unique exacto respalda la carrera, mismo patrón que `Color.nombre`).
model TelaColor {
  id                Int      @id @default(autoincrement())
  idTela            Int      @map("id_tela")
  /// Nombre LIBRE del color de ESTA tela ("Marino Alsa 3040"). Único por tela.
  nombre            String
  /// Pantone del color de ESTA tela (Daniel: va ligado al color de cada tela; dos partidas pueden
  /// traer tonos distintos del MISMO pantone). Opcional y buscable.
  pantone           String?
  /// Precio del metro/kg del CUERPO en este color (informativo; el costo real va por lote).
  precio            Decimal? @db.Decimal(12, 2)
  /// Precio del COMPLEMENTO en este color (Daniel: *"el cardigan es otro precio que la tela"*).
  /// Solo tiene sentido si la tela lleva complemento; el dominio lo rechaza si no.
  precioComplemento Decimal? @map("precio_complemento") @db.Decimal(12, 2)
  /// LEGACY (solo filas migradas de F1-E6): liga al catálogo global de color de PRENDA que el
  /// N:N viejo usaba. Se conserva para que el MRP/precosto sigan resolviendo precio por esa liga
  /// en lo migrado y para la fusión de colores duplicados. Las filas NUEVAS nacen con NULL: el
  /// color de tela ya NO cuelga del catálogo de prenda (§Post-F9.11).
  idColor           Int?     @map("id_color")
  color             Color?   @relation(fields: [idColor], references: [id], onDelete: Restrict)

  tela Tela @relation(fields: [idTela], references: [id], onDelete: Cascade)

  /// Partidas (entradas) de esta tela+color al inventario nuevo (A2 §Post-F9.9 opción B). Restrict.
  partidas           PartidaTela[]
  /// Renglones de kardex de TELA del inventario NUEVO por color (cuerpo+complemento juntos). Restrict.
  movimientosDetTela MovimientoDetTela[]
  /// Renglones de documentos de ENTRADA de tela por factura/remisión (B1). Restrict.
  entradaTelaLineas  EntradaTelaLinea[]

  // ⭐⭐ V1-E3u (§Post-F9.89) — LA TELA SE COMPRA POR COLOR. Todo Restrict: un color que ya se
  // amarró a una receta, se requirió o se pidió en una OC no se borra físico del catálogo.
  /// Amarres "color de prenda → este color de tela" de las recetas de orden.
  ordenTelaColores OrdenTelaColor[]
  /// Renglones del snapshot de explosión (MRP) que piden ESTE color.
  requerimientos   RequerimientoOrden[]
  /// Renglones de orden de compra que piden ESTE color.
  lineasCompra     OrdenCompraLinea[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idTela, nombre])
  @@index([idColor])
  @@map("telas_colores")
}

/// PARTIDA de tela (etapa A2 del inventario nuevo — Daniel §Post-F9.9 opción B, §Post-F9.11):
/// la UNIDAD DE ENTRADA del inventario de telas por COLOR. Cada entrada (compra/ajuste inicial)
/// crea una partida con FOLIO PROPIO consecutivo POR EMPRESA (A3, secuencia `partida-tela`) y,
/// opcional, el número de LOTE del proveedor (texto buscable). La partida cuelga de `TelaColor`
/// (resuelve la dualidad vieja `Lote.idColor` vs `TelaColor` anotada en HOJA-DE-RUTA §4): el
/// color de la partida ES el color-hijo de la tela, no el catálogo de prenda. El CONSUMO empareja
/// por TELA+COLOR (las salidas NO obligan a escoger partida — `MovimientoDetTela.idPartida` va
/// NULL en salidas); la partida queda como traza de entrada y para búsquedas. La EXISTENCIA NO
/// vive aquí (D3): es Σ de `MovimientoDetTela` por tela×color×almacén. Auditoría A7. El
/// inventario viejo por `Lote` NO se toca (queda como legado consultable).
model PartidaTela {
  id        Int     @id @default(autoincrement())
  /// Folio consecutivo POR EMPRESA (A3 — secuencia `partida-tela`, jamás Max()+1).
  folio     BigInt
  idEmpresa Int     @map("id_empresa")
  empresa   Empresa @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)

  /// Color de tela (hijo de la tela) que entró en esta partida. Restrict.
  idTelaColor Int       @map("id_tela_color")
  telaColor   TelaColor @relation(fields: [idTelaColor], references: [id], onDelete: Restrict)

  /// Número de lote del PROVEEDOR (texto libre, opcional y buscable — opción B de Daniel).
  loteProveedor String?   @map("lote_proveedor")
  /// Factura/remisión de la entrada (texto del proveedor; opcional).
  factura       String?
  /// Fecha de la entrada de la partida (solo fecha; opcional).
  fecha         DateTime? @db.Date
  observaciones String?   @db.Text

  /// Renglones de kardex de ENTRADA que trajeron esta partida (en salidas idPartida va NULL).
  movimientosDetTela MovimientoDetTela[]
  /// Renglón del documento de ENTRADA de tela (B1) que creó esta partida al confirmarse. Inversa.
  entradaTelaLineas  EntradaTelaLinea[]
  /// Renglones de RECEPCIÓN de compra (con OC) que crearon esta partida al recibirse (B1). Inversa.
  recepcionLineas    RecepcionCompraLinea[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idEmpresa, folio])
  @@index([idTelaColor])
  @@index([loteProveedor])
  @@map("partidas_tela")
}

/// Tipo del DOCUMENTO del proveedor que ampara una entrada de tela sin orden de compra (B1 —
/// Daniel §Post-F9.9 punto 7: *"permitir las dos vías (con orden de compra y por factura/remisión
/// sin OC)"*).
enum TipoDocumentoEntradaTela {
  factura
  remision

  @@map("tipo_documento_entrada_tela")
}

/// Estado del documento de entrada de tela (B1). `borrador` = capturado, todavía NO tocó el
/// inventario (se puede editar y se le puede adjuntar el PDF); `confirmada` = ya creó sus
/// partidas y su movimiento de kardex (inmutable, D3); `cancelada` = anulada (si estaba
/// confirmada, con su movimiento INVERSO auditado — nunca se edita ni se borra).
enum EstatusEntradaTela {
  borrador
  confirmada
  cancelada

  @@map("estatus_entrada_tela")
}

/// DOCUMENTO DE ENTRADA de tela por FACTURA/REMISIÓN, SIN orden de compra (etapa B1 — Daniel
/// §Post-F9.9 punto 7 y §Post-F9.11). Es la segunda vía de entrada al inventario de telas por
/// COLOR: una CABECERA por documento del proveedor (factura o remisión, con su número) y N
/// PARTIDAS (`EntradaTelaLinea`), cada una con su color y sus cantidades de cuerpo/complemento.
/// La vía con OC sigue siendo `RecepcionCompra` (que desde B1 también entra por color/partida).
///
/// Reglas: folio propio consecutivo POR EMPRESA (A3, secuencia `entrada-tela`); scope por empresa
/// (A9); auditoría uniforme (A7). Al CONFIRMAR, en UNA transacción (A2), cada renglón crea SU
/// `PartidaTela` y el documento genera UN movimiento de kardex de entrada (`entrada-recepcion`,
/// origen `entrada-tela`) — la existencia sigue siendo Σ de movimientos (D3). Cancelar una entrada
/// confirmada genera el movimiento INVERSO auditado (NUNCA edita ni borra).
model EntradaTela {
  id        Int     @id @default(autoincrement())
  /// Folio consecutivo POR EMPRESA (A3 — secuencia `entrada-tela`, jamás Max()+1).
  folio     BigInt
  idEmpresa Int     @map("id_empresa")
  empresa   Empresa @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)

  /// Factura o remisión (el documento con que el proveedor ampara la entrega).
  tipoDocumento   TipoDocumentoEntradaTela @map("tipo_documento")
  /// Número del documento TAL COMO lo trae el proveedor (texto, buscable).
  numeroDocumento String                   @map("numero_documento")
  /// UUID (folio fiscal) del CFDI del que se leyeron los datos (§Post-F9.20 — Daniel: *"que la
  /// información la tomes del XML"*). NULL cuando se capturó a mano o el proveedor no mandó XML.
  /// ÚNICO por empresa: la misma factura no se recibe dos veces. El PDF adjunto es solo referencia.
  uuidCfdi        String?                  @map("uuid_cfdi")
  /// TOTAL del CFDI (la verdad fiscal, con impuestos): es el importe con el que nace la CUENTA POR
  /// PAGAR al confirmar (§Post-F9.21). NO se deriva de los renglones —esos son cantidad×precio sin
  /// IVA—: el cargo entra por lo que dice la factura. NULL si la entrada no nació de un CFDI.
  totalCfdi       Decimal?                 @map("total_cfdi") @db.Decimal(14, 2)
  /// RFC del EMISOR del CFDI, tal como venía en el XML. Se guarda por dos razones:
  ///  1. El cargo de CxP nace CON su RFC (igual que una importación de CFDI de F9), que es lo que
  ///     el reporte fiscal del contador imprime; sin él, la misma factura se veía distinta según
  ///     por dónde hubiera entrado.
  ///  2. Es lo que permite RE-VALIDAR el sello al editar el borrador —¿el proveedor que quedó sigue
  ///     siendo el que facturó?— sin volver a bajar el XML de R2.
  /// NULL si la entrada no nació de un CFDI (o si es anterior a esta columna).
  rfcCfdi         String?                  @map("rfc_cfdi")
  /// XML de la factura guardado en R2 (el mismo del que se leyeron los datos). Lo necesita el cargo
  /// fiscal de CxP para quedar respaldado, igual que una importación de CFDI de F9. SetNull.
  idArchivoCfdi   String?                  @map("id_archivo_cfdi")
  archivoCfdi     Archivo?                 @relation("EntradaTelaCfdi", fields: [idArchivoCfdi], references: [id], onDelete: SetNull)
  /// Proveedor que surtió la tela. Restrict.
  idProveedor     Int                      @map("id_proveedor")
  proveedor       Proveedor                @relation(fields: [idProveedor], references: [id], onDelete: Restrict)
  /// Fecha del documento (solo fecha) — es también la fecha del movimiento de kardex.
  fecha           DateTime                 @db.Date
  /// Almacén DESTINO al que entra la tela. Restrict.
  idAlmacen       Int                      @map("id_almacen")
  almacen         Almacen                  @relation(fields: [idAlmacen], references: [id], onDelete: Restrict)
  observaciones   String?                  @db.Text

  estatus EstatusEntradaTela @default(borrador)

  /// Movimiento de kardex de ENTRADA generado al CONFIRMAR (uno por documento). NULL mientras
  /// está en borrador. SetNull defensivo: los movimientos jamás se borran (D3).
  idMovimiento    Int?        @unique @map("id_movimiento")
  movimiento      Movimiento? @relation(fields: [idMovimiento], references: [id], onDelete: SetNull)
  confirmadaEn    DateTime?   @map("confirmada_en")
  confirmadaPorId String?     @map("confirmada_por_id")

  /// Cancelación SUAVE (D3/A7): cuándo, quién y por qué. Si estaba confirmada, el kardex se
  /// neutraliza con el movimiento INVERSO (el original NO se toca).
  canceladaEn       DateTime? @map("cancelada_en")
  canceladaPorId    String?   @map("cancelada_por_id")
  motivoCancelacion String?   @map("motivo_cancelacion") @db.Text

  /// Renglones/partidas del documento (cada uno crea SU partida al confirmar).
  lineas      EntradaTelaLinea[]
  /// Recepciones de compra generadas al confirmar (una por OC surtida, §Post-F9.14). Restrict.
  recepciones RecepcionCompra[]
  /// Adjuntos del documento (el PDF de la factura/remisión), en R2.
  archivos    EntradaTelaArchivo[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idEmpresa, folio])
  @@unique([idEmpresa, uuidCfdi])
  @@index([idProveedor])
  @@index([idAlmacen])
  @@index([estatus])
  @@index([numeroDocumento])
  @@map("entradas_tela")
}

/// Un RENGLÓN (= una PARTIDA) del documento de entrada de tela (B1). Cada renglón es una partida:
/// una factura con dos lotes del MISMO tela+color son DOS renglones = DOS partidas (regla ya
/// establecida en A2, DECISIONES §Post-F9.11 punto 4) — por eso NO hay unicidad por color.
/// `cantidad` es el CUERPO (admite 0: compra de solo complemento) y `cantidadComplemento` viaja
/// SIEMPRE junta (NULL = la tela no lleva complemento).
///
/// PRECIOS (D1): `precioUnit` es el precio por unidad del CUERPO y es el que viaja al kardex como
/// `costoUnit` del renglón de `MovimientoDetTela` (el kardex valúa `costoUnit × cuerpo`);
/// `precioUnitComplemento` es el precio del complemento (Daniel: *"el cardigan es otro precio que
/// la tela"*) y vive AQUÍ, en el documento, porque el renglón de kardex sólo tiene una columna de
/// costo. En un renglón de SOLO complemento (cuerpo 0) el kardex va sin costo y el dinero queda
/// en el documento.
model EntradaTelaLinea {
  id            Int         @id @default(autoincrement())
  idEntradaTela Int         @map("id_entrada_tela")
  entradaTela   EntradaTela @relation(fields: [idEntradaTela], references: [id], onDelete: Cascade)

  /// Color de tela (hijo de la tela) que entra en este renglón. Restrict.
  idTelaColor Int       @map("id_tela_color")
  telaColor   TelaColor @relation(fields: [idTelaColor], references: [id], onDelete: Restrict)

  /// Cantidad del CUERPO (≥ 0; 0 = el renglón es de solo complemento).
  cantidad              Decimal  @db.Decimal(14, 4)
  /// Cantidad del COMPLEMENTO (cardigan). NULL = la tela no lleva complemento.
  cantidadComplemento   Decimal? @map("cantidad_complemento") @db.Decimal(14, 4)
  /// Precio unitario del CUERPO (viaja al kardex como `costoUnit`, D1). Opcional.
  precioUnit            Decimal? @map("precio_unit") @db.Decimal(12, 4)
  /// Precio unitario del COMPLEMENTO (vive en el documento; el kardex no lo valúa hoy). Opcional.
  precioUnitComplemento Decimal? @map("precio_unit_complemento") @db.Decimal(12, 4)
  /// Número de lote del PROVEEDOR de esta partida (texto libre, opcional y buscable).
  loteProveedor         String?  @map("lote_proveedor")

  /// Partida creada al CONFIRMAR el documento (traza renglón ↔ partida). NULL en borrador. Restrict.
  idPartida Int?         @map("id_partida")
  partida   PartidaTela? @relation(fields: [idPartida], references: [id], onDelete: Restrict)

  /// Renglón de ORDEN DE COMPRA que este renglón de la factura SURTE (§Post-F9.14, petición de
  /// Daniel 7-ago-2026: *"al dar entrada de tela de una factura, la relacionemos con la OC de esa
  /// tela… se marca con estatus de recibido"*). NULL = tela sin orden de compra (compra suelta),
  /// que sigue siendo un caso válido. Es POR RENGLÓN a propósito: una factura del proveedor puede
  /// amparar tela de dos OCs distintas y hasta tela suelta en el mismo documento.
  ///
  /// Al CONFIRMAR el documento, los renglones con este campo generan la `RecepcionCompra` de su OC
  /// —la misma contabilidad que la recepción de F4— y por eso la OC pasa a `recibida_parcial` o
  /// `recibida_total`. Restrict: un renglón de OC ya surtido no se borra físico.
  idOrdenCompraLinea Int?              @map("id_orden_compra_linea")
  ordenCompraLinea   OrdenCompraLinea? @relation(fields: [idOrdenCompraLinea], references: [id], onDelete: Restrict)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idEntradaTela])
  @@index([idTelaColor])
  @@index([idOrdenCompraLinea])
  @@index([idPartida])
  @@map("entrada_tela_linea")
}

/// Adjunto de un documento de entrada de tela (B1): el PDF de la FACTURA/remisión del proveedor
/// (o cualquier soporte) en Cloudflare R2. Espejo de `OrdenArchivo`/`PedidoArchivo`. `onDelete`:
///  • Cascade hacia `EntradaTela`: los adjuntos son del documento.
///  • Cascade hacia `Archivo`: al quitar el adjunto se borra también su `Archivo` (el objeto
///    físico en R2 lo borra el dominio best-effort — ver `comun/archivos.ts`).
model EntradaTelaArchivo {
  id            Int    @id @default(autoincrement())
  idEntradaTela Int    @map("id_entrada_tela")
  idArchivo     String @map("id_archivo")

  entradaTela EntradaTela @relation(fields: [idEntradaTela], references: [id], onDelete: Cascade)
  archivo     Archivo     @relation(fields: [idArchivo], references: [id], onDelete: Cascade)

  creadoEn    DateTime @default(now()) @map("creado_en")
  creadoPorId String?  @map("creado_por_id")

  @@unique([idArchivo])
  @@index([idEntradaTela])
  @@map("entrada_tela_archivo")
}

/// LOTE de tela (F4-E1, D5 — doc 04-Inventarios §B.1/§B.3). Un lote es una compra/teñido
/// concreto que ENTRA al inventario: define el COLOR (el teñido) y trae 1..N telas
/// acompañantes (cuerpo + cardigan + …) del MISMO lote y color, para que casen los colores
/// (D5 elimina el límite viejo de 2 componentes `ExTela1/ExTela2`). El lote es la dimensión de
/// trazabilidad del kardex de telas: la existencia es por tela × lote × almacén (Σ de
/// movimientos, D3). `proveedor`/`factura`/`fecha` son los datos de la entrada (el viejo los
/// llevaba en `Entradas`); en v2 la entrada-recepción (E3) crea el lote en la MISMA transacción
/// que el movimiento de kardex. GLOBAL (sin idEmpresa — catálogo de materiales, ADR-0007: el
/// inventario por empresa lo da `Movimiento.idEmpresa`). Auditoría A7.
model Lote {
  id            Int        @id @default(autoincrement())
  /// Clave de negocio del lote (estable, p. ej. número de lote/teñido del proveedor). Única
  /// global. Para el ETL de lotes legacy sintetizados (E6) se genera una clave determinista.
  clave         String     @unique
  /// Color (teñido) del lote: TODOS sus componentes comparten este color (D5). Restrict.
  idColor       Int        @map("id_color")
  color         Color      @relation(fields: [idColor], references: [id], onDelete: Restrict)
  /// Proveedor que surtió el lote (opcional: el histórico legacy puede no mapearlo). Restrict.
  idProveedor   Int?       @map("id_proveedor")
  proveedor     Proveedor? @relation(fields: [idProveedor], references: [id], onDelete: Restrict)
  /// Factura de la entrada del lote (texto del proveedor; opcional para el legacy).
  factura       String?
  /// Fecha de la entrada/teñido del lote (solo fecha).
  fecha         DateTime?  @db.Date
  observaciones String?    @db.Text

  /// Componentes (telas) que llegaron en este lote (1..N, mismo color — D5).
  componentes        LoteComponente[]
  /// Renglones de kardex de TELA ligados a este lote (existencia por tela×lote×almacén, D3).
  movimientosDetTela MovimientoDetTela[]
  /// Renglones de kardex de AVÍO ligados a este lote (opcional, R4 — pocos avíos por lote).
  movimientosDetAvio MovimientoDetAvio[]
  /// Renglones de recepción de compra que crearon/usaron este lote (F4-E3, D5). Restrict.
  recepcionLineas    RecepcionCompraLinea[]
  /// Renglones de nota de salida que envían tela de este lote a maquila (F4-E5, D5). Restrict.
  notaSalidaLineas   NotaSalidaLinea[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idColor])
  @@index([idProveedor])
  @@map("lotes")
}

/// COMPONENTE de un lote (F4-E1, D5): una tela concreta dentro del lote, con la cantidad y el
/// peso que llegaron. Reemplaza el par fijo `ExTela1/ExTela2` del viejo por N renglones (un
/// lote puede traer cuerpo + cardigan + más). PK compuesta (idLote, idTela): una tela aparece
/// UNA vez por lote. `onDelete`: Cascade hacia `Lote` (los componentes son parte del lote; se
/// reescriben en la transacción A2 de la recepción); Restrict hacia `Tela` (una tela en uso no
/// se borra físico). La EXISTENCIA NO vive aquí (sería un saldo editable, prohibido por D3):
/// `cantidad` es la cantidad ORIGINAL que entró (dato de la entrada); el saldo real es Σ de
/// `MovimientoDetTela` por tela×lote×almacén. Auditoría A7.
model LoteComponente {
  idLote   Int      @map("id_lote")
  lote     Lote     @relation(fields: [idLote], references: [id], onDelete: Cascade)
  idTela   Int      @map("id_tela")
  tela     Tela     @relation(fields: [idTela], references: [id], onDelete: Restrict)
  /// Cantidad de esta tela que ENTRÓ en el lote (dato de la entrada; NO es la existencia — D3).
  cantidad Decimal  @db.Decimal(14, 4)
  /// Peso de esta tela en el lote (kg), informativo (ex `Entradas...Peso`). Opcional.
  peso     Decimal? @db.Decimal(14, 4)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@id([idLote, idTela])
  @@index([idTela])
  @@map("lote_componentes")
}

/// Avío / habilitación (catálogo global, F1-E3, R1). Equivale a `Habilitacion` del viejo
/// (doc 01-Modelos §2, con Favorito/CantFav). `unidad` y `presentacion` son campos NUEVOS
/// que el viejo no tiene: NULLABLE en BD a propósito (obligatorios SOLO en altas nuevas por
/// UI, que valida el dominio/Zod del form) para que el ETL de E6 cargue los 629 avíos
/// históricos sin esos datos (ADR-0009). `precioReferencia` es el fallback de precio cuando
/// el proveedor del precio histórico no es mapeable (ADR-0009, insumo del costeo F7).
model Avio {
  id               Int      @id @default(autoincrement())
  /// Clave de negocio del avío (estable). Única global y clave de captura.
  clave            String   @unique
  descripcion      String
  /// Unidad de CONSUMO (pza, m, kg…): en qué se mide CUÁNTO se gasta del avío por prenda.
  /// NULLABLE en BD; obligatoria en alta por UI (ADR-0009).
  unidad           String?
  /// ⭐ V1-E3g (§Post-F9.66) — Unidad de la ESPECIFICACIÓN, en qué se expresan las `medidas` de
  /// este avío (cm, mm, pulg…). **NO es lo mismo que `unidad`** y por eso es un campo aparte: un
  /// cierre se CONSUME en `pza` pero se PIDE por su largo en `cm`. Es la unidad que la UI pega al
  /// campo numérico de la medida y con la que el dominio decide si un número es absurdo
  /// (`dominio/catalogos/unidades-avio.ts`). NULL = el avío no maneja medidas, o la migración no pudo
  /// deducirla de las etiquetas viejas (entonces sus medidas quedan `requiereRevision`).
  unidadMedida     String?  @map("unidad_medida")
  /// Presentación/empaque (caja, rollo…). NULLABLE en BD; obligatoria en alta por UI (ADR-0009).
  presentacion     String?
  /// Avío de uso frecuente (preselección en la UI; si es favorito ⇒ `cantFav` obligatoria).
  favorito         Boolean  @default(false)
  /// Cantidad preestablecida cuando es favorito (la exige el dominio si `favorito`).
  cantFav          Decimal? @map("cant_fav") @db.Decimal(12, 2)
  /// Avío genérico de stock (R4 / Make-to-Order): no se compra por orden, se tiene en almacén.
  esGenerico       Boolean  @default(false) @map("es_generico")
  /// Precio de referencia (fallback de precio sin proveedor mapeable — ADR-0009).
  precioReferencia Decimal? @map("precio_referencia") @db.Decimal(12, 2)
  /// ⚰️ COLUMNA MUERTA — SIN ESCRITOR Y SIN LECTOR (V1-E8a, §Post-F9.97, decisión de Daniel del
  /// 23-ago-2026). NO LA USES Y NO LA REVIVAS.
  ///
  /// ⭐ LA REGLA QUE LA MATÓ: **la línea de orden de compra va SIEMPRE en unidad de consumo**
  /// (metro, pieza, kilo) — la misma unidad en la que el BOM consume el material y en la que
  /// Desarrollo lo costea. La presentación (rollo, caja, bolsa) NO es una unidad del sistema: si
  /// hay que decirla, va como texto informativo en `OrdenCompra.observaciones` o en
  /// `OrdenCompraLinea.descripcionLibre`.
  ///
  /// Hasta F4 esto guardaba el FACTOR presentación→consumo (cuántos metros trae un rollo) y el
  /// sistema traducía: × la cantidad, ÷ el precio. Esa traducción se hacía EN MEDIO DE LA CADENA
  /// DEL DINERO, que es donde se cuelan los errores que nadie ve: como multiplica la cantidad y
  /// divide el precio, el IMPORTE total sale idéntico —la invariante de valuación se cumple—
  /// sobre números equivocados. Y ya estaba equivocada: el MRP escribía la línea en unidad de
  /// consumo y la recepción la volvía a multiplicar por el factor al recibirla.
  ///
  /// **La columna se CONSERVA a propósito** (D3: en este proyecto nada se destruye) aunque no la
  /// lea nadie. Nunca tuvo escritor —jamás se pudo capturar desde el contrato ni desde el ETL— así
  /// que está en NULL en todas las filas, y con el factor en NULL presentación ≡ consumo: toda
  /// línea histórica es válida en la lectura de hoy. Dejarla vacía es la garantía de que sigue
  /// muerta.
  factorConversion Decimal? @map("factor_conversion") @db.Decimal(14, 6)
  /// Borrado suave (plan §4: patrón conservado del sistema viejo).
  activo           Boolean  @default(true)

  /// Proveedores que surten este avío con su precio (N:N a Proveedor).
  proveedores        AvioProveedor[]
  /// Medidas del avío "por medida" (rediseño R5, B11) — cierres, elástico… Si tiene ≥1 medida
  /// ACTIVA, el avío se considera "por medida": el precosto usa el PROMEDIO de sus precios y la
  /// compra/MRP desglosa por medida×talla. Agrupadas DENTRO del avío padre (decisión Daniel).
  medidas            AvioMedida[]
  /// Renglones del BOM de modelos que usan este avío (F1-E4, Restrict hacia el avío).
  modelos            ModeloAvio[]
  /// Renglones de la RECETA CONGELADA de órdenes que usan este avío (V1-E3d, Restrict).
  ordenAvios         OrdenAvio[]
  /// Renglones de kardex de AVÍO de este avío (dimensión avío×lote opcional + esGenerico,
  /// R4). Las filas las ejercita F4 (el inventario de avíos); la tabla nace en F3-E1 para
  /// fijar el motor genérico. Restrict.
  movimientosDetAvio MovimientoDetAvio[]
  /// Renglones de orden de compra que piden este avío (F4-E2). Restrict.
  ordenCompraLineas  OrdenCompraLinea[]
  /// Renglones de explosión MRP que requieren este avío (F4-E4, R3). Restrict.
  requerimientos     RequerimientoOrden[]
  /// Renglones de nota de salida que descuentan este avío al confirmar (F4-E5, R4). Restrict.
  notaSalidaLineas   NotaSalidaLinea[]
  /// Renglones de precosto que valúan este avío (F8-E3, traza del amarre). Restrict.
  precostoLineas     PrecostoLinea[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("avios")
}

/// Puente N:N avío ↔ proveedor con precio y condiciones (F1-E3, R1 — insight del dueño:
/// el mismo avío se compra a varios proveedores a precios distintos; base de R3/R7 en F4).
/// PK compuesta (idAvio, idProveedor): un proveedor aparece UNA vez por avío. `onDelete`:
///  • Cascade hacia `Avio`: los proveedores son configuración del avío; permite reescribir
///    el set en la transacción A2.
///  • Restrict hacia `Proveedor`: un proveedor con avíos asignados no se borra físico (se
///    desactiva), para no dejar el par colgando.
/// Auditoría COMPLETA: `precio`/`condiciones` son editables (A7).
model AvioProveedor {
  idAvio           Int      @map("id_avio")
  idProveedor      Int      @map("id_proveedor")
  /// Precio al que ESTE proveedor surte el avío, POR UNIDAD DE CONSUMO — metro, pieza, kilo
  /// (§Post-F9.97). Hasta V1-E8a se documentaba "por PRESENTACIÓN de compra (p. ej. por rollo)" y
  /// el sistema lo dividía entre el factor de conversión para costear; ya no: hay una sola unidad.
  precio           Decimal? @db.Decimal(12, 2)
  /// ⚰️ COLUMNA MUERTA — SIN ESCRITOR Y SIN LECTOR (V1-E8a, §Post-F9.97). NO LA USES Y NO LA
  /// REVIVAS. Guardaba el factor presentación→consumo "fino", por proveedor. La regla que la mató,
  /// con su porqué completo, está en `Avio.factorConversion` (arriba) y en la cabecera de
  /// `dominio/compras/recepciones.ts`: **la línea de OC va SIEMPRE en unidad de consumo**. Se
  /// conserva vacía a propósito (D3: nada se destruye); nunca tuvo escritor, así que está en NULL
  /// en todas las filas.
  factorConversion Decimal? @map("factor_conversion") @db.Decimal(14, 6)
  /// Condiciones comerciales de este proveedor para este avío (texto libre).
  condiciones      String?
  /// ⭐ V1-E3m (§Post-F9.82) — **EL PROVEEDOR HABITUAL de este avío**. Daniel: *"en avíos sí podría
  /// ser que un elástico se compre con más de un proveedor… pero tener avíos sin proveedor asignado
  /// está generando más problemas que beneficios"*. Se invierte el default de F4: la explosión ya no
  /// propone **el más barato**, propone **al que se le compra siempre**; el más barato queda de
  /// fallback (no-regresión) para el avío que todavía no tiene habitual.
  ///
  /// **Por qué una BANDERA aquí y no un `Avio.idProveedorHabitual`:** el habitual tiene que ser uno
  /// de los que DE VERDAD surten el avío, y aquí lo es por construcción (el renglón es el par
  /// avío–proveedor, con su `precio` — justo lo que el MRP necesita para proponer precio sin un
  /// segundo viaje). Un FK suelto en `Avio` podría apuntar a un proveedor sin renglón (sin precio) y
  /// habría que validarlo a mano en cada escritura. El riesgo del
  /// otro lado —dos habituales— lo cierra la BASE con un índice único parcial
  /// (`avio_proveedor_habitual_unico ... WHERE habitual`), no la buena voluntad del dominio.
  /// Mismo patrón que `DireccionEntrega.favorita`.
  habitual         Boolean  @default(false)

  avio      Avio      @relation(fields: [idAvio], references: [id], onDelete: Cascade)
  proveedor Proveedor @relation(fields: [idProveedor], references: [id], onDelete: Restrict)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@id([idAvio, idProveedor])
  @@index([idProveedor])
  @@map("avio_proveedor")
}

/// Medida de un avío "POR MEDIDA" (rediseño R5, B11) — cierres, elástico… El avío se COSTEA con un
/// solo precio en el precosto (el PROMEDIO SIMPLE de los precios de sus medidas activas, decisión
/// Daniel: protege el costo sin desglosar) pero se COMPRA por medida, cada una con su precio real.
/// Las medidas viven AGRUPADAS dentro del avío padre (NO son avíos independientes del catálogo,
/// decisión Daniel). Ej.: "Cierre #5 metálico" → 15 cm $5.80 / 18 cm $6.20 / 22 cm $6.80. El amarre
/// medida×talla del BOM vive en `ModeloAvioTalla.idAvioMedida` (lo consume el MRP a futuro; hoy
/// nullable → no cambia el MRP existente). Cascade hacia Avio (config del avío); borrado suave.
model AvioMedida {
  id               Int      @id @default(autoincrement())
  idAvio           Int      @map("id_avio")
  avio             Avio     @relation(fields: [idAvio], references: [id], onDelete: Cascade)
  /// ⭐ V1-E3g (§Post-F9.66) — ETIQUETA de la medida ("53 cm"), para mostrar y para el diff del
  /// set-completo (`@@unique`). **Ya NO se captura a mano:** el dominio la DERIVA de `valor` +
  /// `Avio.unidadMedida`, porque el texto libre partía la compra en tres ("53 cm", "53cm", "53").
  /// Las filas viejas conservan su texto original mientras nadie las corrija (D3: no se tira nada).
  medida           String
  /// ⭐ V1-E3g — El NÚMERO de la medida, en `Avio.unidadMedida`. Es lo único que se captura. NULL
  /// SOLO en filas heredadas cuya etiqueta no se pudo convertir ("S", "vieja", rangos): esas
  /// quedan `requiereRevision = true` en vez de perderse o de recibir un valor inventado.
  valor            Decimal? @db.Decimal(12, 2)
  /// ⭐ V1-E3g — Bandera de REVISIÓN MANUAL (D3): la migración no pudo normalizar esta etiqueta a
  /// número+unidad y NO adivinó. Es un aviso, NO un bloqueo: la medida sigue viva, se sigue
  /// promediando en el precosto y se puede amarrar. Se apaga sola al re-capturarla con un número.
  requiereRevision Boolean  @default(false) @map("requiere_revision")
  /// Precio real de compra de esta medida (por unidad de compra). Entra al PROMEDIO del precosto.
  precio           Decimal  @db.Decimal(12, 2)
  /// Orden de despliegue dentro del avío (lo gestiona el dominio; no único en BD).
  orden            Int      @default(0)
  activo           Boolean  @default(true)

  /// Amarres medida↔talla del BOM que apuntan a esta medida (R5, B11). SetNull al borrarla.
  modeloAvioTallas     ModeloAvioTalla[]
  /// Amarres medida↔talla de la RECETA DE LA ORDEN (V1-E3d). SetNull al borrarla.
  ordenAvioTallas      OrdenAvioTalla[]
  /// ⭐⭐ V1-E8c (§Post-F9.126): desgloses por medida de renglones de EXPLOSIÓN que la piden. SetNull.
  requerimientoMedidas RequerimientoOrdenMedida[]
  /// ⭐⭐ V1-E8c (§Post-F9.126): desgloses por medida de renglones de ORDEN DE COMPRA. SetNull.
  ordenCompraMedidas   OrdenCompraLineaMedida[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idAvio, medida])
  @@index([idAvio])
  @@map("avio_medida")
}

/// (El catálogo global `Bordado` desapareció en V1-E3d — §Post-F9.35. El arte vive
/// ahora DENTRO del modelo: ver `ModeloArte`, más abajo.)

// ─────────────────────────────────────────────────────────────────────────────
// Modelos (Módulo 2, F1-E4) — el catálogo de productos y su RECETA/BOM completa,
// más sus fotos en R2 (doc `Documentacion_MJD/01-Modelos.md`). GLOBAL (sin idEmpresa,
// ADR-0007/A9) con auditoría uniforme (A7) y borrado suave (`activo` = descontinuar).
//
// Un `Modelo` (ex tabla `Modelos`) lleva su BOM en tres tablas de enlace —espejo de
// `ModelosTela`/`ModelosHab`/`ModelosBor` del viejo (doc 01-Modelos §2)—:
//  • `ModeloTela`  (telas) y `ModeloAvio` (avíos): cada renglón con `consumoPorPrenda` y
//    las TRES banderas de uso 🔑 `paraPreCosto`/`paraProduccion`/`paraCosto` (doc 01-Modelos
//    §2: un componente puede costear sin listarse en producción y viceversa — se CONSERVA).
//  • `ModeloArte` (bordados/estampados, V1-E3d): uno o varios, SIN cantidad y SIN banderas,
//    pero CON sus propios datos (nombre/tipo/puntadas/precio/proveedor/foto). Ya NO apunta a
//    un catálogo: el arte ES del modelo (§Post-F9.35). `precio` sigue nullable en BD (los
//    históricos migrados pueden no traerlo); en la captura por UI es REQUERIDO.
// Las fotos (`ModeloFoto`, N por modelo) viven en R2: tabla puente al `Archivo` de F0
// (A5: nunca por convención de nombre, corrige las fotos en `S:\` del viejo, doc 01-Modelos §6).
//
// onDelete (igual que el resto del esquema, F1-E2/E3): Restrict hacia los catálogos en uso
// (Temporada/CurvaTalla/Genero, y Tela/Avio en los renglones del BOM — se desactivan,
// no se borran físico); Cascade del BOM y las fotos hacia el `Modelo` padre (permite reescribir
// el set en la transacción A2 y arrastra todo al descontinuar físico —que no pasa: borrado
// suave—); Cascade en `ModeloFoto`→`Archivo` (mismo criterio que `ProveedorArchivo` de E1B:
// el objeto R2 huérfano es inofensivo).
// ─────────────────────────────────────────────────────────────────────────────

/// Género del modelo (catálogo global, F1-E4). Sembrado con los 8 del sistema viejo
/// (Caballero, Dama, Niño/Niña Infantil/Juvenil, Bebo, Beba). Mismo patrón que
/// `RolProveedor`/`TipoProceso`: se siembra + se expone SOLO un selector
/// (`GET /api/generos` bajo `modelos.ver`); el ABM fino se DIFIERE. Borrado suave + A7.
model Genero {
  id     Int     @id @default(autoincrement())
  /// Nombre del género. Único global (ADR-0007).
  nombre String  @unique
  /// Borrado suave (plan §4: patrón conservado del sistema viejo).
  activo Boolean @default(true)

  /// 2º DÍGITO de la nomenclatura de producción (§Post-F9.34): 1 Caballero · 2 Dama ·
  /// 3 Niño Juvenil · 4 Niño Infantil · 6 Niña Infantil · 7 Niña Juvenil · 9 Beba · 0 Bebo.
  /// El 8 no se usa. NULL = género sin dígito asignado (el generador no puede numerarlo).
  digitoNomenclatura Int? @map("digito_nomenclatura")
  /// Dígito de CONTINUACIÓN cuando la serie del `digitoNomenclatura` se agota (§Post-F9.34):
  /// hoy sólo Caballero lo tiene (1 → 5), porque su serie `x1` ya llegó a 999 y Daniel abrió la
  /// `x5`. NULL = sin continuación (agotada la serie, no hay a dónde seguir).
  digitoAlterno      Int? @map("digito_alterno")

  /// Modelos de este género (F1-E4, FK nullable Restrict).
  modelos Modelo[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("generos")
}

/// Modelo / producto (catálogo global, F1-E4 — ex tabla `Modelos`, doc 01-Modelos §2).
/// `codigo` es la clave de negocio (única global). `maquilaBase` es el costo de maquila base
/// que heredan las órdenes (doc 01-Modelos §4 punto 4). `idTemporada`/`idCurvaTalla`/`idGenero`
/// son FK NULLABLE: el ETL de E7 las poblará y no todos los modelos viejos las traen; la curva
/// vive en el modelo (D4). NO lleva `idEtiquetaMarca` (se difiere a F7/Costos).
model Modelo {
  id          Int      @id @default(autoincrement())
  /// Código VIGENTE del modelo — el que se enseña en toda pantalla e impreso. Único global
  /// (ADR-0007). Mientras el modelo es de DESARROLLO vale lo mismo que `codigoDesarrollo`
  /// (`CYA-26-71-001`); al PASAR A PRODUCCIÓN se sustituye por el nº de 5 dígitos, y el de
  /// desarrollo queda guardado aparte, buscable (§Post-F9.34 punto 5: nada se borra, D3).
  /// Los modelos MIGRADOS del Access nacen en producción con su código de 5 dígitos de siempre.
  codigo      String   @unique
  descripcion String?
  /// COMPOSICIÓN textil de la prenda (decisión de Daniel, 24-jul-2026): la composición NO sale de
  /// la OC del cliente, sale del DESARROLLO del modelo — se captura AQUÍ y toda orden de este
  /// modelo la HEREDA sola (`Orden.composicion`). En una orden puntual se puede corregir a mano;
  /// esa orden queda con `Orden.compForzada = true` y ya no se re-deriva. Null = sin capturar.
  composicion String?  @db.Text
  /// Costo de maquila base que heredan las órdenes (doc 01-Modelos §4).
  maquilaBase Decimal? @map("maquila_base") @db.Decimal(12, 2)

  /// ORIGEN del modelo (§Post-F9.34, V1-E3n): `desarrollo` mientras vive en el catálogo de
  /// desarrollo (numeración `CYA-26-71-001`, fuera del catálogo de producción por default) y
  /// `produccion` en cuanto se le asigna su nº de 5 dígitos. NO se separa la tabla: un modelo de
  /// desarrollo necesita lo MISMO que uno de producción (BOM, arte, fotos, precosteo); lo que se
  /// separa es la marca y la numeración. Los migrados quedan en `produccion` (su código de
  /// siempre ES el de producción).
  origen OrigenModelo @default(produccion)

  /// Nº de DESARROLLO del modelo, con la forma `CYA-26-71-001` = abreviatura del cliente + año de
  /// ENTREGA + concepto/género + consecutivo (§Post-F9.34). Lo arma el sistema ENTERO (es mecánico
  /// y no tiene criterio de negocio) y se CONGELA al nacer: si la entrega se recorre a 2027 el
  /// código sigue diciendo `26`. Se CONSERVA tras pasar a producción (D3) y sigue siendo buscable.
  /// Null = el modelo nunca fue de desarrollo (todo el histórico migrado).
  codigoDesarrollo String? @unique @map("codigo_desarrollo")

  /// Nº de PRODUCCIÓN del modelo como ENTERO de 5 dígitos: `71001` = concepto 7 (pantalón) +
  /// género 1 (caballero) + consecutivo 001 (§Post-F9.34 / §Post-F9.46). Es el mismo valor que
  /// `codigo` cuando el modelo es de producción y su código es numérico de 5 dígitos — se guarda
  /// aparte para que el generador del consecutivo pueda razonar por (concepto, género) sin
  /// parsear texto. Null = modelo de desarrollo, o modelo migrado con código NO numérico
  /// (`51783a`, `M-18`: 285 de los 4,987 del Access).
  /// ⚠️ Antes de V1-E3n esta columna guardaba un consecutivo global SIN significado
  /// (`numero_produccion_seq`, R3/B4); la migración la redefinió.
  numeroProduccion Int? @unique @map("numero_produccion")

  /// ⭐ V1-E7b (§Post-F9.110) — MODELO PADRE del que nació esta VERSIÓN. El sufijo del código
  /// (`CYA-26-71-001-01`) dice el linaje A LA VISTA, pero el texto no se puede consultar: esta
  /// columna es la verdad CONSULTABLE ("¿qué versiones tiene este modelo?", "¿de dónde salió esta
  /// receta?"). Apunta al modelo que se VERSIONÓ —el que se estaba viendo al pulsar «Crear
  /// versión»—, no a la raíz de la familia: ésa es la procedencia real de la receta copiada.
  /// Null = el modelo no nació de otro. `Restrict`: un modelo con versiones no se borra físico
  /// (se descontinúa, D3).
  idModeloPadre Int?     @map("id_modelo_padre")
  modeloPadre   Modelo?  @relation("ModeloVersion", fields: [idModeloPadre], references: [id], onDelete: Restrict)
  /// La otra pata de la auto-relación: las versiones que nacieron de ESTE modelo.
  versiones     Modelo[] @relation("ModeloVersion")

  /// ⭐ V1-E7b — número del SUFIJO de versión (`-01` → 1, `-02` → 2…). Null = el modelo es RAÍZ
  /// (su código no lleva sufijo). La numeración es PLANA por decisión de Daniel: versionar
  /// `CYA-26-71-001-01` da `CYA-26-71-001-02`, JAMÁS `CYA-26-71-001-01-01` — *"con anidamiento,
  /// en tres temporadas hay -01-02-01 y nadie lo lee"*. Y NO quema un consecutivo nuevo de la
  /// serie: es sufijo del código que ya existía, no un código nuevo.
  versionDesarrollo Int? @map("version_desarrollo")

  /// ⭐ V1-E7d (§Post-F9.110) — LA REVISIÓN ANTES DE MANDAR A PRODUCIR. La negociación mueve la
  /// receta EN VIVO, frente al cliente; estas cuatro columnas son la bisagra en la que una
  /// decisión de mesa se vuelve un compromiso de producción, FIRMADA (A7: quién y cuándo).
  ///
  /// Las cuatro se escriben SIEMPRE JUNTAS y describen UN acto de revisión: qué resultó, quién lo
  /// firmó, cuándo, y con qué observación. Un acto nuevo sustituye al anterior por completo —
  /// nunca se limpia un campo suelto dejando una tupla mentirosa ("aprobada" con el motivo del
  /// rechazo viejo colgando). **La SECUENCIA de actos no se pierde (D3):** cada aprobación y cada
  /// rechazo deja su renglón en la bitácora, que se agrega y jamás se edita (mismo reparto que
  /// `ListaPreciosLinea.aprobadoPorId/aprobadoEn` + `NegociacionEvento`).
  ///
  /// ⚠️ Sólo las VERSIONES las usan. Un modelo que no nació de otro las tiene en `null` y la
  /// compuerta de `promoverAProduccionNucleo` ni las mira: esta etapa NO le puso una revisión
  /// nueva al catálogo entero.
  revisionEstado EstadoRevisionModelo? @map("revision_estado")

  /// Quién firmó el último acto de revisión. Es RELACIÓN de verdad (y no un `String` suelto como
  /// `creadoPorId`) a propósito: la ficha tiene que decir *"aprobada por Aurora"* con el nombre,
  /// no con un cuid, y resolverlo por `include` evita el N+1 del listado. `Restrict` es inofensivo
  /// porque los usuarios se dan de baja SUAVE (`Usuario.activo`), nunca se borran.
  idRevisadoPor String?   @map("id_revisado_por")
  revisadoPor   Usuario?  @relation("ModeloRevisadoPor", fields: [idRevisadoPor], references: [id], onDelete: Restrict)
  /// Cuándo se firmó ese acto.
  revisadoEn    DateTime? @map("revisado_en")
  /// Observación del acto: el MOTIVO del rechazo (obligatorio al rechazar) o la nota opcional de
  /// la aprobación. Null = se firmó sin escribir nada.
  revisionNota  String?   @map("revision_nota") @db.Text

  /// ⭐ V1-E8d (§Post-F9.127) — CUÁNDO se tocó por última vez la RECETA de este modelo, y QUÉ parte.
  ///
  /// Las escribe **una sola función**: `tocarModeloPorCambioDeReceta` (`dominio/modelos/
  /// revision-modelo.ts`), el embudo obligatorio de V1-E7e por el que pasan las 6 puertas que
  /// pueden mover la receta (telas, avíos, avíos favoritos, medidas por talla, arte, copiado). Nadie
  /// más las toca.
  ///
  /// ⚠️ **Por qué NO se usa `modificadoEn` para esto.** `modificadoEn` es `@updatedAt`: lo mueve
  /// CUALQUIER escritura al modelo, y hay **11** en el código que no son receta (renombrar la
  /// descripción, pasar a producción, la propia firma de revisión, las fotos…). Con ella, el aviso
  /// de "tu precio está sobre un costo viejo" nacería gritando en falso — *y un aviso que grita en
  /// falso se aprende a ignorar; el día que sea de verdad, nadie lo mira*.
  ///
  /// **Para qué sirve:** un renglón de lista de precios guarda un precosto CONGELADO (inmutable por
  /// diseño, D3) y una copia de su costo. Si la receta se toca DESPUÉS de ese congelado
  /// (`recetaTocadaEn > Precosto.congeladoEn`), el precio —aprobado o no— está calculado sobre un
  /// costo que ya no corresponde a la receta de hoy, y la pantalla lo dice con todas sus letras.
  ///
  /// ⚠️ **NULL = no se sabe, NO "nunca se tocó".** Nace en NULL para todo el catálogo existente
  /// (sin backfill: inventarle una fecha sería mentir) ⇒ un desfase ANTERIOR al despliegue no se
  /// detecta. Ver §Post-F9.127.
  recetaTocadaEn     DateTime? @map("receta_tocada_en")
  /// QUÉ parte de la receta se tocó en ese último cambio: uno de los códigos del tipo
  /// `CambioDeReceta` (`telas` · `avios` · `medidas-por-talla` · `arte` · `copia-de-otro-modelo`).
  /// Es TEXTO y no un enum de Postgres a propósito: el catálogo de cambios vive en TypeScript
  /// (`CambioDeReceta`), lo consume una sola función para armar una frase, y un enum de BD obligaría
  /// a una migración cada vez que nace una puerta nueva de receta. Null = nunca se tocó desde el
  /// despliegue de V1-E8d.
  recetaTocadaCambio String?   @map("receta_tocada_cambio")

  /// # de OPERACIONES de la prenda (rediseño R4, B7): deriva la DIFICULTAD contra la tabla
  /// `RangoDificultad` (regla `porDificultad` del CPM). Se CAPTURA en el editor de desarrollo
  /// (R5); null = sin capturar → la duración cae al tiempo estándar del proceso (fallback).
  numOperaciones Int? @map("num_operaciones")

  /// Secuencia del estampado/bordado respecto a la costura (rediseño R4, B10 — por MODELO;
  /// la captura en el editor de desarrollo llega en R5). Ver el enum `SecuenciaEstampado`.
  secuenciaEstampado SecuenciaEstampado @default(antes) @map("secuencia_estampado")

  /// Costo de CORTE por prenda (rediseño R5, B8): costo fijo SEPARADO de la maquila/costura
  /// (`maquilaBase`). Decisión Daniel: se ESTIMA aquí y NO lleva proveedor (el maquilero cotizado
  /// aplica sólo a la costura). Alimenta el renglón `corte` del precosto (concepto fijo). Null = $0.
  corteBase Decimal? @map("corte_base") @db.Decimal(12, 2)

  /// Maquilero (COSTURA) con el que se COTIZÓ la maquila en el desarrollo (rediseño R5, B9). Es
  /// sólo DATO aquí: siembra el DEFAULT del maquilero asignado en producción (F3/F5), cambiable
  /// después. Restrict hacia Proveedor (un maquilero cotizado en un modelo no se borra físico).
  idMaquileroCotizado Int?       @map("id_maquilero_cotizado")
  maquileroCotizado   Proveedor? @relation("ModeloMaquileroCotizado", fields: [idMaquileroCotizado], references: [id], onDelete: Restrict)

  /// Temporada (opcional). Restrict: una temporada en uso no se borra físico → se desactiva.
  idTemporada    Int?          @map("id_temporada")
  temporada      Temporada?    @relation(fields: [idTemporada], references: [id], onDelete: Restrict)
  /// Curva de tallas del modelo (D4, opcional). Restrict (igual que temporada).
  idCurvaTalla   Int?          @map("id_curva_talla")
  curvaTalla     CurvaTalla?   @relation(fields: [idCurvaTalla], references: [id], onDelete: Restrict)
  /// Género (opcional; se poblará en el ETL E7). Restrict (igual que temporada).
  idGenero       Int?          @map("id_genero")
  genero         Genero?       @relation(fields: [idGenero], references: [id], onDelete: Restrict)
  /// Tipo de producto para Calidad (F6-E1, decisión (d)): la auditoría hereda este tipo del
  /// modelo para filtrar los defectos aplicables. NULLABLE y sin default (no rompe los modelos
  /// existentes; se asigna desde la pantalla de Modelos). Restrict (igual que temporada/género).
  idTipoProducto Int?          @map("id_tipo_producto")
  tipoProducto   TipoProducto? @relation(fields: [idTipoProducto], references: [id], onDelete: Restrict)

  /// ¿La prenda LLEVA arte (bordado/estampado)? Decisión de Daniel (26-jul-2026): *"por default sí
  /// lleva; a menos que la marques como que no lleva. Y de esa manera si no meten la información
  /// del arte, o no desmarcan la casilla, está como incompleto. Siempre hay que atender ese tema"*.
  /// Es el requisito ARTE del estado automático de la orden
  /// (`dominio/produccion/requisitos-orden.ts`): con `true` la orden NO se completa hasta que el BOM
  /// tenga su arte; con `false` el arte no aplica y no estorba. Default `true` A PROPÓSITO, también
  /// para los modelos migrados: el tema se atiende siempre.
  llevaArte Boolean @default(true) @map("lleva_arte")

  /// Borrado suave = descontinuar (plan §4: patrón conservado del sistema viejo).
  activo Boolean @default(true)

  /// Fotos del modelo en R2 (N por modelo).
  fotos                ModeloFoto[]
  /// BOM — telas del modelo (N:N a Tela con consumo + banderas).
  telas                ModeloTela[]
  /// BOM — avíos del modelo (N:N a Avio con consumo + banderas).
  avios                ModeloAvio[]
  /// BOM — ARTE del modelo (bordados/estampados). Hijo del modelo, no catálogo (V1-E3d).
  artes                ModeloArte[]
  /// Renglones de pedidos internos que piden este modelo (F2-E1, Restrict hacia el modelo).
  pedidoLineas         PedidoLinea[]
  /// Órdenes de producción de este modelo (F2-E2, Restrict hacia el modelo).
  ordenes              Orden[]
  /// Renglones de kardex PT de este modelo (F3-E1, D4 — dimensión PT: modelo×color×talla). Restrict.
  movimientosDetPt     MovimientoDetPt[]
  /// Renglones del EDR asociados a este modelo (F7-E2, para el desglose por modelo). Restrict.
  edrLineas            EdrLinea[]
  /// Renglones de inventario cíclico de este modelo (F7-E5). Restrict.
  inventarioCiclicoDet InventarioCiclicoDet[]
  /// Desarrollos (proyectos de cotización) de este modelo (F8-E2, D13/R16). Restrict.
  desarrollos          Desarrollo[]
  /// Ligas APRENDIDAS modelo-del-cliente → este modelo (importador de OC por PDF). Restrict.
  clienteLigas         ClienteModeloLiga[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  /// Órdenes del sistema VIEJO que fabricaron este modelo (archivo de consulta, §Post-F9.26).
  historicoOrdenesV1 HistoricoOrdenV1[]

  /// Filtro por DEFAULT del catálogo y de la galería (V1-E3n): producción + activos.
  @@index([origen, activo])
  /// Linaje de versiones (V1-E7b): "dame las versiones de este modelo" sin recorrer la tabla.
  @@index([idModeloPadre])
  @@map("modelos")
}

/// Tipo de foto del modelo (F1-E4): frente, espalda u otra. `orden` da el orden de
/// despliegue del carrusel (lo gestiona el dominio; no único en BD).
enum TipoFotoModelo {
  FRENTE
  ESPALDA
  OTRO

  @@map("tipo_foto_modelo")
}

/// Foto de un modelo en R2 (F1-E4, R2 — doc 01-Modelos §6: corrige las fotos por nombre en
/// `S:\` del viejo). Liga un `Archivo` (motor de F0) a un modelo con su tipo y orden. N por
/// modelo. `onDelete`:
///  • Cascade hacia `Modelo`: las fotos son del modelo.
///  • Cascade hacia `Archivo`: al quitar la foto se borra también su `Archivo` (el objeto R2
///    huérfano es inofensivo — lo documenta `comun/archivos.ts`). Mismo criterio que
///    `ProveedorArchivo` de E1B.
model ModeloFoto {
  id        Int            @id @default(autoincrement())
  idModelo  Int            @map("id_modelo")
  idArchivo String         @map("id_archivo")
  tipo      TipoFotoModelo @default(OTRO)
  orden     Int            @default(0)

  modelo  Modelo  @relation(fields: [idModelo], references: [id], onDelete: Cascade)
  archivo Archivo @relation(fields: [idArchivo], references: [id], onDelete: Cascade)

  creadoEn    DateTime @default(now()) @map("creado_en")
  creadoPorId String?  @map("creado_por_id")

  @@unique([idArchivo])
  @@index([idModelo])
  @@map("modelo_foto")
}

/// Puente BOM modelo ↔ tela (F1-E4 — ex `ModelosTela`, doc 01-Modelos §2). PK compuesta
/// (idModelo, idTela): una tela aparece UNA vez por modelo. `consumoPorPrenda` = consumo de
/// tela por prenda; las TRES banderas 🔑 marcan para qué propósitos cuenta el renglón
/// (`paraPreCosto`/`paraProduccion`/`paraCosto`, doc 01-Modelos §2 — se conservan). `onDelete`:
/// Cascade hacia `Modelo` (permite reescribir el BOM en la tx A2); Restrict hacia `Tela` (una
/// tela usada por un modelo no se borra físico → se desactiva). Auditoría COMPLETA: los
/// campos son editables (A7).
model ModeloTela {
  idModelo         Int            @map("id_modelo")
  idTela           Int            @map("id_tela")
  /// Consumo de tela por prenda (doc 01-Modelos §2: `CantTela`).
  consumoPorPrenda Decimal        @map("consumo_por_prenda") @db.Decimal(12, 4)
  /// 🔑 Entra en el PRE-costeo (estimación antes de producir).
  paraPreCosto     Boolean        @default(true) @map("para_pre_costo")
  /// 🔑 Se considera al PRODUCIR (lo que realmente se manda pedir/usar).
  paraProduccion   Boolean        @default(true) @map("para_produccion")
  /// 🔑 Entra en el COSTEO real de la orden.
  paraCosto        Boolean        @default(true) @map("para_costo")
  /// F8-E1 (R17): amarre OPCIONAL al renglón proveedor–tela–precio elegido por Desarrollo. La
  /// cascada de resolución de precios (dominio/costos/resolucion-precios.ts) lo PREFIERE; NULL =
  /// sin amarre → cascada por color/sugerido. SetNull: si el renglón proveedor se retira de la
  /// tela, el amarre se limpia (degrada a la cascada, nunca cuelga).
  idTelaProveedor  Int?           @map("id_tela_proveedor")
  telaProveedor    TelaProveedor? @relation(fields: [idTelaProveedor], references: [id], onDelete: SetNull)

  modelo Modelo @relation(fields: [idModelo], references: [id], onDelete: Cascade)
  tela   Tela   @relation(fields: [idTela], references: [id], onDelete: Restrict)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@id([idModelo, idTela])
  @@index([idTela])
  @@index([idTelaProveedor])
  @@map("modelo_tela")
}

/// Puente BOM modelo ↔ avío (F1-E4 — ex `ModelosHab`, doc 01-Modelos §2). Misma forma que
/// `ModeloTela` (consumo + 3 banderas 🔑), referenciando `Avio`. PK compuesta (idModelo,
/// idAvio): un avío aparece UNA vez por modelo. Cascade hacia `Modelo`, Restrict hacia `Avio`.
model ModeloAvio {
  idModelo         Int     @map("id_modelo")
  idAvio           Int     @map("id_avio")
  /// Consumo de avío por prenda (doc 01-Modelos §2: `CantHab`).
  consumoPorPrenda Decimal @map("consumo_por_prenda") @db.Decimal(12, 4)
  /// 🔑 Entra en el PRE-costeo.
  paraPreCosto     Boolean @default(true) @map("para_pre_costo")
  /// 🔑 Se considera al PRODUCIR.
  paraProduccion   Boolean @default(true) @map("para_produccion")
  /// 🔑 Entra en el COSTEO real.
  paraCosto        Boolean @default(true) @map("para_costo")
  /// F8-E1 (R18): ¿este avío se consume por TALLA (cierres, elástico…)? Si true, las medidas viven
  /// en `tallas` (ModeloAvioTalla) y el precosto usa su PROMEDIO SIMPLE (decisión (g)); el MRP (E6)
  /// compra por medida×curva. Si false, se usa `consumoPorPrenda`. Default false.
  consumoPorTalla  Boolean @default(false) @map("consumo_por_talla")
  /// F8-E1 (R17): amarre OPCIONAL al `AvioProveedor` elegido por Desarrollo. Guarda el PROVEEDOR del
  /// par: `(idAvio de este renglón, idAvioProveedor)` → `AvioProveedor`. SIN FK de relación (mismo
  /// criterio y NOMBRE que `OrdenCompraLinea.idAvioProveedor` de F4: el par se reconstruye con
  /// `idAvio`, sin tocar `AvioProveedor`). NULL = sin amarre → el MRP (E6) cae a "más barato" (F4).
  idAvioProveedor  Int?    @map("id_avio_proveedor")

  /// Medidas por talla de este avío (F8-E1, R18) cuando `consumoPorTalla`. Cascade (FK compuesta).
  tallas ModeloAvioTalla[]

  modelo Modelo @relation(fields: [idModelo], references: [id], onDelete: Cascade)
  avio   Avio   @relation(fields: [idAvio], references: [id], onDelete: Restrict)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@id([idModelo, idAvio])
  @@index([idAvio])
  @@index([idAvioProveedor])
  @@map("modelo_avio")
}

/// ARTE de un modelo — bordado/estampado (V1-E3d, §Post-F9.35; ex catálogo `Bordado` +
/// puente `ModeloBordado`, ex `ModelosBor` del viejo, doc 01-Modelos §2).
///
/// **Ya NO es un catálogo.** Daniel, 12-ago-2026: *"cada arte va pegado siempre a un solo
/// modelo… sería más fácil manejar el arte (o varios) dentro del modelo. Ahí mismo establecer
/// su precio, el proveedor"*. Los datos del viejo lo confirmaron: de 2,964 artes, 898 nunca se
/// usaron y el 92 % de los usados vive en UN solo modelo (y los "compartidos" se llaman como el
/// número del modelo). Un modelo lleva UNO o VARIOS artes, cada uno con sus propios datos.
///
/// `precio` es NULLABLE en BD (los históricos migrados pueden no traerlo); en la captura por UI
/// es REQUERIDO. **Es el precio que VIAJA a la OP** (`dominio/costos/costo-orden.ts`: entra UNA
/// vez por modelo, SIN multiplicar por cantidad). `idProveedor` es nuevo (el catálogo no lo
/// tenía): quién hace el arte.
///
/// ⭐ **V1-E3f (§Post-F9.52): el arte ya NO tiene `nombre`.** Daniel: *"Es completamente
/// irrelevante el nombre del estampado. Creo que con la descripción sería suficiente."* Como el
/// nombre era la LLAVE (`@@unique([idModelo, nombre])`) y el desempate del orden, se reemplazó
/// por: identidad = el propio `id`; orden = `orden` con desempate por `id`; y la `descripcion`
/// pasó a REQUERIDA y visible. La migración copió `nombre` a `descripcion` donde ésta venía
/// vacía (D3: nada se pierde en silencio). Se PIERDE a propósito la red que impedía dos artes
/// con el mismo nombre en un modelo — Daniel lo sabe.
///
/// Otros cambios de V1-E3f: `posicion` (texto LIBRE — *"a veces son cosas muy específicas"*),
/// `idTipoArte` (FK al catálogo único `TipoProceso.esArte`, ex enum `TipoArte`) y las fotos en
/// PLURAL (`ModeloArteFoto`, ex `idArchivoFoto` de una sola).
///
/// Cascade hacia `Modelo` (descontinuar físico se lo lleva todo; en la práctica es borrado
/// suave) y Restrict hacia `Proveedor` y `TipoProceso` (un catálogo en uso no se borra físico,
/// se desactiva). Auditoría COMPLETA (A7).
model ModeloArte {
  id          Int      @id @default(autoincrement())
  idModelo    Int      @map("id_modelo")
  /// Descripción del arte — el campo VISIBLE y la identidad de cara al usuario desde V1-E3f
  /// (§Post-F9.52 punto 1). REQUERIDA: sin nombre, es lo único que distingue un arte de otro.
  descripcion String
  /// Dónde va el arte en la prenda: "frente", "espalda", "manga izquierda"… TEXTO LIBRE, NO
  /// catálogo (V1-E3f, §Post-F9.52 punto 2 — Daniel: *"a veces son cosas muy específicas, que no
  /// tendría caso tenerlas en un catálogo"*). Opcional: el histórico migrado no lo trae.
  posicion    String?
  /// Número de puntadas (informativo; contexto del costeo del bordado). Se MUESTRA solo cuando
  /// el tipo lo usa (`TipoProceso.usaPuntadas`): §Post-F9.52 punto 6, el campo no se borra.
  puntadas    Int?
  /// Precio del arte en este modelo — el que viaja a la OP. Nullable en BD, requerido en UI.
  precio      Decimal? @db.Decimal(12, 2)
  /// Tipo del arte: FK al catálogo ÚNICO (`TipoProceso` con `esArte`). Ex enum `TipoArte`
  /// (V1-E3f, §Post-F9.58: *"un solo catálogo"*). Restrict: un tipo en uso no se borra físico.
  idTipoArte  Int      @map("id_tipo_arte")
  /// Proveedor que hace el arte (NUEVO en V1-E3d). Opcional: el histórico migrado no lo trae.
  idProveedor Int?     @map("id_proveedor")
  /// Orden de despliegue del ARTE dentro del modelo (jul-2026, petición de Daniel: "la primera
  /// del arte también"). El arte PRINCIPAL es simplemente el PRIMERO (`orden` más bajo, desempate
  /// por `id` desde V1-E3f — antes por nombre): una sola fuente de verdad, sin bandera que pueda
  /// contradecir al orden. Marcar principal = mover a la posición 0 y reindexar el resto
  /// (`marcarArtePrincipal`). Espejo de `ModeloFoto.orden`.
  orden       Int      @default(0)

  modelo    Modelo      @relation(fields: [idModelo], references: [id], onDelete: Cascade)
  proveedor Proveedor?  @relation(fields: [idProveedor], references: [id], onDelete: Restrict)
  tipoArte  TipoProceso @relation(fields: [idTipoArte], references: [id], onDelete: Restrict)

  /// Fotos del arte en R2 (V1-E3f, §Post-F9.52 punto 5 — Daniel: *"cada arte debe de llevar sus
  /// propias fotos"*, en PLURAL). Cascade: quitar el arte se lleva sus renglones de foto.
  fotos ModeloArteFoto[]

  /// Renglones de precosto que valúan este arte (F8-E3, traza). SetNull: quitar el arte del
  /// modelo NO bloquea ni borra el precosto — su snapshot (`descripcion`/`precioUnit`) ya no
  /// depende de la FK, igual que `PrecostoLinea.idTelaProveedor`.
  precostoLineas PrecostoLinea[]

  /// Renglones de RECETA DE ORDEN copiados de este arte (V1-E3d, traza). SetNull: quitar el arte
  /// del modelo NO toca lo ya congelado en las órdenes (su descripción/precio ya viven en la copia).
  ordenArtes OrdenArte[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idModelo])
  @@index([idProveedor])
  @@index([idTipoArte])
  @@map("modelo_arte")
}

/// Foto de un ARTE del modelo en R2 (V1-E3f, §Post-F9.52 punto 5). Espejo de `ModeloFoto`: liga
/// un `Archivo` (motor de F0) a un arte con su `orden` de despliegue. N por arte.
///
/// ⚠️ **A diferencia de `ModeloFoto`, NO lleva `@@unique([idArchivo])`**: varios artes COMPARTEN
/// el mismo `Archivo` a propósito. Al sacar el arte del catálogo (V1-E3d) los artes usados por
/// varios modelos se DUPLICARON apuntando al mismo objeto de R2 (que no se puede clonar desde
/// SQL), y «copiar arte de otro modelo» hace lo mismo. Por eso el `Archivo` solo se borra cuando
/// NINGUNA otra foto de arte lo referencia (`borrarArchivoSiQuedoHuerfano`).
///
/// `onDelete`: Cascade hacia `ModeloArte` (las fotos son del arte) y Cascade hacia `Archivo` (al
/// borrar el registro del archivo se van sus renglones; el objeto R2 huérfano es inofensivo — lo
/// documenta `comun/archivos.ts`).
model ModeloArteFoto {
  id           Int    @id @default(autoincrement())
  idModeloArte Int    @map("id_modelo_arte")
  idArchivo    String @map("id_archivo")
  /// Posición de la foto dentro del arte (0 = principal). Espejo de `ModeloFoto.orden`.
  orden        Int    @default(0)

  arte    ModeloArte @relation(fields: [idModeloArte], references: [id], onDelete: Cascade)
  archivo Archivo    @relation(fields: [idArchivo], references: [id], onDelete: Cascade)

  creadoEn    DateTime @default(now()) @map("creado_en")
  creadoPorId String?  @map("creado_por_id")

  @@index([idModeloArte])
  @@index([idArchivo])
  @@map("modelo_arte_foto")
}

// ─────────────────────────────────────────────────────────────────────────────
// Migración del sistema viejo (F1-E6, ETL) — tabla de MAPEO clave-vieja → id-nuevo
// ─────────────────────────────────────────────────────────────────────────────

/// Mapeo PERSISTIDO entre la clave de un registro del sistema viejo (Access) y el id
/// de la entidad nueva que lo reemplaza (F1-E6, ETL de catálogos). Es un entregable
/// CLAVE del ETL: lo reutilizan los ETLs de fases futuras (E7 modelos, F2 pedidos, F4
/// inventarios, F9 finanzas) para traducir las FKs viejas (p. ej. `OrdenesDet.IdOrdenes`,
/// `Modelos.IdTemporadas`) sin re-derivar la correspondencia.
///
/// Diseño GENÉRICO (una sola tabla para todas las correspondencias) en vez de una columna
/// `legacyId` por entidad:
///  • `entidad`     — qué clase de cosa se mapea, en el nombre del modelo nuevo más un
///                    sufijo de fuente cuando una entidad nueva absorbe varias viejas. Claves
///                    estables usadas por el ETL (ver `migracion/comun/mapeo.ts`):
///                    "Color" (texto→idColor), "Tela:IdTelas" y "Tela:IdTelasDis"
///                    (las DOS tablas viejas que se unifican en `Tela`), "Proveedor:IdProveedor",
///                    "Proveedor:IdMaquileros", "Proveedor:IdEstampadores", "Proveedor:IdCortadores"
///                    (la fusión de terceros), "Cliente", "EtiquetaMarca", "Bordado", "Avio",
///                    "Genero", "Almacen:IPT" / "Almacen:Tela", "TelaCategoria", "Empresa", etc.
///  • `claveVieja`  — el id (o texto, p. ej. el nombre de color) del sistema viejo, SIEMPRE
///                    como texto (las PKs viejas son Int; el color es texto libre). Único por
///                    `(entidad, claveVieja)`.
///  • `idNuevo`     — id de la entidad nueva, como texto (cubre PKs Int y, a futuro, String).
///  • `datos`       — JSON opcional con contexto de la decisión (p. ej. el nombre original,
///                    si hubo dedup/fusión, el sufijo de desambiguación aplicado…). Auditable.
///
/// IDEMPOTENCIA (§7): el ETL hace upsert por `(entidad, claveVieja)`, así re-ejecutarlo no
/// duplica filas ni rompe el mapeo. No lleva auditoría A7 (es metadato técnico de migración,
/// no una entidad de negocio): solo `creadoEn`/`modificadoEn`.
model MapeoMigracion {
  id         Int    @id @default(autoincrement())
  /// Clase de correspondencia (nombre del modelo nuevo + sufijo de fuente). Ver TSDoc.
  entidad    String
  /// Clave del registro viejo (id Int o texto), SIEMPRE como texto.
  claveVieja String @map("clave_vieja")
  /// Id del registro nuevo, como texto (cubre PKs Int y String).
  idNuevo    String @map("id_nuevo")
  /// Contexto de la decisión (nombre original, dedup/fusión, sufijo…), opcional.
  datos      Json?

  creadoEn     DateTime @default(now()) @map("creado_en")
  modificadoEn DateTime @updatedAt @map("modificado_en")

  @@unique([entidad, claveVieja])
  @@index([entidad, idNuevo])
  @@map("mapeo_migracion")
}

// ─────────────────────────────────────────────────────────────────────────────
// Pedidos (Módulo PEDIDOS, F2-E1) — el segundo paso de la secuencia MODELOS →
// PEDIDOS → PRODUCCIÓN (doc `Documentacion_MJD/02-Pedidos.md`). Dos niveles:
//  • Pedido interno (`Pedido` + `PedidoLinea`, ex `Pedidos`/`PedidosDet`): la
//    planeación/compromiso con el cliente (qué modelos, cuánto y a qué precio).
//    Multi-empresa (A9): `idEmpresa` + folio POR EMPRESA desde la secuencia
//    atómica "pedido" (A3 — nunca Max()+1, corrige el `AumentarNumPed` del viejo).
//  • Pedido Real (`PedidoReal` + `PedidoRealLinea`, ex `PedidosReales`/
//    `PedidosRealesDet`): cada LIBERACIÓN real del cliente contra ese pedido, con
//    su CEDIS, fechas y cantidades pedida/enviada/entregada (doc 02 §1 y §4.4).
//
// onDelete (igual que el resto del esquema): Restrict hacia los catálogos en uso
// (Cliente, Modelo, Empresa — se desactivan, no se borran físico); Cascade del
// detalle hacia su encabezado (PedidoLinea→Pedido, PedidoRealLinea→PedidoReal —
// permite reescribir el set de renglones en la transacción A2). Auditoría
// uniforme (A7) + borrado SUAVE de PEDIDO INTERNO (`pedCancelado`, cancelación
// suave del viejo `CancelarPed_Click`; el pedido sigue consultable).
//
// SNAPSHOTS MIGRADOS de SOLO LECTURA (sufijo `V1`): campos que en el viejo eran
// saldos derivados (`PedidosDet.EntregadoParcial`/`CantFalt`) o FKs a tablas que
// aún no existen en v2 (`Pedidos.IdOrdCompra`). NO son saldo vivo (espíritu D3:
// existencias/saldos = suma de movimientos): los puebla el ETL de E5 y NINGÚN
// endpoint de F2 los escribe. La derivación real (desde EntregasCliente) llega en
// F3 y los reemplaza.
// ─────────────────────────────────────────────────────────────────────────────

/// Pedido interno (F2-E1 — ex `Pedidos`, doc 02-Pedidos §2). El compromiso con el
/// cliente del que salen las órdenes de producción (F3). `folio` sale de la secuencia
/// atómica "pedido" POR EMPRESA (A3/A9 — sustituye el `NumeroPed` por Max()+1 del viejo,
/// doc 02 §6.1). Cancelación SUAVE (`pedCancelado`): el pedido nunca se borra (doc 02 §4.2).
model Pedido {
  id        Int     @id @default(autoincrement())
  /// Folio del pedido, consecutivo POR EMPRESA (A3/A9 — viejo: `NumeroPed`).
  folio     BigInt
  /// Empresa dueña del pedido y de su numeración (A9 — viejo: `IdEmpresas`).
  idEmpresa Int     @map("id_empresa")
  empresa   Empresa @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)
  /// Cliente del pedido (viejo: `IdClientes`). Restrict: un cliente con pedidos no se borra físico.
  idCliente Int     @map("id_cliente")
  cliente   Cliente @relation(fields: [idCliente], references: [id], onDelete: Restrict)

  /// Fecha del pedido (viejo: `FechaPedido`).
  fechaPedido      DateTime? @map("fecha_pedido") @db.Date
  /// Ventana de entrega comprometida — desde (viejo: `FechaDe`).
  fechaDe          DateTime? @map("fecha_de") @db.Date
  /// Ventana de entrega comprometida — hasta (viejo: `FechaHasta`).
  fechaHasta       DateTime? @map("fecha_hasta") @db.Date
  /// Fecha de tela (viejo: `FechaTela`).
  fechaTela        DateTime? @map("fecha_tela") @db.Date
  /// Fecha de elaboración (viejo: `FechaElaboracion`).
  fechaElaboracion DateTime? @map("fecha_elaboracion") @db.Date

  /// Marca de entregado a tienda (viejo: `EntregadoTienda`).
  entregadoTienda Boolean @default(false) @map("entregado_tienda")
  /// Marcado para no producir (viejo: `NoProducir`).
  noProducir      Boolean @default(false) @map("no_producir")
  /// Pedido cancelado — cancelación SUAVE, sigue consultable (viejo: `PedCancelado`).
  pedCancelado    Boolean @default(false) @map("ped_cancelado")

  /// OC ORIGINAL del cliente (rediseño R3, B3 — petición Daniel 7-jul §4.1): el nº de orden de
  /// compra del cliente, captura VIVA y editable. Al crear cada OP se copia como SNAPSHOT a
  /// `Orden.ocCliente` (editar este campo NO re-escribe las órdenes ya nacidas).
  ocCliente String? @map("oc_cliente")

  /// SNAPSHOT MIGRADO de SOLO LECTURA (viejo: `Pedidos.IdOrdCompra` "Orden de compra
  /// ligada", presente en 233 de 1,529 pedidos). SIN FK hasta que OrdCompra exista en F4
  /// (entonces se promueve a relación real). Lo puebla el ETL de E5; NINGÚN endpoint de F2
  /// lo escribe.
  idOrdCompraV1 Int? @map("id_ord_compra_v1")

  lineas   PedidoLinea[]
  reales   PedidoReal[]
  /// Adjuntos de apoyo del pedido en R2 (rediseño R3, B3 — el documento original de la OC del
  /// cliente, Excel/PDF/imágenes). Cascade: son del pedido.
  archivos PedidoArchivo[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idEmpresa, folio])
  @@index([idCliente])
  @@map("pedidos")
}

/// Puente pedido ↔ archivo R2 (rediseño R3, B3). Liga un `Archivo` (motor de archivos de F0) a un
/// PEDIDO interno como adjunto de apoyo — típicamente el documento ORIGINAL de la OC del cliente.
/// Espejo exacto de `OrdenArchivo`. `onDelete`:
///  • Cascade hacia `Pedido`: los adjuntos son del pedido.
///  • Cascade hacia `Archivo`: al quitar el adjunto se borra también su `Archivo` (el objeto físico
///    en R2 lo borra el dominio best-effort tras el commit — ver `dominio/pedidos/adjuntos-pedido.ts`).
model PedidoArchivo {
  id        Int    @id @default(autoincrement())
  idPedido  Int    @map("id_pedido")
  idArchivo String @map("id_archivo")

  pedido  Pedido  @relation(fields: [idPedido], references: [id], onDelete: Cascade)
  archivo Archivo @relation(fields: [idArchivo], references: [id], onDelete: Cascade)

  creadoEn    DateTime @default(now()) @map("creado_en")
  creadoPorId String?  @map("creado_por_id")

  @@unique([idArchivo])
  @@index([idPedido])
  @@map("pedido_archivo")
}

/// Renglón de un pedido interno (F2-E1 — ex `PedidosDet`, doc 02-Pedidos §2). Un modelo
/// del catálogo con su cantidad pedida y el `precio` pactado (SNAPSHOT al momento del
/// pedido). PK propia `id` (a diferencia de los puentes del BOM): un mismo modelo puede
/// repetirse en el pedido y, sobre todo, el Pedido Real referencia el renglón por su id
/// (viejo: `PedidosRealesDet.IdPedidosDet`). Cascade hacia `Pedido` (reescribir el set en
/// la tx A2); Restrict hacia `Modelo`.
model PedidoLinea {
  id       Int    @id @default(autoincrement())
  idPedido Int    @map("id_pedido")
  pedido   Pedido @relation(fields: [idPedido], references: [id], onDelete: Cascade)
  idModelo Int    @map("id_modelo")
  modelo   Modelo @relation(fields: [idModelo], references: [id], onDelete: Restrict)

  /// Desarrollo del que sale el renglón (rediseño R3, B4): el constructor elige el modelo DE
  /// DESARROLLO (F8) y deja aquí la traza directa renglón→desarrollo; `salidaAProduccion` la usa
  /// para ligar la OP (`DesarrolloOrden`). Nullable: renglones legado/F2 sin desarrollo. Restrict.
  idDesarrollo Int?        @map("id_desarrollo")
  desarrollo   Desarrollo? @relation(fields: [idDesarrollo], references: [id], onDelete: Restrict)

  /// Cantidad pedida (viejo: `CantPed`).
  cantidadPedida Int     @map("cantidad_pedida")
  /// Precio pactado por prenda — SNAPSHOT al momento del pedido (viejo: `Precio`). Editable (A7).
  precio         Decimal @db.Decimal(12, 2)

  /// SNAPSHOT MIGRADO de SOLO LECTURA (viejo: `PedidosDet.EntregadoParcial` — cantidad ya
  /// entregada). NO es saldo vivo (espíritu D3: el saldo real se deriva de EntregasCliente
  /// en F3, que lo reemplaza). Lo puebla el ETL de E5; NINGÚN endpoint de F2 lo escribe.
  entregadoParcialV1 Int? @map("entregado_parcial_v1")
  /// SNAPSHOT MIGRADO de SOLO LECTURA (viejo: `PedidosDet.CantFalt` — cantidad faltante).
  /// Mismo trato que `entregadoParcialV1`: NO es saldo vivo, lo puebla el ETL de E5, ningún
  /// endpoint lo escribe.
  cantFaltanteV1     Int? @map("cant_faltante_v1")

  realLineas PedidoRealLinea[]
  /// Órdenes de producción que salen de este renglón (F2-E2, N órdenes por renglón). Restrict.
  ordenes    Orden[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idPedido])
  @@index([idModelo])
  @@index([idDesarrollo])
  @@map("pedido_linea")
}

/// Pedido Real (F2-E1 — ex `PedidosReales`, doc 02-Pedidos §2 y §4.4): una LIBERACIÓN
/// real del cliente contra un pedido interno, con su CEDIS, apertura y fechas. Un pedido
/// interno tiene VARIOS pedidos reales en el tiempo. Se identifica de cara al cliente por
/// `numPedReal` (su número de pedido); NO lleva folio interno por secuencia (el viejo solo
/// usa `IdPedidosReales` autonumérico — la PK `id` cumple ese rol). NOTA F2-E1: la
/// cancelación del Pedido Real queda DIFERIDA (sin campo `cancelado`) — pendiente de
/// decisión de Daniel.
model PedidoReal {
  id       Int    @id @default(autoincrement())
  idPedido Int    @map("id_pedido")
  pedido   Pedido @relation(fields: [idPedido], references: [id], onDelete: Restrict)

  /// Número del pedido real del cliente (viejo: `NumPedReal`, texto libre).
  numPedReal         String?   @map("num_ped_real")
  /// Centro de distribución destino (viejo: `Cedis`, texto libre).
  cedis              String?
  /// Apertura/temporada (viejo: `Apertura`, texto libre en F2).
  apertura           String?
  /// Fecha del pedido real (viejo: `FechaPedPR`).
  fechaPedPR         DateTime? @map("fecha_ped_pr") @db.Date
  /// Ventana de entrega del pedido real — inicio (viejo: `FechaInicioPR`).
  fechaInicio        DateTime? @map("fecha_inicio") @db.Date
  /// Ventana de entrega del pedido real — fin (viejo: `FechaFinPR`).
  fechaFin           DateTime? @map("fecha_fin") @db.Date
  /// Fecha en que se entregó (viejo: `FechaEntregadaReal`).
  fechaEntregadaReal DateTime? @map("fecha_entregada_real") @db.Date

  /// Pedido real CANCELADO — cancelación SUAVE (V1-E4 punto 6, decisión §Post-F9.37 punto 9:
  /// Daniel, *"Sí"*). Cierra el TODO que estaba abierto desde F2-E1. Nunca se borra: sigue
  /// consultable, igual que `Pedido.pedCancelado` y `Orden.estado = cancelada` (D3).
  cancelado       Boolean @default(false)
  /// Motivo de la cancelación (OBLIGATORIO al cancelar, mismo criterio que `Orden.motivoCancelada`).
  motivoCancelada String? @map("motivo_cancelada") @db.Text

  lineas PedidoRealLinea[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idPedido])
  @@map("pedido_real")
}

/// Renglón de un pedido real (F2-E1 — ex `PedidosRealesDet`, doc 02-Pedidos §2). Liga al
/// renglón del pedido interno (`idPedidoLinea` → el modelo/precio) y captura las cantidades
/// pedida/enviada/entregada de ESTA liberación. La réplica automática (un renglón por cada
/// `PedidoLinea` del pedido interno) la hace el dominio en una transacción (doc 02 §4.4).
/// Cascade hacia `PedidoReal`; Restrict hacia `PedidoLinea`.
model PedidoRealLinea {
  id            Int         @id @default(autoincrement())
  idPedidoReal  Int         @map("id_pedido_real")
  pedidoReal    PedidoReal  @relation(fields: [idPedidoReal], references: [id], onDelete: Cascade)
  /// Renglón del pedido interno del que cuelga (viejo: `IdPedidosDet`). Restrict.
  idPedidoLinea Int         @map("id_pedido_linea")
  pedidoLinea   PedidoLinea @relation(fields: [idPedidoLinea], references: [id], onDelete: Restrict)

  /// Cantidad del pedido real (viejo: `CantidadPR`).
  cantidadPR            Int @default(0) @map("cantidad_pr")
  /// Cantidad enviada — captura manual en F2 (viejo: `CantidadEnviada`).
  cantidadEnviada       Int @default(0) @map("cantidad_enviada")
  /// Cantidad realmente entregada/aceptada — captura manual en F2 (viejo: `CantidadEntregadaReal`).
  cantidadEntregadaReal Int @default(0) @map("cantidad_entregada_real")
  /// Empaques (viejo: `Empaques`).
  empaques              Int @default(0)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idPedidoReal])
  @@index([idPedidoLinea])
  @@map("pedido_real_linea")
}

// ─────────────────────────────────────────────────────────────────────────────
// Órdenes de producción (Módulo ÓRDENES, F2-E2) — doc `Documentacion_MJD/03-Produccion.md`
// y `02-Pedidos.md`. La orden es el documento con el que se MANDA A PRODUCIR un renglón de
// un pedido (ex `Ordenes`/`OrdenesDet`). 5 tablas + 1 enum.
//
// Mapeo de columnas v1→v2 (el contrato del ETL futuro; el detalle vive en el TSDoc de
// `src/dominio/produccion/ordenes.ts`). Ninguna columna con datos se tira en silencio (plan §7):
//  • Folio por empresa (A3/A9): `ordenes` lleva un unique (id_empresa, folio); el valor sale de
//    la secuencia atómica "orden". Reemplaza el `AumentarNumOrd`/Max()+1 del viejo.
//  • Snapshots/datos conservados de v1 SIN motor (catálogos RC/finanzas aún no existen): columnas
//    escalares nullable SIN FK (idTipoArticuloRC, idRcAplicaciones, idRcTipoTelas, fechas RC,
//    enRiesgo, siRC, rcViva = F5; maquilaOrd, aplicacionOrd, pagada = F3/F6; tallasV1 = cadena
//    cruda de trazabilidad). Mismo espíritu que `idOrdCompraV1`. El `upc` (códigos de barra) fue
//    ELIMINADO (decisión Gabriel 16-jun-2026).
//  • Orden sin pedido = SOLO HISTÓRICO: `idPedidoLinea` es NULLABLE (el ETL migra ~26 casos
//    huérfanos del viejo), pero el servicio `crearOrden` EXIGE un renglón de pedido válido y
//    rechaza la captura nueva sin pedido.
// ─────────────────────────────────────────────────────────────────────────────

/// Estado de la orden de producción (F2-E2). NO editable por el usuario: lo DERIVAN los
/// servicios. `capturada` = recién abierta sin matriz; `completa` = ya tiene su matriz de
/// colores/tallas (paridad con `Ordenes.FechaDet` del viejo, que se sellaba al meter el
/// primer renglón del detalle); `cancelada` = cancelación suave (`Ordenes.OrdCancelada`).
enum EstadoOrden {
  capturada
  completa
  cancelada

  @@map("estado_orden")
}

/// Orden de producción (F2-E2 — ex `Ordenes`, doc 03-Produccion §Orden). Documento con el
/// que se manda a producir un renglón de un pedido. Folio consecutivo POR EMPRESA (A3/A9).
/// AUTORELLENO al crear desde un renglón de pedido: modelo/cliente/empresa derivan del
/// renglón→pedido (comportamiento `IdPedidosDet_AfterUpdate` del viejo). Ver el mapeo de las
/// 34 columnas v1 en el TSDoc de `src/dominio/produccion/ordenes.ts`.
model Orden {
  id        Int     @id @default(autoincrement())
  /// Folio consecutivo POR EMPRESA (A3/A9 — viejo: `Ordenes.Numero`).
  folio     BigInt
  /// Empresa dueña de la orden y de su numeración (A9 — viejo: `IdEmpresas`).
  idEmpresa Int     @map("id_empresa")
  empresa   Empresa @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)

  /// Renglón del pedido del que sale la orden (viejo: `IdPedidosDet`). NULLABLE en el esquema
  /// para que el ETL migre las órdenes huérfanas del viejo (~26 casos); pero la captura NUEVA
  /// lo EXIGE (orden sin pedido = solo histórico). N órdenes por renglón (resurtidos). Restrict.
  idPedidoLinea Int?         @map("id_pedido_linea")
  pedidoLinea   PedidoLinea? @relation(fields: [idPedidoLinea], references: [id], onDelete: Restrict)

  /// Modelo a producir (viejo: `IdModelos`). Autorrellenado del renglón de pedido. Restrict.
  idModelo  Int     @map("id_modelo")
  modelo    Modelo  @relation(fields: [idModelo], references: [id], onDelete: Restrict)
  /// Cliente de la orden (viejo: `IdClientes`). Autorrellenado del pedido. Restrict.
  idCliente Int     @map("id_cliente")
  cliente   Cliente @relation(fields: [idCliente], references: [id], onDelete: Restrict)

  /// Maquilero asignado (viejo: `IdMaquileros`). El maquilero es un Proveedor con rol de maquila
  /// tras la fusión de terceros (D12/R15); en F2 es SOLO asignación (no se valida el rol).
  /// Nullable (en datos viejos hay 0 = sin asignar). Restrict.
  idMaquilero     Int?           @map("id_maquilero")
  maquilero       Proveedor?     @relation(fields: [idMaquilero], references: [id], onDelete: Restrict)
  /// Etiqueta de marca de la orden (viejo: `IdEtiquetasM`). Nullable (hay nulos en datos). Restrict.
  idEtiquetaMarca Int?           @map("id_etiqueta_marca")
  etiquetaMarca   EtiquetaMarca? @relation(fields: [idEtiquetaMarca], references: [id], onDelete: Restrict)
  /// Tela dispuesta para la orden (viejo: `IdTelasDis`). Nullable. Restrict.
  idTela          Int?           @map("id_tela")
  tela            Tela?          @relation(fields: [idTela], references: [id], onDelete: Restrict)

  /// Fecha de la orden (viejo: `Fecha`).
  fecha         DateTime? @db.Date
  /// Fecha de entrega comprometida (viejo: `FechaEntrega`).
  fechaEntrega  DateTime? @map("fecha_entrega") @db.Date
  /// Observaciones generales (viejo: `Observaciones`).
  observaciones String?   @db.Text

  /// CADENA CRUDA de tallas del viejo (viejo: `Tallas`, p. ej. "CHM G EX"). De SOLO LECTURA, se
  /// conserva para trazabilidad; el despivote a `OrdenLineaTalla` (matriz real) lo hace el ETL.
  tallasV1 String? @map("tallas_v1")

  /// SNAPSHOT de la OC original del cliente (rediseño R3, B3 — petición Daniel 7-jul §4.1): se
  /// copia de `Pedido.ocCliente` AL CREAR la orden y ya NO se re-escribe (queda amarrado a la OP
  /// aunque el pedido interno se reorganice). Ningún endpoint lo edita.
  ocCliente String? @map("oc_cliente")

  /// DESGLOSE SKU/packs del cliente (importador de OC por PDF, petición Daniel): la tabla SKU/Talla/
  /// Piezas de la OC + los grupos "Detalles PACK / SKU" (Pack/tipo/unidades por pack/total packs/
  /// desglose por talla) TAL COMO vienen en el papel. HOY es informativo (no interviene en fabricar);
  /// será la base del futuro módulo de EMPAQUE (decisión de Daniel: guardarlo desde ya). Estructura
  /// jsonb (consultable), forma `{ tabla:[{sku,talla,piezas}], grupos:[{grupo,packId,tipo,unidadesPack,
  /// totalPacks,totalUnidades,desglose:[{talla,cantidad}]}] }`. Se escribe en la MISMA tx del alta de
  /// la OP (revierte con el rollback, A2). Null en órdenes que no nacen de un PDF con packs.
  packsCliente Json? @map("packs_cliente")

  /// Costo de maquila de la orden (viejo: `MaquilaOrd`). DATO conservado de v1; su motor (costeo)
  /// llega en F3/F6 — sin lógica en F2.
  maquilaOrd    Decimal? @map("maquila_ord") @db.Decimal(12, 2)
  /// Costo de aplicación/estampado (viejo: `AplicacionOrd`). DATO de v1; motor en F3/F6.
  aplicacionOrd Decimal? @map("aplicacion_ord") @db.Decimal(12, 2)
  /// No costear esta orden (viejo: `NoCost`). Bandera conservada (consumidor real: el costeo, F6).
  noCostear     Boolean  @default(false) @map("no_costear")
  /// Composición textil (viejo: `Composicion`).
  composicion   String?  @db.Text
  /// Composición forzada (viejo: `CompForzada`): la composición se capturó a mano, no derivó del BOM.
  compForzada   Boolean  @default(false) @map("comp_forzada")
  /// Observaciones de maquila (viejo: `ObsMaquila`).
  obsMaquila    String?  @map("obs_maquila") @db.Text
  /// Maquila ya pagada (viejo: `Pagada`). En F6-E4 es un estado DERIVADO (D3): la orden queda
  /// pagada cuando TODOS sus cargos EsMa pagables (validados, no sin-costo) están pagados. NO se
  /// edita a mano salvo el override `pagadaForzada`; lo recalcula el dominio al aplicar un pago.
  pagada        Boolean? @map("pagada")
  /// Override MANUAL AUDITADO de `pagada` (F6-E4, decisión (f)): si viene (true/false) fuerza el
  /// estatus y la derivación deja de pisarlo; null = derivación automática. Se registra en bitácora.
  pagadaForzada Boolean? @map("pagada_forzada")

  /// Estado AUTOMÁTICO (no editable): capturada/completa/cancelada (ver enum `EstadoOrden`). Lo
  /// decide `dominio/produccion/requisitos-orden.ts` (tallas + avíos, y arte si aplica).
  estado          EstadoOrden @default(capturada)
  /// Fecha en que la orden quedó COMPLETA por PRIMERA vez (paridad con `Ordenes.FechaDet` del
  /// viejo). Es un SELLO HISTÓRICO independiente del estado actual: se pone una sola vez, NO se
  /// re-sella y NO se borra, así que una orden puede estar `capturada` y traer fecha (estuvo
  /// completa y luego le quitaron la matriz). El estado NO se deriva de esta columna.
  fechaCompletada DateTime?   @map("fecha_completada")
  /// Motivo de la cancelación suave (viejo: `MotivoCancelada`; `OrdCancelada` → estado=cancelada).
  motivoCancelada String?     @map("motivo_cancelada") @db.Text

  // El código de barra de la orden (viejo: `UPC`) fue ELIMINADO (decisión Gabriel 16-jun-2026):
  // los códigos de barra están en retiro; la columna no se conserva ni se migra.

  // ── Datos de Ruta Crítica (F5) — conservados de v1 SIN FK ni motor (los catálogos RC aún no
  //    existen). Columnas escalares nullable; su lógica/relaciones llegan en F5.
  /// viejo: `IdCP_Articulos` (tipo de artículo RC). Sin FK hasta F5.
  idTipoArticuloRC Int?      @map("id_tipo_articulo_rc")
  /// viejo: `IdRC_Aplicaciones`. Sin FK hasta F5.
  idRcAplicaciones Int?      @map("id_rc_aplicaciones")
  /// viejo: `IdRC_TipoTelas`. Sin FK hasta F5.
  idRcTipoTelas    Int?      @map("id_rc_tipo_telas")
  /// viejo: `FechaInicioRC`. Dato RC (F5).
  fechaInicioRC    DateTime? @map("fecha_inicio_rc")
  /// viejo: `FechaEntregaRC`. Dato RC (F5).
  fechaEntregaRC   DateTime? @map("fecha_entrega_rc")
  /// viejo: `FechaProg`. Dato RC (F5).
  fechaProg        DateTime? @map("fecha_prog")
  /// viejo: `EnRiesgo`. Dato RC (F5).
  enRiesgo         Boolean?  @map("en_riesgo")
  /// viejo: `SI_RC`. Dato RC (F5).
  siRC             Boolean?  @map("si_rc")
  /// viejo: `RC_Viva`. Dato RC (F5).
  rcViva           Boolean?  @map("rc_viva")

  // ── Programación de la Ruta Crítica (F5-E3, motor pt1) — campos NUEVOS de v2 ──────────────
  //    Los escalares legacy de arriba (idTipoArticuloRC/idRcAplicaciones/idRcTipoTelas/…) se
  //    conservan SIN tocar (datos ETL de v1); la programación de v2 usa estos campos aditivos,
  //    con FK a los catálogos de E2. Todos nullable: prueba ya tiene órdenes ETL sin RC.
  /// ¿La RC de la orden está GENERADA y vigente? (v2, F5-E3). Distinto de `rcViva` (dato legado de v1).
  rcActiva             Boolean?               @map("rc_activa")
  /// Cuándo se PROGRAMÓ la RC de esta orden (v2; sello al generar). Paralelo al legado `fechaProg`.
  fechaProgramada      DateTime?              @map("fecha_programada")
  /// ¿La orden se programó como RESURTIDO? (v2). Los procesos `esResurtido` quedan en duración 0.
  esResurtidoRC        Boolean?               @map("es_resurtido_rc")
  /// Artículo RC elegido para la programación de v2 (FK al catálogo de E2). Restrict, nullable.
  idArticuloRcProg     Int?                   @map("id_articulo_rc_prog")
  articuloRcProg       ArticuloRC?            @relation(fields: [idArticuloRcProg], references: [id], onDelete: Restrict)
  /// Tipo de tela elegido para la programación de v2 (FK a DuracionPorTipoTela). Restrict, nullable.
  idDuracionTela       Int?                   @map("id_duracion_tela")
  duracionTela         DuracionPorTipoTela?   @relation(fields: [idDuracionTela], references: [id], onDelete: Restrict)
  /// Aplicación elegida para la programación de v2 (FK a DuracionPorAplicacion). Restrict, nullable.
  idDuracionAplicacion Int?                   @map("id_duracion_aplicacion")
  duracionAplicacion   DuracionPorAplicacion? @relation(fields: [idDuracionAplicacion], references: [id], onDelete: Restrict)
  /// Elección de secuencia de estampado de ESTA orden (rediseño R4, B10): solo aplica cuando el
  /// modelo es `flexible` (antes|despues; `flexible` no es un valor válido aquí — lo valida el
  /// dominio). Null = hereda la secuencia del modelo / aún sin decidir.
  secEstampadoElegido  SecuenciaEstampado?    @map("sec_estampado_elegido")
  /// Renglones de la RUTA VIVA de esta orden (un proceso por renglón) (F5-E3, D11). Cascade.
  rutaProcesos         RutaOrden[]

  // ── RECETA CONGELADA DE LA ORDEN (V1-E3d, §Post-F9.43) ────────────────────────────────────
  //    "El BOM debe de vivir en la OP" (Daniel). Al nacer la orden se COPIA la receta del modelo
  //    (telas + avíos con sus medidas por talla + artes) con su CANTIDAD y su PRECIO; a partir de
  //    ahí la orden vive de SU receta y el modelo sigue siendo la plantilla. Ver `orden_tela`.

  /// ⚠️ **DERIVADO desde V1-E3h (§Post-F9.72): "TODO lo vivo de esta receta está liberado".** La
  /// firma dejó de ser una sola para toda la receta y bajó AL RENGLÓN
  /// (`orden_tela/avio/arte.liberado_en`), porque Daniel pidió liberar POR PARTES: *"podría haber
  /// algún cierre que aún no autoriza el cliente, pero ya podríamos ir comprando lo demás"*.
  ///
  /// Se CONSERVA —y lo mantiene el DOMINIO, nunca la UI ni una vista— porque es lo que leen el
  /// semáforo de "orden completa" (`requisitos-orden.ts`) y el detalle de la orden: ahí la pregunta
  /// sigue siendo *"¿la receta está completa?"*, que es exactamente "no queda ningún renglón vivo
  /// sin firmar". NULL = queda algo por liberar (o no hay nada liberado).
  ///
  /// ⚠️ La PUERTA DE COMPRA ya NO se decide con esta columna: se compra lo LIBERADO, renglón por
  /// renglón (ver `exigirRecetaLiberada`). Cortar y producir siguen SIN bloquearse.
  recetaLiberadaEn    DateTime? @map("receta_liberada_en")
  /// Quién dejó la receta COMPLETAMENTE liberada. NULL con `recetaLiberadaEn` presente = la liberó
  /// la MIGRACIÓN (backfill de V1-E3d).
  recetaLiberadaPorId String?   @map("receta_liberada_por_id")

  /// Renglones de TELA de la receta congelada de esta orden. Cascade.
  recetaTelas OrdenTela[]
  /// Renglones de AVÍO de la receta congelada de esta orden. Cascade.
  recetaAvios OrdenAvio[]
  /// ARTES congelados de esta orden (bordado/estampado con su precio de ESTA orden). Cascade.
  recetaArtes OrdenArte[]

  lineas               OrdenLinea[]
  referencias          OrdenReferencia[]
  comentarios          OrdenComentario[]
  /// Etapas de producción de esta orden (corte/envío/recibo/entrega) (F3-E1, D4). Restrict.
  etapasMovimiento     EtapaMovimiento[]
  /// Cargos a maquileros (EsMa) derivados de los recibos de esta orden (F3-E1). Restrict.
  cargosEsMa           EsMaCargo[]
  /// Renglones de orden de compra ligados a esta orden de producción (F4-E2, R7: la
  /// liga es POR LÍNEA para cruzar gasto↔producción sin prorrateos). Restrict.
  ordenCompraLineas    OrdenCompraLinea[]
  /// Ligas N:N (a nivel encabezado) entre esta orden de producción y sus OC (F4-E2). Restrict.
  ordenesCompra        OrdenCompraOrden[]
  /// Snapshot de explosión MRP de esta orden (F4-E4, R3). Se reemplaza al regenerar. Cascade.
  requerimientos       RequerimientoOrden[]
  /// Renglones de nota de salida (avíos/telas enviados a maquila) ligados a esta orden (F4-E5). Restrict.
  notaSalidaLineas     NotaSalidaLinea[]
  /// Auditorías de calidad de esta orden (F6-E2). Restrict (una orden con auditorías no se borra).
  auditorias           Auditoria[]
  /// Renglones de kardex PT que PERTENECEN a esta orden (F6-E2 "PT por orden"). Restrict.
  movimientosDetPt     MovimientoDetPt[]
  /// Costo real de la orden (F7-E1, 1:1 opcional). Cascade: el costeo pertenece a la orden.
  costoOrden           CostoOrden?
  /// Renglones del EDR que valúan las ventas de esta orden en un mes (F7-E2). Restrict: una orden
  /// referida por un EDR no se borra físico (las líneas automáticas se reconcilian, no se cascadean).
  edrLineas            EdrLinea[]
  /// Verificaciones de confiabilidad de la ficha técnica de esta orden (F7-E4). Cascade: el checklist
  /// pertenece a la orden (si la orden desapareciera, sus verificaciones también).
  fichasVerificacion   FichaVerificacion[]
  /// Renglones de inventario cíclico ligados a esta orden (F7-E5 "PT por orden"). Restrict.
  inventarioCiclicoDet InventarioCiclicoDet[]
  /// Liga desarrollo↔orden (F8-E6): a lo más un desarrollo por orden. Cascade.
  desarrolloOrden      DesarrolloOrden?
  /// Adjuntos de apoyo (Excel/PDF/imágenes) de esta orden en R2 (F8-E6, R6). Cascade: son de la orden.
  archivos             OrdenArchivo[]
  /// Historial INMUTABLE de cambios de precio maquila/aplicación (rediseño R2, §4.4.3). Cascade.
  precioEventos        OrdenPrecioEvento[]
  /// Hitos capturados a mano de esta orden (post-F9): revisión OP, fit, tono, avíos, empaque, arte.
  /// Cada hito vivo auto-completa su proceso RC vía el auto-avance. Restrict (nunca se borra, D3).
  hitos                HitoOrden[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idEmpresa, folio])
  @@index([idPedidoLinea])
  @@index([idModelo])
  @@index([idCliente])
  @@index([idMaquilero])
  @@index([estado])
  @@map("ordenes")
}

/// Puente orden ↔ archivo R2 (F8-E6, R6). Liga un `Archivo` (registro del motor de archivos de F0)
/// a una ORDEN de producción como adjunto de apoyo (Excel/PDF/imágenes). Espejo de `ProveedorArchivo`
/// (sin `tipo`: los adjuntos de orden no llevan clasificación documental). `onDelete`:
///  • Cascade hacia `Orden`: los adjuntos son de la orden.
///  • Cascade hacia `Archivo`: al quitar el adjunto se borra también su `Archivo` (el objeto físico
///    en R2 lo borra el dominio best-effort, ya no queda huérfano — ver `comun/archivos.ts`).
model OrdenArchivo {
  id        Int    @id @default(autoincrement())
  idOrden   Int    @map("id_orden")
  idArchivo String @map("id_archivo")

  orden   Orden   @relation(fields: [idOrden], references: [id], onDelete: Cascade)
  archivo Archivo @relation(fields: [idArchivo], references: [id], onDelete: Cascade)

  creadoEn    DateTime @default(now()) @map("creado_en")
  creadoPorId String?  @map("creado_por_id")

  @@unique([idArchivo])
  @@index([idOrden])
  @@map("orden_archivo")
}

/// Qué precio de la orden cambió un evento: maquila (costura) o aplicación (estampado/bordado).
enum CampoPrecioOrden {
  maquila
  aplicacion

  @@map("campo_precio_orden")
}

/// Evento de cambio de PRECIO de la orden (rediseño R2, requisito de Daniel §4.4.3) — historial
/// INMUTABLE estilo `NegociacionEvento` (D3/A7: solo se INSERTA, jamás update/delete). Registra
/// quién capturó el precio real de maquila/aplicación, cuándo, con qué proveedor se negoció y el
/// valor anterior→nuevo. La edición vive en `dominio/produccion/precios-orden.ts` (permiso
/// `ordenes.precio-maquila`); la lectura de montos reales exige `ordenes.ver-precio-real-maquila`.
/// Cascade hacia `Orden` (el historial es de la orden); Restrict hacia `Proveedor`.
model OrdenPrecioEvento {
  id      Int   @id @default(autoincrement())
  idOrden Int   @map("id_orden")
  orden   Orden @relation(fields: [idOrden], references: [id], onDelete: Cascade)

  /// Cuál precio cambió (`maquilaOrd` o `aplicacionOrd`).
  campo          CampoPrecioOrden
  /// Valor que tenía el precio ANTES del cambio (null si no había precio real capturado).
  precioAnterior Decimal?         @map("precio_anterior") @db.Decimal(12, 2)
  /// Precio real negociado que quedó vigente con este evento.
  precioNuevo    Decimal          @map("precio_nuevo") @db.Decimal(12, 2)

  /// Proveedor con quien se NEGOCIÓ el precio (maquilero/estampador), opcional. Restrict.
  idProveedor Int?       @map("id_proveedor")
  proveedor   Proveedor? @relation(fields: [idProveedor], references: [id], onDelete: Restrict)
  /// Nota libre de la negociación (opcional). Inmutable.
  nota        String?    @db.Text

  /// Quién capturó (id de `Usuario`, sin FK física — patrón de auditoría del proyecto).
  capturadoPorId String?  @map("capturado_por_id")
  capturadoEn    DateTime @default(now()) @map("capturado_en")

  @@index([idOrden])
  @@index([idProveedor])
  @@map("orden_precio_evento")
}

/// Renglón de la matriz de una orden = un COLOR (F2-E2 — ex `OrdenesDet`, doc 03-Produccion).
/// En v1 el color era texto libre; en v2 es FK al catálogo `Color` (F1). Color ÚNICO por orden
/// (@@unique). Las cantidades por talla cuelgan en `OrdenLineaTalla` (NUNCA una columna `total`:
/// el total se deriva por suma, D4 + espíritu D3). Cascade hacia `Orden`; Restrict hacia `Color`.
model OrdenLinea {
  id      Int   @id @default(autoincrement())
  idOrden Int   @map("id_orden")
  orden   Orden @relation(fields: [idOrden], references: [id], onDelete: Cascade)
  idColor Int   @map("id_color")
  color   Color @relation(fields: [idColor], references: [id], onDelete: Restrict)

  /// Código PANTONE de ESTE color en la orden (petición Daniel: antes iba en observaciones, ahora es
  /// campo propio). POR color (una orden multi-color lleva un pantone por renglón). Opcional siempre
  /// (muchas OC no lo traen), editable a mano en la captura de la matriz; el importador de OC lo
  /// PREFILLEA cuando la OC lo trae. Texto libre (formato del cliente, p. ej. "11-0601 TCX").
  pantone String?

  tallas OrdenLineaTalla[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idOrden, idColor])
  @@index([idOrden])
  @@index([idColor])
  @@map("orden_linea")
}

/// Cantidad de una talla dentro de un renglón (color) de la matriz (F2-E2 — despivota las
/// columnas fijas `T1..T8` del viejo, D4: tallas ilimitadas por catálogo). Una talla aparece UNA
/// vez por renglón (@@unique). `cantidad` entera ≥0. NUNCA hay un `total` persistido: el total se
/// deriva por suma (D4 + espíritu D3). Cascade hacia `OrdenLinea`; Restrict hacia `Talla`.
model OrdenLineaTalla {
  id           Int        @id @default(autoincrement())
  idOrdenLinea Int        @map("id_orden_linea")
  ordenLinea   OrdenLinea @relation(fields: [idOrdenLinea], references: [id], onDelete: Cascade)
  idTalla      Int        @map("id_talla")
  talla        Talla      @relation(fields: [idTalla], references: [id], onDelete: Restrict)

  /// Cantidad de prendas de esta talla en este color (viejo: `T1..T8`). Entera ≥0.
  cantidad Int

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idOrdenLinea, idTalla])
  @@index([idOrdenLinea])
  @@index([idTalla])
  @@map("orden_linea_talla")
}

/// Valor de un campo de referencia del cliente en una orden (F2-E2, D7 — generaliza el
/// `Monarch` del viejo a campos por cliente). Cada valor corresponde a un `ClienteCampo` (la
/// DEFINICIÓN está en F1-E2) ACTIVO del cliente de la orden. Índice dedicado sobre `valor` para
/// la búsqueda GLOBAL de órdenes por referencia (D7). Cascade hacia `Orden`; Restrict hacia
/// `ClienteCampo`. Un campo se llena UNA vez por orden (@@unique).
model OrdenReferencia {
  id             Int          @id @default(autoincrement())
  idOrden        Int          @map("id_orden")
  orden          Orden        @relation(fields: [idOrden], references: [id], onDelete: Cascade)
  idClienteCampo Int          @map("id_cliente_campo")
  clienteCampo   ClienteCampo @relation(fields: [idClienteCampo], references: [id], onDelete: Restrict)
  /// Valor capturado para ese campo en esta orden (texto; el tipo lo valida el dominio según
  /// `ClienteCampo.tipo`). Indexado para búsqueda global por referencia (D7).
  valor          String

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idOrden, idClienteCampo])
  @@index([idOrden])
  @@index([valor])
  @@index([idClienteCampo, valor])
  @@map("orden_referencia")
}

/// Comentario INMUTABLE de una orden (F2-E2 — ex `ComentaOrd`, doc 03-Produccion). Cada
/// comentario lleva su autor y su fecha; una vez puesto NO se edita ni se borra (es un hilo de
/// bitácora del usuario). Cascade hacia `Orden`. `idUsuario` sin FK físico (mismo criterio que
/// la bitácora: log inmutable, los usuarios no se borran).
model OrdenComentario {
  id         Int      @id @default(autoincrement())
  idOrden    Int      @map("id_orden")
  orden      Orden    @relation(fields: [idOrden], references: [id], onDelete: Cascade)
  /// Usuario que escribió el comentario (viejo: `IdUsuarios`). Sin FK físico (log inmutable).
  idUsuario  String?  @map("id_usuario")
  /// Texto del comentario (viejo: `Comentario`). Inmutable.
  comentario String   @db.Text
  /// Fecha del comentario (viejo: `FechaComen`).
  fecha      DateTime @default(now())

  @@index([idOrden])
  @@map("orden_comentario")
}

// ═════════════════════════════════════════════════════════════════════════════
// RECETA CONGELADA DE LA ORDEN DE PRODUCCIÓN (V1-E3d, §Post-F9.43)
// ═════════════════════════════════════════════════════════════════════════════
//
// Daniel (14-ago-2026): *"Un modelo se desarrolla a partir de cierta información. Y en ocasiones
// se negocia con el cliente que ya no lleve alguna cosa (por ejemplo, quitarle una jareta para
// abaratar el costo)… **El BOM debe de vivir en la OP**. De hecho así funciona en Control viejo."*
//
// EL HUECO QUE TAPA: hasta aquí, TODO lo que en producción necesitaba saber qué lleva la prenda
// (MRP, habilitación, costeo real y el semáforo de "orden completa") leía el BOM del **modelo, en
// vivo**. Como las banderas `paraProduccion`/`paraCosto` son del MODELO, apagar la jareta de un
// cliente la apagaba en TODAS las órdenes de ese modelo, incluidas las ya producidas CON jareta.
//
// LA FORMA ESTÁ PROBADA POR 30 AÑOS: el viejo tiene `OrdenesHab(IdOrdenes, IdHabilitacion,
// CantHabOrd, PrecioHabOrd)` — congela por orden el avío, SU cantidad y SU precio. Medido sobre el
// volcado (5,451 órdenes / 28,432 renglones): 132 de 1,222 órdenes comparables (10.8 %) NO coinciden
// con el BOM de su modelo (72 quitaron un avío, 100 agregaron, 60 cambiaron cantidad); en 2,577
// órdenes la receta SOLO existe en la OP; y 15,255 de 24,480 renglones (62 %) traen precio distinto
// al del catálogo (la OP guardó **el precio del día**). v2 añade lo que el viejo no congelaba:
// **la TELA** (en v2 tiene consumo por prenda y alimenta el MRP) y **el ARTE**.
//
// LAS REGLAS DE ESTAS CUATRO TABLAS:
//  1. **Se copian al CREAR la orden** (elección de Daniel sobre "al explotar el MRP": así se revisa
//     y ajusta ANTES de comprar nada). Después son de la ORDEN: cambiar el modelo NO las pisa.
//  2. **Las TRES banderas viajan** (`paraPreCosto`/`paraProduccion`/`paraCosto`). No se colapsan a
//     una sola lista: cada consumidor conserva EXACTAMENTE el filtro que ya usaba, solo que ahora
//     sobre la receta de la orden → cero regresión de alcance.
//  3. **Quitar un renglón que vino del MODELO no lo borra: lo EXCLUYE** (`excluido`). Sin esa
//     lápida, el comparador contra el modelo no podría distinguir *"le quité la jareta a ESTA
//     orden"* (el caso de negocio) de *"el modelo agregó una jareta"*, y el aviso gritaría justo en
//     el caso que la etapa vino a habilitar. El renglón AGREGADO A MANO sí se borra de verdad (no
//     hay nada que recordar frente al modelo) dejando su copia ÍNTEGRA en la bitácora (D3).
//  4. **`estado` por renglón** (`sin_revisar`/`revisado`/`ajustado`) — mismo patrón `ajustado` que
//     el precosteo de F8. `ajustado` significa *"lo tocó una persona"*: por eso, ante una diferencia
//     contra el modelo, un renglón `ajustado` la atribuye a la persona y uno no-ajustado al modelo.
//     Ése es TODO el estado que hace falta: la desalineación se calcula AL VUELO comparando la
//     receta congelada con el BOM vivo — **sin evento, sin outbox, sin estado acumulado**
//     (§Post-F9.43(d): sin correo, el evento no compra nada).

/// En qué punto de revisión está un renglón de la receta de la orden (§Post-F9.43(c)).
///
/// ⚠️ **NO se fuerza el OK uno por uno.** El 89 % de las órdenes lleva la receta del modelo tal
/// cual; obligar a 8 clics por OP entrena a la gente a clickear sin leer, y ahí se pierde el control
/// con la ilusión de tenerlo. Por eso hay UN botón de "marcar todo revisado" y el renglón que se
/// desvía del modelo se pinta distinto para pedir atención solo.
enum EstadoRenglonReceta {
  /// Nació de la copia y nadie lo ha mirado.
  sin_revisar
  /// Alguien de Desarrollo lo miró y lo dio por bueno TAL COMO vino del modelo.
  revisado
  /// Se editó (o se agregó/excluyó) a mano en ESTA orden. Un cambio posterior del modelo NO lo pisa.
  ajustado

  @@map("estado_renglon_receta")
}

/// Renglón de TELA de la receta congelada de una orden (V1-E3d). Espejo de `ModeloTela` + el
/// PRECIO de esta orden + el estado de revisión. El viejo NO congelaba la tela (`Ordenes.IdTelasDis`
/// era una sola en el encabezado); en v2 sí, porque la tela tiene consumo por prenda y alimenta el
/// MRP — dejarla fuera repetiría el hueco que la etapa vino a tapar.
model OrdenTela {
  id      Int   @id @default(autoincrement())
  idOrden Int   @map("id_orden")
  orden   Orden @relation(fields: [idOrden], references: [id], onDelete: Cascade)
  idTela  Int   @map("id_tela")
  tela    Tela  @relation(fields: [idTela], references: [id], onDelete: Restrict)

  /// Consumo de tela por prenda EN ESTA ORDEN (copiado de `ModeloTela.consumoPorPrenda`).
  consumoPorPrenda Decimal  @map("consumo_por_prenda") @db.Decimal(12, 4)
  /// PRECIO congelado de esta tela EN ESTA ORDEN (el "precio del día" del viejo). Se copia del
  /// precio que la receta del modelo COSTEA (la cascada única de §Post-F9.48) y desde entonces es
  /// de la orden. NULL = no había ningún precio que congelar (el catálogo tampoco lo tenía).
  precio           Decimal? @db.Decimal(12, 2)

  /// 🔑 Las tres banderas, copiadas del modelo. Aquí significan lo mismo, pero **para esta orden**.
  paraPreCosto   Boolean @default(true) @map("para_pre_costo")
  paraProduccion Boolean @default(true) @map("para_produccion")
  paraCosto      Boolean @default(true) @map("para_costo")

  /// Amarre proveedor–tela heredado del BOM (R17). El MRP lo usa para saber A QUIÉN comprarle.
  /// SetNull: si el renglón proveedor se retira de la tela, el amarre se limpia (nunca cuelga).
  idTelaProveedor Int?           @map("id_tela_proveedor")
  telaProveedor   TelaProveedor? @relation(fields: [idTelaProveedor], references: [id], onDelete: SetNull)

  /// ⭐ V1-E3m (§Post-F9.82) — EL PROVEEDOR QUE **COMPRAS** ASIGNÓ **PARA ESTA ORDEN**. Daniel:
  /// *"el comprador asigna un proveedor **para esa OP en particular**… no para siempre ni para
  /// todo. El proveedor puede seguir viniendo desde desarrollo"*. Por eso vive AQUÍ (en la receta
  /// congelada = en la orden) y **jamás toca el catálogo**: una compra de urgencia no se vuelve
  /// permanente sin que nadie lo decida. Es el ÚLTIMO escalón de la resolución del MRP —solo se usa
  /// cuando ni Desarrollo (`idTelaProveedor`) ni el catálogo (`Tela.idProveedor`, el dueño)
  /// resuelven—, así que NO PUEDE pisar a Desarrollo: la autoridad queda intacta por construcción.
  /// Si algún día deja de usarse (porque Desarrollo amarró uno), la explosión lo DICE en un aviso
  /// en vez de callarlo (D3). Restrict: un proveedor asignado a una orden no se borra físico.
  idProveedorCompra Int?       @map("id_proveedor_compra")
  proveedorCompra   Proveedor? @relation("OrdenTelaProveedorCompra", fields: [idProveedorCompra], references: [id], onDelete: Restrict)
  /// Precio POR UNIDAD DE CONSUMO que capturó Compras junto con ese proveedor (opcional). Si viene,
  /// MANDA sobre la última compra real (alguien lo tecleó para ESTA compra, hoy); si no, el precio
  /// se resuelve solo (última compra a ese proveedor → su precio de catálogo → referencia).
  /// ⚠️ NO es `OrdenTela.precio` (el precio congelado que COSTEA la orden): éste es del día que se
  /// compra, aquél del día que nació la orden — la misma distinción de §Post-F9.43/.48.
  precioCompra      Decimal?   @map("precio_compra") @db.Decimal(12, 4)

  estado        EstadoRenglonReceta @default(sin_revisar)
  /// El renglón NO vino del modelo: lo agregó una persona en esta orden (regla 3 del encabezado).
  agregadoAMano Boolean             @default(false) @map("agregado_a_mano")
  /// LÁPIDA: el renglón vino del modelo y se decidió que ESTA orden no lo lleva (la jareta). Se
  /// conserva visible y tachado; ningún consumidor lo cuenta.
  excluido      Boolean             @default(false)
  /// Por qué se ajustó/excluyó (texto libre, opcional). Viaja a la bitácora.
  notas         String?             @db.Text

  /// ⭐ V1-E3h (§Post-F9.72) — LA FIRMA DE DESARROLLO, POR RENGLÓN. Daniel: *"podría haber algún
  /// cierre que aún no autoriza el cliente, pero ya podríamos ir comprando lo demás"*. NULL = este
  /// renglón todavía no lo firma Desarrollo: **no se compra** (la explosión del MRP no lo trae, y
  /// lo REPORTA aparte para que el comprador vea qué le falta). Tocar el CONTENIDO de un renglón ya
  /// liberado lo vuelve a poner en NULL (`enRecetaEditable`).
  liberadoEn    DateTime? @map("liberado_en")
  /// Quién firmó ESTE renglón. NULL con `liberadoEn` presente = lo firmó la MIGRACIÓN (backfill de
  /// V1-E3h: los renglones de las órdenes que ya estaban liberadas nacieron firmados, para que
  /// nadie se despierte con la puerta cerrada el día del deploy).
  liberadoPorId String?   @map("liberado_por_id")

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  /// ⭐⭐ V1-E3u (§Post-F9.89) — EL COLOR, QUE ES LO QUE SE COMPRA. Un renglón por cada color de
  /// la matriz de la orden que use esta tela, diciendo QUÉ COLOR DE LA TELA le toca. Ausencia =
  /// todavía nadie lo dijo: la explosión lo REPORTA (D3) en vez de adivinarlo. Cascade.
  colores OrdenTelaColor[]

  @@unique([idOrden, idTela])
  @@index([idOrden])
  @@index([liberadoEn])
  @@index([idTela])
  @@index([idTelaProveedor])
  @@index([idProveedorCompra])
  @@map("orden_tela")
}

/// ⭐⭐ **EL PUENTE QUE FALTABA** (V1-E3u, §Post-F9.89) — Daniel: *"cuando se hace la receta no
/// lleva el color, solo lleva la tela. Pero al pedir la tela… tengo que pedir el color en cada
/// modelo"*.
///
/// El sistema tenía DOS nociones de color que nunca se tocaban:
///  • el **color de la PRENDA** (`Color`), que es el de la matriz color×talla de la orden y trae
///    su pantone (`OrdenLinea.pantone`), y
///  • el **color de la TELA** (`TelaColor`), nombre libre del proveedor con su propio pantone,
///    su **precio** y su **precio de complemento** — que es lo que el almacén RECIBE y lo que el
///    kardex de telas guarda (`MovimientoDetTela.idTelaColor`, obligatorio).
///
/// La receta de la orden (`OrdenTela`) sólo decía la TELA, y el renglón de OC tampoco llevaba
/// color: **el sistema obligaba a RECIBIR por color y no dejaba PEDIR por color**, así que quien
/// recibía tenía que inventar la correspondencia. Esta tabla la ESCRIBE, por orden y por renglón
/// de receta: *para esta OP, el marino de la matriz es este color de esta tela*.
///
/// Vive en la ORDEN (no en el catálogo ni en el BOM del modelo) por la misma razón que
/// `OrdenTela.idProveedorCompra` (§Post-F9.82): el modelo define la TELA y eso está bien; el
/// COLOR es de cada pedido. Dos OP del mismo modelo compran colores distintos sin pisarse.
///
/// ⚠️ **NO se inventa.** El sistema PROPONE (por la liga legada `TelaColor.idColor`, si no por
/// nombre exacto) pero la propuesta no se guarda sola: mientras no haya renglón aquí, la explosión
/// dice *"falta decir de qué color"* y no compra ese renglón. Auditoría A7 en `Bitacora`.
model OrdenTelaColor {
  id          Int       @id @default(autoincrement())
  idOrdenTela Int       @map("id_orden_tela")
  ordenTela   OrdenTela @relation(fields: [idOrdenTela], references: [id], onDelete: Cascade)

  /// Color de la PRENDA (el de la matriz de la orden, `OrdenLinea.idColor`). Restrict.
  idColor Int   @map("id_color")
  color   Color @relation(fields: [idColor], references: [id], onDelete: Restrict)

  /// ⭐ Color de la TELA que le corresponde — lo que se PIDE al proveedor y lo que el almacén
  /// RECIBE. Restrict: un color de tela usado por una orden no se borra físico.
  idTelaColor Int       @map("id_tela_color")
  telaColor   TelaColor @relation(fields: [idTelaColor], references: [id], onDelete: Restrict)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idOrdenTela, idColor])
  @@index([idOrdenTela])
  @@index([idColor])
  @@index([idTelaColor])
  @@map("orden_tela_color")
}

/// Renglón de AVÍO de la receta congelada de una orden (V1-E3d) — el heredero directo de
/// `OrdenesHab` del viejo (`CantHabOrd`/`PrecioHabOrd`). Espejo de `ModeloAvio` + precio + estado.
model OrdenAvio {
  id      Int   @id @default(autoincrement())
  idOrden Int   @map("id_orden")
  orden   Orden @relation(fields: [idOrden], references: [id], onDelete: Cascade)
  idAvio  Int   @map("id_avio")
  avio    Avio  @relation(fields: [idAvio], references: [id], onDelete: Restrict)

  /// Consumo por prenda EN ESTA ORDEN (`CantHabOrd` del viejo).
  consumoPorPrenda Decimal  @map("consumo_por_prenda") @db.Decimal(12, 4)
  /// PRECIO congelado por unidad de consumo EN ESTA ORDEN (`PrecioHabOrd` del viejo).
  precio           Decimal? @db.Decimal(12, 2)

  paraPreCosto   Boolean @default(true) @map("para_pre_costo")
  paraProduccion Boolean @default(true) @map("para_produccion")
  paraCosto      Boolean @default(true) @map("para_costo")

  /// ¿Este avío se consume POR TALLA (R18)? Si sí, las medidas viven en `tallas`.
  consumoPorTalla Boolean @default(false) @map("consumo_por_talla")
  /// Proveedor del par `(idAvio, idAvioProveedor)` → `AvioProveedor` (SIN FK de relación, mismo
  /// criterio y nombre que `ModeloAvio.idAvioProveedor` y `OrdenCompraLinea.idAvioProveedor`).
  idAvioProveedor Int?    @map("id_avio_proveedor")

  /// ⭐ V1-E3m (§Post-F9.82) — EL PROVEEDOR QUE **COMPRAS** ASIGNÓ **PARA ESTA ORDEN** (mismo
  /// criterio, palabra por palabra, que `OrdenTela.idProveedorCompra`: vive en la orden, nunca en el
  /// catálogo, y es el ÚLTIMO escalón —debajo del amarre de Desarrollo, del habitual y del más
  /// barato—, así que no puede pisar a nadie). Restrict.
  idProveedorCompra Int?       @map("id_proveedor_compra")
  proveedorCompra   Proveedor? @relation("OrdenAvioProveedorCompra", fields: [idProveedorCompra], references: [id], onDelete: Restrict)
  /// Precio POR UNIDAD DE CONSUMO capturado por Compras junto al proveedor (opcional). Si viene,
  /// manda sobre la última compra real. ⚠️ NO es `OrdenAvio.precio` (el precio que COSTEA la orden).
  precioCompra      Decimal?   @map("precio_compra") @db.Decimal(12, 4)

  estado        EstadoRenglonReceta @default(sin_revisar)
  agregadoAMano Boolean             @default(false) @map("agregado_a_mano")
  excluido      Boolean             @default(false)
  notas         String?             @db.Text

  /// Medidas por talla de ESTE avío en ESTA orden (R18). Cascade.
  tallas OrdenAvioTalla[]

  /// ⭐ V1-E3h (§Post-F9.72) — LA FIRMA DE DESARROLLO, POR RENGLÓN. Daniel: *"podría haber algún
  /// cierre que aún no autoriza el cliente, pero ya podríamos ir comprando lo demás"*. NULL = este
  /// renglón todavía no lo firma Desarrollo: **no se compra** (la explosión del MRP no lo trae, y
  /// lo REPORTA aparte para que el comprador vea qué le falta). Tocar el CONTENIDO de un renglón ya
  /// liberado lo vuelve a poner en NULL (`enRecetaEditable`).
  liberadoEn    DateTime? @map("liberado_en")
  /// Quién firmó ESTE renglón. NULL con `liberadoEn` presente = lo firmó la MIGRACIÓN (backfill de
  /// V1-E3h: los renglones de las órdenes que ya estaban liberadas nacieron firmados, para que
  /// nadie se despierte con la puerta cerrada el día del deploy).
  liberadoPorId String?   @map("liberado_por_id")

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idOrden, idAvio])
  @@index([idOrden])
  @@index([liberadoEn])
  @@index([idAvio])
  @@index([idAvioProveedor])
  @@index([idProveedorCompra])
  @@map("orden_avio")
}

/// Medida (consumo) por TALLA de un avío de la receta de la orden (V1-E3d, R18). Copia de
/// `ModeloAvioTalla`, editable por orden — es la parte que Daniel puso a cargo de Desarrollo
/// (*"Desarrollo ajusta, define las medidas por talla y libera"*).
model OrdenAvioTalla {
  idOrdenAvio Int       @map("id_orden_avio")
  ordenAvio   OrdenAvio @relation(fields: [idOrdenAvio], references: [id], onDelete: Cascade)
  idTalla     Int       @map("id_talla")
  talla       Talla     @relation(fields: [idTalla], references: [id], onDelete: Restrict)

  /// ⭐ CANTIDAD que se consume de este avío en esta talla EN ESTA ORDEN, en `Avio.unidad` (R18).
  /// ⚠️ NO es la medida/especificación: eso es `idAvioMedida` (§Post-F9.66, V1-E3g).
  consumo      Decimal     @db.Decimal(12, 4)
  /// Amarre medida×talla (qué `AvioMedida` usa esta talla), copiado del BOM. SetNull.
  idAvioMedida Int?        @map("id_avio_medida")
  avioMedida   AvioMedida? @relation(fields: [idAvioMedida], references: [id], onDelete: SetNull)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@id([idOrdenAvio, idTalla])
  @@index([idOrdenAvio])
  @@index([idTalla])
  @@index([idAvioMedida])
  @@map("orden_avio_talla")
}

/// ARTE congelado de una orden (V1-E3d + §Post-F9.35). Copia de `ModeloArte` con **el precio de
/// ESTA orden** — el override que la decisión pedía ("el precio del modelo es referencia; el real
/// se define en la OP"). El viejo NO hacía nada por orden con los bordados: esto es nuevo de v2.
///
/// ⚠️ **Invariante heredada de la pieza A:** el precio del arte entra **UNA vez por orden, SIN
/// multiplicar por cantidad** (`dominio/costos/costo-orden.ts`). La foto NO se copia (vive en el
/// modelo, y R2 no se clona desde SQL): la traza `idModeloArte` la alcanza mientras exista.
model OrdenArte {
  id      Int   @id @default(autoincrement())
  idOrden Int   @map("id_orden")
  orden   Orden @relation(fields: [idOrden], references: [id], onDelete: Cascade)

  /// Traza al arte del modelo del que se copió, y desde V1-E3f **la IDENTIDAD del renglón dentro
  /// de la orden** (`@@unique([idOrden, idModeloArte])`): al desaparecer el `nombre` (§Post-F9.52
  /// punto 1) es lo único que casa un renglón congelado con su arte del modelo. NULL = renglón
  /// AGREGADO A MANO (Postgres trata los NULL como distintos, así que caben varios por orden).
  /// SetNull: quitar el arte del modelo NO toca lo ya congelado (descripción y precio viven aquí).
  idModeloArte Int?        @map("id_modelo_arte")
  modeloArte   ModeloArte? @relation(fields: [idModeloArte], references: [id], onDelete: SetNull)

  /// Descripción del arte EN ESTA ORDEN — el campo visible (V1-E3f: el `nombre` se retiró y la
  /// migración lo copió aquí donde la descripción venía vacía, D3). REQUERIDA.
  descripcion String
  /// Dónde va el arte en la prenda (texto libre, V1-E3f §Post-F9.52 punto 2).
  posicion    String?
  puntadas    Int?
  /// Precio del arte EN ESTA ORDEN (el override de §Post-F9.35). NULL = sin precio congelado.
  precio      Decimal?    @db.Decimal(12, 2)
  /// Tipo del arte: FK al catálogo ÚNICO (`TipoProceso.esArte`), ex enum `TipoArte` (V1-E3f).
  idTipoArte  Int         @map("id_tipo_arte")
  tipoArte    TipoProceso @relation(fields: [idTipoArte], references: [id], onDelete: Restrict)
  /// Proveedor que hace el arte. Restrict (un proveedor en uso no se borra físico).
  idProveedor Int?        @map("id_proveedor")
  proveedor   Proveedor?  @relation(fields: [idProveedor], references: [id], onDelete: Restrict)

  estado        EstadoRenglonReceta @default(sin_revisar)
  agregadoAMano Boolean             @default(false) @map("agregado_a_mano")
  excluido      Boolean             @default(false)
  notas         String?             @db.Text

  /// ⭐ V1-E3h (§Post-F9.72) — LA FIRMA DE DESARROLLO, POR RENGLÓN. Daniel: *"podría haber algún
  /// cierre que aún no autoriza el cliente, pero ya podríamos ir comprando lo demás"*. NULL = este
  /// renglón todavía no lo firma Desarrollo: **no se compra** (la explosión del MRP no lo trae, y
  /// lo REPORTA aparte para que el comprador vea qué le falta). Tocar el CONTENIDO de un renglón ya
  /// liberado lo vuelve a poner en NULL (`enRecetaEditable`).
  liberadoEn    DateTime? @map("liberado_en")
  /// Quién firmó ESTE renglón. NULL con `liberadoEn` presente = lo firmó la MIGRACIÓN (backfill de
  /// V1-E3h: los renglones de las órdenes que ya estaban liberadas nacieron firmados, para que
  /// nadie se despierte con la puerta cerrada el día del deploy).
  liberadoPorId String?   @map("liberado_por_id")

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idOrden, idModeloArte])
  @@index([idOrden])
  @@index([liberadoEn])
  @@index([idModeloArte])
  @@index([idProveedor])
  @@index([idTipoArte])
  @@map("orden_arte")
}

// ═════════════════════════════════════════════════════════════════════════════
// PRODUCCIÓN / WIP + MOTOR KARDEX (F3-E1) — modelo de datos de TODA F3 en una
// migración. Diseño en docs/arquitectura/ADR-0010-motor-kardex-produccion.md.
//
// Dos planos que NO se mezclan (ADR-0010):
//  • PLANO WIP (avance de la orden): `EtapaMovimiento` + `EtapaMovimientoDet`. Captura
//    corte/envío/recibo/entrega por color×talla (D4). Los pendientes del WIP (por cortar,
//    cortado por enviar, por recibir…) son DERIVADOS de estas filas — sin acumuladores.
//  • PLANO INVENTARIO (kardex genérico, D3): `Movimiento` (encabezado) + un detalle POR
//    TIPO de artículo (`MovimientoDetPt`/`MovimientoDetTela`/`MovimientoDetAvio`). La
//    existencia es SIEMPRE Σ del detalle — NUNCA una columna/tabla editable (D3).
//
// MECANISMO DE EXTENSIBILIDAD (ADR-0010 §2): un detalle por tipo de artículo (NO columnas
// nullable+CHECKs en una tabla gorda). En F3 solo se ejercita la dimensión PT; las tablas
// de tela y avío nacen aquí VACÍAS para que F4 las ejercite SIN migrar filas existentes ni
// tocar el núcleo de `kardex.ts` (que opera sobre el encabezado `Movimiento` y delega el
// detalle por tipo). La única ALTER que F4 hará es agregar la FK `id_lote → Lote` (modelo
// que nace en F4): es aditiva y segura, no migra filas. Criterio verificable contra D5/R4.
//
// costoUnit: NULLABLE y SIEMPRE NULL en F3 (D1/D2 — la valuación a costo actual llega en
// F7). Política fijada en ADR-0010 §4, con test en Fase 2.
//
// Auditoría A7 + idEmpresa A9 + folio por secuencia atómica A3 ("etapa-mov", "movimiento")
// + borrado/cancelación SUAVE (canceladoEn/canceladoPor/motivoCancelacion). FKs Restrict
// hacia catálogos en uso; Cascade hacia el encabezado en los detalles (reescribir el set
// en la tx A2). El despachador de eventos de dominio vive en src/comun/eventos.ts (Fase 2,
// solo el gancho — ADR-0010 §6).
// ═════════════════════════════════════════════════════════════════════════════

/// Tipo de etapa del WIP de una orden (D4 — PLANMAESTRO §4). La maquila es UNIFICADA: el
/// envío/recibo NO distinguen costura vs estampado en el enum, lo distingue `idTipoProceso`
/// (D8 — "maquila unificada parametrizada por TipoProceso"). El `corte` y la `entrega_cliente`
/// no llevan proceso. El estampado pre/post-costura se modela como envío/recibo de su
/// TipoProceso (WIP+cargo) y, para su va-y-ven de inventario, con los tipos 6/3 del kardex (E3).
enum TipoEtapaMovimiento {
  corte
  envio_maquila
  recibo_maquila
  entrega_cliente

  @@map("tipo_etapa_movimiento")
}

/// Dirección de un tipo de movimiento de inventario (ex `IPT_TiposMov.TipoEnSa`: 1/2/3).
/// `entrada` suma (+1), `salida` resta (−1). El detalle guarda `cantidad` SIEMPRE positiva; el
/// SIGNO de la existencia lo deriva el kardex de esta dirección.
///
/// `traspaso` es una ETIQUETA DE CATÁLOGO (el tipo viejo 9 'Transferencia entre almacenes',
/// `TipoEnSa=3`): NO es una dirección que la vista de existencia interprete con un signo plano.
/// Resolución del nit #1 del reviewer (ADR-0010 §1/§5): un traspaso se MATERIALIZA como DOS
/// `Movimiento` —salida del almacén origen + entrada del almacén destino, cada uno con un
/// `TipoMovimientoInventario` de dirección EFECTIVA `salida`/`entrada`— en UNA transacción (A2).
/// Así la vista `existencia_pt` solo ve patas `entrada`/`salida` y la existencia TOTAL no cambia
/// (la cantidad pasa de origen a destino). La vista mapea `entrada→+1`, `salida→−1` y cualquier
/// otra (incluido `traspaso`, que NO debería aparecer en el detalle) a `0` (defensivo): un
/// encabezado con dirección `traspaso` jamás lleva detalle de existencia, no la infla.
enum DireccionMovimiento {
  entrada
  salida
  traspaso

  @@map("direccion_movimiento")
}

/// Estado del cargo a un maquilero (EsMa). Nace `propuesto` al registrar el recibo (F3-E4);
/// el admin lo `validado` (ajusta cantidad/precio real, doc 07-EsMa §2 — punto de control
/// humano CONSERVADO sin recapturar); `cancelado` si el recibo se cancela antes de validar.
enum EstadoCargoEsMa {
  propuesto
  validado
  cancelado

  @@map("estado_cargo_esma")
}

/// Etapa del WIP de una orden (F3-E1 — PLANO WIP; D4 §PLANMAESTRO §4, doc 03-Produccion).
/// Es el encabezado de cada CAPTURA de corte/envío/recibo/entrega; el detalle color×talla
/// cuelga en `EtapaMovimientoDet`. NO es el kardex: el kardex PT (entrada/salida real de
/// existencia) lo genera SOLO el recibo de costura (`TipoProceso.generaEntradaPt`) y la
/// entrega, vía un `Movimiento` aparte (F3-E4/E5). Aquí los pendientes del WIP se DERIVAN
/// por suma (sin acumuladores). Folio por secuencia atómica (A3, clave "etapa-mov") POR
/// EMPRESA (A9). Cancelación SUAVE + motivo + Bitácora (A7). Liga recibo↔envío AGREGADA por
/// orden+proceso, con `idEtapaEnvio` OPCIONAL (decisión (d), ADR-0010 §7: reversible).
model EtapaMovimiento {
  id        Int     @id @default(autoincrement())
  /// Folio consecutivo POR EMPRESA (A3 — secuencia "etapa-mov"; en el ETL conserva el
  /// `Consecutivo` histórico de v1).
  folio     BigInt
  /// Empresa dueña de la etapa y de su numeración (A9).
  idEmpresa Int     @map("id_empresa")
  empresa   Empresa @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)

  /// Orden a la que pertenece la etapa (doc 03-Produccion). Restrict.
  idOrden Int   @map("id_orden")
  orden   Orden @relation(fields: [idOrden], references: [id], onDelete: Restrict)

  /// Qué etapa es (corte/envío/recibo/entrega). Ver enum `TipoEtapaMovimiento`.
  tipo TipoEtapaMovimiento

  /// Tipo de proceso de maquila (costura/estampado/bordado/lavado). OBLIGATORIO en
  /// envío/recibo de maquila, NULL en corte y entrega a cliente (lo valida el dominio —
  /// el esquema lo deja nullable porque no todas las etapas lo llevan). Restrict.
  idTipoProceso Int?         @map("id_tipo_proceso")
  tipoProceso   TipoProceso? @relation(fields: [idTipoProceso], references: [id], onDelete: Restrict)

  /// Tercero de la etapa: cortador (corte) o maquilero/estampador (envío/recibo). Es un
  /// `Proveedor` con su rol de servicio (fusión de terceros D12/R15). NULL en entrega a
  /// cliente y en datos viejos sin asignar. Restrict.
  idTercero Int?       @map("id_tercero")
  tercero   Proveedor? @relation(fields: [idTercero], references: [id], onDelete: Restrict)

  /// Fecha de la etapa (captura o compromiso, según el tipo — el dominio lo precisa).
  fecha           DateTime  @db.Date
  /// Fecha compromiso del maquilero en los envíos (doc 03-Produccion Paso 4). Nullable.
  fechaCompromiso DateTime? @map("fecha_compromiso") @db.Date
  /// Precio pactado de maquila para envíos (doc 03 — `PrecioPactado`); base del cargo EsMa
  /// del recibo. Nullable: 1,309 envíos viejos no lo traen (por eso la validación del cargo
  /// en F3-E4 es obligatoria). Decimal.
  precioPactado   Decimal?  @map("precio_pactado") @db.Decimal(12, 2)
  observaciones   String?   @db.Text

  /// LIGA recibo↔envío (decisión (d), ADR-0010 §7): en un recibo apunta OPCIONALMENTE al
  /// envío que se está recibiendo. Hoy el WIP cuadra por AGREGADO orden+proceso (la liga
  /// puede quedar NULL); se deja para que, si Daniel pide amarre estricto por envío, sea
  /// dato y no migración. Autorreferencia Restrict (no borrar un envío con recibos ligados).
  idEtapaEnvio Int?              @map("id_etapa_envio")
  etapaEnvio   EtapaMovimiento?  @relation("ReciboDeEnvio", fields: [idEtapaEnvio], references: [id], onDelete: Restrict)
  recibos      EtapaMovimiento[] @relation("ReciboDeEnvio")

  /// Almacén destino de las PRIMERAS de un RECIBO de costura (F3-E4). Solo se usa cuando el
  /// recibo genera entrada a PT (`TipoProceso.generaEntradaPt`); NULL en corte/envío y en los
  /// recibos de procesos que NO meten a PT (estampado/bordado/lavado). La CALIDAD (primeras/
  /// segundas) se captura SEPARADA del almacén destino (decisión Gabriel F3-E4): lo bueno va a
  /// "Primeras", lo defectuoso a "Segundas". Restrict.
  idAlmacenPrimeras Int?     @map("id_almacen_primeras")
  almacenPrimeras   Almacen? @relation("ReciboAlmacenPrimeras", fields: [idAlmacenPrimeras], references: [id], onDelete: Restrict)
  /// Almacén destino de las SEGUNDAS de un RECIBO de costura (F3-E4). NULL si el recibo no
  /// reportó segundas o no genera entrada a PT. Restrict.
  idAlmacenSegundas Int?     @map("id_almacen_segundas")
  almacenSegundas   Almacen? @relation("ReciboAlmacenSegundas", fields: [idAlmacenSegundas], references: [id], onDelete: Restrict)

  /// ⭐ V1-E4b (§Post-F9.61) — ENVÍO DE PRENDAS YA TERMINADAS. `true` cuando lo que se manda al
  /// tercero ya es producto terminado (un estampado/lavado DESPUÉS de la costura, que Daniel ya
  /// hace hoy — §Post-F9.60). Solo aplica a `envio_maquila`.
  ///
  /// Es la propiedad que ARREGLA el problema de nivel de §Post-F9.59: si el proceso va antes o
  /// después de la costura NO es del `TipoProceso` (el mismo estampado va antes en una orden y
  /// después en otra), es de ESTE envío. Con la bandera puesta:
  ///   • el envío SACA las prendas de `idAlmacenOrigen` y las mete al almacén de TRÁNSITO;
  ///   • su recibo las DEVUELVE del tránsito a Primeras/Segundas (reclasificación incluida),
  ///     sin importar `TipoProceso.generaEntradaPt` (que sigue significando "este proceso CREA
  ///     producto terminado", que sí es del tipo: la costura).
  /// `false` = flujo de siempre (bultos cortados): el envío no toca el kardex de PT.
  prendaTerminada Boolean @default(false) @map("prenda_terminada")

  /// Almacén de PT del que SALEN las prendas de un envío con `prendaTerminada` (V1-E4b).
  /// OBLIGATORIO en ese caso (lo exige el dominio), NULL en todo lo demás. Restrict.
  idAlmacenOrigen Int?     @map("id_almacen_origen")
  almacenOrigen   Almacen? @relation("EnvioAlmacenOrigen", fields: [idAlmacenOrigen], references: [id], onDelete: Restrict)

  /// De QUÉ BUCKET de existencia salieron las prendas de un envío con `prendaTerminada` (V1-E4b).
  /// La existencia de PT es por modelo×color×talla×**ORDEN**×almacén (F6-E2 "PT por orden"), y el
  /// bucket `id_orden = NULL` —"sin orden asignada"— es donde cae TODO lo capturado a mano en el
  /// arranque y TODO el histórico migrado (`migracion/loaders/ipt-kardex.ts` no etiqueta orden).
  ///
  /// `false` (default) = las piezas salen del bucket de SU orden. `true` = salen del bucket «sin
  /// orden». Sin este dato, un envío solo podía sacar del bucket de la orden y el stock de arranque
  /// de Daniel —que es el que hay el día uno— era inalcanzable. El recibo DEVUELVE al MISMO bucket
  /// del que salió: el tránsito no reetiqueta mercancía a espaldas de nadie.
  stockSinOrden Boolean @default(false) @map("stock_sin_orden")

  /// Cancelación SUAVE (plan §4): la etapa nunca se borra ni se edita; se cancela con motivo
  /// y queda en el historial (A7). El kardex/efectos se revierten con movimiento inverso (E4/E5).
  canceladoEn       DateTime? @map("cancelado_en")
  /// Usuario que canceló (sin FK físico, mismo criterio que la auditoría — ADR-0005).
  canceladoPorId    String?   @map("cancelado_por_id")
  motivoCancelacion String?   @map("motivo_cancelacion") @db.Text

  /// Detalle color×talla de la etapa (SIEMPRE, D4). Cascade (reescribir el set en la tx A2).
  detalles   EtapaMovimientoDet[]
  /// Cargo(s) EsMa derivados de esta etapa cuando es un recibo (F3-E4). Restrict.
  cargosEsMa EsMaCargo[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idEmpresa, folio])
  @@index([idOrden])
  @@index([idOrden, tipo, idTipoProceso])
  @@index([idTipoProceso])
  @@index([idTercero])
  @@index([idEtapaEnvio])
  @@index([idAlmacenPrimeras])
  @@index([idAlmacenSegundas])
  @@index([idAlmacenOrigen])
  @@map("etapa_movimiento")
}

/// Renglón color×talla de una etapa del WIP (F3-E1, D4 — despivota T1..T8/TC1..TC8 del viejo
/// a FILAS, MEJORAS A6). Una talla aparece UNA vez por color por etapa (@@unique). `cantidad`
/// entera ≥0; NUNCA hay un `total` persistido (se deriva por suma, D4 + espíritu D3). Cascade
/// hacia la etapa (reescribir el set en la tx); Restrict hacia Color/Talla (en uso ⇒ se desactiva).
/// NO lleva `idEmpresa`: la empresa SE DERIVA del encabezado `EtapaMovimiento.idEmpresa` (A9 —
/// el detalle nunca se consulta ni escribe fuera de su encabezado).
model EtapaMovimientoDet {
  id         Int             @id @default(autoincrement())
  idEtapaMov Int             @map("id_etapa_mov")
  etapaMov   EtapaMovimiento @relation(fields: [idEtapaMov], references: [id], onDelete: Cascade)
  idColor    Int             @map("id_color")
  color      Color           @relation(fields: [idColor], references: [id], onDelete: Restrict)
  idTalla    Int             @map("id_talla")
  talla      Talla           @relation(fields: [idTalla], references: [id], onDelete: Restrict)

  /// Cantidad de prendas de esta talla en este color para la etapa. Entera ≥0. En un RECIBO
  /// de maquila es el TOTAL recibido (= primeras + segundas); en corte/envío es la cantidad
  /// cortada/enviada (sin desglose de calidad).
  cantidad Int

  /// CALIDAD del recibo (F3-E4, decisión Gabriel): cuántas de las `cantidad` recibidas son
  /// PRIMERAS (buenas) y cuántas SEGUNDAS (defectuosas). Solo se llenan en recibos; NULL en
  /// corte/envío. Cuando ambas vienen, `cantidadPrimeras + cantidadSegundas = cantidad` (lo
  /// valida el dominio). La calidad es DATO del WIP, SEPARADA del almacén destino (que vive en
  /// el encabezado). El kardex de costura mete las primeras al almacén de primeras y las
  /// segundas al de segundas (F3-E4).
  cantidadPrimeras Int? @map("cantidad_primeras")
  cantidadSegundas Int? @map("cantidad_segundas")

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idEtapaMov, idColor, idTalla])
  @@index([idEtapaMov])
  @@index([idColor])
  @@index([idTalla])
  @@map("etapa_movimiento_det")
}

/// Catálogo de tipos de movimiento de inventario (F3-E1 — ex `IPT_TiposMov`, doc 04-Inventarios
/// §A.2). 19 tipos en el seed (Fase 2): Inventario Inicial, Entrada de Maquila, Entrega a
/// Cliente, Transferencia, Ajustes… Cada tipo lleva su `direccion` (entrada/salida/traspaso, ex
/// `TipoEnSa` 1/2/3) que el kardex usa para el signo. GLOBAL (catálogo, sin idEmpresa — ADR-0007).
/// `codigo` estable kebab-case para referenciarlo en código/seed sin atarlo al texto. Borrado
/// suave (los tipos en desuso se desactivan, no se borran). Solo lectura por API en F3-E1.
model TipoMovimientoInventario {
  id        Int                 @id @default(autoincrement())
  /// Clave estable kebab-case (p. ej. "entrada-maquila", "entrega-cliente"). Única global.
  codigo    String              @unique
  /// Nombre para mostrar (ex `IPT_TiposMov.TipoMov`).
  nombre    String
  /// Dirección del movimiento (ex `TipoEnSa`): entrada suma, salida resta, traspaso mueve.
  direccion DireccionMovimiento
  activo    Boolean             @default(true)

  /// Movimientos de kardex de este tipo (F3). Restrict: un tipo en uso no se borra físico.
  movimientos Movimiento[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("tipos_movimiento_inventario")
}

/// Encabezado de un movimiento del KARDEX único (F3-E1 — PLANO INVENTARIO; D3, PLANMAESTRO §4).
/// GENÉRICO para PT/tela/avío: el encabezado es el mismo; el detalle es POR TIPO de artículo
/// (`detallesPt`/`detallesTela`/`detallesAvio` — ADR-0010 §2). En F3 SOLO se ejercita PT. La
/// existencia es SIEMPRE Σ del detalle (D3) — NO hay columna/tabla de existencia editable; la
/// vista `ExistenciaPt` (CREATE VIEW en la migración) es solo para CONSULTA. Las validaciones
/// transaccionales (no entregar lo que no existe) suman el detalle DIRECTO bajo bloqueo, NUNCA
/// la vista (ADR-0010 §3). Referencia polimórfica al ORIGEN (`origenTipo`+`origenId`, ADR-0010
/// §1): qué hecho generó el movimiento (recibo, entrega, movimiento manual, traspaso…). Folio
/// por secuencia atómica (A3, "movimiento") POR EMPRESA (A9). Cancelación = movimiento INVERSO
/// auditado, NUNCA edición/borrado (D3/A7) — `idMovimientoInverso` enlaza el par.
model Movimiento {
  id        Int     @id @default(autoincrement())
  /// Folio consecutivo POR EMPRESA (A3 — secuencia "movimiento").
  folio     BigInt
  /// Empresa dueña del movimiento y de su numeración (A9).
  idEmpresa Int     @map("id_empresa")
  empresa   Empresa @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)

  /// Tipo de movimiento (entrada/salida/traspaso vía su `direccion`). Restrict.
  idTipoMov Int                      @map("id_tipo_mov")
  tipoMov   TipoMovimientoInventario @relation(fields: [idTipoMov], references: [id], onDelete: Restrict)

  /// Almacén afectado (D4: existencia por …×almacén). En un traspaso, cada pata del par
  /// (salida-origen / entrada-destino) es un `Movimiento` con su propio almacén. Restrict.
  idAlmacen Int     @map("id_almacen")
  almacen   Almacen @relation(fields: [idAlmacen], references: [id], onDelete: Restrict)

  fecha DateTime @db.Date

  /// REFERENCIA POLIMÓRFICA al origen (ADR-0010 §1): `origenTipo` discrimina (p. ej.
  /// "recibo-maquila", "entrega-cliente", "movimiento-manual", "traspaso", "ajuste") y
  /// `origenId` es el id de esa fila (texto, para cubrir PKs Int/String). SIN FK física (el
  /// origen es de varias tablas; el dominio garantiza la consistencia, mismo criterio que la
  /// Bitácora — ADR-0005). Permite trazar el movimiento a su hecho sin acoplar el kardex a
  /// cada tabla de origen.
  origenTipo String? @map("origen_tipo")
  origenId   String? @map("origen_id")

  /// Usuario que registró el movimiento (sin FK física — ADR-0005, log de inventario).
  idUsuario String? @map("id_usuario")

  /// Movimiento que ANULA a otro (cancelación = inverso auditado, NUNCA borrado — D3/A7).
  /// En el inverso apunta al original; el original referencia al inverso por la relación
  /// inversa `anuladoPor`. Autorreferencia Restrict.
  idMovimientoInverso Int?         @map("id_movimiento_inverso")
  movimientoOriginal  Movimiento?  @relation("MovimientoInverso", fields: [idMovimientoInverso], references: [id], onDelete: Restrict)
  anuladoPor          Movimiento[] @relation("MovimientoInverso")

  observaciones String? @db.Text

  /// Detalle por TIPO de artículo (ADR-0010 §2). En F3 solo se llena `detallesPt`; tela/avío
  /// nacen vacías para F4 (sin migrar filas ni tocar el núcleo). Cascade (reescribir set en tx).
  detallesPt   MovimientoDetPt[]
  detallesTela MovimientoDetTela[]
  detallesAvio MovimientoDetAvio[]

  /// Renglones de recepción de compra que GENERARON este movimiento de entrada (F4-E3): traza
  /// del movimiento de kardex a su renglón de recepción. SetNull al borrar el movimiento (que
  /// nunca pasa — D3: los movimientos no se borran). Relación inversa informativa.
  recepcionLineas RecepcionCompraLinea[]

  /// Renglones de nota de salida de TELA que REFERENCIAN este movimiento `salida-tela-orden` como
  /// documento de envío (F4-E5, decisión (e): la nota no descuenta tela, la referencia). Inversa.
  notaLineasSalidaTela NotaSalidaLinea[]      @relation("NotaLineaSalidaTela")
  /// Renglones de nota de salida de AVÍO cuyo descuento (`salida-por-nota`) GENERÓ este movimiento
  /// al confirmar la nota (F4-E5, R4). Inversa informativa.
  notaLineasAvio       NotaSalidaLinea[]      @relation("NotaLineaAvio")
  /// Renglones de inventario cíclico cuyo AJUSTE generó este movimiento (F7-E5). Inversa informativa.
  ajustesCiclico       InventarioCiclicoDet[]
  /// Documento de ENTRADA de tela por factura/remisión (B1) que generó este movimiento al
  /// CONFIRMARSE. 0 o 1 (la liga es 1:1 — `EntradaTela.idMovimiento` es único). Inversa.
  entradaTela          EntradaTela?

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idEmpresa, folio])
  @@index([idTipoMov])
  @@index([idAlmacen])
  @@index([origenTipo, origenId])
  @@index([idMovimientoInverso])
  @@map("movimientos")
}

/// Detalle de kardex para PRODUCTO TERMINADO (F3-E1, D4 — dimensión PT: modelo×color×talla).
/// La existencia PT es Σ(cantidad·signo) por modelo×color×talla×almacén (D3). `cantidad`
/// SIEMPRE positiva (el signo lo da `Movimiento.tipoMov.direccion`); el dominio lo valida.
/// `costoUnit` NULLABLE y SIEMPRE NULL en F3 (D1/D2 — valuación en F7; ADR-0010 §4). Cascade
/// hacia `Movimiento`; Restrict hacia Modelo/Color/Talla. La empresa y el almacén SE DERIVAN
/// del encabezado `Movimiento` (A9 — el detalle no se consulta fuera de él). NO hay @@unique:
/// un movimiento PUEDE repetir el mismo artículo en líneas distintas (nit #3 del reviewer — la
/// vista suma todas las líneas; la unicidad operativa, si aplica, la cuida el dominio).
model MovimientoDetPt {
  id           Int        @id @default(autoincrement())
  idMovimiento Int        @map("id_movimiento")
  movimiento   Movimiento @relation(fields: [idMovimiento], references: [id], onDelete: Cascade)
  idModelo     Int        @map("id_modelo")
  modelo       Modelo     @relation(fields: [idModelo], references: [id], onDelete: Restrict)
  idColor      Int        @map("id_color")
  color        Color      @relation(fields: [idColor], references: [id], onDelete: Restrict)
  idTalla      Int        @map("id_talla")
  talla        Talla      @relation(fields: [idTalla], references: [id], onDelete: Restrict)

  /// ORDEN de producción a la que PERTENECEN estas prendas (F6-E2 "PT por orden" — restaura el
  /// `IPT_Modelos.IdOrdenes` de v1; ver ADR-0014, enmienda de ADR-0010). NULLABLE: el histórico
  /// migrado (`origenTipo='migracion'`) y los movimientos manuales/traspasos NO la traen (bucket
  /// "sin orden"). Con esta columna la existencia PT pasa a ser por modelo×color×talla×ORDEN×almacén;
  /// la suma directa y el advisory lock casan el NULL con `IS NOT DISTINCT FROM`. Restrict (una
  /// orden con PT en el kardex no se borra físico).
  idOrden Int?   @map("id_orden")
  orden   Orden? @relation(fields: [idOrden], references: [id], onDelete: Restrict)

  /// NÚMERO DE ORDEN DEL SISTEMA VIEJO (§Post-F9.25 — Daniel: *"será bueno incluir un campo de orden
  /// de producción para poder saber qué orden anterior es la que se fabricó, para poder consultar
  /// información en Control viejo"*).
  ///
  /// POR QUÉ TEXTO Y NO LA LLAVE `idOrden`: la migración lleva solo 2025-2026 (§Post-F9.24) y el
  /// almacén de PT arranca de un CONTEO FÍSICO desde cero, pero las prendas contadas las fabricaron
  /// órdenes VIEJAS que no existen en v2. Una FK no puede apuntar a una orden que no se migró; este
  /// campo guarda el número tal como lo imprime Control viejo, para poder ir a consultarlo allá.
  ///
  /// Es INFORMATIVO: **no** entra en la llave de existencia (modelo×color×talla×orden×almacén). Dos
  /// conteos del mismo artículo con distinta orden vieja son el MISMO inventario — lo que cambia es
  /// de dónde vino, no qué hay en el anaquel. Fragmentar el stock por una nota de consulta habría
  /// partido en pedazos el inventario de arranque.
  numOrdenV1 String? @map("num_orden_v1")

  /// Cantidad de prendas (positiva; el signo lo da la dirección del tipo de movimiento).
  cantidad  Int
  /// Costo unitario al momento del movimiento. NULLABLE y NULL en toda F3 (D1/D2 — ADR-0010 §4).
  costoUnit Decimal? @map("costo_unit") @db.Decimal(12, 4)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idMovimiento])
  @@index([idModelo, idColor, idTalla])
  @@index([idOrden])
  @@index([idOrden, idModelo, idColor, idTalla])
  @@index([numOrdenV1])
  @@map("movimiento_det_pt")
}

/// Detalle de kardex para TELA (dimensión tela×lote, D5). NACE VACÍA en F3-E1 para fijar el
/// motor genérico (ADR-0010 §2); las filas las ejercita F4 (inventario de telas). `idLote` es
/// ESCALAR NULLABLE SIN FK en F3: el modelo `Lote` nace en F4 y entonces se agrega la FK
/// `id_lote → Lote` con un ALTER aditivo y seguro (no migra filas ni toca el núcleo de
/// kardex.ts). `cantidad` Decimal (telas se miden en kg/m). `costoUnit` NULL en F3 (D1/D2).
/// Cascade hacia `Movimiento`; Restrict hacia `Tela`. La empresa y el almacén SE DERIVAN del
/// encabezado `Movimiento` (A9 — el detalle no se consulta fuera de él).
model MovimientoDetTela {
  id           Int        @id @default(autoincrement())
  idMovimiento Int        @map("id_movimiento")
  movimiento   Movimiento @relation(fields: [idMovimiento], references: [id], onDelete: Cascade)
  idTela       Int        @map("id_tela")
  tela         Tela       @relation(fields: [idTela], references: [id], onDelete: Restrict)
  /// Lote de la tela (D5). En F4-E1 se agrega la FK `→ Lote` (ALTER aditivo): el lote es la
  /// dimensión de trazabilidad de la existencia (tela×lote×almacén). NULLABLE: un ajuste
  /// inicial sin lote conocido puede no traerlo (el dominio decide). Restrict.
  idLote       Int?       @map("id_lote")
  lote         Lote?      @relation(fields: [idLote], references: [id], onDelete: Restrict)

  // ── INVENTARIO NUEVO por COLOR (etapa A2 — Daniel §Post-F9.9/§Post-F9.11). Columnas ADITIVAS:
  // las filas viejas (flujo por Lote) quedan con las 3 en NULL; las filas NUEVAS llevan SIEMPRE
  // `idTelaColor` (la dimensión de existencia pasa a tela×color×almacén, vista
  // `existencia_tela_color`). `idPartida` SOLO en entradas (el consumo empareja por color, no por
  // partida: en salidas va NULL). `cantidad` = CUERPO (puede ser 0 si la entrada es solo
  // complemento); `cantidadComplemento` NULL cuando la tela no lleva complemento. ──

  /// Color de tela (hijo de la tela) del renglón NUEVO. NULL = fila del flujo viejo por Lote. Restrict.
  idTelaColor Int?         @map("id_tela_color")
  telaColor   TelaColor?   @relation(fields: [idTelaColor], references: [id], onDelete: Restrict)
  /// Partida de la ENTRADA (traza; NULL en salidas — el consumo empareja por tela+color). Restrict.
  idPartida   Int?         @map("id_partida")
  partida     PartidaTela? @relation(fields: [idPartida], references: [id], onDelete: Restrict)

  /// Cantidad de tela (positiva; el signo lo da la dirección del tipo de movimiento). Decimal.
  /// En el flujo NUEVO por color es el CUERPO y admite 0 (entrada de solo complemento).
  cantidad             Decimal  @db.Decimal(14, 4)
  /// Cantidad del COMPLEMENTO (cardigan) que viaja JUNTA en el mismo renglón (Daniel: el
  /// complemento es parte de la misma tela). NULL si la tela no lleva complemento o fila vieja.
  cantidadComplemento  Decimal? @map("cantidad_complemento") @db.Decimal(14, 4)
  /// Costo unitario del CUERPO. NULLABLE y NULL en F3 (D1/D2 — ADR-0010 §4).
  costoUnit            Decimal? @map("costo_unit") @db.Decimal(12, 4)
  /// Costo unitario del COMPLEMENTO (cardigan) — B1. El complemento tiene SU propio precio
  /// (Daniel: *"el cardigan es otro precio que la tela"*), así que el renglón valúa por separado
  /// cada componente: `costoUnit × cantidad` + `costoUnitComplemento × cantidadComplemento`. Lo
  /// pueblan las DOS puertas de entrada (documento por factura B1 y recepción de compra); NULL
  /// cuando la tela no lleva complemento, cuando no se capturó precio, o en filas del flujo viejo.
  costoUnitComplemento Decimal? @map("costo_unit_complemento") @db.Decimal(12, 4)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idMovimiento])
  @@index([idTela, idLote])
  @@index([idTelaColor])
  @@index([idPartida])
  @@map("movimiento_det_tela")
}

/// Detalle de kardex para AVÍO (dimensión avío×lote opcional, R4). NACE VACÍA en F3-E1 para
/// fijar el motor genérico (ADR-0010 §2); las filas las ejercita F4 (inventario de avíos).
/// `esGenerico` se DERIVA del catálogo `Avio.esGenerico` (R4 — pocos avíos de stock); se copia
/// aquí para consultas de kardex sin join. `idLote` ESCALAR NULLABLE SIN FK en F3 (igual que
/// tela: la FK `→ Lote` la agrega F4). `cantidad` Decimal. `costoUnit` NULL en F3 (D1/D2).
/// Cascade hacia `Movimiento`; Restrict hacia `Avio`. La empresa y el almacén SE DERIVAN del
/// encabezado `Movimiento` (A9 — el detalle no se consulta fuera de él).
model MovimientoDetAvio {
  id           Int        @id @default(autoincrement())
  idMovimiento Int        @map("id_movimiento")
  movimiento   Movimiento @relation(fields: [idMovimiento], references: [id], onDelete: Cascade)
  idAvio       Int        @map("id_avio")
  avio         Avio       @relation(fields: [idAvio], references: [id], onDelete: Restrict)
  /// Lote del avío (opcional, R4 — pocos avíos se manejan por lote). En F4-E1 se agrega la FK
  /// `→ Lote` (ALTER aditivo). NULLABLE: el inventario de avíos suele ser por avío×almacén sin
  /// lote (la vista `ExistenciaAvio` agrega por avío×almacén). Restrict.
  idLote       Int?       @map("id_lote")
  lote         Lote?      @relation(fields: [idLote], references: [id], onDelete: Restrict)
  /// Avío genérico de stock (R4 — copiado de `Avio.esGenerico` para consultas sin join).
  esGenerico   Boolean    @default(false) @map("es_generico")

  /// Cantidad de avío (positiva; el signo lo da la dirección del tipo de movimiento). Decimal.
  cantidad  Decimal  @db.Decimal(14, 4)
  /// Costo unitario. NULLABLE y NULL en F3 (D1/D2 — ADR-0010 §4).
  costoUnit Decimal? @map("costo_unit") @db.Decimal(12, 4)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idMovimiento])
  @@index([idAvio, idLote])
  @@map("movimiento_det_avio")
}

/// Cargo a la cuenta corriente de un maquilero (EsMa) — F3-E1 SOLO el esquema; el flujo
/// (propuesto→validado) llega en F3-E4 (doc 07-EsMa). Nace al registrar un recibo de maquila
/// para TODO proceso (costura Y estampado — `EsMa_Recibos.EsEstampado` lo confirma), con
/// cantidad×precio del envío. `idEtapaRecibo` NULLABLE: la captura nueva la liga al recibo,
/// pero el ETL (F3-E6) migra 7,401 cargos históricos SIN FK formal al recibo (la liga nace en
/// v2). `estado` propuesto/validado/cancelado (el admin valida ajustando cantidad/precio real,
/// punto de control humano CONSERVADO). `cantidadReal`/`precioReal` los fija la validación
/// (nullables hasta entonces). Auditoría A7 + idEmpresa A9. EsMa es la semilla de la cuenta
/// corriente de terceros que F8 generaliza (R10/D12).
model EsMaCargo {
  id        Int     @id @default(autoincrement())
  /// Empresa dueña del cargo (A9). Restrict.
  idEmpresa Int     @map("id_empresa")
  empresa   Empresa @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)

  /// Recibo de maquila que originó el cargo (F3-E4). NULLABLE para el histórico migrado
  /// (F3-E6: cargos viejos sin liga formal). Restrict.
  idEtapaRecibo Int?             @map("id_etapa_recibo")
  etapaRecibo   EtapaMovimiento? @relation(fields: [idEtapaRecibo], references: [id], onDelete: Restrict)

  /// Maquilero al que se le carga (Proveedor con rol de maquila — fusión D12/R15). Restrict.
  idMaquilero Int       @map("id_maquilero")
  maquilero   Proveedor @relation(fields: [idMaquilero], references: [id], onDelete: Restrict)

  /// Orden a la que pertenece el cargo (para el estado de cuenta por orden). Restrict.
  idOrden Int   @map("id_orden")
  orden   Orden @relation(fields: [idOrden], references: [id], onDelete: Restrict)

  /// Proceso de maquila del cargo (costura/estampado…). Restrict.
  idTipoProceso Int         @map("id_tipo_proceso")
  tipoProceso   TipoProceso @relation(fields: [idTipoProceso], references: [id], onDelete: Restrict)

  /// Cantidad real validada por el admin (F3-E4). NULL mientras esté `propuesto`. Decimal.
  cantidadReal Decimal? @map("cantidad_real") @db.Decimal(14, 2)
  /// Precio real validado por el admin (F3-E4). NULL mientras esté `propuesto`. Decimal.
  precioReal   Decimal? @map("precio_real") @db.Decimal(12, 2)

  /// Prendas de este cargo YA PAGADAS (F6-E4, decisión (g) — "prendas por pagar"). Suma de las
  /// `PagoAplicacion.cantidad` que consumió este cargo; se actualiza bajo lock por maquilero al
  /// aplicar un pago. El "pagado" se DERIVA (cantidadPagada ≥ cantidadReal): no hay bandera editable.
  cantidadPagada Decimal  @default(0) @map("cantidad_pagada") @db.Decimal(14, 2)
  /// Segundas SIN COSTO (F6-E4, decisión (f)): prenda reclasificada a 2ª que NO se le paga al
  /// maquilero. Un cargo `sinCosto` se EXCLUYE del saldo y del pago (importe 0). Default false.
  sinCosto       Boolean  @default(false) @map("sin_costo")
  /// Modalidad de facturación de ESTE movimiento (F6-E4, decisión (h)): true con factura, false sin
  /// factura, null sin definir. Se fija al VALIDAR según la `modalidadFacturacion` del proveedor.
  conFactura     Boolean? @map("con_factura")

  /// Estado del cargo (propuesto/validado/cancelado). Ver enum `EstadoCargoEsMa`. NOTA (F6-E4): los
  /// 3 estados de conciliación "capturado/revisado/pagado" NO se persisten aparte — se PROYECTAN de
  /// `estado` (propuesto=capturado, validado=revisado) + `cantidadPagada` (pagado). No hay columna
  /// redundante `estadoConciliacion` (D3: un solo dato de verdad).
  estado        EstadoCargoEsMa @default(propuesto)
  observaciones String?         @db.Text

  /// Validación: quién y cuándo (sin FK física — ADR-0005).
  validadoEn    DateTime? @map("validado_en")
  validadoPorId String?   @map("validado_por_id")

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  /// Pagos aplicados a este cargo (F6-E4, puente N:N; decisión (g)). Restrict (no borrar un cargo
  /// con pagos aplicados).
  aplicacionesPago PagoAplicacion[]

  @@index([idEmpresa])
  @@index([idEtapaRecibo])
  @@index([idMaquilero])
  @@index([idOrden])
  @@index([idTipoProceso])
  @@index([estado])
  @@map("esma_cargo")
}

// ─────────────────────────────────────────────────────────────────────────────
// EsMa — MOVIMIENTOS de la cuenta corriente de maquileros (F6-E4, doc
// `Documentacion_MJD/07-EsMa-Estados-de-Cuenta-Maquileros.md`; DECISIONES.md §F6 (e)–(h)).
// Corazón contable: los 3 conceptos PLANOS que completan el ciclo junto al cargo (nacido en
// F3). "Planos" = sin encabezado EsMa; el maquilero + la fecha + las observaciones viven en
// CADA movimiento (mejora sobre el viejo, que llevaba un encabezado por maquilero). Todos con
// `idEmpresa` (A9, Restrict), `idMaquilero`→Proveedor (Restrict), `monto` Decimal(14,2), `fecha`,
// `conFactura` (decisión h), `estadoRevision` (asteriscos Rev del viejo → E5) y auditoría A7.
// El SALDO NUNCA se persiste: es la suma derivada (D3) `Σcargos + Σabonos − Σpagos − Σdescuentos`.
// ─────────────────────────────────────────────────────────────────────────────

/// Modalidad de facturación de un maquilero/movimiento EsMa (F6-E4, decisión (h), R15). `ambos`
/// obliga a elegir con/sin factura por movimiento (y su estado de cuenta se segmenta en dos, E5).
enum ModalidadFacturacion {
  solo_con
  solo_sin
  ambos

  @@map("modalidad_facturacion")
}

/// Estado de revisión de un movimiento EsMa (F6-E4; ex asteriscos `Rev` del `EsMa_EdoCta` viejo).
/// `capturado` recién metido; `revisado` confirmado por quien supervisa (la transición fina la
/// opera E5). Default `capturado`.
enum EstadoRevisionEsMa {
  capturado
  revisado

  @@map("estado_revision_esma")
}

/// ABONO a la cuenta de un maquilero (F6-E4; ex `EsMaAbonos`). Movimiento plano.
model AbonoMaquilero {
  id          Int       @id @default(autoincrement())
  /// Empresa dueña del movimiento (A9). Restrict.
  idEmpresa   Int       @map("id_empresa")
  empresa     Empresa   @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)
  /// Maquilero (Proveedor) al que se le abona. Restrict.
  idMaquilero Int       @map("id_maquilero")
  maquilero   Proveedor @relation(fields: [idMaquilero], references: [id], onDelete: Restrict)

  /// Importe del abono (positivo). Decimal.
  monto          Decimal            @db.Decimal(14, 2)
  /// Fecha del movimiento (date-only).
  fecha          DateTime           @db.Date
  /// Con/sin factura (decisión h). Null = sin definir. Se resuelve del proveedor al capturar.
  conFactura     Boolean?           @map("con_factura")
  observaciones  String?            @db.Text
  estadoRevision EstadoRevisionEsMa @default(capturado) @map("estado_revision")

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idEmpresa])
  @@index([idMaquilero])
  @@map("abono_maquilero")
}

/// DESCUENTO a la cuenta de un maquilero (F6-E4; ex `EsMaDescuentos`). Movimiento plano.
model DescuentoMaquilero {
  id          Int       @id @default(autoincrement())
  /// Empresa dueña del movimiento (A9). Restrict.
  idEmpresa   Int       @map("id_empresa")
  empresa     Empresa   @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)
  /// Maquilero (Proveedor) al que se le descuenta. Restrict.
  idMaquilero Int       @map("id_maquilero")
  maquilero   Proveedor @relation(fields: [idMaquilero], references: [id], onDelete: Restrict)

  /// Importe del descuento (positivo). Decimal.
  monto          Decimal            @db.Decimal(14, 2)
  /// Fecha del movimiento (date-only).
  fecha          DateTime           @db.Date
  conFactura     Boolean?           @map("con_factura")
  observaciones  String?            @db.Text
  estadoRevision EstadoRevisionEsMa @default(capturado) @map("estado_revision")

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idEmpresa])
  @@index([idMaquilero])
  @@map("descuento_maquilero")
}

/// PAGO a un maquilero (F6-E4; ex `EsMaPagos`). Movimiento plano LIGADO a cargos (decisión (g)):
/// el pago se aplica a uno o más cargos consumiendo sus "prendas por pagar". `monto` = Σ importes
/// aplicados (se sella al capturar). El recibo de pago (R9) se imprime de este registro.
model PagoMaquilero {
  id          Int       @id @default(autoincrement())
  /// Empresa dueña del movimiento (A9). Restrict.
  idEmpresa   Int       @map("id_empresa")
  empresa     Empresa   @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)
  /// Maquilero (Proveedor) al que se le paga. Restrict.
  idMaquilero Int       @map("id_maquilero")
  maquilero   Proveedor @relation(fields: [idMaquilero], references: [id], onDelete: Restrict)

  /// Importe total del pago (= Σ `aplicaciones.importe`). Decimal.
  monto          Decimal            @db.Decimal(14, 2)
  /// Fecha del pago (date-only).
  fecha          DateTime           @db.Date
  conFactura     Boolean?           @map("con_factura")
  observaciones  String?            @db.Text
  estadoRevision EstadoRevisionEsMa @default(capturado) @map("estado_revision")

  /// Aplicaciones del pago a cargos concretos (decisión (g)). Cascade (el detalle vive con el pago).
  aplicaciones PagoAplicacion[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idEmpresa])
  @@index([idMaquilero])
  @@map("pago_maquilero")
}

/// Aplicación de un PAGO a un CARGO (F6-E4, puente decisión (g)): cuántas prendas de ese cargo se
/// pagaron y por qué importe. El saldo "por pagar" de un cargo = `cantidadReal − Σ cantidad` de sus
/// aplicaciones; pagar de más se BLOQUEA en el dominio (anti-doble-pago duro). PK (idPago, idCargo).
model PagoAplicacion {
  idPago  Int           @map("id_pago")
  pago    PagoMaquilero @relation(fields: [idPago], references: [id], onDelete: Cascade)
  idCargo Int           @map("id_cargo")
  cargo   EsMaCargo     @relation(fields: [idCargo], references: [id], onDelete: Restrict)

  /// Prendas de este cargo cubiertas por el pago (>0, ≤ prendas por pagar del cargo). Decimal.
  cantidad Decimal @db.Decimal(14, 2)
  /// Importe aplicado (= cantidad × precioReal del cargo). Decimal.
  importe  Decimal @db.Decimal(14, 2)

  @@id([idPago, idCargo])
  @@index([idCargo])
  @@map("pago_aplicacion")
}

// ─────────────────────────────────────────────────────────────────────────────
// FINANZAS — Cuenta corriente ÚNICA de terceros (Módulo 14, F9-E1; D12/D15/R10; doc
// `Documentacion_MJD/PROPUESTA-Finanzas-y-Proveedores.md` §3). Generaliza el motor EsMa (F6):
// UN SOLO libro de movimientos por tercero del que cuelgan CxC (clientes), CxP (proveedores) y
// —por lectura/convivencia, sin migrar datos— el propio EsMa. El SALDO NUNCA se persiste
// editable: es la suma de los movimientos (D3), igual que el kardex y que EsMa.
// Modelo del tercero (D15a, ADR-0017): el movimiento REFERENCIA a Cliente o Proveedor existentes
// por tipo+id (dos FKs reales nullable + CHECK de exclusividad en la migración), SIN tabla
// `Tercero` polimórfica nueva — el Proveedor ya unifica maquilero/estampador vía roles (R15), así
// que un proveedor que maquila tiene UNA sola cuenta.
// ─────────────────────────────────────────────────────────────────────────────

/// Tipo de tercero al que apunta un `MovimientoTercero` (D15a). Discrimina cuál de las dos FKs
/// nullable (`idCliente`/`idProveedor`) está poblada; la exclusividad se blinda con un CHECK.
enum TipoTercero {
  cliente
  proveedor

  @@map("tipo_tercero")
}

/// ORIGEN de un movimiento de cuenta de terceros (eje 1, propuesta §3.3). Determina de dónde NACE
/// el movimiento y —vía el dominio `signoDeOrigen`— su DIRECCIÓN contable: los CARGOS
/// (`recibo_maquila`, `factura_proveedor`, `entrada_sin_factura`) AUMENTAN el saldo del tercero
/// (monto +); los ABONOS (`nota_credito`, `pago`, `abono`, `descuento`) lo DISMINUYEN (monto −).
/// Las notas de crédito son un movimiento más que baja el saldo (propuesta §3.5). EXTENSIBLE: E4
/// (CxC) agregará los orígenes de venta/cobro; el signo lo fija el dominio, no un CHECK.
enum OrigenMovimientoTercero {
  recibo_maquila
  factura_proveedor
  entrada_sin_factura
  /// CARGO de CxC por VENTA (F9-E4): nace del CFDI de venta timbrado o de un cargo manual al cliente.
  /// Aumenta lo que el cliente nos debe (monto +, ver `signoDeOrigen`). Se agregó con una migración
  /// ADITIVA de enum aparte (ALTER TYPE ... ADD VALUE; en Postgres no convive con otro DDL en la misma tx).
  factura_cliente
  nota_credito
  pago
  abono
  descuento

  @@map("origen_movimiento_tercero")
}

/// Movimiento de la cuenta corriente de un tercero (F9-E1, D12/D15/R10). Es el ladrillo del que
/// se derivan CxC/CxP: `saldo(tercero) = Σ monto` (nunca una columna editable — D3). Dos ejes por
/// movimiento: `origen` (de dónde nace + su dirección) y `esFiscal` (si entra al reporte del
/// contador). Dos vistas = dos FILTROS del mismo libro (operativa = todo; fiscal = `esFiscal`),
/// NO dos libros. Multi-empresa (A9), folio por secuencia atómica (A3) y auditoría A7. La
/// cancelación es por movimiento INVERSO auditado (D3/A7), NUNCA edición/borrado.
model MovimientoTercero {
  id        Int     @id @default(autoincrement())
  /// Empresa dueña del movimiento y de su folio (A9, multi-empresa: CxC/CxP por empresa). Restrict.
  idEmpresa Int     @map("id_empresa")
  empresa   Empresa @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)
  /// Folio consecutivo POR EMPRESA (A3 — secuencia "movimiento-tercero"). Unique (idEmpresa, folio).
  folio     BigInt

  /// Tipo de tercero (D15a): discrimina cuál FK está poblada. Ver el CHECK de exclusividad.
  tipoTercero TipoTercero @map("tipo_tercero")
  /// Cliente al que pertenece el movimiento (CxC), o NULL si es de proveedor. Restrict.
  idCliente   Int?        @map("id_cliente")
  cliente     Cliente?    @relation(fields: [idCliente], references: [id], onDelete: Restrict)
  /// Proveedor al que pertenece el movimiento (CxP/EsMa), o NULL si es de cliente. Restrict.
  idProveedor Int?        @map("id_proveedor")
  proveedor   Proveedor?  @relation(fields: [idProveedor], references: [id], onDelete: Restrict)

  /// Fecha del movimiento (date-only).
  fecha  DateTime                @db.Date
  /// Origen del movimiento (eje 1): determina su dirección contable (ver enum). El dominio valida
  /// que el signo del `monto` sea coherente con el origen (`signoDeOrigen`, único lugar de verdad).
  origen OrigenMovimientoTercero
  /// Importe CON SIGNO (D3): cargo + / abono − (convención en el dominio `signoDeOrigen`). El SALDO
  /// del tercero = Σ monto. Decimal(14,2). CHECK `monto <> 0` (un movimiento en cero no tiene sentido).
  monto  Decimal                 @db.Decimal(14, 2)

  /// Fecha de VENCIMIENTO derivada (aging D15d): fecha + días de crédito del tercero. Persistida
  /// para que el aging (E5) la lea directo; NULL para movimientos que no vencen (pagos/abonos) o
  /// terceros de contado. Se recalcula si cambia la fecha; nunca se edita suelta.
  fechaVencimiento DateTime? @map("fecha_vencimiento") @db.Date

  // ── Eje 2: naturaleza FISCAL (propuesta §3.2/§3.3) — lo fino (parser CFDI) llega en E3 ──
  /// ¿Es un movimiento FISCAL (con CFDI)? Filtra la vista fiscal (para el contador) de la operativa.
  esFiscal      Boolean  @default(false) @map("es_fiscal")
  /// UUID (folio fiscal) del CFDI, si es fiscal. Único global cuando existe (evita CFDI duplicados,
  /// base de la conciliación de E3/E4). NULL en movimientos no fiscales.
  uuidCfdi      String?  @map("uuid_cfdi")
  /// RFC del emisor (proveedor) o receptor (cliente) del CFDI. NULL si no es fiscal.
  rfcTercero    String?  @map("rfc_tercero")
  /// Archivo R2 del XML/PDF del CFDI (motor de F0). NULL hasta que E3/E4 adjunten el comprobante.
  idArchivoCfdi String?  @map("id_archivo_cfdi")
  archivoCfdi   Archivo? @relation(fields: [idArchivoCfdi], references: [id], onDelete: Restrict)

  /// Referencia POLIMÓRFICA a la operación real que originó el movimiento (recibo de maquila, OC,
  /// recepción, pedido…): `refTipo` discrimina y `refId` es el id de esa fila. SIN FK física (el
  /// origen es de varias tablas; el dominio garantiza la consistencia — mismo criterio que la
  /// Bitácora y el kardex, ADR-0005/ADR-0010). NULL en movimientos capturados a mano. E2–E4 la pueblan.
  refTipo String? @map("ref_tipo")
  refId   Int?    @map("ref_id")

  observaciones String? @db.Text

  /// Cancelación SUAVE = movimiento INVERSO auditado, NUNCA edición/borrado (D3/A7, patrón kardex).
  /// `cancelado` marca el original ya anulado; `idMovimientoInverso` apunta (en el inverso) al
  /// original; `anuladoPor` es la relación inversa. Autorreferencia Restrict.
  cancelado           Boolean             @default(false)
  idMovimientoInverso Int?                @map("id_movimiento_inverso")
  movimientoOriginal  MovimientoTercero?  @relation("MovimientoTerceroInverso", fields: [idMovimientoInverso], references: [id], onDelete: Restrict)
  anuladoPor          MovimientoTercero[] @relation("MovimientoTerceroInverso")

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idEmpresa, folio])
  @@unique([uuidCfdi])
  /// UN SOLO inverso por original (defensa en profundidad D3): en PostgreSQL los NULL son DISTINTOS,
  /// así que este unique deja pasar las N filas normales (idMovimientoInverso NULL) pero impide dos
  /// inversos apuntando al mismo original — dos cancelaciones concurrentes no pueden duplicar el inverso.
  @@unique([idMovimientoInverso])
  @@index([idEmpresa])
  @@index([tipoTercero])
  @@index([idCliente])
  @@index([idProveedor])
  @@index([origen])
  @@index([esFiscal])
  @@index([idArchivoCfdi])
  @@index([idEmpresa, tipoTercero, idProveedor])
  @@index([idEmpresa, tipoTercero, idCliente])
  @@map("movimientos_tercero")
}

// ─────────────────────────────────────────────────────────────────────────────
// Órdenes de COMPRA (Módulo 3, F4-E2 — doc `Documentacion_MJD/03-Produccion.md` §OC).
// El documento con el que se COMPRA material (telas/avíos) a un proveedor. Folio
// consecutivo POR EMPRESA (A3/A9). Documento por empresa (A9), catálogos globales.
// E2 captura/autoriza/cancela/duplica la OC; E3 conectará la RECEPCIÓN al kardex de
// telas/avíos (aquí NO se mueve inventario todavía, D3). Decisiones cerradas con el
// dueño (DECISIONES.md §"Decisiones de diseño F4"):
//  • (a) Una OC AUTORIZADA queda bloqueada para el usuario normal (el admin sí la edita,
//    cada cambio a Bitácora). "Duplicar a nueva OC" (todos) copia a un `borrador` nuevo.
//  • (c) Se ELIMINA el Excel: el renglón que lo requiera lleva matriz talla×color NATIVA
//    (análoga a OrdenLineaTalla de F2); la suma de la matriz = cantidad del renglón.
//    Renglones que no la necesiten = cantidad simple.
// Totales NO se persisten: se derivan por suma (Σ cantidad×precio) al proyectar (D3).
// onDelete: Restrict hacia empresa/proveedor/tela/avío/orden y los catálogos en uso
// (Color/Talla en la matriz). Cascade del detalle (líneas, matriz, ligas N:N) hacia su
// OC padre (permite reescribir el set completo en la transacción A2, igual que F2).
// ─────────────────────────────────────────────────────────────────────────────

/// Dirección de entrega (catálogo global, §Post-F9.18 — petición de Daniel: *"la dirección de
/// entrega debe de ser un catálogo de los que se llenan automáticamente, para que la dirección,
/// que en el 95% es la misma, tenga la dirección correcta y escrita siempre de la misma manera"*).
/// Antes era texto libre en la OC (`entregaEn`) y salía escrito distinto en cada orden.
/// SIN permiso propio: se gobierna con `compras.ver`/`compras.administrar` (mismo criterio que
/// `TelaCategoria` con `telas.administrar`, ADR-0009) → no requiere `SEED_ON_START`.
/// Borrado suave + auditoría A7. Global, no por empresa (ADR-0007/A9: los catálogos son globales).
model DireccionEntrega {
  id        Int     @id @default(autoincrement())
  /// Nombre corto con el que se elige ("Naucalpan", "Bodega Cortador Montaño"). Único global.
  nombre    String  @unique
  /// La dirección COMPLETA, tal como debe salir impresa en la OC.
  direccion String  @db.Text
  /// A quién buscar en esa dirección (opcional).
  contacto  String?
  telefono  String?
  /// La de todos los días: se preselecciona al capturar una OC nueva. La UI cuida que solo
  /// una la tenga (el dominio la apaga en las demás al prenderla aquí).
  favorita  Boolean @default(false)
  /// Borrado suave (plan §4).
  activo    Boolean @default(true)

  /// Órdenes de compra que entregan aquí. Restrict: una dirección en uso no se borra.
  ordenesCompra OrdenCompra[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("direcciones_entrega")
}

/// Estatus de la orden de compra (F4-E2). `borrador` recién capturada (editable);
/// `pendiente_autorizacion` lista para revisión; `autorizada` aprobada y bloqueada para
/// el usuario normal (decisión (a)); `recibida_parcial`/`recibida_total` los pondrá la
/// RECEPCIÓN de E3 (aquí solo se declaran); `cancelada` = cancelación suave con motivo.
enum EstatusOrdenCompra {
  borrador
  pendiente_autorizacion
  autorizada
  recibida_parcial
  recibida_total
  cancelada

  @@map("estatus_orden_compra")
}

/// Orden de compra (F4-E2 — ex `OrdCompra`, doc 03-Produccion §OC). Encabezado del
/// documento de compra de material a un proveedor. Folio `numCompra` consecutivo POR
/// EMPRESA (A3/A9, secuencia "orden-compra"). El TOTAL no se almacena: se deriva de las
/// líneas (Σ cantidad×precio). El ETL de E6 llenará `facturasAmparadasLegacy` (solo
/// lectura; en v2 lo supera la factura por recepción).
model OrdenCompra {
  id        Int     @id @default(autoincrement())
  /// Folio consecutivo POR EMPRESA (A3/A9 — viejo: `OrdCompra.NumCompra`).
  numCompra BigInt  @map("num_compra")
  /// Empresa dueña de la OC y de su numeración (A9). Restrict.
  idEmpresa Int     @map("id_empresa")
  empresa   Empresa @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)

  /// Proveedor al que se le compra. Restrict.
  idProveedor Int       @map("id_proveedor")
  proveedor   Proveedor @relation(fields: [idProveedor], references: [id], onDelete: Restrict)

  /// Fecha de EMISIÓN. En las OC nuevas la pone el SERVIDOR (= el día en que se captura, sin
  /// opción a cambiarla — §Post-F9.18); nullable por el histórico migrado.
  fecha              DateTime?         @db.Date
  /// Fecha de entrega esperada del material. OBLIGATORIA en las OC nuevas (§Post-F9.18);
  /// nullable por el histórico migrado, que muchas veces no la traía.
  fechaEntrega       DateTime?         @map("fecha_entrega") @db.Date
  /// Dirección de entrega DEL CATÁLOGO (§Post-F9.18: el 95% de las OC entregan en el mismo lugar,
  /// y tecleado a mano salía escrito distinto cada vez). Restrict: una dirección en uso no se borra.
  idDireccionEntrega Int?              @map("id_direccion_entrega")
  direccionEntrega   DireccionEntrega? @relation(fields: [idDireccionEntrega], references: [id], onDelete: Restrict)
  /// Dónde se entrega el material (texto libre). LEGADO: es lo único que traen las OC migradas y
  /// las capturadas antes del catálogo. En las nuevas se copia el texto de la dirección elegida
  /// (para que impresos y consultas viejas sigan leyendo un solo campo, sin join).
  entregaEn          String?           @map("entrega_en")

  /// Estatus del documento (ver enum). DERIVADO/controlado por los servicios; default borrador.
  estatus EstatusOrdenCompra @default(borrador)

  /// Autorización (decisión (a)): quién y cuándo autorizó. NULL mientras no se autorice.
  /// SIN FK física al usuario (mismo criterio que EsMaCargo.validadoPorId — ADR-0005).
  idUsuAutorizado String?   @map("id_usu_autorizado")
  fechaAutorizado DateTime? @map("fecha_autorizado")

  /// Cancelación suave: cuándo, quién y por qué. NULL si no está cancelada. Motivo obligatorio
  /// al cancelar (lo exige el dominio). SIN FK física al usuario (ADR-0005).
  canceladaEn       DateTime? @map("cancelada_en")
  canceladaPorId    String?   @map("cancelada_por_id")
  motivoCancelacion String?   @map("motivo_cancelacion") @db.Text

  observaciones           String? @db.Text
  /// A qué corresponde la compra (texto libre; viejo: `OrdCompra.CorrespondeA`).
  correspondeA            String? @map("corresponde_a")
  /// Facturas que amparaba la OC en v1 (viejo: texto). SOLO LECTURA, lo llena el ETL de E6;
  /// en v2 lo supera la factura por recepción (E3+). No se captura por UI.
  facturasAmparadasLegacy String? @map("facturas_amparadas_legacy") @db.Text

  lineas         OrdenCompraLinea[]
  /// Ligas N:N (a nivel encabezado) a las órdenes de producción de la OC (F4-E2). Cascade.
  ordenesLigadas OrdenCompraOrden[]
  /// Recepciones de material contra esta OC (F4-E3, R7). Restrict: una OC con recepciones
  /// no se borra; la cancelación de la OC se bloquea si hay recepciones activas (decisión b).
  recepciones    RecepcionCompra[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idEmpresa, numCompra])
  @@index([idProveedor])
  @@index([estatus])
  @@index([fecha])
  @@index([idDireccionEntrega])
  @@map("ordenes_compra")
}

/// Renglón de una orden de compra (F4-E2 — ex `OrdCompraDet`). Un material a comprar:
/// de catálogo (`idTela` XOR `idAvio`) o LIBRE (`descripcionLibre`, fallback para
/// servicios/no-catalogados — esas líneas NO cruzan en R7). EXACTAMENTE una de las tres
/// (lo valida el dominio).
///
/// ⭐⭐ REGLA — **EL RENGLÓN VA SIEMPRE EN UNIDAD DE CONSUMO** (metro, pieza, kilo): la misma
/// unidad en la que el BOM consume el material y en la que Desarrollo lo costea. `cantidad` y
/// `precio` se escriben y se leen TAL CUAL, sin traducir nada, en toda la cadena — MRP → OC →
/// recepción → kardex → costo real (§Post-F9.97, decisión de Daniel del 23-ago-2026).
///
/// **Por qué es una regla y no una nota.** Hasta V1-E8a el renglón se documentaba en la
/// PRESENTACIÓN de compra (rollo, caja) y un «factor de conversión» lo traducía a consumo:
/// × la cantidad, ÷ el precio. Esa traducción vivía EN MEDIO DE LA CADENA DEL DINERO, que es
/// justo donde se cuelan los errores que nadie ve — multiplica la cantidad y divide el precio,
/// así que el IMPORTE total sale idéntico y la invariante de valuación se cumple SOBRE NÚMEROS
/// EQUIVOCADOS. Y estaba equivocada: el MRP ya escribía en unidad de consumo mientras la
/// recepción leía presentación. El costo nace en Desarrollo, y ahí se costea POR METRO, no por
/// rollo: sin dos unidades no hay traducción que equivocarse.
///
/// 🔴 **No reintroducir la dualidad.** Si hace falta decir la presentación (cuántos rollos son),
/// va como TEXTO INFORMATIVO en `OrdenCompra.observaciones` o en `descripcionLibre` — nunca como
/// una segunda unidad que el sistema deba convertir. `Avio.factorConversion` y
/// `AvioProveedor.factorConversion` quedaron MUERTOS, sin escritor ni lector.
///
/// El `precio` es el unitario de la línea (D1: precio actual);
/// `idAvioProveedor` se conserva para trazar el origen del precio R1 (es el idAvio del
/// `AvioProveedor` cuyo proveedor = el de la OC). La liga `idOrden` (orden de PRODUCCIÓN)
/// es POR LÍNEA para que R7 cruce gasto↔producción sin prorrateos. Cascade hacia la OC;
/// Restrict hacia tela/avío/orden.
model OrdenCompraLinea {
  id            Int         @id @default(autoincrement())
  idOrdenCompra Int         @map("id_orden_compra")
  ordenCompra   OrdenCompra @relation(fields: [idOrdenCompra], references: [id], onDelete: Cascade)

  /// Tela pedida (catálogo). XOR con `idAvio`/`descripcionLibre`. Restrict.
  idTela          Int?  @map("id_tela")
  tela            Tela? @relation(fields: [idTela], references: [id], onDelete: Restrict)
  /// Avío pedido (catálogo). XOR con `idTela`/`descripcionLibre`. Restrict.
  idAvio          Int?  @map("id_avio")
  avio            Avio? @relation(fields: [idAvio], references: [id], onDelete: Restrict)
  /// Avío del `AvioProveedor` que da el precio R1 (traza el origen del precio). Solo se
  /// guarda cuando la línea es de avío; el proveedor es el de la OC. SIN FK (el par vive
  /// en `AvioProveedor` con PK compuesta; aquí basta el idAvio para reconstruir el par).
  idAvioProveedor Int?  @map("id_avio_proveedor")

  /// ⭐⭐ V1-E3u (§Post-F9.89) — EL COLOR QUE SE PIDE. *"Debo de tener la posibilidad de ir
  /// comprando esa tela en diferentes colores (y pantones)"* (Daniel). Sólo en líneas de TELA;
  /// NULL en avíos —su color es OTRO, el de la PRENDA (`idColorPrenda`, ⭐⭐ V1-E8c §Post-F9.126)—,
  /// en líneas libres y en TODO lo que ya existía antes de esta etapa (la tela se pedía sin color).
  /// Cuando viene, el color tiene que ser de `idTela` (lo valida el dominio) y
  /// la recepción CRUZA contra él: lo que llega de otro color se rechaza con su nombre en vez de
  /// entrar callado. Restrict.
  idTelaColor Int?       @map("id_tela_color")
  telaColor   TelaColor? @relation(fields: [idTelaColor], references: [id], onDelete: Restrict)

  /// ⭐⭐ **V1-E8c (§Post-F9.126) — EL COLOR QUE PARTE EL RENGLÓN DE AVÍO.** Daniel: *"cada color es
  /// diferente y cada color tiene cantidades por medida… En la receta no viene definido el color.
  /// Eso viene hasta que nos hacen el pedido"*. El avío **no tiene catálogo de color propio**
  /// (§Post-F9.91), así que el color que lo identifica es el de la PRENDA que lo lleva — el de la
  /// matriz color×talla de la OP. Es la IDENTIDAD del renglón: por él netea la explosión (para no
  /// volver a comprar lo ya comprado) y por él se agrupan las OP en un mismo renglón.
  /// Sólo en líneas de AVÍO; NULL en telas (su color es `idTelaColor`), en líneas libres, en avíos
  /// de OP sin matriz y en TODO lo anterior a esta etapa. Restrict.
  idColorPrenda Int?   @map("id_color_prenda")
  colorPrenda   Color? @relation(fields: [idColorPrenda], references: [id], onDelete: Restrict)

  /// ⭐⭐ **V1-E8c (§Post-F9.126) — EL COLOR QUE LEE EL PROVEEDOR**, como TEXTO. Daniel: *"poner 4
  /// veces el cierre y en la descripción del avío ponerle el color"*. Nace precargado con el nombre
  /// de `colorPrenda` y es **editable**: a veces el avío va en contraste (cierre negro en prenda
  /// roja), y ahí el nombre del color de la prenda sería una instrucción equivocada.
  /// Es TEXTO y no un catálogo a propósito (§Post-F9.91, decisión de Daniel: *"los avíos no llevan
  /// catálogo de color: el color va en su descripción"*). NULL = no se dijo color.
  colorAvio String? @map("color_avio")

  /// Cantidad a comprar (en `unidad`). Decimal. Si la línea usa matriz, = Σ de la matriz.
  /// En una tela CON complemento, ésta es la cantidad del CUERPO.
  cantidad         Decimal  @db.Decimal(14, 2)
  /// ⭐ V1-E3u (§Post-F9.89(a)) — LO QUE EL SISTEMA PROPUSO, junto a lo que Compras tecleó.
  /// *"El sistema debería de validar que las cantidades no excedan un porcentaje… si encuentra
  /// algún desvío grande que le notifique a la persona que va a autorizar la OC"*. El aviso NO se
  /// guarda como texto: se guarda el DATO con el que se calcula, para que la bandeja de
  /// autorización pueda decir cuánto se desvió cada renglón sin depender de una frase congelada.
  /// NULL = la línea no nació de una propuesta (captura a mano), así que no hay desvío que medir.
  cantidadSugerida Decimal? @map("cantidad_sugerida") @db.Decimal(14, 2)
  /// Unidad de compra (texto: m, pza, kg…) — que es la UNIDAD DE CONSUMO, ver la REGLA del modelo.
  /// En líneas de TELA ya NO se captura: la fija la `unidadMedida` de la tela (§Post-F9.18 — una
  /// tela que se compra en kilos no puede pedirse en piezas). En avíos sigue siendo texto libre,
  /// pero es una ETIQUETA, no una segunda unidad: escribir "rollo" aquí NO hace que el sistema
  /// convierta nada (§Post-F9.97), así que la cantidad seguiría leyéndose como metros.
  unidad           String?
  /// Precio unitario de la línea (D1: precio actual). Decimal. En tela con complemento, del CUERPO.
  precio           Decimal  @db.Decimal(12, 2)

  // ── COMPLEMENTO de la tela (§Post-F9.18; Daniel: *"la tela se debe de comprar con su
  // complemento en caso de tenerlo (Cardigan)"*). El complemento es PARTE de la misma tela
  // (`Tela.nombreComplemento` es la bandera), así que viaja en el MISMO renglón con su propia
  // cantidad y precio — igual que `EntradaTelaLinea` ya lo hacía al recibir. NULL en avíos, en
  // líneas libres, en telas sin complemento y en todo el histórico migrado. ──

  /// Cantidad del COMPLEMENTO a comprar (misma unidad que el cuerpo). Obligatoria (>0) cuando la
  /// tela define `nombreComplemento`; NULL en cualquier otro caso (lo valida el dominio).
  cantidadComplemento Decimal? @map("cantidad_complemento") @db.Decimal(14, 2)
  /// Precio unitario del COMPLEMENTO. NULL = se cobra al mismo precio que el cuerpo.
  precioComplemento   Decimal? @map("precio_complemento") @db.Decimal(12, 2)

  /// Orden de PRODUCCIÓN a la que se liga este renglón (R7, liga por línea). NULLABLE
  /// (compras genéricas/stock no ligan). Restrict.
  idOrden Int?   @map("id_orden")
  orden   Orden? @relation(fields: [idOrden], references: [id], onDelete: Restrict)

  /// Descripción libre (SOLO si la línea NO es de catálogo: servicios/no-catalogados).
  /// Cuando viene, `idTela`/`idAvio` van NULL (XOR validado en dominio). No cruza en R7.
  descripcionLibre String? @map("descripcion_libre")

  /// Matriz talla×color OPCIONAL del renglón (decisión (c)). Cuando se usa, `cantidad` = Σ.
  tallas          OrdenCompraLineaTalla[]
  /// ⭐⭐ V1-E8c (§Post-F9.126) — DESGLOSE POR MEDIDA del renglón (cierres, jaretas, cintas
  /// palmita…). Σ de sus cantidades = `cantidad` del renglón (lo garantiza el dominio repartiendo
  /// con `repartirEntreOrdenes`). Vacío = el avío no se pide por medida. Cascade.
  medidas         OrdenCompraLineaMedida[]
  /// Renglones de recepción que recibieron (parcial o total) contra este renglón de OC
  /// (F4-E3, R7). Restrict hacia la línea de OC. La suma de lo recibido por esta línea define
  /// el estatus de la OC (parcial/total).
  recepcionLineas RecepcionCompraLinea[]

  creadoEn          DateTime           @default(now()) @map("creado_en")
  creadoPorId       String?            @map("creado_por_id")
  modificadoEn      DateTime           @updatedAt @map("modificado_en")
  modificadoPorId   String?            @map("modificado_por_id")
  entradaTelaLineas EntradaTelaLinea[]

  @@index([idOrdenCompra])
  @@index([idTela])
  @@index([idTelaColor])
  @@index([idAvio])
  @@index([idColorPrenda])
  @@index([idOrden])
  @@map("orden_compra_linea")
}

/// ⭐⭐ **V1-E8c (§Post-F9.126) — CUÁNTO DE CADA MEDIDA lleva un renglón de OC de avío.**
///
/// Daniel: *"Le había puesto que el cierre lo tengo que comprar por medidas. Y al hacer la OC no me
/// aparece cantidad por medida… sólo veo un solo renglón"*.
///
/// 🔴 **LA REGLA QUE DECIDE DÓNDE VIVE CADA COSA: lo que parte el RENGLÓN es lo que se recibe por
/// separado; lo que sólo hay que decirle al proveedor va en esta TABLITA.** La medida **no se
/// recibe**: llegan "3,200 cierres" y el proveedor los mandó cortados según este desglose. Por eso
/// el COLOR parte el renglón (se recibe contra la LÍNEA, que lleva el color) y la MEDIDA no.
/// ⚠️ El KARDEX de avíos NO lleva color: `MovimientoDetAvio` no tiene columna de color y la vista
/// `existencia_avio` agrupa sin él. Por eso el stock del genérico se netea UNA vez.
///
/// ⚠️ **LA MEDIDA NO MULTIPLICA NUNCA.** La cantidad de un renglón sale de cuántas PRENDAS llevan
/// esa medida (piezas de la talla × consumo por prenda), jamás del número de la medida — leer el
/// "50" de *50 cm* como consumo es de donde salieron los 133,095 cierres que Daniel cazó
/// (§Post-F9.105).
model OrdenCompraLineaMedida {
  id                 Int              @id @default(autoincrement())
  idOrdenCompraLinea Int              @map("id_orden_compra_linea")
  ordenCompraLinea   OrdenCompraLinea @relation(fields: [idOrdenCompraLinea], references: [id], onDelete: Cascade)

  /// Medida del catálogo del avío (`AvioMedida`), o NULL = **las tallas sin medida amarrada**
  /// (cubeta "Sin medida"). SetNull: borrar la medida del catálogo NO borra lo que ya se pidió, y
  /// la `etiqueta` congelada sigue diciendo qué se compró (D3).
  idAvioMedida Int?        @map("id_avio_medida")
  avioMedida   AvioMedida? @relation(fields: [idAvioMedida], references: [id], onDelete: SetNull)
  /// Etiqueta CONGELADA de la medida ("53 cm") tal como se pidió, o "Sin medida". Es la identidad
  /// del renglón dentro de la línea (@@unique): las etiquetas son únicas por avío.
  etiqueta     String
  /// Cantidad de esa medida, a la MISMA escala que `OrdenCompraLinea.cantidad` — para que la suma
  /// del desglose pueda cerrar EXACTAMENTE contra el renglón.
  cantidad     Decimal     @db.Decimal(14, 2)
  /// Orden de despliegue (lo fija el dominio: el del catálogo de medidas del avío).
  orden        Int         @default(0)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idOrdenCompraLinea, etiqueta])
  @@index([idOrdenCompraLinea])
  @@index([idAvioMedida])
  @@map("orden_compra_linea_medida")
}

/// Cantidad de una talla×color dentro de un renglón de OC (F4-E2, decisión (c) —
/// análoga a `OrdenLineaTalla` de F2 pero con color EN la misma fila, porque el renglón
/// de OC ya es de un material, no de un color). El par (color, talla) aparece UNA vez
/// por renglón (@@unique). `cantidad` entera ≥0. Cascade hacia el renglón; Restrict hacia
/// Color/Talla. La suma de la matriz = `cantidad` del renglón (lo valida el dominio).
model OrdenCompraLineaTalla {
  id                 Int              @id @default(autoincrement())
  idOrdenCompraLinea Int              @map("id_orden_compra_linea")
  ordenCompraLinea   OrdenCompraLinea @relation(fields: [idOrdenCompraLinea], references: [id], onDelete: Cascade)
  idColor            Int              @map("id_color")
  color              Color            @relation(fields: [idColor], references: [id], onDelete: Restrict)
  idTalla            Int              @map("id_talla")
  talla              Talla            @relation(fields: [idTalla], references: [id], onDelete: Restrict)

  /// Cantidad de esta talla×color. Entera ≥0.
  cantidad Int

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idOrdenCompraLinea, idColor, idTalla])
  @@index([idOrdenCompraLinea])
  @@index([idColor])
  @@index([idTalla])
  @@map("orden_compra_linea_talla")
}

/// Liga N:N (a nivel ENCABEZADO) entre una orden de compra y una orden de producción
/// (F4-E2 — ex `OrdCom-Ord`). Informativo/derivado: se deriva de los `idOrden` de las
/// líneas pero se persiste a nivel encabezado (la ficha lo pide). Una orden de producción
/// aparece UNA vez por OC (@@unique). Cascade hacia la OC; Restrict hacia la orden.
model OrdenCompraOrden {
  id            Int         @id @default(autoincrement())
  idOrdenCompra Int         @map("id_orden_compra")
  ordenCompra   OrdenCompra @relation(fields: [idOrdenCompra], references: [id], onDelete: Cascade)
  idOrden       Int         @map("id_orden")
  orden         Orden       @relation(fields: [idOrden], references: [id], onDelete: Restrict)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idOrdenCompra, idOrden])
  @@index([idOrdenCompra])
  @@index([idOrden])
  @@map("orden_compra_orden")
}

// ─────────────────────────────────────────────────────────────────────────────
// RECEPCIÓN de compras (Módulo 3, F4-E3 — doc `Documentacion_MJD/03-Produccion.md` §OC;
// R7 — REQUISITOS-NUEVOS.md). La recepción es el HECHO que conecta la OC con el kardex de
// materiales: recibe (parcial o total) el material de una OC AUTORIZADA, crea el lote de la
// tela (D5), registra la ENTRADA al kardex (`entrada-recepcion`) con cantidad y costo YA
// convertidos a unidad de consumo (R1: factor presentación→consumo, costo ÷ factor, D1), y
// recalcula el estatus de la OC (parcial/total, R7). Decisión (b) cerrada con Daniel: SOLO se
// recibe contra una OC `autorizada`/`recibida_parcial` (server-side, A4). Reverso SUAVE: nada
// se borra (D3) — la reversión genera el movimiento INVERSO de kardex y marca la recepción
// como reversada (A7). Folio por empresa (A3/A9, secuencia "recepcion-compra").
// ─────────────────────────────────────────────────────────────────────────────

/// Recepción de material contra una orden de compra (F4-E3, R7). Encabezado del documento de
/// entrada: factura del proveedor, fecha, almacén DESTINO y empresa (A9). Folio `folio`
/// consecutivo POR EMPRESA (A3/A9). SIEMPRE ligada a una OC (`idOrdenCompra` obligatorio: las
/// recepciones de v2 nacen de una OC, no hay entrada "suelta"). Reverso suave (`reversadaEn`):
/// la recepción reversada sigue consultable; sus movimientos de kardex se neutralizan con su
/// inverso (D3). Auditoría A7.
model RecepcionCompra {
  id        Int     @id @default(autoincrement())
  /// Folio consecutivo POR EMPRESA (A3/A9 — secuencia "recepcion-compra").
  folio     BigInt
  /// Empresa dueña de la recepción y de su numeración (A9). Restrict.
  idEmpresa Int     @map("id_empresa")
  empresa   Empresa @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)

  /// Orden de compra que se recibe (OBLIGATORIO — recepciones v2 siempre ligadas a OC). Restrict.
  idOrdenCompra Int         @map("id_orden_compra")
  ordenCompra   OrdenCompra @relation(fields: [idOrdenCompra], references: [id], onDelete: Restrict)

  /// Almacén DESTINO al que entra el material recibido (D4: existencia por …×almacén). Restrict.
  idAlmacen Int     @map("id_almacen")
  almacen   Almacen @relation(fields: [idAlmacen], references: [id], onDelete: Restrict)

  /// Documento de ENTRADA DE TELA que generó esta recepción (§Post-F9.14). NULL = recepción
  /// capturada directo contra la OC (las de avíos y todas las históricas). Con valor, la recepción
  /// es el "recibo" de esa factura contra la OC: es lo que permite verla desde la orden de compra y
  /// lo que el CANCELAR de la factura busca para reversarla. Restrict.
  idEntradaTela Int?         @map("id_entrada_tela")
  entradaTela   EntradaTela? @relation(fields: [idEntradaTela], references: [id], onDelete: Restrict)

  /// Factura del proveedor de esta recepción (texto; opcional). El lote de tela también la guarda.
  factura String?
  /// Fecha de la recepción (solo fecha).
  fecha   DateTime @db.Date

  observaciones String? @db.Text

  /// Reverso SUAVE (D3): cuándo, quién y por qué se reversó. NULL si está activa. Al reversar se
  /// genera el movimiento INVERSO de kardex (la recepción NO se borra). SIN FK física al usuario
  /// (mismo criterio que OrdenCompra.canceladaPorId — ADR-0005).
  reversadaEn    DateTime? @map("reversada_en")
  reversadaPorId String?   @map("reversada_por_id")
  motivoReverso  String?   @map("motivo_reverso") @db.Text

  /// Renglones recibidos (uno por renglón de OC recibido, parcial o total).
  lineas RecepcionCompraLinea[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idEmpresa, folio])
  @@index([idOrdenCompra])
  @@index([idAlmacen])
  @@index([idEntradaTela])
  @@index([reversadaEn])
  @@map("recepciones_compra")
}

/// Renglón de una recepción (F4-E3): cuánto se recibió contra un renglón de OC. `cantidadRecibida`
/// está en UNIDAD DE CONSUMO ya convertida (R1: cantidad × factor) — es la que cuenta para el
/// estatus de la OC y la que entró al kardex. `idLote` (telas) = el lote creado en esta recepción;
/// `idMovimiento` = el movimiento de kardex de ENTRADA que generó (traza). Las líneas LIBRES de la
/// OC (sin tela/avío) se registran con cantidad pero SIN lote ni movimiento (no inventarían).
/// Cascade hacia la recepción; Restrict hacia la línea de OC/lote; SetNull hacia el movimiento (que
/// nunca se borra — D3). `costoUnit` = costo por unidad de consumo (precio ÷ factor, D1).
model RecepcionCompraLinea {
  id                Int             @id @default(autoincrement())
  idRecepcionCompra Int             @map("id_recepcion_compra")
  recepcionCompra   RecepcionCompra @relation(fields: [idRecepcionCompra], references: [id], onDelete: Cascade)

  /// Renglón de la OC que se recibe (R7). Restrict.
  idOrdenCompraLinea Int              @map("id_orden_compra_linea")
  ordenCompraLinea   OrdenCompraLinea @relation(fields: [idOrdenCompraLinea], references: [id], onDelete: Restrict)

  /// Cantidad recibida en UNIDAD DE CONSUMO (ya convertida: cantidadPresentación × factor, R1).
  /// Para líneas de catálogo es lo que entró al kardex; para líneas libres es informativa.
  cantidadRecibida Decimal  @map("cantidad_recibida") @db.Decimal(14, 4)
  /// Costo por unidad de consumo (precioPresentación ÷ factor, D1). NULL en líneas libres.
  costoUnit        Decimal? @map("costo_unit") @db.Decimal(12, 4)

  /// Cantidad del COMPLEMENTO (cardigan) recibida en esta línea de TELA (flujo NUEVO por color,
  /// B1). NULL en avío/libre y en telas sin complemento. El CUERPO va en `cantidadRecibida`.
  cantidadComplemento Decimal? @map("cantidad_complemento") @db.Decimal(14, 4)

  /// LEGADO (F4-E3): lote creado para esta línea de TELA por el flujo viejo (D5). Desde B1 las
  /// recepciones de tela entran por COLOR y crean una PARTIDA (`idPartida`), no un lote: en las
  /// recepciones NUEVAS esta columna va NULL. Se conserva para las filas históricas. Restrict.
  idLote Int?  @map("id_lote")
  lote   Lote? @relation(fields: [idLote], references: [id], onDelete: Restrict)

  /// PARTIDA creada para esta línea de TELA (flujo NUEVO por color, B1 — la unidad de entrada del
  /// inventario de telas). NULL en avío/libre y en las recepciones históricas por lote. Restrict.
  idPartida Int?         @map("id_partida")
  partida   PartidaTela? @relation(fields: [idPartida], references: [id], onDelete: Restrict)

  /// Movimiento de kardex de ENTRADA que generó esta línea (tela/avío). NULL en líneas libres y
  /// tras un reverso conceptual (el movimiento sigue existiendo; aquí se conserva la traza).
  /// SetNull: los movimientos nunca se borran (D3), pero el FK es defensivo.
  idMovimiento Int?        @map("id_movimiento")
  movimiento   Movimiento? @relation(fields: [idMovimiento], references: [id], onDelete: SetNull)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idRecepcionCompra])
  @@index([idOrdenCompraLinea])
  @@index([idLote])
  @@index([idPartida])
  @@index([idMovimiento])
  @@map("recepcion_compra_linea")
}

// ─────────────────────────────────────────────────────────────────────────────
// OUTBOX de eventos de dominio (F4-E3 — ADR-0011: patrón outbox transaccional + pg-boss).
// La fila se inserta DENTRO de la transacción de negocio (atómica con la recepción): el evento
// NUNCA se pierde aunque el proceso muera tras el commit. Un relay (`comun/cola-eventos.ts`)
// publica las filas pendientes a pg-boss (sobre el MISMO Postgres) y marca `publicadoEn`; un
// barrido periódico reintenta las no publicadas (durabilidad). El consumidor de negocio es de
// F5 (RC/MRP) — aquí SOLO se publica.
// ─────────────────────────────────────────────────────────────────────────────

/// Evento de dominio pendiente de publicar (F4-E3, ADR-0011 — patrón OUTBOX). Se escribe en la
/// MISMA transacción que el hecho de negocio (atómico); el relay lo publica a la cola pg-boss y
/// marca `publicadoEn`. `tipo` = nombre del evento (p. ej. "material-recibido"); `version` =
/// versión del contrato del payload; `payload` = la carga JSON versionada. `intentos`/`error`
/// registran los reintentos del relay. GLOBAL por empresa (A9: `idEmpresa` para trazar/segmentar).
model EventoOutbox {
  id          Int       @id @default(autoincrement())
  /// Nombre del evento (contrato versionado, p. ej. "material-recibido"). Ver ADR-0011.
  tipo        String
  /// Versión del contrato del payload (para evolucionar el evento sin romper consumidores).
  version     Int       @default(1)
  /// Empresa dueña del hecho (A9). Restrict.
  idEmpresa   Int       @map("id_empresa")
  empresa     Empresa   @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)
  /// Carga del evento (JSON). Lo MÍNIMO para que el consumidor reaccione (ids + material).
  payload     Json
  /// Cuándo se publicó a la cola (NULL = pendiente). El relay lo sella tras encolar.
  publicadoEn DateTime? @map("publicado_en")
  /// Número de intentos de publicación (el barrido lo incrementa al reintentar).
  intentos    Int       @default(0)
  /// Último error de publicación (texto), si lo hubo. NULL si nunca falló.
  error       String?   @db.Text

  creadoEn DateTime @default(now()) @map("creado_en")

  @@index([publicadoEn])
  @@index([idEmpresa])
  @@map("eventos_outbox")
}

// ─────────────────────────────────────────────────────────────────────────────
// EXPLOSIÓN MRP / requerimiento de materiales por orden (F4-E4 — REQUISITOS-NUEVOS.md
// §R3/R7 + principio Make-to-Order; doc `Documentacion_MJD/01-Modelos.md §2`). La explosión
// cruza el BOM del modelo (telas+avíos `paraProduccion`) contra las cantidades color×talla de
// la orden para obtener QUÉ y CUÁNTO material hace falta comprar. El resultado se PERSISTE como
// un SNAPSHOT regenerable: congela lo requerido aunque el BOM cambie después (R3 — el cálculo
// que originó la compra queda trazable). Regenerar = borrar el snapshot anterior de la orden y
// reescribirlo en una transacción (D3: nada se edita en sitio). El cruce con OC/recepciones (R7)
// es on-demand (no se materializa aquí).
// ─────────────────────────────────────────────────────────────────────────────

/// Renglón del SNAPSHOT de explosión de una orden (F4-E4, R3). Un material (tela XOR avío) con la
/// cantidad requerida YA en unidad de consumo del BOM (consumoPorPrenda × Σ piezas color×talla de
/// la orden). `idProveedorSugerido` viene del `AvioProveedor` más barato para avíos (R1); para
/// telas es NULL (no hay liga directa tela→proveedor en v2 — el proveedor se decide al comprar el
/// lote, D5). `esGenerico`/`cubiertoPorStock`/`cantidadAComprar` registran el NETEO contra el
/// kardex de avíos genéricos (decisión (d) de Daniel): un genérico solo manda a compra el faltante.
/// El snapshot se REEMPLAZA al regenerar (se borra y reescribe en la misma tx, A2/D3). Auditoría A7.
model RequerimientoOrden {
  id      Int   @id @default(autoincrement())
  /// Orden de producción a la que pertenece este requerimiento (R3). Cascade: el snapshot es
  /// configuración derivada de la orden; al borrar la orden se va con ella.
  idOrden Int   @map("id_orden")
  orden   Orden @relation(fields: [idOrden], references: [id], onDelete: Cascade)

  /// Tela requerida (catálogo). XOR con `idAvio`. Restrict. NULL si el renglón es de avío.
  idTela Int?  @map("id_tela")
  tela   Tela? @relation(fields: [idTela], references: [id], onDelete: Restrict)
  /// Avío requerido (catálogo). XOR con `idTela`. Restrict. NULL si el renglón es de tela.
  idAvio Int?  @map("id_avio")
  avio   Avio? @relation(fields: [idAvio], references: [id], onDelete: Restrict)

  /// ⭐⭐ V1-E3u (§Post-F9.89) — EL COLOR DE LA TELA que pide este renglón. Con el color, la
  /// explosión deja de tener UNA fila por tela y pasa a tener **una por tela×color**: cada una con
  /// la cantidad que sale de la matriz color×talla de la OP. NULL en avíos —cuyo color es OTRO, el
  /// de la PRENDA (`idColorPrenda`, ⭐⭐ V1-E8c §Post-F9.126: el avío no tiene catálogo de color
  /// propio)— y en las telas cuyo color todavía nadie amarró (`OrdenTelaColor`), que se reportan
  /// aparte en vez de comprarse a ciegas. Restrict.
  idTelaColor Int?       @map("id_tela_color")
  telaColor   TelaColor? @relation(fields: [idTelaColor], references: [id], onDelete: Restrict)

  /// ⭐⭐ **V1-E8c (§Post-F9.126) — EL COLOR DE PRENDA QUE PARTE EL RENGLÓN DE AVÍO.** Lo mismo que
  /// `idTelaColor` hace en las telas desde V1-E3u, pero para avíos: la identidad de un renglón de
  /// avío pasa a ser *(avío, color de prenda)*, y su cantidad sale de las piezas DE ESE COLOR en la
  /// matriz color×talla de la OP. NULL en telas y en avíos de órdenes sin matriz capturada.
  /// El avío NO tiene catálogo de color (§Post-F9.91): el color es el de la prenda. Restrict.
  idColorPrenda Int?   @map("id_color_prenda")
  colorPrenda   Color? @relation(fields: [idColorPrenda], references: [id], onDelete: Restrict)

  /// ⭐⭐ V1-E8c (§Post-F9.126): el desglose POR MEDIDA de este renglón (Σ = `cantidadRequerida`).
  /// Vacío = el avío no se pide por medida (o es tela). Cascade con el snapshot.
  medidas RequerimientoOrdenMedida[]

  /// Cantidad requerida en UNIDAD DE CONSUMO del BOM (consumoPorPrenda × piezas de la orden, R3).
  cantidadRequerida Decimal @map("cantidad_requerida") @db.Decimal(14, 4)
  /// Unidad de consumo del material (m, kg, pza…), copiada del catálogo para mostrar sin join.
  unidad            String?

  /// ¿El avío es genérico (de stock, R4)? Copiado de `Avio.esGenerico`. FALSE para telas.
  esGenerico       Boolean @default(false) @map("es_generico")
  /// Existencia REAL del kardex de avíos (Σ de movimientos, D3) al momento del snapshot — solo se
  /// llena para genéricos (decisión (d)); 0 para el resto. Informativa (el neteo ya se aplicó).
  existenciaStock  Decimal @default(0) @map("existencia_stock") @db.Decimal(14, 4)
  /// Cantidad que realmente va a COMPRA = requerida − existencia (solo genéricos netean; el resto
  /// va completo). NUNCA negativa. Es la base de la generación de OC y del cruce R7.
  cantidadAComprar Decimal @map("cantidad_a_comprar") @db.Decimal(14, 4)

  /// Proveedor SUGERIDO para comprar este material (avíos: el `AvioProveedor` más barato, R1).
  /// NULL para telas (sin liga directa tela→proveedor) o si el avío no tiene proveedor mapeado.
  /// SIN FK de relación inversa nombrada al revés: Restrict para no perder la sugerencia.
  idProveedorSugerido Int?       @map("id_proveedor_sugerido")
  proveedorSugerido   Proveedor? @relation("RequerimientoProveedorSugerido", fields: [idProveedorSugerido], references: [id], onDelete: Restrict)

  /// Precio unitario sugerido (por unidad de consumo) del proveedor sugerido (R1: precio ÷ factor),
  /// para pre-llenar la OC. NULL si no hay proveedor/precio mapeado.
  precioSugerido Decimal? @map("precio_sugerido") @db.Decimal(12, 4)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idOrden])
  @@index([idTela])
  @@index([idAvio])
  @@index([idTelaColor])
  @@index([idColorPrenda])
  @@index([idProveedorSugerido])
  @@map("requerimiento_orden")
}

/// ⭐⭐ **V1-E8c (§Post-F9.126) — el desglose POR MEDIDA de un renglón de explosión.** Es la BASE
/// con la que se reparte la cantidad de cada línea de OC (`OrdenCompraLineaMedida`): se congela con
/// el snapshot para que la previa y la OC digan lo mismo aunque la receta cambie después.
///
/// ⚠️ La cantidad sale de **piezas de la talla × consumo por prenda de esa talla** (la MISMA regla
/// R18 de `produccion/receta-avios.ts`, no una copia), nunca del NÚMERO de la medida.
model RequerimientoOrdenMedida {
  id              Int                @id @default(autoincrement())
  idRequerimiento Int                @map("id_requerimiento")
  requerimiento   RequerimientoOrden @relation(fields: [idRequerimiento], references: [id], onDelete: Cascade)

  /// Medida del catálogo del avío, o NULL = cubeta "Sin medida" (tallas sin amarre). SetNull.
  idAvioMedida Int?        @map("id_avio_medida")
  avioMedida   AvioMedida? @relation(fields: [idAvioMedida], references: [id], onDelete: SetNull)
  /// Etiqueta congelada ("53 cm" / "Sin medida"). Identidad dentro del renglón (@@unique).
  etiqueta     String
  /// Requerido de esa medida, a la escala del snapshot (`cantidadRequerida`, 4 decimales).
  cantidad     Decimal     @db.Decimal(14, 4)
  /// Orden de despliegue (el del catálogo de medidas del avío; "Sin medida" va al final).
  orden        Int         @default(0)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idRequerimiento, etiqueta])
  @@index([idRequerimiento])
  @@index([idAvioMedida])
  @@map("requerimiento_orden_medida")
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTAS DE SALIDA estructuradas (Módulo 5, F4-E5 — doc `Documentacion_MJD/03-Produccion.md`
// §"Submódulo — Notas de Salida (Menú 3.4)"; 04-Inventarios.md §"Cómo conecta"; MEJORAS §03;
// R4/R9). Una nota de salida documenta el ENVÍO de materiales a un maquilero contra una orden de
// producción. Sustituye las notas de TEXTO LIBRE del viejo (`Notas`/`NotasDet`, 11,459 renglones)
// por renglones ESTRUCTURADOS contra catálogo, ligados a la orden. Dos tipos de renglón:
//  • AVÍO: al CONFIRMAR la nota descuenta el kardex de avíos con un movimiento `salida-por-nota`
//    (R4 — el consumo de avíos va ligado a las notas).
//  • TELA: la tela YA se descontó UNA sola vez con `registrarSalidaTelaAOrden` (E1, traza
//    `origenTipo=salida-tela-orden`, `origenId=idOrden`). La nota solo REFERENCIA ese movimiento
//    como documento de envío y NO genera segundo movimiento de kardex (DECISIÓN (e) de Daniel).
// Folio `NumNota` por secuencia atómica por empresa (A3/A9, clave "nota-salida"). Cancelación
// suave (D3): reversa SOLO los movimientos de avíos que la nota generó; la tela no se toca.
// ─────────────────────────────────────────────────────────────────────────────

/// Estatus de una nota de salida. Nace `borrador` (capturable/editable); al CONFIRMAR pasa a
/// `confirmada` y se descuentan los avíos del kardex (A2). `cancelada` = cancelación suave
/// (reverso auditado de los avíos, D3). Mismo patrón de enum que `EstatusOrdenCompra`.
enum EstatusNotaSalida {
  borrador
  confirmada
  cancelada

  @@map("estatus_nota_salida")
}

/// Nota de salida de materiales a un maquilero (F4-E5, R4/R9). Encabezado del documento de envío:
/// el maquilero (un Proveedor/tercero — fusión D12/R15), fechas de elaboración y envío, empresa
/// (A9) y folio `numNota` consecutivo POR EMPRESA (A3/A9, secuencia "nota-salida"). El consumo
/// real (descuento de avíos) sucede al CONFIRMAR (`estatus=confirmada`); la cancelación es SUAVE
/// (`canceladaEn` + reverso auditado de los avíos, D3 — nada se borra). Auditoría A7.
model NotaSalida {
  id        Int     @id @default(autoincrement())
  /// Folio consecutivo POR EMPRESA (A3/A9 — viejo: `Notas.NumNota`). Secuencia "nota-salida".
  numNota   BigInt  @map("num_nota")
  /// Empresa dueña de la nota y de su numeración (A9). Restrict.
  idEmpresa Int     @map("id_empresa")
  empresa   Empresa @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)

  /// Maquilero al que se le envían los materiales (un Proveedor/tercero — fusión D12/R15). Restrict.
  idMaquilero Int       @map("id_maquilero")
  maquilero   Proveedor @relation(fields: [idMaquilero], references: [id], onDelete: Restrict)

  /// Almacén ORIGEN del que salen los avíos al CONFIRMAR la nota (un almacén por nota, en el
  /// ENCABEZADO — decisión (g) de Daniel, espejo de la recepción de compra; la tela no descuenta,
  /// decisión (e)). El inventario de avíos es multi-almacén (R4). Restrict.
  idAlmacen Int     @map("id_almacen")
  almacen   Almacen @relation(fields: [idAlmacen], references: [id], onDelete: Restrict)

  /// Fecha de elaboración de la nota (solo fecha).
  fechaElaboracion DateTime  @map("fecha_elaboracion") @db.Date
  /// Fecha de envío real de los materiales (solo fecha; opcional hasta que salga el envío).
  fechaEnvio       DateTime? @map("fecha_envio") @db.Date

  /// Estatus del documento (ver enum). Controlado por el dominio; default borrador.
  estatus EstatusNotaSalida @default(borrador)

  observaciones String? @db.Text

  /// Confirmación: cuándo se confirmó (se descontaron los avíos). NULL mientras esté en borrador.
  /// SIN FK física al usuario (mismo criterio que OrdenCompra.idUsuAutorizado — ADR-0005).
  confirmadaEn    DateTime? @map("confirmada_en")
  confirmadaPorId String?   @map("confirmada_por_id")

  /// Cancelación SUAVE (D3): cuándo, quién y por qué. NULL si no está cancelada. Motivo obligatorio
  /// al cancelar (lo exige el dominio). SIN FK física al usuario (ADR-0005). Al cancelar una nota
  /// confirmada se generan los movimientos INVERSOS de los avíos (la tela NO se toca).
  canceladaEn       DateTime? @map("cancelada_en")
  canceladaPorId    String?   @map("cancelada_por_id")
  motivoCancelacion String?   @map("motivo_cancelacion") @db.Text

  /// Renglones de la nota (avío que descuenta O tela que referencia su salida-a-orden).
  lineas NotaSalidaLinea[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idEmpresa, numNota])
  @@index([idMaquilero])
  @@index([idAlmacen])
  @@index([estatus])
  @@index([fechaElaboracion])
  @@map("notas_salida")
}

/// Renglón de una nota de salida (F4-E5). XOR de material: AVÍO (`idAvio`, del catálogo) o TELA
/// (`idTela` + `idLote` + `idMovimientoSalidaTela` → liga al movimiento `salida-tela-orden` de E1).
/// SIEMPRE ligado a una `idOrden` de producción destino (R7/04-Inventarios §"Cómo conecta").
///  • AVÍO: al confirmar la nota, el dominio crea el movimiento `salida-por-nota` y lo guarda en
///    `idMovimientoAvio` (traza del descuento; NULL en borrador y para renglones de tela).
///  • TELA: `idMovimientoSalidaTela` apunta al movimiento de salida-a-orden YA registrado (E1) —
///    la base del ANTI-DOBLE-DESCUENTO (la nota REFERENCIA, no descuenta otra vez; decisión (e)).
/// `descripcionLegacy` es SOLO para el texto libre que migrará E6 (la captura nueva no la usa).
/// Cascade hacia la nota; Restrict hacia avío/tela/lote/orden; SetNull hacia los movimientos (que
/// nunca se borran — D3). Auditoría A7.
model NotaSalidaLinea {
  id           Int        @id @default(autoincrement())
  idNotaSalida Int        @map("id_nota_salida")
  notaSalida   NotaSalida @relation(fields: [idNotaSalida], references: [id], onDelete: Cascade)

  /// Orden de PRODUCCIÓN destino del envío (R7). Restrict.
  idOrden Int   @map("id_orden")
  orden   Orden @relation(fields: [idOrden], references: [id], onDelete: Restrict)

  /// Avío enviado (catálogo). XOR con `idTela`. Restrict. NULL si el renglón es de tela.
  idAvio Int?  @map("id_avio")
  avio   Avio? @relation(fields: [idAvio], references: [id], onDelete: Restrict)

  /// Tela enviada (catálogo). XOR con `idAvio`. Restrict. NULL si el renglón es de avío.
  idTela Int?  @map("id_tela")
  tela   Tela? @relation(fields: [idTela], references: [id], onDelete: Restrict)
  /// Lote de la tela enviada (D5). Obligatorio (dominio) en renglones de tela; NULL en avío. Restrict.
  idLote Int?  @map("id_lote")
  lote   Lote? @relation(fields: [idLote], references: [id], onDelete: Restrict)

  /// Movimiento `salida-tela-orden` de E1 que esta línea de TELA referencia (decisión (e): la nota
  /// NO descuenta tela; documenta el envío de una salida YA registrada). NULL en renglones de avío.
  /// SetNull: el movimiento nunca se borra (D3); el FK es defensivo.
  idMovimientoSalidaTela Int?        @map("id_movimiento_salida_tela")
  movimientoSalidaTela   Movimiento? @relation("NotaLineaSalidaTela", fields: [idMovimientoSalidaTela], references: [id], onDelete: SetNull)

  /// Movimiento `salida-por-nota` que el descuento de AVÍO de esta línea generó al CONFIRMAR la
  /// nota (R4). NULL en borrador y en renglones de tela. SetNull (el movimiento no se borra — D3).
  idMovimientoAvio Int?        @map("id_movimiento_avio")
  movimientoAvio   Movimiento? @relation("NotaLineaAvio", fields: [idMovimientoAvio], references: [id], onDelete: SetNull)

  /// Cantidad enviada (en `unidad`). Decimal (avíos en pza; telas en kg/m).
  cantidad Decimal @db.Decimal(14, 4)
  /// Unidad de medida del renglón (texto: pza, m, kg…), copiada del catálogo para mostrar sin join.
  unidad   String?

  /// Texto libre del renglón en v1 — SOLO para lo que migrará E6 (la captura nueva NO la usa).
  descripcionLegacy String? @map("descripcion_legacy") @db.Text

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idNotaSalida])
  @@index([idOrden])
  @@index([idAvio])
  @@index([idTela])
  @@index([idLote])
  @@index([idMovimientoSalidaTela])
  @@index([idMovimientoAvio])
  @@map("nota_salida_linea")
}

// ─────────────────────────────────────────────────────────────────────────────
// HITOS de la orden (cierre del hueco de emisores, post-F9). Varios procesos que
// Daniel dictó AUTOMÁTICOS no tienen un HECHO estructurado de v2 que los dispare
// (revisión de la OP, autorización de fit, de tono de tela, de avíos, empaque, y la
// autorización de arte). Un HITO es ese hecho: un acto puntual que se captura a mano
// en el detalle de la orden y que —vía el evento `hito-orden-resuelto`— auto-completa
// el proceso RC correspondiente (mismo motor de auto-avance que corte/recibo). Es la
// contraparte "sin submódulo propio" de los eventos que sí nacen de OC/nota/auditoría.
// ─────────────────────────────────────────────────────────────────────────────

/// Tipo de HITO de una orden. Cada valor mapea a un `TipoEventoProceso` en el dominio
/// (`hitosOrden.tipoEventoDeHito`): revisionOp→revisionOp, fit→autorizacionFit,
/// tonoTela→autorizacionTono, avios→autorizacionAvios, empaque→empaque, arte→
/// autorizacionArte (este último cierra el proceso `autorizacion-arte` que YA era auto
/// pero nadie emitía). Enum GLOBAL (los hitos son de la orden, no del catálogo).
enum TipoHitoOrden {
  revisionOp
  fit
  tonoTela
  avios
  empaque
  arte

  @@map("tipo_hito_orden")
}

/// HITO capturado en una orden (post-F9). Un acto puntual (p. ej. "autorización de fit
/// OK") que dispara el auto-avance del proceso RC ligado. NO lleva cantidades (es
/// binario: existe/no existe un hito vivo del tipo). Cancelación SUAVE (D3/A7): nunca
/// se borra ni se edita — un hito cancelado deja de contar y se puede re-registrar. El
/// índice UNIQUE PARCIAL `hito_orden_vivo_unico` (creado a mano en la migración, como las
/// vistas: Prisma no expresa el WHERE) garantiza UN hito VIVO por orden+tipo. A9: sellado
/// por empresa. Referencias de usuario SIN FK física (ADR-0005, patrón `autorizadaPorId`).
model HitoOrden {
  id        Int     @id @default(autoincrement())
  /// Empresa dueña del hito (A9). Restrict.
  idEmpresa Int     @map("id_empresa")
  empresa   Empresa @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)
  /// Orden a la que pertenece el hito. Restrict.
  idOrden   Int     @map("id_orden")
  orden     Orden   @relation(fields: [idOrden], references: [id], onDelete: Restrict)

  /// Tipo de hito (ver enum). Su mapeo a proceso RC vive en el dominio.
  tipo TipoHitoOrden

  /// Quién registró el hito (usuario de sesión). Sin FK física (ADR-0005).
  registradoPorId String?  @map("registrado_por_id")
  /// Fecha FÍSICA del acto (date-only). Es la que se escribe como `fechaReal` del proceso
  /// RC si el hito lo auto-completa (KPI D11 "cuándo": la fecha del hecho, no el reloj).
  fecha           DateTime @db.Date

  /// Cancelación SUAVE (D3/A7): NULL = vivo. Motivo OBLIGATORIO al cancelar (lo exige el dominio).
  canceladoEn       DateTime? @map("cancelado_en")
  canceladoPorId    String?   @map("cancelado_por_id")
  motivoCancelacion String?   @map("motivo_cancelacion") @db.Text

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idEmpresa])
  @@index([idOrden])
  @@index([tipo])
  @@map("hito_orden")
}

// ─────────────────────────────────────────────────────────────────────────────
// RUTA CRÍTICA — catálogo configurable de procesos (Módulo 8, F5-E1; doc
// 08-Ruta-Critica.md; D10/D11). El "corazón configurable" del motor de workflow:
// el catálogo de procesos como DATOS (`ProcesoDef`), sus roles responsables N:M
// sobre el RBAC único (`ProcesoDefRol`, A4 — sin catálogo de roles paralelo), el
// grafo (DAG) de dependencias genéricas (`ProcesoDep`, con rechazo de ciclos en
// el dominio) y los checklists configurables (`ProcesoChecklist`). El MOTOR (las
// instancias por orden con fechas/semáforos) y las plantillas llegan en E2+.
//
// Origen v1: `CP_Procesos` (26 procesos), `RC_TipoUsuarios` (roles funcionales) y
// `RC_ProcUsua` (asignaciones proceso×rol). El ETL formal con cuadre es E7; aquí
// el seed de desarrollo siembra los 26 procesos reales (datos bakeados, sin
// depender del CSV en runtime de deploy).
// ─────────────────────────────────────────────────────────────────────────────

/// ¿Bajo qué condición APLICA un proceso a una orden? (F5-E1). TIPADO SIMPLE (no es
/// un motor de expresiones): `ninguna` = siempre aplica; `soloSiLlevaAplicacion` =
/// solo si la orden lleva estampado/aplicación (ex `CP_Procesos.NoLlevaProceso`, que
/// marcaba los procesos saltables cuando no hay arte/aplicación). El motor de E2+
/// evaluará esta bandera al instanciar la RC de cada orden.
enum CondicionAplicabilidad {
  ninguna
  soloSiLlevaAplicacion

  @@map("condicion_aplicabilidad")
}

/// Tipo de EVENTO de negocio que un proceso de la RC representa (F5-E1). Liga el
/// proceso configurable con los hechos reales de v2 (recepción de tela, corte,
/// envío/recibo de costura/estampado, auditoría, autorización de arte, entrega a
/// cliente). El motor de E2+ podrá auto-completar el cumplimiento de un proceso a
/// partir del evento de dominio correspondiente (gancho RC, F3-E1). `manual` = el
/// proceso no tiene evento del sistema y se cumple a mano.
///
/// Los 8 valores del bloque final (revisionOp…empaque) se AGREGARON al cerrar el
/// hueco de emisores (post-F9, hallazgo de Gabriel: Daniel dictó ~18/20 procesos
/// AUTOMÁTICOS pero v2 no emitía sus eventos). `compraTela`/`surtidoAvios`/
/// `auditoriaCorte` los completan la OC de tela autorizada, la nota de salida de
/// avíos confirmada y la auditoría de corte aprobada; `revisionOp`/`autorizacionFit`/
/// `autorizacionTono`/`autorizacionAvios`/`empaque` los completa un HITO capturado a
/// mano (`HitoOrden`) — el gancho es el mismo motor de auto-avance (`autoAvance.ts`).
/// Van AL FINAL del enum (BD == schema) para que el `ADD VALUE` no requiera reordenar.
enum TipoEventoProceso {
  recepcionTela
  corte
  envioCostura
  reciboCostura
  envioEstampado
  reciboEstampado
  auditoria
  autorizacionArte
  entregaCliente
  manual
  revisionOp
  autorizacionFit
  autorizacionTono
  autorizacionAvios
  compraTela
  surtidoAvios
  auditoriaCorte
  empaque

  @@map("tipo_evento_proceso")
}

/// Cómo se calcula la DURACIÓN estimada de un proceso (F5-E1). TIPADO SIMPLE: `fija`
/// (días fijos), `porCantidad` (escala con las piezas — ex `CP_Procesos.Variable`),
/// `porTipoTela`, `porAplicacion` o `porDificultad` (rediseño R4, B7: los días salen
/// del RANGO de # de operaciones del modelo — tabla `RangoDificultad`; pensado para la
/// costura/maquila). El cálculo concreto vive en `calcularDuracion`.
enum TipoDuracionProceso {
  fija
  porCantidad
  porTipoTela
  porAplicacion
  porDificultad

  @@map("tipo_duracion_proceso")
}

/// SECUENCIA del estampado/bordado respecto a la costura (rediseño R4, B10 — decisión
/// Daniel 6-jul): `antes` = la confección SIEMPRE espera al estampado (dependencia
/// `reciboEstampado → envioCostura` en la ruta); `despues` = se estampa la prenda ya
/// cosida (sin esa dependencia); `flexible` = se decide EN PRODUCCIÓN por orden, según
/// la carga (la orden guarda su elección en `Orden.secEstampadoElegido` y la ruta se
/// reprograma en vivo). El default del catálogo es `antes` (hoy el taller estampa los
/// paneles cortados antes de coser: la rama de estampado del catálogo cuelga entre el
/// corte y la confección).
/// Origen del modelo (§Post-F9.34): de dónde salió su numeración y en qué catálogo se enseña
/// por default. Ver `Modelo.origen`.
/// ⭐ V1-E7d (§Post-F9.110) — Estado de la REVISIÓN de una VERSIÓN de modelo, la firma que
/// convierte una decisión de mesa en un compromiso de producción. Daniel: *"después de la
/// negociación con el cliente debe de haber una revisión antes de mandar a producir, porque
/// enfrente del cliente puede ser que se cometa una imprudencia o un error"*.
///
/// ⚠️ La columna que lo guarda es NULLABLE y `null` NO es un cuarto estado: significa **no
/// aplica** — el modelo no nació de una negociación (los 4,987 migrados del Access y todo
/// desarrollo normal). En una VERSIÓN, `null` se lee igual que `pendiente` (sin revisar), porque
/// las versiones que nacieron antes de esta etapa no tienen firma y tampoco la tienen que fingir.
enum EstadoRevisionModelo {
  /// Nació la versión y nadie la ha revisado todavía: NO puede pasar a producción.
  pendiente
  /// Alguien con `modelos.aprobar-receta` la firmó: ya puede pasar a producción.
  aprobada
  /// Se revisó y se devolvió con observaciones (`revisionNota` dice cuáles): NO pasa a producción.
  rechazada

  @@map("estado_revision_modelo")
}

enum OrigenModelo {
  /// Nació en el módulo de Desarrollo; su código es `CYA-26-71-001`. Oculto del catálogo y de la
  /// galería de producción salvo que se pida el filtro.
  desarrollo
  /// Está en el catálogo de PRODUCCIÓN: su código es el nº de 5 dígitos.
  produccion

  @@map("origen_modelo")
}

enum SecuenciaEstampado {
  antes
  despues
  flexible

  @@map("secuencia_estampado")
}

/// Definición de un PROCESO de la Ruta Crítica (catálogo configurable y GLOBAL — sin
/// idEmpresa, como TipoProceso/ADR-0007). Es la pieza-DATO del CPM hecho a mano del
/// viejo (doc 08): cada proceso tiene su criticidad, condición de aplicabilidad,
/// tipo de evento y de duración, sus roles responsables (N:M) y sus antecesores
/// (DAG). Borrado SUAVE (`activo`). Auditoría uniforme (A7).
model ProcesoDef {
  id     Int    @id @default(autoincrement())
  /// Clave estable kebab-case (p. ej. "corte", "recepcion-tela"). Única global.
  codigo String @unique
  nombre String

  /// ¿Es un proceso CRÍTICO de la ruta? (ex `CP_Procesos.Critico`). Marca los procesos
  /// que entran al cálculo de la ruta crítica / KPIs (doc 08).
  critico       Boolean @default(false)
  /// ¿Es el ÚLTIMO proceso (checkpoint final de la orden)? (ex `CP_Procesos.UltimoProceso`).
  /// El motor de E2+ lo usa para cerrar la RC de la orden.
  ultimoProceso Boolean @default(false) @map("ultimo_proceso")
  /// ¿Aplica también en órdenes de RESURTIDO? (ex `CP_Procesos.EsResurtido`).
  esResurtido   Boolean @default(false) @map("es_resurtido")

  /// Condición de aplicabilidad del proceso a una orden (TIPADO, no motor de expresiones).
  condicionAplicabilidad CondicionAplicabilidad @default(ninguna) @map("condicion_aplicabilidad")
  /// Evento de negocio que el proceso representa (gancho con los hechos reales de v2).
  tipoEvento             TipoEventoProceso      @default(manual) @map("tipo_evento")
  /// Cómo se estima la duración del proceso (TIPADO; la fórmula la pone el motor de E2+).
  tipoDuracion           TipoDuracionProceso    @default(fija) @map("tipo_duracion")

  /// Borrado SUAVE (plan §4): un proceso en uso por la RC nunca se borra físico → se desactiva.
  activo Boolean @default(true)

  /// Roles RESPONSABLES del proceso (N:M sobre el RBAC único, A4).
  roles        ProcesoDefRol[]
  /// Dependencias en las que ESTE proceso es el sucesor (sus antecesores).
  antecesores  ProcesoDep[]           @relation("ProcesoComoSucesor")
  /// Dependencias en las que ESTE proceso es el antecesor (sus sucesores).
  sucesores    ProcesoDep[]           @relation("ProcesoComoAntecesor")
  /// Ítems de checklist configurable del proceso.
  checklist    ProcesoChecklist[]
  /// Renglones de plantilla de ruta que usan este proceso (F5-E2). Restrict.
  enPlantillas PlantillaRutaProceso[]
  /// Renglones de ruta viva (por orden) que usan este proceso (F5-E3). Restrict.
  enRutas      RutaOrden[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("proceso_def")
}

/// Puente N:M `ProcesoDef` × `Rol` — el/los rol(es) RESPONSABLE(s) de un proceso de la RC
/// (F5-E1, A4: sobre el RBAC único, sin catálogo de roles paralelo). PK compuesta; solo
/// auditoría de creación (las puentes no se "modifican": se crean/borran al re-set de roles).
model ProcesoDefRol {
  idProcesoDef Int        @map("id_proceso_def")
  procesoDef   ProcesoDef @relation(fields: [idProcesoDef], references: [id], onDelete: Cascade)
  idRol        Int        @map("id_rol")
  rol          Rol        @relation(fields: [idRol], references: [id], onDelete: Restrict)

  creadoEn    DateTime @default(now()) @map("creado_en")
  creadoPorId String?  @map("creado_por_id")

  @@id([idProcesoDef, idRol])
  @@index([idRol])
  @@map("proceso_def_rol")
}

/// Arista del DAG de dependencias genéricas entre procesos de la RC (F5-E1): `idAntecesor`
/// DEBE ocurrir antes que `idProceso`. Self-relation con dos nombres de relación distintos.
/// El RECHAZO DE CICLOS vive en el dominio (`definirDependencias`): el grafo siempre acíclico.
/// PK compuesta `[idProceso, idAntecesor]`; Restrict (un proceso con dependencias no se borra
/// físico). Solo auditoría de creación (las aristas se crean/borran al re-set de dependencias).
model ProcesoDep {
  idProceso   Int        @map("id_proceso")
  proceso     ProcesoDef @relation("ProcesoComoSucesor", fields: [idProceso], references: [id], onDelete: Restrict)
  idAntecesor Int        @map("id_antecesor")
  antecesor   ProcesoDef @relation("ProcesoComoAntecesor", fields: [idAntecesor], references: [id], onDelete: Restrict)

  creadoEn    DateTime @default(now()) @map("creado_en")
  creadoPorId String?  @map("creado_por_id")

  @@id([idProceso, idAntecesor])
  @@index([idAntecesor])
  @@map("proceso_dep")
}

/// Ítem de CHECKLIST configurable de un proceso de la RC (F5-E1). Lista ordenada de puntos a
/// verificar por proceso (doc 08: la RC del viejo llevaba comprobaciones manuales). Borrado
/// SUAVE (`activo`): al re-set del checklist, los ítems quitados se desactivan (no se borran).
model ProcesoChecklist {
  id           Int        @id @default(autoincrement())
  idProcesoDef Int        @map("id_proceso_def")
  procesoDef   ProcesoDef @relation(fields: [idProcesoDef], references: [id], onDelete: Cascade)
  descripcion  String
  /// Orden de despliegue del ítem dentro del checklist (lo gestiona el dominio).
  orden        Int        @default(0)
  /// Borrado suave: un ítem quitado del checklist se desactiva (conserva historial).
  activo       Boolean    @default(true)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idProcesoDef])
  @@map("proceso_checklist")
}

// ─────────────────────────────────────────────────────────────────────────────
// RUTA CRÍTICA · F5-E2 — Plantillas de ruta, reglas de duración y calendario
// ─────────────────────────────────────────────────────────────────────────────

/// Familia de artículos de la Ruta Crítica (ex `CP_Familia`). Agrupa los `ArticuloRC`
/// (tipos de artículo del CPM). Catálogo GLOBAL, borrado SUAVE (`activo`), auditoría A7.
model FamiliaArticulo {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  activo Boolean @default(true)

  /// Artículos RC de esta familia (Restrict: una familia con artículos no se borra física).
  articulos ArticuloRC[]

  creadoEn        DateTime        @default(now()) @map("creado_en")
  creadoPorId     String?         @map("creado_por_id")
  modificadoEn    DateTime        @updatedAt @map("modificado_en")
  modificadoPorId String?         @map("modificado_por_id")
  plantillaRutas  PlantillaRuta[]

  @@map("familia_articulo")
}

/// Tipo de artículo de la Ruta Crítica (ex `CP_Articulos`, viejo `IdCP_Articulos`). Es la
/// dimensión por la que el CPM viejo variaba sus tiempos (p. ej. "SENCILLO 1/6", "DIFICIL 6/6").
/// Pertenece a una `FamiliaArticulo`. NO se conecta por FK desde `Orden` en esta etapa: la orden
/// guarda `idTipoArticuloRC` como escalar nullable sin FK (prueba ya tiene órdenes ETL con valores
/// ahí; el enganche formal llega cuando el motor lo necesite). Catálogo GLOBAL, borrado SUAVE.
model ArticuloRC {
  id                Int             @id @default(autoincrement())
  nombre            String
  idFamiliaArticulo Int             @map("id_familia_articulo")
  familia           FamiliaArticulo @relation(fields: [idFamiliaArticulo], references: [id], onDelete: Restrict)
  activo            Boolean         @default(true)

  /// Plantillas de ruta que aplican específicamente a este artículo (Restrict).
  plantillas PlantillaRuta[]
  /// Órdenes programadas con este artículo RC (F5-E3). Restrict.
  ordenes    Orden[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idFamiliaArticulo])
  @@map("articulo_rc")
}

/// PLANTILLA de ruta: qué procesos lleva un artículo/familia, con qué tiempo estándar y con qué
/// ENCADENAMIENTO PROPIO (puede diferir del DAG genérico de `ProcesoDep`, porque el viejo
/// `CP_Tiempos.Antecesor` se capturaba por artículo). Identifica a qué aplica por familia y/o
/// artículo (ambos opcionales: una plantilla puede ser de toda una familia o de un artículo
/// concreto). Catálogo GLOBAL, borrado SUAVE, auditoría A7.
model PlantillaRuta {
  id     Int    @id @default(autoincrement())
  nombre String

  /// Familia a la que aplica (opcional). Restrict.
  idFamiliaArticulo Int?             @map("id_familia_articulo")
  familia           FamiliaArticulo? @relation(fields: [idFamiliaArticulo], references: [id], onDelete: Restrict)
  /// Artículo concreto al que aplica (opcional). Restrict.
  idArticuloRC      Int?             @map("id_articulo_rc")
  articulo          ArticuloRC?      @relation(fields: [idArticuloRC], references: [id], onDelete: Restrict)

  activo Boolean @default(true)

  /// Procesos de la plantilla (su tiempo estándar + posición). Cascade: al borrar la plantilla.
  procesos PlantillaRutaProceso[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idFamiliaArticulo])
  @@index([idArticuloRC])
  @@map("plantilla_ruta")
}

/// Renglón de una `PlantillaRuta`: un proceso del catálogo con su TIEMPO ESTÁNDAR (días) y su
/// posición (`orden`) dentro de la plantilla (ex `CP_Tiempos`). El encadenamiento PROPIO de la
/// plantilla se modela aparte en `PlantillaRutaDep` (un renglón puede tener antecesores distintos
/// a los del DAG genérico). Cascade desde la plantilla; Restrict hacia el `ProcesoDef`.
model PlantillaRutaProceso {
  id              Int           @id @default(autoincrement())
  idPlantillaRuta Int           @map("id_plantilla_ruta")
  plantilla       PlantillaRuta @relation(fields: [idPlantillaRuta], references: [id], onDelete: Cascade)
  idProcesoDef    Int           @map("id_proceso_def")
  procesoDef      ProcesoDef    @relation(fields: [idProcesoDef], references: [id], onDelete: Restrict)

  /// Tiempo estándar del proceso en esta plantilla, en días (ex `CP_Tiempos.Tiempo`).
  tiempoEstandar Int @map("tiempo_estandar")
  /// Posición del renglón dentro de la plantilla (lo gestiona el dominio).
  orden          Int @default(0)

  /// Dependencias en las que ESTE renglón es el sucesor (sus antecesores en la plantilla).
  antecesores PlantillaRutaDep[] @relation("PlantillaProcesoComoSucesor")
  /// Dependencias en las que ESTE renglón es el antecesor (sus sucesores en la plantilla).
  sucesores   PlantillaRutaDep[] @relation("PlantillaProcesoComoAntecesor")

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idPlantillaRuta, idProcesoDef])
  @@index([idProcesoDef])
  @@map("plantilla_ruta_proceso")
}

/// Arista del DAG de encadenamiento PROPIO de una plantilla: `idAntecesor` (renglón de la plantilla)
/// debe ocurrir antes que `idPlantillaRutaProceso` (otro renglón de la MISMA plantilla). Se valida
/// acíclico en el dominio (reusa `grafo.ts`). Ambos extremos Cascade desde sus renglones (al borrar
/// la plantilla caen sus renglones y con ellos sus aristas). Solo auditoría de creación.
model PlantillaRutaDep {
  idPlantillaRutaProceso Int                  @map("id_plantilla_ruta_proceso")
  proceso                PlantillaRutaProceso @relation("PlantillaProcesoComoSucesor", fields: [idPlantillaRutaProceso], references: [id], onDelete: Cascade)
  idAntecesor            Int                  @map("id_antecesor")
  antecesor              PlantillaRutaProceso @relation("PlantillaProcesoComoAntecesor", fields: [idAntecesor], references: [id], onDelete: Cascade)

  creadoEn    DateTime @default(now()) @map("creado_en")
  creadoPorId String?  @map("creado_por_id")

  @@id([idPlantillaRutaProceso, idAntecesor])
  @@index([idAntecesor])
  @@map("plantilla_ruta_dep")
}

/// Factor de duración POR CANTIDAD de piezas (ex `CP_Cant`, 11 rangos). El motor de E4 multiplica
/// el tiempo base por el `factor` del rango `[deCant, aCant]` en el que cae la cantidad de la orden.
/// Catálogo GLOBAL, borrado SUAVE, auditoría A7.
model FactorCantidad {
  id     Int     @id @default(autoincrement())
  /// Límite inferior del rango (inclusive) (ex `CP_Cant.DeCant`).
  deCant Int     @map("de_cant")
  /// Límite superior del rango (inclusive) (ex `CP_Cant.ACant`).
  aCant  Int     @map("a_cant")
  /// Factor multiplicador para ese rango (ex `CP_Cant.FactorCant`).
  factor Decimal @db.Decimal(10, 4)
  activo Boolean @default(true)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([deCant, aCant])
  @@map("factor_cantidad")
}

/// Duración (días de espera) POR TIPO DE TELA (ex `RC_TipoTelas`, 7). El `factorTela` se guarda
/// aunque el viejo NO lo aplicaba (decisión (b)): queda disponible para el motor de E4. Catálogo
/// GLOBAL, borrado SUAVE, auditoría A7.
model DuracionPorTipoTela {
  id         Int     @id @default(autoincrement())
  /// Nombre del tipo de tela (ex `RC_TipoTelas.TipoTela`). Único.
  nombre     String  @unique
  /// Días de espera que suma este tipo de tela (ex `RC_TipoTelas.Dias`).
  dias       Int
  /// Factor de la tela (ex `RC_TipoTelas.FactorTela`). Se conserva aunque el viejo no lo aplicara.
  factorTela Decimal @map("factor_tela") @db.Decimal(10, 4)
  activo     Boolean @default(true)

  /// Órdenes programadas con este tipo de tela (F5-E3). Restrict.
  ordenes Orden[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("duracion_tipo_tela")
}

/// RANGO de DIFICULTAD por # de operaciones (rediseño R4, B7 — spec §4.9): la dificultad de una
/// prenda NO se teclea, se DERIVA del `Modelo.numOperaciones` (capturado en el desarrollo, R5)
/// contra esta tabla CONFIGURABLE (Daniel define cuántos niveles, sus rangos, nombres y días).
/// `opsHasta` null = rango abierto ("33+"). Alimenta la regla `porDificultad` de
/// `calcularDuracion` (impacta sobre todo la costura/maquila). Los rangos ACTIVOS no se solapan
/// (validación server-side en el dominio). Catálogo GLOBAL, borrado SUAVE, auditoría A7.
model RangoDificultad {
  id          Int     @id @default(autoincrement())
  /// Límite inferior del rango de operaciones (inclusive).
  opsDesde    Int     @map("ops_desde")
  /// Límite superior (inclusive), o null = abierto hacia arriba ("33+").
  opsHasta    Int?    @map("ops_hasta")
  /// Nombre de la dificultad (p. ej. "Muy sencillo", "Complejo").
  nombre      String
  /// Días de costura que aporta este rango (la duración del proceso `porDificultad`).
  diasCostura Int     @map("dias_costura")
  /// Posición de despliegue en la tabla (lo gestiona el dominio).
  orden       Int     @default(0)
  activo      Boolean @default(true)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([opsDesde])
  @@map("rango_dificultad")
}

/// Duración (días de espera) POR APLICACIÓN/estampado (ex `RC_Aplicaciones`, 9). El origen NO trae
/// factor (solo `Dias`): `factor` queda OPCIONAL (decisión (b)) para el motor de E4. Catálogo
/// GLOBAL, borrado SUAVE, auditoría A7.
model DuracionPorAplicacion {
  id     Int      @id @default(autoincrement())
  /// Nombre de la aplicación (ex `RC_Aplicaciones.TipoAplicacion`). Único.
  nombre String   @unique
  /// Clave corta de la aplicación (ex `RC_Aplicaciones.ClaveAplicacion`, p. ej. "A1").
  clave  String?
  /// Días de espera que suma esta aplicación (ex `RC_Aplicaciones.Dias`).
  dias   Int
  /// Factor (no existe en el origen; opcional para el motor de E4, decisión (b)).
  factor Decimal? @db.Decimal(10, 4)
  activo Boolean  @default(true)

  /// Órdenes programadas con esta aplicación (F5-E3). Restrict.
  ordenes Orden[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("duracion_aplicacion")
}

/// CALENDARIO LABORAL por empresa (decisión (a)): qué días de la semana son hábiles. Un registro
/// por empresa (1:1). Los 7 booleanos default L–V hábiles, sáb/dom no. Las funciones puras de
/// `díasHábiles` lo consultan junto con los `DiaFestivo`. Auditoría A7.
model CalendarioEmpresa {
  id        Int     @id @default(autoincrement())
  idEmpresa Int     @unique @map("id_empresa")
  empresa   Empresa @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)

  lunes     Boolean @default(true)
  martes    Boolean @default(true)
  miercoles Boolean @default(true)
  jueves    Boolean @default(true)
  viernes   Boolean @default(true)
  sabado    Boolean @default(false)
  domingo   Boolean @default(false)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("calendario_empresa")
}

/// DÍA FESTIVO (no laborable) de una empresa (decisión (a)). Fecha + descripción. El motor de E4 lo
/// salta al contar días hábiles. Único por empresa+fecha. Borrado SUAVE, auditoría A7.
model DiaFestivo {
  id          Int      @id @default(autoincrement())
  idEmpresa   Int      @map("id_empresa")
  empresa     Empresa  @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)
  fecha       DateTime @db.Date
  descripcion String
  activo      Boolean  @default(true)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idEmpresa, fecha])
  @@index([idEmpresa])
  @@map("dia_festivo")
}

// ─────────────────────────────────────────────────────────────────────────────
// RUTA CRÍTICA · F5-E3 — Ruta viva por orden (motor pt1: generación + duraciones)
// ─────────────────────────────────────────────────────────────────────────────

/// Estado de un proceso dentro de la RUTA VIVA de una orden (F5-E3). El SEMÁFORO de
/// cumplimiento (a tiempo / en riesgo / atrasado) es de E4 y NO se modela aquí: aquí solo el
/// avance simple del proceso. `pendiente` (sin capturar), `activo` (en curso), `completado`
/// (cumplido — su `fechaReal` ya se capturó o se auto-completó por duración 0).
enum EstadoProcesoRuta {
  pendiente
  activo
  completado

  @@map("estado_proceso_ruta")
}

/// CÓMO se capturó el cumplimiento de un proceso de la ruta viva (F5-E3). `manual` (un usuario
/// lo marcó), `evento` (lo auto-completó el sistema: un evento de dominio o la duración 0 al
/// generar). Nullable: queda en null mientras el proceso no se ha completado.
enum OrigenCaptura {
  manual
  evento

  @@map("origen_captura")
}

/// RENGLÓN de la RUTA VIVA de UNA orden (F5-E3): un proceso de la ruta de esa orden, con su
/// duración estimada, sus fechas (planeadas/reales) y su estado. Pensado para explotación
/// analítica (D11): una fila por proceso×orden. Se GENERA desde la plantilla aplicable
/// (`generarRutaOrden`); el snapshot de banderas (`critico`, `ultimoProceso`, `esResurtido`,
/// `condicionAplicabilidad`) congela cómo estaba el proceso AL GENERAR (la plantilla puede cambiar
/// luego sin alterar rutas ya generadas). Las dependencias propias de la orden viven en
/// `RutaOrdenDep` (editables sin tocar la plantilla, D10). Las fechas planeadas las calcula el CPM
/// de E4 (aquí quedan en null salvo los procesos de duración 0 auto-completados). Auditoría A7.
model RutaOrden {
  id           Int        @id @default(autoincrement())
  idOrden      Int        @map("id_orden")
  orden        Orden      @relation(fields: [idOrden], references: [id], onDelete: Restrict)
  idProcesoDef Int        @map("id_proceso_def")
  procesoDef   ProcesoDef @relation(fields: [idProcesoDef], references: [id], onDelete: Restrict)

  /// Posición del proceso en la ruta de la orden (lo gestiona el dominio al generar).
  secuencia Int @default(0)

  // ── Snapshot de las banderas del proceso AL GENERAR (no se re-leen del catálogo) ──
  /// ¿Era CRÍTICO al generar? (snapshot de `ProcesoDef.critico`).
  critico                Boolean                @default(false)
  /// ¿Era el ÚLTIMO proceso al generar? (snapshot de `ProcesoDef.ultimoProceso`).
  ultimoProceso          Boolean                @default(false) @map("ultimo_proceso")
  /// ¿Aplicaba en resurtido al generar? (snapshot de `ProcesoDef.esResurtido`).
  esResurtido            Boolean                @default(false) @map("es_resurtido")
  /// Condición de aplicabilidad al generar (snapshot de `ProcesoDef.condicionAplicabilidad`).
  condicionAplicabilidad CondicionAplicabilidad @default(ninguna) @map("condicion_aplicabilidad")

  /// Duración estimada del proceso en DÍAS (la calcula `calcularDuracion` al generar, F5-E3).
  duracionDias  Int  @map("duracion_dias")
  /// Días acumulados hasta este proceso (lo llena el CPM de E4; null en E3).
  acumuladoDias Int? @map("acumulado_dias")

  /// Fecha planeada ORIGINAL (primer cálculo del CPM, E4). Null en E3 (pendiente de cálculo).
  fechaPlaneadaOriginal DateTime? @map("fecha_planeada_original")
  /// Fecha planeada VIGENTE (se recalcula al ajustar la ruta, E4). Null en E3.
  fechaPlaneadaVigente  DateTime? @map("fecha_planeada_vigente")
  /// Fecha REAL de cumplimiento del proceso (capturada o auto-completada por duración 0).
  fechaReal             DateTime? @map("fecha_real")

  /// Estado del proceso en la ruta (avance simple; el semáforo es E4).
  estado EstadoProcesoRuta @default(pendiente)

  /// ¿Hay una entrada PARCIAL en curso para este proceso? (F5-E6, decisión (d)). El auto-avance la
  /// enciende cuando un evento (recibo de maquila, recepción de tela, entrega…) cubre SOLO una parte
  /// de la cantidad pedida color×talla, y la apaga cuando se completa (proceso `completado`) o se
  /// des-completa por una cancelación (decisión (f)). Es una MARCA visible "parcial en curso"; el
  /// proceso solo se marca `completado` cuando llega la cantidad COMPLETA.
  parcialEnCurso Boolean @default(false) @map("parcial_en_curso")

  /// Quién capturó el cumplimiento (null mientras no se complete).
  capturadoPorId String?        @map("capturado_por_id")
  /// Cuándo se capturó el cumplimiento (null mientras no se complete).
  capturadoEn    DateTime?      @map("capturado_en")
  /// Cómo se capturó (manual / evento del sistema). Null mientras no se complete.
  origenCaptura  OrigenCaptura? @map("origen_captura")

  /// Dependencias de la ruta de ESTA orden en las que este renglón es el sucesor (sus antecesores).
  antecesores RutaOrdenDep[]       @relation("RutaProcesoComoSucesor")
  /// Dependencias de la ruta de ESTA orden en las que este renglón es el antecesor (sus sucesores).
  sucesores   RutaOrdenDep[]       @relation("RutaProcesoComoAntecesor")
  /// Ítems de checklist (snapshot del proceso al generar) de este renglón.
  checklist   RutaOrdenChecklist[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idOrden, idProcesoDef])
  @@index([idOrden])
  @@index([idProcesoDef])
  @@map("ruta_orden")
}

/// Arista del DAG de dependencias de la RUTA VIVA de UNA orden (F5-E3): `idAntecesor` debe ocurrir
/// antes que `idRutaOrden`, AMBOS renglones de la MISMA orden. Es un SNAPSHOT editable sin tocar la
/// plantilla (D10: `ajustarRutaOrden` cambia estas aristas, no `PlantillaRutaDep`). Se valida
/// acíclico en el dominio (reusa `grafo.ts`). Ambos extremos Cascade desde sus renglones.
model RutaOrdenDep {
  idRutaOrden Int       @map("id_ruta_orden")
  rutaOrden   RutaOrden @relation("RutaProcesoComoSucesor", fields: [idRutaOrden], references: [id], onDelete: Cascade)
  idAntecesor Int       @map("id_antecesor")
  antecesor   RutaOrden @relation("RutaProcesoComoAntecesor", fields: [idAntecesor], references: [id], onDelete: Cascade)

  creadoEn    DateTime @default(now()) @map("creado_en")
  creadoPorId String?  @map("creado_por_id")

  @@id([idRutaOrden, idAntecesor])
  @@index([idAntecesor])
  @@map("ruta_orden_dep")
}

/// Ítem de CHECKLIST de un proceso de la ruta viva de una orden (F5-E3). Snapshot de
/// `ProcesoChecklist` al generar la ruta; se marca `hecho` por orden (no toca el catálogo).
/// Cascade desde su renglón de ruta. Auditoría A7.
model RutaOrdenChecklist {
  id          Int       @id @default(autoincrement())
  idRutaOrden Int       @map("id_ruta_orden")
  rutaOrden   RutaOrden @relation(fields: [idRutaOrden], references: [id], onDelete: Cascade)
  descripcion String
  /// Posición del ítem dentro del checklist (snapshot del orden del catálogo).
  orden       Int       @default(0)
  /// ¿Ya se verificó este punto en esta orden?
  hecho       Boolean   @default(false)
  /// Cuándo se marcó como hecho (null si no se ha hecho).
  fechaHecho  DateTime? @map("fecha_hecho")
  /// Quién lo marcó (null si no se ha hecho).
  hechoPorId  String?   @map("hecho_por_id")

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idRutaOrden])
  @@map("ruta_orden_checklist")
}

// ═════════════════════════════════════════════════════════════════════════════
// CALIDAD (F6-E1) — Control de calidad: catálogo de defectos enriquecido + tipos de
// producto + motor de planes de muestreo AQL como DATOS (no código). doc funcional
// `09-Control-de-Calidad.md` §2/§5; MEJORAS 09; DECISIONES.md §F6 (a)–(d). El núcleo
// transaccional de auditorías llega en F6-E2 (este E1 es solo la base configurable).
// ═════════════════════════════════════════════════════════════════════════════

/// Severidad del defecto (doc 09 §5.4: categorías/severidad para el catálogo). Es METADATO
/// INFORMATIVO (categorización + KPIs de F7): NO entra en ningún veredicto de auditoría
/// (decisión (a) — el resultado lo decide el auditor a mano en E2). Por eso vive como enum
/// libre, sin pesos ni números de aceptación.
enum SeveridadDefecto {
  critico
  mayor
  menor

  @@map("severidad_defecto")
}

/// Tipo de producto (F6-E1, decisión (d) — DECISIONES.md §F6). Catálogo CORTO y editable que
/// clasifica los modelos (playera, pantalón, sudadera…) para FILTRAR qué defectos aplican a una
/// auditoría (NO para el plan AQL: hay un solo plan para todos, decisión (c)). El tipo se hereda
/// del modelo (`Modelo.tipoProductoId`) y en el alta de auditoría se puede sobre-escribir (E2).
/// GLOBAL como los catálogos de F1 (sin idEmpresa); borrado suave + auditoría A7.
model TipoProducto {
  id     Int     @id @default(autoincrement())
  /// Nombre del tipo (único global, insensible a mayúsculas lo valida el dominio).
  nombre String  @unique
  activo Boolean @default(true)

  /// 1er DÍGITO (CONCEPTO) de la nomenclatura de producción (§Post-F9.34): 2 Conjunto ·
  /// 3 Bermuda/Falda/Short · 4 Vestido · 5 Playera · 6 Sudadera · 7 Pantalón/Jogger/Leggings ·
  /// 8 Chamarra/Chaleco · 9 Gorra/Polo/Bata. El 1 NO significa nada (no se usa). Cada concepto
  /// es una serie INDEPENDIENTE de 999 (el encadenamiento existe sólo en el género, §Post-F9.46).
  /// NULL = tipo sin dígito asignado (el generador no puede numerarlo).
  digitoConcepto Int? @map("digito_concepto")

  /// Modelos clasificados con este tipo (F1, Restrict: un tipo en uso por un modelo no se borra
  /// físico → se desactiva).
  modelos         Modelo[]
  /// Defectos etiquetados con este tipo (M:N por `DefectoTipoProducto`). Cascade desde el puente.
  defectosLigados DefectoTipoProducto[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  /// Un concepto es una serie INDEPENDIENTE de 999 (§Post-F9.34): dos tipos ACTIVOS con el mismo
  /// dígito se repartirían la misma serie. Índice PARCIAL (sólo activos, sólo con dígito) creado a
  /// mano en la migración `20260820160000_modelos_desarrollo_vs_produccion` — Prisma no expresa
  /// unique parciales, así que aquí sólo queda anotado.
  @@map("tipos_producto")
}

/// Defecto del catálogo de calidad (F6-E1 — ex `CC_Catalogo`, doc 09 §2). `nivelAQL` numérico
/// (1.0 / 2.5 / 10 — el AQL al que pertenece el defecto, doc 09 §2: la columna AQL del viejo trae
/// '1'/'2.5'/'10' limpios). `favorito` = se pre-carga en toda auditoría nueva (ex `Favorito`,
/// E2). `severidad` es METADATO (no veredicto, decisión (a)). `aplicaGeneral=true` → el defecto
/// aplica a TODOS los tipos de producto sin importar las ligas de `DefectoTipoProducto` (decisión
/// (d)). GLOBAL (sin idEmpresa — catálogo maestro como F1); borrado suave (un defecto con
/// auditorías históricas NO se borra físico, solo se inactiva); auditoría A7.
model DefectoCatalogo {
  id            Int              @id @default(autoincrement())
  /// Clave de negocio del defecto (ex `CC_Catalogo.Clave`). Única global.
  clave         String           @unique
  descripcion   String
  /// Página/referencia del manual de calidad donde se ilustra (ex `Pag`). Opcional.
  pag           String?
  /// Nivel AQL al que pertenece el defecto (1.0 / 2.5 / 10). Numérico para agrupar por nivel en E2.
  nivelAQL      Decimal          @map("nivel_aql") @db.Decimal(4, 2)
  /// Se pre-carga en toda auditoría nueva (ex `CC_Catalogo.Favorito` — hoy 33 favoritos).
  favorito      Boolean          @default(false)
  /// Categoría libre para agrupar defectos (doc 09 §5.4). Opcional.
  categoria     String?
  /// Severidad informativa (NO entra en el veredicto, decisión (a)).
  severidad     SeveridadDefecto @default(menor)
  /// ¿Aplica a TODOS los tipos de producto? (decisión (d)). Si es `true`, las ligas de
  /// `DefectoTipoProducto` se ignoran (el defecto es universal).
  aplicaGeneral Boolean          @default(false) @map("aplica_general")
  activo        Boolean          @default(true)

  /// Tipos de producto a los que aplica este defecto (M:N por `DefectoTipoProducto`). Cuando
  /// `aplicaGeneral=true` estas ligas no importan (aplica a todos).
  tiposLigados      DefectoTipoProducto[]
  /// Renglones de auditoría que cuentan fallas de este defecto (F6-E2). Restrict (en uso ⇒ se desactiva).
  auditoriaDefectos AuditoriaDefecto[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("defectos_catalogo")
}

/// Puente M:N defecto ↔ tipo de producto (F6-E1, decisión (d)). Un defecto aplica a los tipos
/// ligados aquí (salvo que `DefectoCatalogo.aplicaGeneral=true`, que lo hace universal). PK
/// compuesta: una liga única por par. Cascade desde ambos extremos (reescribir las ligas de un
/// defecto en la tx; quitar un tipo arrastra sus ligas).
model DefectoTipoProducto {
  idDefecto      Int @map("id_defecto")
  idTipoProducto Int @map("id_tipo_producto")

  defecto      DefectoCatalogo @relation(fields: [idDefecto], references: [id], onDelete: Cascade)
  tipoProducto TipoProducto    @relation(fields: [idTipoProducto], references: [id], onDelete: Cascade)

  @@id([idDefecto, idTipoProducto])
  @@index([idTipoProducto])
  @@map("defecto_tipo_producto")
}

/// Plan de muestreo AQL (F6-E1 — doc 09 §5.2; ISO 2859 nivel general II, AQL 1.0/2.5/10). Es la
/// tabla de muestreo COMO DATOS (no motor estadístico — "no sobre-diseñar"). Decisión (c): hay UN
/// solo plan default activo para todos (sin asignación por cliente ni tipo de producto). El plan
/// sirve para la MUESTRA (decisión (b)); el límite acepta/rechaza queda como referencia (el
/// veredicto lo decide el auditor a mano en E2, decisión (a)). GLOBAL; auditoría A7.
model PlanMuestreoAQL {
  id     Int     @id @default(autoincrement())
  /// Nombre del plan (único global). Ej. "ISO 2859 — Nivel general II".
  nombre String  @unique
  /// Solo un plan default es el activo que el resolver usa (decisión (c)). Borrado suave.
  activo Boolean @default(true)

  /// Renglones por rango de tamaño de lote (Cascade: reescribir el plan en la tx A2).
  renglones PlanMuestreoRenglon[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("planes_muestreo_aql")
}

/// Renglón del plan AQL por RANGO de tamaño de lote → tamaño de muestra (F6-E1, doc 09 §5.2). El
/// resolver elige el renglón cuyo [loteMin, loteMax] contiene el tamaño del lote y devuelve
/// `tamanoMuestra` (decisión (b): la muestra es lo vinculante). `loteMax` null = "en adelante"
/// (último rango abierto). Cascade desde el plan.
model PlanMuestreoRenglon {
  id            Int             @id @default(autoincrement())
  idPlan        Int             @map("id_plan")
  plan          PlanMuestreoAQL @relation(fields: [idPlan], references: [id], onDelete: Cascade)
  /// Tamaño de lote mínimo del rango (inclusivo).
  loteMin       Int             @map("lote_min")
  /// Tamaño de lote máximo del rango (inclusivo); null = sin tope (último rango abierto).
  loteMax       Int?            @map("lote_max")
  /// Tamaño de muestra para este rango (cuántas piezas se inspeccionan).
  tamanoMuestra Int             @map("tamano_muestra")

  /// Límites acepta/rechaza por nivel AQL de este renglón (Cascade).
  limites PlanMuestreoLimite[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idPlan])
  @@map("plan_muestreo_renglon")
}

/// Límite acepta/rechaza de un renglón del plan POR NIVEL AQL (F6-E1, doc 09 §2: en ISO 2859 cada
/// nivel AQL tiene su PROPIO número de aceptación/rechazo). El resolver, dado (lote, nivel),
/// localiza el renglón por lote y este límite por `nivelAQL`. `aceptar` = máximo de defectos para
/// APROBAR; `rechazar` = mínimo para RECHAZAR (normalmente aceptar+1). Es REFERENCIA (el veredicto
/// es manual en E2, decisión (a)). Un nivel único por renglón.
model PlanMuestreoLimite {
  id        Int                 @id @default(autoincrement())
  idRenglon Int                 @map("id_renglon")
  renglon   PlanMuestreoRenglon @relation(fields: [idRenglon], references: [id], onDelete: Cascade)
  /// Nivel AQL al que aplica el límite (1.0 / 2.5 / 10).
  nivelAQL  Decimal             @map("nivel_aql") @db.Decimal(4, 2)
  /// Número de aceptación (Ac): hasta este número de defectos, se ACEPTA.
  aceptar   Int
  /// Número de rechazo (Re): a partir de este número de defectos, se RECHAZA.
  rechazar  Int

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idRenglon, nivelAQL])
  @@map("plan_muestreo_limite")
}

// ═════════════════════════════════════════════════════════════════════════════
// AUDITORÍAS DE CALIDAD (F6-E2) — núcleo transaccional del Control de calidad. doc
// funcional `09-Control-de-Calidad.md` §1/§2/§4; DECISIONES.md §F6 (a)/(b). Una
// auditoría inspecciona una MUESTRA de prendas de una orden (recibidas de un
// maquilero), cuenta las fallas por defecto y deja un RESULTADO que el auditor
// decide A MANO (decisión (a) — el cálculo por nivel AQL es solo sugerencia
// informativa, NO vinculante; la severidad del defecto NO entra en el veredicto).
// ═════════════════════════════════════════════════════════════════════════════

/// Resultado de una auditoría de calidad (doc 09 §2). Lo decide el auditor A MANO
/// (decisión (a)); el cálculo por nivel AQL del plan es solo SUGERENCIA. `no_calificado`
/// es el estado inicial (capturada sin veredicto). Una auditoría FINAL `aprobado`
/// auto-completa el proceso de RC "auditoría" de la orden (F5/F6 integración).
enum ResultadoAuditoria {
  aprobado
  reprobado
  no_calificado

  @@map("resultado_auditoria")
}

/// Tipo de auditoría (doc 09 §1: en piso durante la producción, o final al recibir).
/// `no_definida` para los casos viejos/sin clasificar. Una auditoría `final` `aprobado`
/// gatilla el auto-avance del proceso RC `auditoria`; una `corte` `aprobado` gatilla el
/// proceso RC `auditoriaCorte` (la de piso es un control intermedio que no auto-completa).
enum TipoAuditoria {
  en_piso
  final
  no_definida
  corte

  @@map("tipo_auditoria")
}

/// Auditoría de calidad de una orden (F6-E2 — ex `CC_Auditorias`, doc 09 §2). Folio
/// `numAuditoria` por SECUENCIA ATÓMICA por empresa (A3 — reemplaza el `Max()+1` del
/// viejo `AumentarNumAudit`). `idMaquilero` es el `Proveedor` con rol de maquila al que
/// se le audita la prenda (NO existe tabla Maquilero — fusión de terceros D12/R15); se
/// PROPONE desde las entregas reales de la orden y se puede ELEGIR. Doble responsable:
/// `elaboroPorId` (quien la dio de alta) + `auditorPorId` (quien la auditó) — referencias
/// de usuario SIN FK físico, mismo criterio que la Bitácora (ADR-0005). `tamanoMuestra`
/// se propone del plan AQL default según la cantidad de la orden (decisión (b), vinculante)
/// y solo se cambia a mano con permiso (`muestraManual`). `resultado` se persiste MANUAL
/// (decisión (a)). Cancelación = borrado SUAVE (la auditoría nunca se borra; A7). A9.
model Auditoria {
  id           Int        @id @default(autoincrement())
  /// Folio consecutivo POR EMPRESA (A3 — secuencia "auditoria"; viejo: `CC_Auditorias.NumAudit`).
  numAuditoria BigInt     @map("num_auditoria")
  /// Empresa dueña de la auditoría y de su numeración (A9).
  idEmpresa    Int        @map("id_empresa")
  empresa      Empresa    @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)
  /// Orden auditada (doc 09 §2 — `CC_Auditorias.IdOrdenes`). Restrict.
  idOrden      Int        @map("id_orden")
  orden        Orden      @relation(fields: [idOrden], references: [id], onDelete: Restrict)
  /// Maquilero auditado (Proveedor con rol maquila; D12/R15). Propuesto de las entregas
  /// reales de la orden. Nullable (puede no haberse asignado). Restrict.
  idMaquilero  Int?       @map("id_maquilero")
  maquilero    Proveedor? @relation(fields: [idMaquilero], references: [id], onDelete: Restrict)

  /// Fecha en que se ELABORÓ la auditoría (alta). `@db.Date`.
  fechaElaboracion DateTime @map("fecha_elaboracion") @db.Date
  /// Fecha en que se AUDITÓ físicamente la prenda. `@db.Date`. Es la fecha que se escribe
  /// como `fechaReal` del proceso de RC si la auditoría final aprobada lo auto-completa.
  fechaAuditoria   DateTime @map("fecha_auditoria") @db.Date

  /// Quién dio de alta la auditoría (usuario de sesión). Sin FK físico (ADR-0005).
  elaboroPorId String? @map("elaboro_por_id")
  /// Quién auditó (responsable de calidad). Sin FK físico (ADR-0005).
  auditorPorId String? @map("auditor_por_id")

  /// Tamaño de muestra inspeccionado. Se PROPONE del plan AQL default por la cantidad de la
  /// orden (decisión (b)); cambiarlo a mano exige permiso y enciende `muestraManual`.
  tamanoMuestra Int     @map("tamano_muestra")
  /// `true` si el `tamanoMuestra` se sobre-escribió a mano (decisión (b) — gate por permiso).
  muestraManual Boolean @default(false) @map("muestra_manual")

  /// Veredicto MANUAL del auditor (decisión (a)). `no_calificado` mientras no se captura.
  resultado       ResultadoAuditoria @default(no_calificado)
  /// Siempre `true` en v2: el resultado lo decide el humano (la sugerencia AQL NO es vinculante).
  /// Se conserva como bandera para el ETL del histórico y para KPIs de F7.
  resultadoManual Boolean            @default(true) @map("resultado_manual")
  /// Tipo de auditoría (en piso / final / no definida). Solo `final` + `aprobado` gatilla la RC.
  tipoAuditoria   TipoAuditoria      @default(no_definida) @map("tipo_auditoria")

  /// Observaciones del auditor (justifica el veredicto manual). Nullable.
  observaciones String? @db.Text

  /// Cancelación SUAVE (borrado lógico, A7): la auditoría nunca se borra ni se edita destructivo.
  /// La MODIFICACIÓN/cancelación es F6-E3; aquí solo el esquema. NULL = viva.
  cancelada         Boolean   @default(false)
  canceladaEn       DateTime? @map("cancelada_en")
  /// Usuario que canceló (sin FK físico, ADR-0005).
  canceladaPorId    String?   @map("cancelada_por_id")
  motivoCancelacion String?   @map("motivo_cancelacion") @db.Text

  /// Renglones defecto → nº de fallas (todos los favoritos se pre-cargan al alta). Cascade.
  defectos AuditoriaDefecto[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idEmpresa, numAuditoria])
  @@index([idEmpresa])
  @@index([idOrden])
  @@index([idMaquilero])
  @@map("auditorias")
}

/// Renglón defecto → nº de fallas de una auditoría (F6-E2 — ex `CC_AuditoriasDet`, doc 09 §2).
/// Al dar de alta una auditoría se PRE-CARGAN todos los defectos favoritos activos con
/// `numFallas = 0` (ex `InsertarFav`); el auditor captura cuántas fallas vio de cada uno. Un
/// defecto aparece UNA vez por auditoría (@@unique). El nivel AQL para la sugerencia se lee del
/// `DefectoCatalogo` (NO se snapshotea). Cascade desde la auditoría; Restrict hacia el defecto
/// (un defecto con auditorías históricas no se borra físico — se desactiva).
model AuditoriaDefecto {
  id          Int             @id @default(autoincrement())
  idAuditoria Int             @map("id_auditoria")
  auditoria   Auditoria       @relation(fields: [idAuditoria], references: [id], onDelete: Cascade)
  idDefecto   Int             @map("id_defecto")
  defecto     DefectoCatalogo @relation(fields: [idDefecto], references: [id], onDelete: Restrict)

  /// Número de prendas con este defecto en la muestra. Entero ≥ 0.
  numFallas Int @default(0) @map("num_fallas")

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idAuditoria, idDefecto])
  @@index([idDefecto])
  @@map("auditoria_defecto")
}

/// Catálogo de AUDITORES de calidad (rediseño R9 — proto `CAT_AUDITORES`). GLOBAL como los demás
/// catálogos (A9, sin idEmpresa). Hoy `Usuario.esAuditor` (bool) y `Auditoria.auditorPorId` (String
/// SIN FK, ADR-0005) identifican al auditor por su nombre; este catálogo le da entidad propia
/// (nombre, rol y nivel AQL de certificación). El conteo de auditorías (`numeroAuditorias`) NO se
/// persiste: se DERIVA best-effort del histórico contando las `Auditoria` cuyo `auditorPorId`
/// coincide con el `nombre` (String histórico). CRUD patrón catálogo con borrado SUAVE (`activo`);
/// `rol`/`nivelAql` se validan a listas cerradas en el dominio (A1). Auditoría A7.
model Auditor {
  id       Int     @id @default(autoincrement())
  /// Nombre del auditor (único global; unicidad insensible a mayúsculas en el dominio).
  nombre   String  @unique
  /// Rol del auditor: "Auditor" | "Sr. Auditor" (validado en el dominio).
  rol      String
  /// Nivel AQL de certificación: "1.0" | "1.5" | "2.5" | "4.0" (validado en el dominio).
  nivelAql String  @map("nivel_aql")
  activo   Boolean @default(true)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("auditores")
}

// ─────────────────────────────────────────────────────────────────────────────
// COSTOS (Módulo 6, F7-E1) — costo REAL por orden (doc 06-Costos-y-EDR §3; D1/D2).
// El PRE-COSTO por modelo NO es tabla: es cálculo de dominio sobre la receta
// (receta paraPreCosto × precios de catálogo + maquila — verificado: `PreCostos`
// no era tabla en el viejo). El EDR (F7-E2) referenciará `CostoOrden`. Auditoría
// A7 + Bitácora (módulo financiero). Valuación a costo ACTUAL (D1): sin CostoViejo.
// ─────────────────────────────────────────────────────────────────────────────

/// Base de prorrateo del costo unitario de la orden (D2): sobre qué cantidad se
/// divide el `costoTotal` para obtener el costo por prenda. `cortado` (DEFAULT,
/// confirmado por Daniel: tela ÷ prendas cortadas = `CantCorte` del viejo);
/// `recibido` = piezas recibidas de costura (prenda terminada, `generaEntradaPt`);
/// `vendido` = piezas entregadas a cliente. Las tres se DERIVAN por suma directa de
/// `EtapaMovimientoDet` (nunca un acumulador — D3/D4).
enum BaseProrrateo {
  cortado
  recibido
  vendido

  @@map("base_prorrateo")
}

/// Costo REAL por orden (F7-E1 — ex `CostoOrd`, doc 06-Costos-y-EDR §3). 1:1 con la
/// orden (`idOrden` @unique). Componentes en DOBLE juego (doc 06 §3):
///  • `*Calc` = TEÓRICOS, snapshot de la receta × precios vigentes al momento de
///    guardar (se recalculan en vivo para comparar, pero también se congelan aquí);
///  • `*Cost` = los GUARDADOS (el usuario confirma o AJUSTA los teóricos).
/// `costoTotal` se ARMA con los guardados: `telaCost + procesosCost + aviosCost +
/// otros` (doc 06 §3). La REGALÍA NO es componente del costo (D2, 2026-07-02): va
/// sobre la VENTA (lista de precios) — por eso NO hay `regaliasCalc/regaliasCost`.
/// `procesos` = maquila + estampado + otros procesos; `avios` = habilitación de
/// costura + empaque. `otros`/`descOtros` dan flexibilidad. Todo NULLABLE (un
/// componente sin capturar cuenta como 0 en el total — patrón ceronulo). Valuación
/// a costo ACTUAL (D1). Auditoría A7. Cascade hacia `Orden`; Restrict hacia `Empresa`.
model CostoOrden {
  id        Int     @id @default(autoincrement())
  idOrden   Int     @unique @map("id_orden")
  orden     Orden   @relation(fields: [idOrden], references: [id], onDelete: Cascade)
  /// Empresa dueña (A9). Se persiste para acotar las consultas/reportes por empresa activa.
  idEmpresa Int     @map("id_empresa")
  empresa   Empresa @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)

  /// Tela — teórico (receta paraCosto × precio × base) y GUARDADO (ex `TelaCost`).
  telaCalc     Decimal? @map("tela_calc") @db.Decimal(14, 2)
  telaCost     Decimal? @map("tela_cost") @db.Decimal(14, 2)
  /// Procesos: maquila + estampado + otros procesos — teórico y GUARDADO (ex `MaquilaCost`+`BordCost`).
  procesosCalc Decimal? @map("procesos_calc") @db.Decimal(14, 2)
  procesosCost Decimal? @map("procesos_cost") @db.Decimal(14, 2)
  /// Avíos: habilitación de costura + empaque — teórico y GUARDADO (ex `HabCost`).
  aviosCalc    Decimal? @map("avios_calc") @db.Decimal(14, 2)
  aviosCost    Decimal? @map("avios_cost") @db.Decimal(14, 2)

  /// REAL DE COMPRAS congelado al guardar (petición de DANIEL, 26-jul-2026): lo que el motor
  /// `dominio/costos/costo-real-compras.ts` calculó en ESE momento = compra directa (líneas de OC
  /// autorizada+ ligadas a la orden) + el consumo sin compra propia valuado a ÚLTIMO PRECIO DE
  /// COMPRA. Es el tercer origen del costo, junto al teórico (`*Calc`) y el guardado (`*Cost`):
  /// NO se suma a nada, solo deja constancia de CON QUÉ se costeó. NULL en las órdenes costeadas
  /// antes de esta columna (histórico intacto).
  telaReal  Decimal? @map("tela_real") @db.Decimal(14, 2)
  aviosReal Decimal? @map("avios_real") @db.Decimal(14, 2)
  /// Otros costos + su descripción (ex `CostoOrd.Otros`/`DescOtros`), para flexibilidad.
  otros     Decimal? @db.Decimal(14, 2)
  descOtros String?  @map("desc_otros")

  /// Costo TOTAL de la orden = Σ de los GUARDADOS (doc 06 §3). Lo ARMA el dominio al
  /// guardar (nunca se edita a mano ni suma los teóricos). NULLABLE hasta el primer guardado.
  costoTotal Decimal? @map("costo_total") @db.Decimal(14, 2)

  /// Base de prorrateo del costo unitario (D2). Default `cortado` (= `CantCorte`).
  baseProrrateo BaseProrrateo @default(cortado) @map("base_prorrateo")

  observaciones String? @db.Text

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idEmpresa])
  @@map("costo_orden")
}

// ─────────────────────────────────────────────────────────────────────────────
// Estado de Resultados (EDR) — F7-E2 (doc 06-Costos-y-EDR §4; DECISIONES.md D1/D2)
//
// El P&L mensual de la empresa, GENERADO automáticamente y valuado SIEMPRE a COSTO ACTUAL (D1):
// el costo NUNCA se congela en la línea; se recalcula desde `CostoOrden` al leer. A diferencia de
// otros módulos, el EDR es CONSOLIDADO (no se acota a la empresa activa): el encabezado `Edr` es
// GLOBAL por mes y los cortes por empresa/cliente se DERIVAN de las líneas (D2 #6). Solo entran
// empresas `paraEdr=true`; se excluyen órdenes `noCostear=true` (lo aplica el dominio).
// ─────────────────────────────────────────────────────────────────────────────

/// Origen de una línea del EDR (F7-E2). `automatica` = propuesta por el generador desde las
/// entregas a cliente del mes (se RECONCILIA en cada re-generación). `ajustada` = una automática
/// que el usuario editó (precio/cantidad); ya NO se toca al re-generar. `manual` = línea capturada
/// a mano (sin orden); tampoco se toca al re-generar.
enum EdrOrigenLinea {
  automatica
  ajustada
  manual

  @@map("edr_origen_linea")
}

/// Encabezado GLOBAL del Estado de Resultados de un mes (F7-E2 — ex `EdoResult`, doc 06 §4). Uno
/// por (año, mes): NO lleva `idEmpresa` (es consolidado; el corte por empresa se deriva de las
/// líneas, D2 #6). Los gastos/intereses/bonificaciones/otros son GLOBALES del mes (D2 #6). Ventas y
/// Costo se DERIVAN de las líneas al leer (nunca se persisten aquí).
model Edr {
  id   Int @id @default(autoincrement())
  /// Año del estado de resultados (viejo: año de `EdoResult.Fecha`).
  anio Int
  /// Mes 1-12 del estado de resultados (viejo: mes de `EdoResult.Fecha`).
  mes  Int

  /// Gastos del mes (viejo: `EdoResult.Gastos`). Globales (D2 #6).
  gastos         Decimal @default(0) @db.Decimal(14, 2)
  /// Intereses del mes (viejo: `EdoResult.Intereses`).
  intereses      Decimal @default(0) @db.Decimal(14, 2)
  /// Bonificaciones del mes (viejo: `EdoResult.Bonificaciones`). SUMAN al resultado (doc 06 §4).
  bonificaciones Decimal @default(0) @db.Decimal(14, 2)
  /// Otros (± al resultado) + su descripción (viejo: `EdoResult.Otros`/`DescOtros`).
  otros          Decimal @default(0) @db.Decimal(14, 2)
  descOtros      String? @map("desc_otros")
  observaciones  String? @db.Text

  /// Líneas de venta del mes (una por orden vendida + manuales). Cascade: son del encabezado.
  lineas EdrLinea[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([anio, mes])
  @@map("edr")
}

/// Renglón del EDR (F7-E2 — ex `EdoResultDet`, doc 06 §4): una venta del mes, por orden/modelo. El
/// PRECIO manda de lo FACTURADO (D2 #5); mientras Finanzas/CFDI no exista, se PRE-PROPONE desde las
/// entregas a cliente de F3 y el usuario ajusta a lo realmente facturado. El COSTO NO se guarda aquí
/// (D1): se recalcula desde `CostoOrden` al leer. `@@unique([idEdr, idOrden])` ancla la idempotencia
/// del generador (los NULL de las líneas manuales conviven, Postgres permite múltiples NULL).
model EdrLinea {
  id    Int @id @default(autoincrement())
  idEdr Int @map("id_edr")
  edr   Edr @relation(fields: [idEdr], references: [id], onDelete: Cascade)

  /// Orden vendida (viejo: liga vía `EdoResultDet.IdCostoOrd`). NULL en líneas manuales. Restrict.
  idOrden Int?   @map("id_orden")
  orden   Orden? @relation(fields: [idOrden], references: [id], onDelete: Restrict)

  /// Empresa de la línea (para el corte por empresa; solo `paraEdr=true`, lo valida el dominio).
  idEmpresa   Int      @map("id_empresa")
  empresa     Empresa  @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)
  /// Cliente de la línea (para el corte por cliente). NULL solo en históricos sin cliente. Restrict.
  idCliente   Int?     @map("id_cliente")
  cliente     Cliente? @relation(fields: [idCliente], references: [id], onDelete: Restrict)
  /// Modelo vendido (viejo: `EdoResultDet.ModeloC`). NULL en manuales sin modelo. Restrict.
  idModelo    Int?     @map("id_modelo")
  modelo      Modelo?  @relation(fields: [idModelo], references: [id], onDelete: Restrict)
  /// Descripción libre para líneas manuales (viejo: no existía). NULL en automáticas.
  descripcion String?

  /// Cantidad vendida (viejo: `EdoResultDet.CantVendida`). En automáticas = Σ entregas del mes.
  cantVendida Int     @map("cant_vendida")
  /// Precio de venta FACTURADO por prenda (viejo: `EdoResultDet.PrecioVenta`). Editable (D2 #5).
  precioVenta Decimal @map("precio_venta") @db.Decimal(14, 2)

  /// Costo histórico congelado (viejo: `EdoResultDet.CostoViejo`). SOLO-INFORMATIVO: el EDR valúa a
  /// costo ACTUAL (D1); esta columna la llena el ETL de E6 para conservar el dato histórico. NUNCA se
  /// usa para el cálculo del resultado; nace NULL en toda línea generada por v2.
  costoHistorico Decimal? @map("costo_historico") @db.Decimal(14, 2)

  /// Origen de la línea (automática/ajustada/manual) — gobierna la reconciliación (ver enum).
  origen EdrOrigenLinea @default(automatica)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idEdr, idOrden])
  @@index([idEdr])
  @@index([idEmpresa])
  @@index([idCliente])
  @@index([idModelo])
  @@index([idOrden])
  @@map("edr_linea")
}

// ─────────────────────────────────────────────────────────────────────────────
// INDICADORES · F7-E3 — Motor de KPIs en segundo plano (plan §11; doc 08 §4.4 /
// doc 09 §5.3 / MEJORAS 03-WIP / D11). Los TABLEROS directivos se calculan sobre
// VISTAS MATERIALIZADAS (SQL crudo en la migración `20260703140000_f7_e3_kpis`,
// NO son modelos Prisma: se consultan por `$queryRaw`) que refresca un job de
// pg-boss (`comun/jobs/refrescar-kpis.ts`). La CAPTURA nunca espera un recálculo:
// las pantallas leen la vista ya materializada y muestran "datos al: <fecha>".
// Esta tabla es el ÚNICO modelo Prisma del módulo: guarda ese timestamp.
// ─────────────────────────────────────────────────────────────────────────────

/// Sello de la última actualización de las vistas materializadas de KPIs (F7-E3). Fila
/// SINGLETON (`clave = "global"`, @unique): la estampa `refrescarKpis` tras refrescar las
/// vistas; el API la devuelve como "datos al: <fecha/hora>" para que el usuario sepa qué
/// tan frescos son los números. No lleva `idEmpresa`: el refresco es global (las vistas ya
/// llevan la empresa por fila y el dominio filtra por la empresa activa, A9).
model KpiRefresco {
  id           Int      @id @default(autoincrement())
  /// Clave del singleton (siempre "global"): ancla el upsert idempotente del job.
  clave        String   @unique @default("global")
  /// Momento en que terminó el último refresco de las vistas materializadas.
  refrescadoEn DateTime @map("refrescado_en")

  creadoEn     DateTime @default(now()) @map("creado_en")
  modificadoEn DateTime @updatedAt @map("modificado_en")

  @@map("kpi_refresco")
}

// ─────────────────────────────────────────────────────────────────────────────
// Productividad unificada IP / Almacén (Módulo Indicadores, F7-E4 — doc 05 §A.1/§B.1;
// MEJORAS 05 §1: "motor de KPIs/productividad configurable por área"). Se DESPIVOTA el
// patrón repetido del viejo (IP_* y Alm_Prd_*) a un solo motor, distinguido por `area`
// (D4/A6: filas configurables en vez de tablas paralelas). Auditoría A7; A9 por empresa.
// ─────────────────────────────────────────────────────────────────────────────

/// Área a la que pertenece un dato de productividad (F7-E4). Unifica los dos módulos
/// gemelos del viejo (Ingeniería del Producto y Almacén) en un solo motor.
enum AreaProductividad {
  ip
  almacen

  @@map("area_productividad")
}

/// Persona del área para el índice de productividad (F7-E4; ← `IP_Personal`, doc 05 §A.1).
/// Es un catálogo GLOBAL (sin idEmpresa — ADR-0007): las personas son las mismas para todas
/// las empresas del grupo. El almacén casi no captura personas individuales (usa la cuadrilla
/// `personas` del registro), por eso `horasBase` es opcional y solo aplica al índice de IP.
model PersonalArea {
  id        Int               @id @default(autoincrement())
  /// Nombre de la persona (viejo: `IP_Personal.NombreIP`). Único por área.
  nombre    String
  /// Área de la persona (ip/almacen). Casi siempre `ip`.
  area      AreaProductividad
  /// Jornada base (horas/día) de la persona para el índice de IP (viejo: `HorasBase`). Solo IP.
  horasBase Decimal?          @map("horas_base") @db.Decimal(5, 2)
  /// Puesto (viejo: `IP_Personal.Puesto`).
  puesto    String?
  /// Borrado suave (plan §4): una persona que se va se desactiva, jamás se borra.
  activo    Boolean           @default(true)

  /// Registros de productividad capturados a nombre de esta persona (F7-E4, Restrict).
  registros RegistroProductividad[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([area, nombre])
  @@map("personal_area")
}

/// Catálogo de actividades productivas por área (F7-E4; ← `IP_Actividades` + `Alm_Prd_Act`,
/// doc 05 §A.1/§B.1). Una actividad pertenece a UNA área; los estándares que no aplican al
/// área quedan NULL (A6: campos configurables, no columnas fijas por cada módulo del viejo):
/// IP usa `porcentajeD`; almacén usa `pzPersDia` (+ `porcenPzas`). Catálogo GLOBAL (ADR-0007).
model ActividadProductividad {
  id          Int               @id @default(autoincrement())
  /// Nombre de la actividad (viejo: `IP_Actividades.Actividad` / `Alm_Prd_Act.ActividadAlm`). Único por área.
  nombre      String
  /// Área de la actividad (ip/almacen).
  area        AreaProductividad
  /// Peso/estándar de la actividad de IP (viejo: `IP_Actividades.PorcentajeD`). Solo IP.
  porcentajeD Decimal?          @map("porcentaje_d") @db.Decimal(10, 4)
  /// Estándar piezas/persona/día de la actividad de almacén (viejo: `Alm_Prd_Act.Pz_Pers_Dia`). Solo almacén.
  pzPersDia   Decimal?          @map("pz_pers_dia") @db.Decimal(10, 4)
  /// Peso de piezas de la actividad de almacén (viejo: `Alm_Prd_Act.PorcenPzas`). Solo almacén.
  porcenPzas  Decimal?          @map("porcen_pzas") @db.Decimal(10, 4)
  /// Borrado suave (plan §4).
  activo      Boolean           @default(true)

  /// Registros de productividad de esta actividad (F7-E4, Restrict).
  registros RegistroProductividad[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([area, nombre])
  @@map("actividad_productividad")
}

/// Registro diario de productividad (F7-E4; ← `IP_Productiv` + `Alm_Prd`/`Alm_Prd_Det`, doc
/// 05 §A.1/§B.1). Un registro es de UNA área (la de su actividad). Para IP lleva `idPersona`
/// (y `personas` = 1); para almacén lleva la cuadrilla `personas` (y opcionalmente `idCliente`).
/// Cancelación SUAVE (auditada, A7); NUNCA se edita/borra: se cancela y se re-captura. A9.
model RegistroProductividad {
  id        Int               @id @default(autoincrement())
  idEmpresa Int               @map("id_empresa")
  empresa   Empresa           @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)
  /// Fecha del trabajo (viejo: `IP_Productiv.Fecha` / `Alm_Prd.FechaAlm`). Solo día.
  fecha     DateTime          @db.Date
  /// Área del registro (redundante con la de la actividad; se sella para filtrar el tablero).
  area      AreaProductividad

  idActividad Int                    @map("id_actividad")
  actividad   ActividadProductividad @relation(fields: [idActividad], references: [id], onDelete: Restrict)

  /// Persona (solo IP; viejo: `IP_Productiv.IdIp_Personal`). NULL en almacén (cuadrilla).
  idPersona Int?          @map("id_persona")
  persona   PersonalArea? @relation(fields: [idPersona], references: [id], onDelete: Restrict)

  /// Cantidad producida (viejo: `IP_Productiv.CantidadAct` / `Alm_Prd_Det.Piezas`).
  cantidad        Decimal @db.Decimal(12, 2)
  /// Horas trabajadas (viejo: `HorasTrabajadas`). Debe ser > 0 (división en el índice).
  horasTrabajadas Decimal @map("horas_trabajadas") @db.Decimal(6, 2)
  /// Cuadrilla que trabajó (viejo: `Alm_Prd.Personas`). Almacén > 1; IP = 1. Debe ser > 0.
  personas        Int     @default(1)

  /// Cliente al que se le procesó (solo almacén, opcional; viejo: `Alm_Prd_Det.IdClientes`). Restrict.
  idCliente Int?     @map("id_cliente")
  cliente   Cliente? @relation(fields: [idCliente], references: [id], onDelete: Restrict)

  /// Cancelación suave con motivo (A7): un registro erróneo se cancela, no se borra.
  cancelado         Boolean   @default(false)
  canceladoEn       DateTime? @map("cancelado_en")
  canceladoPorId    String?   @map("cancelado_por_id")
  motivoCancelacion String?   @map("motivo_cancelacion")

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idEmpresa, area, fecha])
  @@index([idActividad])
  @@index([idPersona])
  @@index([idCliente])
  @@map("registro_productividad")
}

// ─────────────────────────────────────────────────────────────────────────────
// Fichas confiables (Módulo Indicadores, F7-E4 — doc 05 §A.2; ex `IP_InfConf` +
// `Ind_IP_InfConfiable`). Checklist de confiabilidad de la ficha técnica POR ORDEN,
// modelado por FILAS (reactivo × orden) en vez de las 8 columnas fijas del viejo (A6).
// ─────────────────────────────────────────────────────────────────────────────

/// Reactivo (aspecto a verificar) del checklist de confiabilidad de la ficha (F7-E4, A6 —
/// configurable, ← columnas fijas `InfGeneral..MedidasPrendas` de `IP_InfConf`). Catálogo
/// GLOBAL (ADR-0007). El seed siembra los 8 fijos del viejo (doc 05 §A.2); se pueden agregar
/// más sin migración. Hook a futuro: si se construye la ficha estructurada (R5, módulo 12),
/// los reactivos podrán derivarse de sus secciones en vez de capturarse a mano.
model ChecklistFichaDef {
  id       Int     @id @default(autoincrement())
  /// Clave estable del reactivo (viejo nombre de columna, p. ej. "InfGeneral"). Única global.
  clave    String  @unique
  /// Etiqueta para UI (español), p. ej. "Información de tela".
  etiqueta String
  /// Orden de despliegue en el checklist.
  orden    Int     @default(0)
  /// Borrado suave (plan §4): un reactivo que se retira se desactiva, no se borra.
  activo   Boolean @default(true)

  /// Verificaciones de este reactivo en las órdenes (F7-E4, Restrict).
  verificaciones FichaVerificacion[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("checklist_ficha_def")
}

/// Verificación de UN reactivo del checklist en UNA orden (F7-E4; doc 05 §A.2). Modelado por
/// FILAS (una fila reactivo × orden) — el anti-patrón del viejo eran 8 columnas booleanas
/// fijas. `revisorId`/`fecha` = quién marcó y cuándo (sin FK física a usuarios, ADR-0005). El
/// indicador "% de fichas confiables" (ex `Ind_IP_InfConfiable`) = Σ hecho ÷ Σ reactivos. A9.
model FichaVerificacion {
  id        Int     @id @default(autoincrement())
  idEmpresa Int     @map("id_empresa")
  empresa   Empresa @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)

  idOrden Int   @map("id_orden")
  orden   Orden @relation(fields: [idOrden], references: [id], onDelete: Cascade)

  idReactivo Int               @map("id_reactivo")
  reactivo   ChecklistFichaDef @relation(fields: [idReactivo], references: [id], onDelete: Restrict)

  /// ¿El aspecto está OK en la ficha? (viejo: cada columna booleana).
  hecho     Boolean   @default(false)
  /// Usuario que verificó (sin FK física, ADR-0005; viejo: `IP_InfConf.IdUsuarios`).
  revisorId String?   @map("revisor_id")
  /// Fecha de la revisión (viejo: `IP_InfConf.FechaRevision`).
  fecha     DateTime? @db.Date

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idOrden, idReactivo])
  @@index([idEmpresa])
  @@index([idReactivo])
  @@map("ficha_verificacion")
}

// ─────────────────────────────────────────────────────────────────────────────
// Muestrarios pendientes (Módulo Indicadores, F7-E4 — doc 05 §A.3; ← `IP_MuesPend`).
// Seguimiento de boards y muestras solicitados: solicitud → seguimiento → entrega. A9.
// ─────────────────────────────────────────────────────────────────────────────

/// Muestrario pendiente (F7-E4; ← `IP_MuesPend`, doc 05 §A.3). KPI de cumplimiento =
/// `fechaEntregado <= fechaRequerida`. Cancelación suave con motivo (A7). A9 por empresa.
model Muestrario {
  id        Int     @id @default(autoincrement())
  idEmpresa Int     @map("id_empresa")
  empresa   Empresa @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)

  idCliente Int     @map("id_cliente")
  cliente   Cliente @relation(fields: [idCliente], references: [id], onDelete: Restrict)

  /// Categoría del muestrario (viejo: `IP_MuesPend.Categoria`).
  categoria   String?
  /// Temporada (viejo: `IP_MuesPend.Temporada`). FK nullable al catálogo (Restrict).
  idTemporada Int?       @map("id_temporada")
  temporada   Temporada? @relation(fields: [idTemporada], references: [id], onDelete: Restrict)

  /// Cuántos boards se piden (viejo: `CantBoards`).
  cantBoards   Int @default(0) @map("cant_boards")
  /// Cuántas muestras se piden (viejo: `CantMuestras`).
  cantMuestras Int @default(0) @map("cant_muestras")

  /// Fecha de solicitud (viejo: `FechaSolicitado`).
  fechaSolicitado DateTime  @map("fecha_solicitado") @db.Date
  /// Fecha requerida/compromiso (viejo: `FechaRequerida`).
  fechaRequerida  DateTime  @map("fecha_requerida") @db.Date
  /// Fecha en que se entregó (viejo: `FechaEntregado`). NULL = pendiente.
  fechaEntregado  DateTime? @map("fecha_entregado") @db.Date

  /// Boards que quedaron listos (viejo: `BoardsOK`).
  boardsOK   Int @default(0) @map("boards_ok")
  /// Muestras que quedaron listas (viejo: `MuestrasOK`).
  muestrasOK Int @default(0) @map("muestras_ok")

  /// Usuario solicitante (sin FK física, ADR-0005; viejo: `IdUsuarioSolicitante`).
  solicitanteId String? @map("solicitante_id")

  /// Cancelación suave con motivo (viejo: `Cancelado`; A7).
  cancelado         Boolean   @default(false)
  canceladoEn       DateTime? @map("cancelado_en")
  canceladoPorId    String?   @map("cancelado_por_id")
  motivoCancelacion String?   @map("motivo_cancelacion")

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idEmpresa, fechaRequerida])
  @@index([idCliente])
  @@index([idTemporada])
  @@map("muestrarios")
}

/// Estado del ciclo de vida de un inventario cíclico (F7-E5; doc 05-Indicadores; ← forms `Alm_IC_*`).
/// Máquina de estados: `abierto` (recién dado de alta, con el teórico ya CONGELADO — D6) → `contado`
/// (todos sus renglones tienen conteo físico) → `cerrado` (el ajuste ya se aplicó al kardex, D3: no se
/// re-genera). `cancelado` = abortado antes de cerrar (cancelación suave con motivo, A7).
enum EstadoInventarioCiclico {
  abierto
  contado
  cerrado
  cancelado

  @@map("estado_inventario_ciclico")
}

/// INVENTARIO CÍCLICO — encabezado (F7-E5; doc 05-Indicadores; ← forms `Alm_IC_Alta`/`_Cont`/
/// `_Consulta`). Cuenta el físico contra el KARDEX de v2 (D3/D6): el ALTA CONGELA el teórico por
/// artículo (`InventarioCiclicoDet.cantTeorica`) para que no cambie mientras se cuenta; el conteo es
/// CIEGO (el capturista NO ve el teórico); el ajuste se aplica SOLO como MOVIMIENTO de kardex (D3),
/// jamás editando un saldo. A9 por empresa; folio por secuencia (A3); auditoría A7 + cancelación suave.
model InventarioCiclico {
  id        Int     @id @default(autoincrement())
  /// Folio consecutivo POR EMPRESA (A3 — secuencia "inventario-ciclico"). Referencia humana de la hoja.
  folio     BigInt
  idEmpresa Int     @map("id_empresa")
  empresa   Empresa @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)

  /// Almacén que se cuenta (D4: existencia por …×almacén). Restrict.
  idAlmacen Int     @map("id_almacen")
  almacen   Almacen @relation(fields: [idAlmacen], references: [id], onDelete: Restrict)

  /// Fecha del alta (el instante en que se congeló el teórico).
  fecha  DateTime                @db.Date
  estado EstadoInventarioCiclico @default(abierto)

  observaciones String? @db.Text

  /// Renglones (artículos) del conteo, a la granularidad REAL del kardex (…×orden). Cascade.
  detalles InventarioCiclicoDet[]

  /// Cancelación suave con motivo (A7): abortar el conteo sin generar ajuste.
  canceladoEn       DateTime? @map("cancelado_en")
  canceladoPorId    String?   @map("cancelado_por_id")
  motivoCancelacion String?   @map("motivo_cancelacion")

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idEmpresa, folio])
  @@index([idEmpresa, estado])
  @@index([idAlmacen])
  @@map("inventarios_ciclicos")
}

/// INVENTARIO CÍCLICO — detalle (F7-E5). Un renglón por ARTÍCULO de kardex a su granularidad REAL:
/// modelo×color×talla×ORDEN×almacén (el almacén sale del encabezado; F6-E2 "PT por orden", ADR-0014).
/// `idOrden` NULLABLE (bucket "sin orden" = movimientos manuales/traspasos/histórico). Se llavea así a
/// PROPÓSITO (decisión del lead F7-E5): el teórico se congela por artículo con
/// `existenciaPtBloqueada(...,idOrden)` y el ajuste es un movimiento de kardex 1:1 sobre la MISMA llave
/// — no hay que repartir el delta entre órdenes y la validación no-negativo funciona por artículo.
/// Cascade hacia el encabezado; Restrict hacia los catálogos.
model InventarioCiclicoDet {
  id                  Int               @id @default(autoincrement())
  idInventarioCiclico Int               @map("id_inventario_ciclico")
  inventario          InventarioCiclico @relation(fields: [idInventarioCiclico], references: [id], onDelete: Cascade)

  idModelo Int    @map("id_modelo")
  modelo   Modelo @relation(fields: [idModelo], references: [id], onDelete: Restrict)
  idColor  Int    @map("id_color")
  color    Color  @relation(fields: [idColor], references: [id], onDelete: Restrict)
  idTalla  Int    @map("id_talla")
  talla    Talla  @relation(fields: [idTalla], references: [id], onDelete: Restrict)
  /// Orden dueña de estas prendas (F6-E2 "PT por orden"); NULL = bucket "sin orden". Restrict.
  idOrden  Int?   @map("id_orden")
  orden    Orden? @relation(fields: [idOrden], references: [id], onDelete: Restrict)

  /// Existencia TEÓRICA CONGELADA al dar de alta (D6): Σ de movimientos del artículo en ese instante.
  cantTeorica Int  @map("cant_teorica")
  /// Cantidad contada FÍSICAMENTE (conteo ciego). NULL hasta capturar el conteo del renglón.
  cantReal    Int? @map("cant_real")

  contadoEn    DateTime? @map("contado_en")
  contadoPorId String?   @map("contado_por_id")

  /// Movimiento de kardex del AJUSTE que reconcilió este renglón (D3): la existencia SOLO cambia por
  /// movimiento, nunca editando un saldo. NULL hasta generar el ajuste. Restrict (traza).
  idMovimientoAjuste Int?        @map("id_movimiento_ajuste")
  movimientoAjuste   Movimiento? @relation(fields: [idMovimientoAjuste], references: [id], onDelete: Restrict)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  /// Un artículo (…×orden) NO se repite dentro del mismo conteo (el alta lo enumera 1 vez desde la
  /// vista agregada). NOTA: Postgres trata los NULL de `id_orden` como distintos, así que la unicidad
  /// del bucket "sin orden" la garantiza el dominio (enumera una sola fila por artículo).
  @@unique([idInventarioCiclico, idModelo, idColor, idTalla, idOrden])
  @@index([idInventarioCiclico])
  @@index([idMovimientoAjuste])
  @@map("inventario_ciclico_det")
}

// ─────────────────────────────────────────────────────────────────────────────
// DESARROLLO, COTIZACIÓN y LISTAS DE PRECIOS (Módulo 15, F8 — decisión D13,
// requisitos R16–R20; propuesta PROPUESTA-Desarrollo-Cotizacion-y-Listas-de-Precios.md).
// TODA la fase nace en UNA migración aditiva (patrón F3-E1): las tablas de E2–E6 se crean
// AQUÍ aunque su dominio/UI llegue en etapas posteriores. GLOBAL vs por-empresa según el caso
// (catálogos globales — ADR-0007; Proyecto/ListaPrecios por empresa con folio A3/A9). Auditoría
// uniforme (A7) y borrado suave donde aplica. Las REGLAS (cascada de resolución de precios,
// congelado inmutable, snapshot de factores, estados derivados) viven en el DOMINIO, no en la BD
// (E1a: el helper de resolución de precios; E3/E4/E5: precosto/lista/negociación).
//
// AMARRES al proveedor del avío (ModeloAvio.idAvioProveedor, PrecostoLinea.idAvioProveedor): son
// ESCALARES sin FK, con el MISMO nombre que F4 (`OrdenCompraLinea.idAvioProveedor`) — el par
// (idAvio, idAvioProveedor) reconstruye el `AvioProveedor` sin tocar ese modelo (PK compuesta, R1).
// El amarre de TELA sí es FK real (TelaProveedor tiene surrogate `id`).
// ─────────────────────────────────────────────────────────────────────────────

/// Concepto de costo del precosto (F8-E1, R19). Catálogo GLOBAL que gobierna por DATO los renglones
/// del precosto (como `TipoProceso` gobierna el kardex): tela/avíos/maquila FIJOS + estampado/
/// bordado/otros AMPLIABLES. `fijo=true` (tela/avíos/maquila) ⇒ no desactivable (lo exige el dominio
/// de admin). Patrón catálogo-con-bandera de F3-E1. La REGALÍA no es concepto del costo (D2: va sobre
/// la venta — factor de la lista, E4).
model ConceptoCosto {
  id     Int     @id @default(autoincrement())
  /// Clave estable kebab-case (ej. "tela", "estampado"). Única global.
  codigo String  @unique
  nombre String
  /// Orden de despliegue (lo gestiona el dominio; no único en BD).
  orden  Int     @default(0)
  /// Concepto FIJO (tela/avíos/maquila): no se puede desactivar (lo exige el dominio de admin).
  fijo   Boolean @default(false)
  activo Boolean @default(true)

  /// Renglones de precosto de este concepto (F8-E3). Restrict.
  precostoLineas PrecostoLinea[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("concepto_costo")
}

/// Estado de una lista de precios (F8-E1, R20). Catálogo GLOBAL configurable (los estados de lista
/// son ampliables, decisión de Daniel). `esCierre=true` (cerrada/ya-pedida) bloquea nuevas rondas de
/// negociación (regla de dominio, E5). Patrón catálogo-con-bandera.
model EstadoLista {
  id       Int     @id @default(autoincrement())
  /// Clave estable kebab-case (ej. "abierta", "en-negociacion"). Única global.
  codigo   String  @unique
  nombre   String
  orden    Int     @default(0)
  /// ¿Es un estado de CIERRE? (cerrada/ya-pedida) — bloquea nuevas rondas/ediciones de renglón (E5).
  esCierre Boolean @default(false) @map("es_cierre")
  activo   Boolean @default(true)

  /// Listas de precios en este estado (F8-E4). Restrict.
  listas ListaPrecios[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@map("estado_lista")
}

/// Departamento de un cliente (F8-E1, D13 — ej. C&A/NIÑOS). Catálogo chico capturado a mano; los
/// proyectos y listas viven por Cliente+Departamento. `nombre` único DENTRO del cliente. Cascade
/// hacia Cliente (config del cliente, como `ClienteCampo`); Restrict hacia él desde proyectos/listas.
model ClienteDepartamento {
  id        Int     @id @default(autoincrement())
  idCliente Int     @map("id_cliente")
  cliente   Cliente @relation(fields: [idCliente], references: [id], onDelete: Cascade)
  nombre    String
  activo    Boolean @default(true)

  proyectos     Proyecto[]
  factores      ClienteFactores[]
  listasPrecios ListaPrecios[]
  /// Cotizaciones emitidas para este departamento (V1-E7c). Restrict.
  cotizaciones  Cotizacion[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idCliente, nombre])
  @@index([idCliente])
  @@map("cliente_departamento")
}

/// Precio de una TELA por PROVEEDOR (F8-E1, D13/R17 — el hueco grande: hoy solo hay
/// `Tela.precioSugerido` genérico y `TelaColor.precio` sin proveedor). ESPEJO de `AvioProveedor`
/// (R1), que NO se toca. Lleva surrogate `id` (lo referencian `TelaProveedorColor`, el amarre del
/// BOM `ModeloTela.idTelaProveedor` y el precosto). `precio` NULLABLE como en AvioProveedor (los que
/// manejan precio por color pueden dejarlo nulo). `manejaPrecioPorColor` = ciertos proveedores
/// cotizan distinto por color → el precio fino vive en `TelaProveedorColor`. Cascade hacia Tela
/// (config de la tela, permite reescribir el set en la tx A2); Restrict hacia Proveedor.
model TelaProveedor {
  id                   Int       @id @default(autoincrement())
  idTela               Int       @map("id_tela")
  tela                 Tela      @relation(fields: [idTela], references: [id], onDelete: Cascade)
  idProveedor          Int       @map("id_proveedor")
  proveedor            Proveedor @relation(fields: [idProveedor], references: [id], onDelete: Restrict)
  /// Precio base al que este proveedor surte la tela (por unidad de compra). Nullable.
  precio               Decimal?  @db.Decimal(12, 2)
  /// ¿Este proveedor cotiza distinto por COLOR? Entonces el precio fino vive en TelaProveedorColor.
  manejaPrecioPorColor Boolean   @default(false) @map("maneja_precio_por_color")
  /// Condiciones comerciales (texto libre; ej. "USD, LAB Manzanillo" — decisión (d): sin motor FX).
  condiciones          String?
  activo               Boolean   @default(true)

  colores        TelaProveedorColor[]
  /// Renglones del BOM AMARRADOS a este proveedor–tela (F8-E1, R17). SetNull al quitar el renglón.
  modelosTela    ModeloTela[]
  /// Renglones de la RECETA DE LA ORDEN amarrados a este proveedor–tela (V1-E3d). SetNull.
  ordenesTela    OrdenTela[]
  /// Renglones de precosto que salieron de este amarre (F8-E3, traza). SetNull.
  precostoLineas PrecostoLinea[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idTela, idProveedor])
  @@index([idProveedor])
  @@map("tela_proveedor")
}

/// Precio de una TELA de un PROVEEDOR por COLOR (F8-E1, D13) — solo para proveedores con
/// `TelaProveedor.manejaPrecioPorColor`. PK compuesta (renglón proveedor, color). Cascade hacia el
/// renglón proveedor (reescribir el grid en la tx); Restrict hacia Color (en uso → se desactiva).
model TelaProveedorColor {
  idTelaProveedor Int           @map("id_tela_proveedor")
  telaProveedor   TelaProveedor @relation(fields: [idTelaProveedor], references: [id], onDelete: Cascade)
  idColor         Int           @map("id_color")
  color           Color         @relation(fields: [idColor], references: [id], onDelete: Restrict)
  precio          Decimal?      @db.Decimal(12, 2)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@id([idTelaProveedor, idColor])
  @@index([idColor])
  @@map("tela_proveedor_color")
}

/// Medida (consumo) por TALLA de un avío del BOM (F8-E1, R18) — cierres, elástico… Solo para
/// `ModeloAvio.consumoPorTalla=true`. PK compuesta (modelo, avío, talla); FK COMPUESTA a `ModeloAvio`
/// (su PK es [idModelo, idAvio]). Cascade hacia ModeloAvio (reescribir en la tx); Restrict hacia
/// Talla. El precosto (E3) usa el PROMEDIO SIMPLE de estas medidas (decisión (g)); el MRP (E6) compra
/// por medida×curva.
model ModeloAvioTalla {
  idModelo     Int         @map("id_modelo")
  idAvio       Int         @map("id_avio")
  idTalla      Int         @map("id_talla")
  talla        Talla       @relation(fields: [idTalla], references: [id], onDelete: Restrict)
  /// ⭐ CANTIDAD que se consume de este avío en esta talla, en `Avio.unidad` (R18) — 0.75 m de
  /// elástico en CH, 0.80 en M. Se MULTIPLICA por las piezas y por el precio.
  /// ⚠️ NO es la medida/especificación del avío: eso es `idAvioMedida` (el cierre de 53 cm). La
  /// vieja glosa decía "Medida (consumo)" y ahí nació la confusión que V1-E3g vino a deshacer
  /// (§Post-F9.66): un campo captura CUÁNTO GASTAS, el otro QUÉ PIDES.
  consumo      Decimal     @db.Decimal(12, 4)
  /// AMARRE medida×talla (rediseño R5, B11): qué `AvioMedida` (tamaño) usa esta talla, para que la
  /// compra/MRP desglose por medida×talla con el precio real de la medida. NULLABLE → sin amarre: el
  /// MRP cae a su comportamiento actual (no rompe F4/R6; el precosto ya usa el promedio). SetNull.
  idAvioMedida Int?        @map("id_avio_medida")
  avioMedida   AvioMedida? @relation(fields: [idAvioMedida], references: [id], onDelete: SetNull)

  modeloAvio ModeloAvio @relation(fields: [idModelo, idAvio], references: [idModelo, idAvio], onDelete: Cascade)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@id([idModelo, idAvio, idTalla])
  @@index([idTalla])
  @@index([idModelo, idAvio])
  @@index([idAvioMedida])
  @@map("modelo_avio_talla")
}

/// Proyecto de desarrollo (F8-E2, R16) = 1 cliente + 1 departamento, con nombre/tema (varios por
/// departamento/temporada). Agrupa desarrollos. Folio consecutivo POR EMPRESA (A3/A9, secuencia
/// "proyecto"). El dominio (E2) valida que el departamento PERTENEZCA al cliente (A1). Archivado =
/// borrado suave (el archivo del departamento es parte del valor).
model Proyecto {
  id                    Int                 @id @default(autoincrement())
  folio                 BigInt
  idEmpresa             Int                 @map("id_empresa")
  empresa               Empresa             @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)
  idCliente             Int                 @map("id_cliente")
  cliente               Cliente             @relation(fields: [idCliente], references: [id], onDelete: Restrict)
  idClienteDepartamento Int                 @map("id_cliente_departamento")
  clienteDepartamento   ClienteDepartamento @relation(fields: [idClienteDepartamento], references: [id], onDelete: Restrict)
  /// Nombre/tema del proyecto (joggers, Disney, básicos…).
  nombre                String
  idTemporada           Int?                @map("id_temporada")
  temporada             Temporada?          @relation(fields: [idTemporada], references: [id], onDelete: Restrict)
  notas                 String?             @db.Text
  archivado             Boolean             @default(false)

  desarrollos Desarrollo[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idEmpresa, folio])
  @@index([idCliente])
  @@index([idClienteDepartamento])
  @@index([idTemporada])
  @@map("proyectos")
}

/// Desarrollo (F8-E2, R16): un modelo dentro de un proyecto, con DOS números (el nuestro =
/// `Modelo.codigo`; el del cliente = `numeroCliente`). El ESTADO es DERIVADO en el dominio (E2): en
/// desarrollo → cotizado (precosto congelado) → en lista → ligado a producción; `apagado` (borrado
/// suave con motivo, reversible) lo corta. `@@unique([idProyecto, idModelo])`. Cascade hacia
/// Proyecto; Restrict hacia Modelo.
model Desarrollo {
  id            Int       @id @default(autoincrement())
  idProyecto    Int       @map("id_proyecto")
  proyecto      Proyecto  @relation(fields: [idProyecto], references: [id], onDelete: Cascade)
  idModelo      Int       @map("id_modelo")
  modelo        Modelo    @relation(fields: [idModelo], references: [id], onDelete: Restrict)
  /// Número del cliente para este modelo (el "otro número"; opcional).
  numeroCliente String?   @map("numero_cliente")
  /// Apagado = borrado suave con motivo (reversible). NUNCA se borra (el archivo es parte del valor).
  apagado       Boolean   @default(false)
  apagadoEn     DateTime? @map("apagado_en")
  apagadoPorId  String?   @map("apagado_por_id")
  motivoApagado String?   @map("motivo_apagado") @db.Text
  notas         String?   @db.Text

  precostos    Precosto[]
  ordenLigadas DesarrolloOrden[]
  listaLineas  ListaPreciosLinea[]
  /// Renglones de pedido interno que salen de este desarrollo (rediseño R3, B4). Restrict.
  pedidoLineas PedidoLinea[]
  /// Tech pack / adjuntos del desarrollo en R2 (rediseño R5, B16: PDFs de referencia + fotos). Cascade.
  archivos     DesarrolloArchivo[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idProyecto, idModelo])
  @@index([idModelo])
  @@map("desarrollos")
}

/// Tech pack / adjunto de un DESARROLLO (rediseño R5, B16) — PDFs de referencia + fotos de muestra
/// en R2, ligados a UN desarrollo por tabla puente (espejo EXACTO de `OrdenArchivo`, sin `tipo`).
/// Cascade en ambos lados: borrar el desarrollo o el archivo arrastra el puente. `@@unique(idArchivo)`
/// = un archivo se adjunta a UN solo desarrollo.
model DesarrolloArchivo {
  id           Int    @id @default(autoincrement())
  idDesarrollo Int    @map("id_desarrollo")
  idArchivo    String @map("id_archivo")

  desarrollo Desarrollo @relation(fields: [idDesarrollo], references: [id], onDelete: Cascade)
  archivo    Archivo    @relation(fields: [idArchivo], references: [id], onDelete: Cascade)

  creadoEn    DateTime @default(now()) @map("creado_en")
  creadoPorId String?  @map("creado_por_id")

  @@unique([idArchivo])
  @@index([idDesarrollo])
  @@map("desarrollo_archivo")
}

/// Liga desarrollo ↔ orden de producción (F8-E6): una orden liga a lo más UN desarrollo (`idOrden`
/// @unique); un desarrollo puede tener N órdenes (resurtidos). Cascade hacia Desarrollo; Restrict
/// hacia Orden. Al ligar, el precio acordado se PROPONE en el pedido y el MRP hereda lo predefinido
/// (E6; todo editable por el humano).
model DesarrolloOrden {
  id           Int        @id @default(autoincrement())
  idDesarrollo Int        @map("id_desarrollo")
  desarrollo   Desarrollo @relation(fields: [idDesarrollo], references: [id], onDelete: Cascade)
  idOrden      Int        @unique @map("id_orden")
  orden        Orden      @relation(fields: [idOrden], references: [id], onDelete: Restrict)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idDesarrollo])
  @@map("desarrollo_orden")
}

/// Estado de un precosto (F8-E3): `borrador` (editable) → `congelado` (INMUTABLE, base de la
/// lista/negociación). Patrón enum como `EstadoOrden`.
enum EstadoPrecosto {
  borrador
  congelado

  @@map("estado_precosto")
}

/// Precosto PERSISTIDO por desarrollo (F8-E3, R17/R18/R19) — el corazón de la fase. Versionable por
/// congelado inmutable (base del re-costeo de negociación, E5). A lo más UN borrador por desarrollo
/// (regla de dominio bajo transacción, E3). `costoTotal` es DERIVADO y se persiste al congelar
/// (snapshot, como `RequerimientoOrden`/`CostoOrden.*Calc`; espíritu D3: las versiones congeladas
/// NUNCA se editan ni se borran). Cascade hacia Desarrollo.
model Precosto {
  id             Int            @id @default(autoincrement())
  idDesarrollo   Int            @map("id_desarrollo")
  desarrollo     Desarrollo     @relation(fields: [idDesarrollo], references: [id], onDelete: Cascade)
  version        Int
  estado         EstadoPrecosto @default(borrador)
  congeladoEn    DateTime?      @map("congelado_en")
  congeladoPorId String?        @map("congelado_por_id")
  /// Costo total DERIVADO; se persiste al congelar. Nullable en borrador.
  costoTotal     Decimal?       @map("costo_total") @db.Decimal(12, 2)

  lineas                    PrecostoLinea[]
  /// Renglones de lista que usan esta versión congelada (F8-E4). Restrict.
  listaLineas               ListaPreciosLinea[]
  /// Eventos de negociación que apuntan a esta versión como ANTERIOR (F8-E5). Restrict.
  negociacionesComoAnterior NegociacionEvento[] @relation("NegociacionPrecostoAnterior")
  /// Eventos de negociación que apuntan a esta versión como NUEVA (F8-E5). Restrict.
  negociacionesComoNuevo    NegociacionEvento[] @relation("NegociacionPrecostoNuevo")
  /// Renglones de cotización emitidos CON esta receta (V1-E7c). Restrict: la versión con la que se
  /// cotizó nunca se borra (es la respuesta a "¿con qué receta le mandé ese precio?").
  cotizacionLineas          CotizacionLinea[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idDesarrollo, version])
  @@map("precostos")
}

/// Origen de un renglón de precosto (F8-E3): BOM (tela/avío/arte) o `manual` (otros
/// procesos…). Gobierna el re-cálculo (E3: `recalcularDesdeBom` refresca los BOM sin pisar manuales).
enum OrigenPrecostoLinea {
  bom_tela
  bom_avio
  bom_arte
  manual

  @@map("origen_precosto_linea")
}

/// Renglón de precosto (F8-E3). Guarda las FK del amarre para TRAZABILIDAD ("de dónde salió este
/// precio") + el precio/importe ya resueltos (snapshot). Las FK de amarre son todas NULLABLE (un
/// renglón manual no las trae). El amarre de AVÍO es escalar sin FK (`idAvioProveedor`, par con
/// `idAvio` → AvioProveedor, mismo nombre que F4); el de TELA es FK real a `TelaProveedor`. Cascade hacia
/// Precosto; Restrict hacia los catálogos (Tela/Avío/Concepto); SetNull hacia TelaProveedor y ModeloArte
/// (si el renglón proveedor se retira, la traza se limpia — el precio usado ya vive en `precioUnit`).
model PrecostoLinea {
  id              Int                 @id @default(autoincrement())
  idPrecosto      Int                 @map("id_precosto")
  precosto        Precosto            @relation(fields: [idPrecosto], references: [id], onDelete: Cascade)
  idConceptoCosto Int                 @map("id_concepto_costo")
  conceptoCosto   ConceptoCosto       @relation(fields: [idConceptoCosto], references: [id], onDelete: Restrict)
  origen          OrigenPrecostoLinea
  /// TRAZA del amarre (de dónde salió el precio). Todas nullable.
  idTela          Int?                @map("id_tela")
  tela            Tela?               @relation(fields: [idTela], references: [id], onDelete: Restrict)
  idTelaProveedor Int?                @map("id_tela_proveedor")
  telaProveedor   TelaProveedor?      @relation(fields: [idTelaProveedor], references: [id], onDelete: SetNull)
  idAvio          Int?                @map("id_avio")
  avio            Avio?               @relation(fields: [idAvio], references: [id], onDelete: Restrict)
  /// Proveedor del amarre de avío (par con `idAvio` → AvioProveedor; SIN FK, mismo nombre que F4). Snapshot.
  idAvioProveedor Int?                @map("id_avio_proveedor")
  /// Traza del ARTE del modelo (V1-E3d; antes `idBordado` → catálogo `Bordado`). SetNull: el
  /// arte se puede quitar del modelo sin bloquear el precosto (el precio usado ya vive en
  /// `precioUnit`), mismo criterio que `idTelaProveedor`.
  idModeloArte    Int?                @map("id_modelo_arte")
  modeloArte      ModeloArte?         @relation(fields: [idModeloArte], references: [id], onDelete: SetNull)
  descripcion     String
  /// Consumo (tela: por prenda; avío por talla: PROMEDIO, decisión (g)). Nullable (arte/manual).
  consumo         Decimal?            @db.Decimal(12, 4)
  precioUnit      Decimal             @map("precio_unit") @db.Decimal(12, 2)
  importe         Decimal             @db.Decimal(12, 2)
  /// Renglón de origen BOM AJUSTADO a mano en la CALCULADORA DE NEGOCIACIÓN (rediseño R5, B12): se
  /// editó su consumo/precio o se quitó/agregó en la mesa, SIN tocar el BOM del modelo. Cuando está
  /// en true, `recalcularDesdeBom` NO lo pisa (preserva el ajuste) y `restaurarLineaBom` lo revierte
  /// al valor del BOM. Su `origen` conserva de qué BOM salió (traza). Los `manual` nacen en false
  /// (no vienen del BOM y ya sobreviven al recalcular). Default false.
  ajustado        Boolean             @default(false)
  notas           String?             @db.Text

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@index([idPrecosto])
  @@index([idConceptoCosto])
  @@index([idTela])
  @@index([idTelaProveedor])
  @@index([idAvio])
  @@index([idModeloArte])
  @@map("precosto_linea")
}

/// Factores de lista de precios de un cliente (F8-E4, R20a). Default por cliente, con override
/// OPCIONAL por departamento (decisión (a); `idClienteDepartamento` NULL = default del cliente).
/// `@@unique([idCliente, idClienteDepartamento])` (la unicidad del default-por-cliente —NULL— la
/// enforcea el dominio de E4, porque Postgres trata los NULL como distintos). Todos MXN (decisión
/// (d)). % con estilo "sobre la venta" (la fórmula la aplica E4). Cascade hacia Cliente/Departamento.
model ClienteFactores {
  id                    Int                  @id @default(autoincrement())
  idCliente             Int                  @map("id_cliente")
  cliente               Cliente              @relation(fields: [idCliente], references: [id], onDelete: Cascade)
  idClienteDepartamento Int?                 @map("id_cliente_departamento")
  clienteDepartamento   ClienteDepartamento? @relation(fields: [idClienteDepartamento], references: [id], onDelete: Cascade)
  margenPct             Decimal              @map("margen_pct") @db.Decimal(5, 2)
  descuentosPct         Decimal              @map("descuentos_pct") @db.Decimal(5, 2)
  regaliasPct           Decimal              @map("regalias_pct") @db.Decimal(5, 2)
  costoVentasPct        Decimal              @map("costo_ventas_pct") @db.Decimal(5, 2)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idCliente, idClienteDepartamento])
  @@index([idCliente])
  @@index([idClienteDepartamento])
  @@map("cliente_factores")
}

/// Lista de precios por Cliente+Departamento (F8-E4, R20a). Folio por empresa (A3/A9, secuencia
/// "lista-precios"). Los factores son un SNAPSHOT copiado de `ClienteFactores` al crearla, EDITABLE
/// en la lista (decisión (a); recalcular precios al cambiarlos). Los renglones pueden venir de varios
/// proyectos del mismo departamento. La lista NO dispara pedidos (propuesta §5). Restrict hacia
/// empresa/cliente/departamento/estado.
model ListaPrecios {
  id                    Int                 @id @default(autoincrement())
  folio                 BigInt
  idEmpresa             Int                 @map("id_empresa")
  empresa               Empresa             @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)
  idCliente             Int                 @map("id_cliente")
  cliente               Cliente             @relation(fields: [idCliente], references: [id], onDelete: Restrict)
  idClienteDepartamento Int                 @map("id_cliente_departamento")
  clienteDepartamento   ClienteDepartamento @relation(fields: [idClienteDepartamento], references: [id], onDelete: Restrict)
  fecha                 DateTime            @db.Date
  idEstadoLista         Int                 @map("id_estado_lista")
  estadoLista           EstadoLista         @relation(fields: [idEstadoLista], references: [id], onDelete: Restrict)
  /// SNAPSHOT de los factores del cliente al crear la lista (editables aquí). La fórmula (E4) los usa.
  margenPct             Decimal             @map("margen_pct") @db.Decimal(5, 2)
  descuentosPct         Decimal             @map("descuentos_pct") @db.Decimal(5, 2)
  regaliasPct           Decimal             @map("regalias_pct") @db.Decimal(5, 2)
  costoVentasPct        Decimal             @map("costo_ventas_pct") @db.Decimal(5, 2)
  notas                 String?             @db.Text

  lineas       ListaPreciosLinea[]
  /// Cotizaciones EMITIDAS desde esta lista (V1-E7c). Restrict: el papel que ya salió al cliente
  /// no deja borrar la mesa que lo produjo.
  cotizaciones Cotizacion[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idEmpresa, folio])
  @@index([idCliente])
  @@index([idClienteDepartamento])
  @@index([idEstadoLista])
  @@map("lista_precios")
}

/// Renglón de una lista de precios (F8-E4). Un desarrollo por lista (`@@unique([idLista,
/// idDesarrollo])`), con la versión CONGELADA del precosto usada (`idPrecosto`), su costo snapshot,
/// el precio calculado por la fórmula y el precio APROBADO por el dueño (`precioAprobado`, lo escribe
/// SOLO quien tiene `listas.aprobar`: aprueba el calculado o teclea otro). Cascade hacia la lista;
/// Restrict hacia Desarrollo/Precosto.
model ListaPreciosLinea {
  id              Int          @id @default(autoincrement())
  idLista         Int          @map("id_lista")
  lista           ListaPrecios @relation(fields: [idLista], references: [id], onDelete: Cascade)
  idDesarrollo    Int          @map("id_desarrollo")
  desarrollo      Desarrollo   @relation(fields: [idDesarrollo], references: [id], onDelete: Restrict)
  idPrecosto      Int          @map("id_precosto")
  precosto        Precosto     @relation(fields: [idPrecosto], references: [id], onDelete: Restrict)
  costoUnit       Decimal      @map("costo_unit") @db.Decimal(12, 2)
  precioCalculado Decimal      @map("precio_calculado") @db.Decimal(12, 2)
  precioAprobado  Decimal?     @map("precio_aprobado") @db.Decimal(12, 2)
  aprobadoPorId   String?      @map("aprobado_por_id")
  aprobadoEn      DateTime?    @map("aprobado_en")

  eventos          NegociacionEvento[]
  /// Renglones de cotización EMITIDOS desde este renglón (V1-E7c). Restrict: un renglón ya
  /// cotizado al cliente no se puede quitar de la lista (la cotización lo referencia).
  cotizacionLineas CotizacionLinea[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idLista, idDesarrollo])
  // F8-E5: un desarrollo vive en A LO MÁS UNA lista (defensa en profundidad a nivel BD; E4 ya lo
  // enforza en dominio bajo advisory lock). El @@unique global reemplaza al índice simple de E4.
  @@unique([idDesarrollo])
  @@index([idPrecosto])
  @@map("lista_precios_linea")
}

/// Evento de negociación por renglón (F8-E5, R20b) — bitácora INMUTABLE (A7: se agrega, jamás se
/// edita). Registra una ronda (versión anterior/nueva del precosto + precio anterior/nuevo) o un
/// acuerdo SIN re-costeo (solo precio acordado + nota). Cascade hacia el renglón de lista; Restrict
/// hacia los precostos referidos (nunca borra la versión que la ronda registró).
model NegociacionEvento {
  id                 Int               @id @default(autoincrement())
  idListaLinea       Int               @map("id_lista_linea")
  listaLinea         ListaPreciosLinea @relation(fields: [idListaLinea], references: [id], onDelete: Cascade)
  idPrecostoAnterior Int?              @map("id_precosto_anterior")
  precostoAnterior   Precosto?         @relation("NegociacionPrecostoAnterior", fields: [idPrecostoAnterior], references: [id], onDelete: Restrict)
  idPrecostoNuevo    Int?              @map("id_precosto_nuevo")
  precostoNuevo      Precosto?         @relation("NegociacionPrecostoNuevo", fields: [idPrecostoNuevo], references: [id], onDelete: Restrict)
  precioAnterior     Decimal?          @map("precio_anterior") @db.Decimal(12, 2)
  precioNuevo        Decimal?          @map("precio_nuevo") @db.Decimal(12, 2)
  /// Qué se cambió/acordó (texto). Inmutable.
  acuerdo            String            @db.Text

  registradoPorId String?  @map("registrado_por_id")
  registradoEn    DateTime @default(now()) @map("registrado_en")

  @@index([idListaLinea])
  @@index([idPrecostoAnterior])
  @@index([idPrecostoNuevo])
  @@map("negociacion_evento")
}

/// ⭐ COTIZACIÓN (V1-E7c, §Post-F9.109) — **el papel que se le manda al cliente**.
///
/// Daniel (25-ago-2026): *"hay motor de cálculo y no hay documento"*. El flujo llegaba hasta la LISTA
/// de precios —que es la MESA donde se negocia y donde el dueño aprueba— y ahí se cortaba. Esta tabla
/// es lo que SALE de esa mesa: un documento con **VARIOS modelos** (*"es un documento con las 5
/// cotizaciones… o sea una cotización con los 5 modelos"*), colgado de la LISTA (cliente +
/// departamento), no de un desarrollo suelto.
///
/// 🔴 **INMUTABLE.** Nace ya `emitida` —es la FOTO de un momento— y **no se edita jamás**. Otra vuelta
/// de negociación = **otra cotización**, con LOS CINCO modelos otra vez (aunque sólo hayan cambiado
/// tres): el cliente la lee sola, sin la anterior al lado, y mandarle sólo el delta lo obligaría a
/// reconstruir el paquete de memoria. *Una cotización dice lo que se ofrece AHORA, completo.*
/// Lo único que se puede hacer después es **CANCELARLA con motivo** (D3: nunca se borra ni se edita);
/// la cancelación sólo escribe sus tres columnas de sello, no toca el contenido del documento.
///
/// Folio por secuencia atómica `"cotizacion"` por empresa (A3, NUNCA Max()+1), igual que su vecina
/// `ListaPrecios`.
///
/// 🔴 **El ENCABEZADO también va congelado** (`nombreCliente`, `nombreDepartamento`, `folioLista`), y
/// por eso `idLista` es NULLABLE con `SetNull`. La razón es la misma que la de los renglones, más una
/// segunda que se descubrió al revisar: si el documento tuviera que LEER el nombre del cliente por la
/// FK, la FK habría que blindarla con `Restrict` — y entonces **la lista quedaría atrapada para
/// siempre**, exactamente el mismo defecto que V1-E4 tuvo que ir a arreglar (el `@@unique
/// ([idDesarrollo])` de `ListaPreciosLinea` sigue vivo: un renglón retenido no puede entrar NUNCA a
/// otra lista, y aquí no habría escapatoria porque una cotización no se borra ni cancelándola).
/// Congelando el encabezado se cierran las dos cosas de un golpe: el papel es AUTOSUFICIENTE, así que
/// la FK ya no protege nada y puede irse a null sin que el documento pierda una sola letra.
///
/// *Es el mismo patrón que su vecina `ListaPrecios`, que ya guarda los factores del cliente como
/// SNAPSHOT en vez de apuntarlos.*
model Cotizacion {
  id        Int           @id @default(autoincrement())
  folio     BigInt
  idEmpresa Int           @map("id_empresa")
  empresa   Empresa       @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)
  /// Lista de la que salió: PROCEDENCIA, no fuente de lectura. Se pone en NULL si la lista se borra.
  idLista   Int?          @map("id_lista")
  lista     ListaPrecios? @relation(fields: [idLista], references: [id], onDelete: SetNull)
  fecha     DateTime      @db.Date
  /// `emitida` | `cancelada`. Nace emitida (no hay borrador: el documento nace ya mandado).
  estado    String        @default("emitida") @db.VarChar(20)
  notas     String?       @db.Text

  // ── ENCABEZADO CONGELADO (a quién se le mandó, y desde qué lista) ──
  idCliente             Int                 @map("id_cliente")
  cliente               Cliente             @relation(fields: [idCliente], references: [id], onDelete: Restrict)
  idClienteDepartamento Int                 @map("id_cliente_departamento")
  clienteDepartamento   ClienteDepartamento @relation(fields: [idClienteDepartamento], references: [id], onDelete: Restrict)
  /// Nombre del cliente TAL COMO SE IMPRIMIÓ. Un renombre posterior no reescribe el papel de marzo.
  nombreCliente         String              @map("nombre_cliente")
  /// Nombre del departamento tal como se imprimió.
  nombreDepartamento    String              @map("nombre_departamento")
  /// Folio de la lista que la produjo, copiado: se sigue imprimiendo aunque la lista ya no exista.
  folioLista            BigInt              @map("folio_lista")

  /// Sello de CANCELACIÓN (D3): motivo obligatorio + quién/cuándo. Nulos mientras esté emitida.
  motivoCancelacion String?   @map("motivo_cancelacion") @db.Text
  canceladaPorId    String?   @map("cancelada_por_id")
  canceladaEn       DateTime? @map("cancelada_en")

  lineas CotizacionLinea[]

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idEmpresa, folio])
  @@index([idLista])
  @@index([idCliente])
  @@index([idClienteDepartamento])
  @@index([estado])
  @@map("cotizacion")
}

/// Renglón de una COTIZACIÓN (V1-E7c) — un MODELO ofrecido, con sus valores **CONGELADOS**.
///
/// 🔴 Por qué se copian los valores y no sólo las FK: la LISTA sigue moviéndose después de emitir (se
/// re-negocia, se recalculan factores, se teclea otro precio). Si el papel sólo guardara punteros,
/// reimprimir la cotización de marzo enseñaría **los precios de mayo** — o sea, mentiría sobre lo que
/// se le mandó al cliente. Es el MISMO patrón de copia congelada que ya gobierna la receta modelo→OP.
///
/// 🔴 Las FK (`idListaLinea`, `idPrecosto`) son PROCEDENCIA —"de qué renglón salió y con qué versión
/// de la receta"—, **no fuente de lectura**, y por eso van NULLABLE con `SetNull` en vez de `Restrict`.
///
/// Blindarlas con `Restrict` no protegía el papel: protegía el PUNTERO. El contenido del documento
/// vive en sus propias columnas y nadie lo toca; lo que `Restrict` conseguía era que un renglón ya
/// cotizado **no pudiera salir NUNCA de su lista** —y con el `@@unique([idDesarrollo])` de
/// `ListaPreciosLinea` todavía vivo, ese desarrollo no podría entrar jamás a otra lista—. Sin
/// escapatoria, además: una cotización no se borra, y cancelarla tampoco libera. Es literalmente el
/// atrapamiento que V1-E4 tuvo que ir a arreglar.
///
/// Con `SetNull`, quitar el renglón de la lista deja el puntero en null y **el documento se sigue
/// imprimiendo idéntico**. La procedencia no se pierde: la bitácora de la emisión guarda cada
/// renglón (modelo + versión + precio), y la de `quitar-linea` guarda el renglón entero.
model CotizacionLinea {
  id           Int                @id @default(autoincrement())
  idCotizacion Int                @map("id_cotizacion")
  cotizacion   Cotizacion         @relation(fields: [idCotizacion], references: [id], onDelete: Cascade)
  idListaLinea Int?               @map("id_lista_linea")
  listaLinea   ListaPreciosLinea? @relation(fields: [idListaLinea], references: [id], onDelete: SetNull)
  /// Versión congelada del precosto con la que se cotizó. El VALOR que contesta "¿con qué receta?"
  /// es `versionPrecosto` (copiado); esto es sólo el puntero, y se va a null si el precosto muere.
  idPrecosto   Int?               @map("id_precosto")
  precosto     Precosto?          @relation(fields: [idPrecosto], references: [id], onDelete: SetNull)

  // ── Valores CONGELADOS (la foto del momento; NUNCA se releen de la lista) ──
  codigoModelo      String  @map("codigo_modelo")
  descripcionModelo String? @map("descripcion_modelo")
  /// Número del modelo EN EL CATÁLOGO DEL CLIENTE: es como él lo lee en su propia orden de compra.
  numeroCliente     String? @map("numero_cliente")
  versionPrecosto   Int     @map("version_precosto")
  /// Precio unitario OFRECIDO (el `precioAprobado` del renglón al momento de emitir). Sin él no se
  /// emite: mandar un precio que el dueño no aprobó es un compromiso que nadie firmó.
  precioUnit        Decimal @map("precio_unit") @db.Decimal(12, 2)

  creadoEn        DateTime @default(now()) @map("creado_en")
  creadoPorId     String?  @map("creado_por_id")
  modificadoEn    DateTime @updatedAt @map("modificado_en")
  modificadoPorId String?  @map("modificado_por_id")

  @@unique([idCotizacion, idListaLinea])
  @@index([idListaLinea])
  @@index([idPrecosto])
  @@map("cotizacion_linea")
}

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ARCHIVO HISTÓRICO DE ÓRDENES DEL SISTEMA VIEJO (§Post-F9.26)
// ═══════════════════════════════════════════════════════════════════════════════════════════════
//
// Daniel (10-ago-2026): *"me gustaría tenerlas también como archivo histórico de órdenes.
// Normalmente cuando queremos consultar algo de información, lo hacemos más desde las órdenes de
// producción que del catálogo de modelos. Para poder buscar por cliente, número de modelo, tipo de
// prenda, fecha de producción, maquilero, etc."* — y antes: *"sin poder manipular las órdenes…
// pero sí con algo de información fija… sin jalar maquileros, estampadores dentro de un catálogo,
// sino como un campo informativo"*.
//
// POR QUÉ ESTO EXISTE Y NO SON `Orden`s NORMALES: la migración lleva solo 2025-2026 (§Post-F9.24),
// así que de 5,451 órdenes del viejo solo 262 entran como órdenes OPERATIVAS. Las otras ~5,200 son
// historia que se quiere CONSULTAR, no operar. Traerlas como `Orden` obligaría a arrastrar folios,
// kardex, costeo, ruta crítica, existencias y los catálogos de terceros que justo se depuraron
// (§Post-F9.23). Aquí no: es un archivo PLANO y de SOLO LECTURA.
//
// LAS DOS REGLAS QUE LO MANTIENEN INOCUO:
//  1. **Los terceros van como TEXTO** (`maquilero`, `cortador`…), no como FK a `Proveedor`. El
//     nombre se resuelve UNA vez, al migrar, desde los CSV del viejo. Así el catálogo depurado no
//     se vuelve a llenar de los 897 terceros muertos.
//  2. **Nada de esto alimenta nada.** No hay kardex, ni costos, ni RC, ni secuencias de folio. El
//     dominio solo LEE. La única FK "de verdad" es al `Modelo`, porque los modelos SÍ migran
//     completos — y es la que permite filtrar por tipo de prenda y género sin duplicar esos datos.

/// Etapa de producción registrada en el archivo histórico (equivalentes viejos de F3).
enum ProcesoHistoricoV1 {
  /// `Corte` — quién cortó y cuánto.
  corte
  /// `Entregas` — envío a maquila de COSTURA.
  envio_maquila
  /// `Recibos` — recibo de maquila de COSTURA.
  recibo_maquila
  /// `EntregasEst` — envío a ESTAMPADO/aplicación.
  envio_estampado
  /// `RecibosEst` — recibo de ESTAMPADO/aplicación.
  recibo_estampado

  @@map("proceso_historico_v1")
}

/// Una orden de producción del sistema viejo, congelada para consulta (§Post-F9.26).
model HistoricoOrdenV1 {
  id        Int     @id @default(autoincrement())
  idEmpresa Int     @map("id_empresa")
  empresa   Empresa @relation(fields: [idEmpresa], references: [id], onDelete: Restrict)

  /// `Ordenes.IdOrdenes` del viejo. Es la llave de IDEMPOTENCIA del ETL (re-correrlo no duplica).
  idOrdenV1 String @map("id_orden_v1")
  /// `Ordenes.Numero` — el número que la gente conoce y por el que va a buscar. TEXTO: en el viejo
  /// no siempre es un entero limpio, y aquí no se numera nada (no hay secuencia, A3 no aplica).
  numero    String

  /// Nombre de la empresa a la que la orden pertenecía en el sistema viejo (`Empresas.Empresa`),
  /// en TEXTO y ligado a nada (§Post-F9.29).
  ///
  /// Daniel (11-ago-2026), sobre las 1,528 órdenes de las 6 empresas que no migran: *"sí, está bien,
  /// rescata todas y solo pon en algún lugar la empresa a la que correspondía."* `idEmpresa` es FK
  /// real y solo puede apuntar a una empresa VIVA, así que esas órdenes se cuelgan de la empresa
  /// principal (FR Moda) para que existan y se puedan consultar (A9: el listado filtra por la empresa
  /// activa); esta columna conserva de QUIÉN eran de verdad. Mismo criterio que los talleres
  /// (§Post-F9.27): el dato viejo se guarda escrito, no revive como entidad.
  ///
  /// Se llena SIEMPRE, también en las órdenes de las 2 empresas activas: si solo lo trajeran las
  /// rescatadas, un valor vacío sería ambiguo (¿es de la empresa activa, o el CSV no traía nombre?).
  empresaV1 String? @map("empresa_v1")

  /// Fecha de la orden y fecha de entrega comprometida (solo día).
  fecha        DateTime? @db.Date
  fechaEntrega DateTime? @db.Date

  /// Modelo, ligado DE VERDAD: los modelos migran completos, así que se puede filtrar por tipo de
  /// prenda y género a través de él sin copiar esos campos. Restrict. NULL si no se pudo mapear.
  idModelo       Int?    @map("id_modelo")
  modelo         Modelo? @relation(fields: [idModelo], references: [id], onDelete: Restrict)
  /// Código del modelo TAL COMO lo traía el viejo. Respalda la búsqueda cuando `idModelo` es NULL
  /// (modelo que no se pudo mapear) — que la orden no aparezca por un mapeo fallido sería peor.
  codigoModeloV1 String? @map("codigo_modelo_v1")

  // ── Terceros y datos como TEXTO (regla 1 del encabezado) ────────────────────
  /// Cliente de la orden.
  cliente   String?
  /// Taller de maquila asignado en la CABECERA de la orden (`Ordenes.IdMaquileros`, resuelto a
  /// nombre). Es solo el asignado: quien de verdad la trabajó puede ser otro, o varios (ver abajo).
  maquilero String?

  // ── TODOS los que la trabajaron, en campo abierto (§Post-F9.27) ─────────────
  //
  // Daniel (10-ago-2026), corrigiendo la primera versión: *"es importante que vayan todos. Y no
  // solo el primero. Lo mismo para estampadores. Pero lo puedes poner en un campo abierto, donde
  // sí pueda encontrarlo, pero no esté ligado a nada."*
  //
  // Una orden del viejo pasa por VARIOS talleres: se corta en uno, se cosen partidas en dos o tres
  // y se estampa en otro. La cabecera solo guarda al primero, así que verla a ella dejaba fuera a
  // la mayoría. Estas tres columnas concentran los nombres DISTINTOS de cada rol, separados por
  // " · ", tomados de los movimientos de producción.
  //
  // POR QUÉ DUPLICAR lo que ya está en `HistoricoOrdenV1Proceso`: para poder VERLOS en el renglón
  // del listado y buscarlos sin un subquery por fila. El archivo es INMUTABLE —se llena una vez con
  // el ETL y no se edita nunca—, así que esta copia no puede desincronizarse: es el caso en el que
  // desnormalizar no cuesta nada.
  //
  // Texto libre, ligado a NADA: son en su mayoría los ~897 talleres que la depuración del catálogo
  // (§Post-F9.23) dejó fuera, y así siguen fuera.

  /// Cortadores que cortaron la orden; nombres distintos separados por " · ".
  cortadores    String?
  /// Talleres de COSTURA por los que pasó (envíos y recibos de maquila).
  maquileros    String?
  /// Talleres de ESTAMPADO/aplicación por los que pasó.
  estampadores  String?
  /// Marca/etiqueta.
  etiquetaMarca String? @map("etiqueta_marca")
  /// Tela de la orden (`IdTelasDis`, resuelto a nombre).
  tela          String?
  composicion   String?
  observaciones String? @db.Text

  /// La orden se canceló en el viejo (`OrdCancelada`). Se conserva: parte de la historia es saber
  /// qué NO se hizo.
  cancelada       Boolean @default(false)
  motivoCancelada String? @map("motivo_cancelada") @db.Text

  /// Suma de la matriz color×talla. Se guarda calculada para poder listar y ordenar sin agregar
  /// 39,853 celdas en cada consulta.
  totalPiezas Int @default(0) @map("total_piezas")

  lineas       HistoricoOrdenV1Linea[]
  procesos     HistoricoOrdenV1Proceso[]
  /// Habilitación (avíos) que la orden llevó de verdad en el viejo (`OrdenesHab`, V1-E3d).
  habilitacion HistoricoOrdenV1Hab[]

  creadoEn DateTime @default(now()) @map("creado_en")

  @@unique([idEmpresa, idOrdenV1])
  @@index([idEmpresa, numero])
  @@index([idModelo])
  @@index([fecha])
  @@index([cliente])
  @@index([maquilero])
  @@index([maquileros])
  @@index([estampadores])
  @@map("historico_orden_v1")
}

/// Una celda color×talla de una orden histórica (`OrdenesDet` ya despivotado).
model HistoricoOrdenV1Linea {
  id       Int              @id @default(autoincrement())
  idOrden  Int              @map("id_orden")
  orden    HistoricoOrdenV1 @relation(fields: [idOrden], references: [id], onDelete: Cascade)
  /// Color TAL COMO lo escribió el viejo (texto libre, sin normalizar: ver §Post-F9.26 — adivinar
  /// equivalencias entre casi 40,000 celdas metería errores silenciosos).
  color    String
  /// Etiqueta de talla ya interpretada de la cadena posicional `Ordenes.Tallas` (reusa el lector
  /// de F2, `migracion/comun/tallas-orden.ts`).
  talla    String
  cantidad Int

  @@index([idOrden])
  @@map("historico_orden_v1_linea")
}

/// Un movimiento de producción de una orden histórica: quién la cortó, cosió o estampó y cuánto.
model HistoricoOrdenV1Proceso {
  id      Int              @id @default(autoincrement())
  idOrden Int              @map("id_orden")
  orden   HistoricoOrdenV1 @relation(fields: [idOrden], references: [id], onDelete: Cascade)

  tipo          ProcesoHistoricoV1
  fecha         DateTime?          @db.Date
  /// Nombre del cortador/taller/estampador, resuelto al migrar. TEXTO (regla 1 del encabezado).
  tercero       String?
  cantidad      Int
  observaciones String?            @db.Text

  @@index([idOrden])
  @@index([tercero])
  @@map("historico_orden_v1_proceso")
}

/// La HABILITACIÓN (avíos) que una orden del viejo llevó de verdad, con SU cantidad y SU precio
/// (`OrdenesHab`, 28,432 renglones que hasta V1-E3d se tiraban completos). §Post-F9.43(e).
///
/// Daniel (14-ago-2026): *"no sé si vale la pena migrar toda la info… mucha de esa info no es tan
/// real. No quisiera hacer un catálogo con información no precisa… pero no quiero que interfiera
/// con el nuevo catálogo para no meter información basura acumulada de 30 años."*
///
/// Por eso vive AQUÍ y no en el catálogo, con **la regla ya establecida en §Post-F9.28**: el avío va
/// como **TEXTO**, resuelto UNA vez al migrar. Consecuencias, todas buscadas:
///  • **No se crea ni un solo registro en el catálogo de avíos.**
///  • No aparece en ningún selector de captura; es de SOLO LECTURA.
///  • **No hay —ni habrá— botón de "traer al catálogo"**: ese botón sería la puerta trasera por la
///    que volvería la basura recién depurada. Por eso tampoco existe en el directorio histórico.
///
/// Lo que se gana: cuando alguien pregunte *"¿qué llevaba de verdad este modelo en 2019 y a qué
/// precio?"*, la respuesta existe.
model HistoricoOrdenV1Hab {
  id      Int              @id @default(autoincrement())
  idOrden Int              @map("id_orden")
  orden   HistoricoOrdenV1 @relation(fields: [idOrden], references: [id], onDelete: Cascade)

  /// Descripción del avío TAL COMO la traía el viejo (`Habilitacion.Descripcion`), resuelta al
  /// migrar. TEXTO ligado a NADA. Si el catálogo viejo no traía descripción, cae a la clave.
  avio     String
  /// Clave del avío en el viejo (`Habilitacion.Clave`), si la traía. Respalda la búsqueda.
  claveV1  String?  @map("clave_v1")
  /// `OrdenesHab.CantHabOrd` — la cantidad de ESA orden.
  cantidad Decimal? @db.Decimal(12, 4)
  /// `OrdenesHab.PrecioHabOrd` — el precio de ESA orden (15,255 de 24,480 renglones difieren del
  /// catálogo: la OP guardaba el precio del día).
  precio   Decimal? @db.Decimal(12, 2)

  creadoEn DateTime @default(now()) @map("creado_en")

  @@index([idOrden])
  @@index([avio])
  @@map("historico_orden_v1_hab")
}

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// DIRECTORIO HISTÓRICO DE TERCEROS DEL SISTEMA VIEJO (§Post-F9.28)
// ═══════════════════════════════════════════════════════════════════════════════════════════════
//
// Daniel (10-ago-2026): *"Al no pasar la información de los maquileros, ¿qué hacemos con la
// información de ellos si quisiera encontrar algún teléfono o nombre? ¿Habrá manera de mantener la
// información acá, sin tener toda la información basura en el catálogo? ¿Podríamos guardarlo en
// algún otro repositorio que no sea el catálogo de proveedores?"*
//
// EL PROBLEMA: la depuración (§Post-F9.23) deja fuera del catálogo ~897 de los 1,052 terceros del
// Access. Eso es lo que se quería —que no estorben al capturar—, pero su TELÉFONO y su DIRECCIÓN
// siguen siendo útiles: un taller con el que no se trabaja desde 2021 puede volver a hacer falta.
//
// LA RESPUESTA A SU PREGUNTA ES SÍ, y es la misma idea que el archivo de órdenes (§Post-F9.26):
// **una libreta de direcciones aparte, plana y de solo lectura**. NO es el catálogo `Proveedor`:
//  • No sale en NINGÚN selector ni buscador de captura (ni telas, ni OC, ni maquila).
//  • No tiene roles, ni `activo`, ni bandera de factura, ni FK a nada.
//  • No se le puede dar de alta a nada: si un taller vuelve, se da de alta LIMPIO en el catálogo,
//    copiando de aquí lo que sirva. Que sea de solo lectura es lo que impide que la basura
//    depurada se cuele de vuelta por la puerta de atrás.
//
// Entran **TODOS** los 1,052 (también los 155 que sí sobrevivieron): así el directorio es la foto
// completa del Access y nadie tiene que preguntarse en cuál de los dos lados buscar.

/// Un tercero del sistema viejo con sus datos de contacto, para consulta (§Post-F9.28).
model DirectorioTerceroV1 {
  id Int @id @default(autoincrement())

  /// De qué catálogo del viejo salió: `Proveedores`, `Cortadores`, `Maquileros` o `Estampadores`.
  /// TEXTO, no enum: es la procedencia del dato, no una clasificación que el sistema use.
  fuente  String
  /// Id que tenía en ESE catálogo. Con `fuente` forma la llave de idempotencia del ETL.
  idViejo String @map("id_viejo")

  nombre      String
  /// Clave corta de uso diario del taller (`Maquileros.Corto`).
  corto       String?
  razonSocial String? @map("razon_social")
  telefono    String? @db.Text
  contacto    String?
  direccion   String? @db.Text
  /// `Observaciones` del viejo + lo que no tiene columna propia (condiciones, obs. de pago…).
  notas       String? @db.Text

  /// Qué hacía, en texto legible ("Costura", "Corte", "Vende telas"…). Informativo: NO son los
  /// roles del catálogo `RolProveedor`, y no se usan para filtrar nada operativo.
  servicios String?

  /// Fecha del ÚLTIMO movimiento suyo en el viejo (OC, corte, entrega, recibo o nota). Es lo que
  /// contesta de un vistazo *"¿hace cuánto que no trabajamos con este?"*. NULL = nunca movió nada.
  ultimaActividad DateTime? @map("ultima_actividad") @db.Date
  /// Cuántos documentos suyos hay en el viejo (el peso de la relación, no solo la fecha).
  documentos      Int       @default(0)

  /// `true` si este tercero SÍ sobrevivió a la depuración y existe en el catálogo `Proveedor`
  /// (§Post-F9.23). Se guarda calculado para poder decir en la pantalla "este ya está dado de
  /// alta" sin cruzar por nombre en cada consulta — el cruce por nombre es justo lo frágil.
  enCatalogo Boolean @default(false) @map("en_catalogo")

  creadoEn DateTime @default(now()) @map("creado_en")

  @@unique([fuente, idViejo])
  @@index([nombre])
  @@index([ultimaActividad])
  @@map("directorio_tercero_v1")
}

// ─────────────────────────────────────────────────────────────────────────────
// SEGUNDO respaldo: copia cifrada a R2 (V1-E6a — PLANMAESTRO §2.2 "respaldo doble" y
// §11, mitigación #1 de la tabla de riesgos). El job de pg-boss vuelca la base con
// `pg_dump`, cifra el volcado (AES-256-GCM) y lo sube a R2. Corre MENSUAL: los
// respaldos diarios de Railway ya cubren el día a día, y esta copia cubre el caso que
// ellos NO pueden cubrir — que el problema SEA Railway.
//
// Esta tabla es el RASTRO de cada corrida: un respaldo que falla callado es peor que
// no tener respaldo, porque genera confianza falsa — aquí queda por escrito si subió,
// cuánto pesó y, si tronó, en qué paso y con qué error. Con corridas mensuales el
// rastro pesa MÁS: un fallo de enero no se nota hasta que hace falta en junio.
// ─────────────────────────────────────────────────────────────────────────────

/// Cómo va (o cómo terminó) una corrida del respaldo.
///
/// `EN_CURSO` existe para que una corrida que MUERE A MEDIA deje huella: la fila se escribe al
/// EMPEZAR y se actualiza al terminar, así que un redeploy, un OOM o un SIGKILL durante el
/// `pg_dump` —el paso largo— dejan una fila colgada en `EN_CURSO` en vez de no dejar nada. La
/// siguiente corrida las cierra como `FALLO` con su motivo (ver `iniciarCorrida`).
enum EstadoRespaldo {
  EN_CURSO
  EXITO
  FALLO

  @@map("estado_respaldo")
}

/// En qué paso del respaldo se estaba (sirve para saber DÓNDE tronó sin leer el texto
/// del error). Se guarda también en las corridas exitosas (`RETENCION`, el último paso).
enum PasoRespaldo {
  /// Faltó configuración (llave de cifrado, credenciales R2 reales…): ni se intentó.
  CONFIGURACION
  /// La configuración estaba BIEN pero el respaldo no se pudo dejar programado (el motor de jobs
  /// no levantó, o `schedule` falló). El sistema queda sin respaldo aunque nada esté mal escrito.
  PROGRAMACION
  /// `pg_dump` del Postgres del sistema.
  VOLCADO
  /// Cifrado del volcado (AES-256-GCM).
  CIFRADO
  /// Subida del archivo cifrado a R2.
  SUBIDA
  /// Comprobación de que el objeto QUEDÓ en R2 con el tamaño esperado (HeadObject).
  VERIFICACION
  /// Borrado de los respaldos que ya pasaron la retención.
  RETENCION

  @@map("paso_respaldo")
}

/// Una corrida del respaldo a R2 (V1-E6a). Se escribe SIEMPRE, salga bien o mal;
/// es lo que hace consultable el respaldo sin entrar a R2. Cada corrida deja además
/// un renglón de `Bitacora` (entidad `RespaldoBd`) para que se vea en la pantalla de
/// auditoría que ya existe, sin construir pantalla nueva.
model RespaldoCorrida {
  id BigInt @id @default(autoincrement())

  /// Cuándo arrancó la corrida.
  iniciadoEn  DateTime  @default(now()) @map("iniciado_en")
  /// Cuándo terminó (con éxito o con error).
  terminadoEn DateTime? @map("terminado_en")

  /// Cómo terminó.
  estado EstadoRespaldo
  /// Paso alcanzado: el ÚLTIMO que se completó si salió bien, o el que tronó si falló.
  paso   PasoRespaldo

  /// Bucket R2 destino (NULL si ni se llegó a intentar la subida).
  bucket String?
  /// Key del objeto en R2 (NULL si no se subió). Es lo que se le pasa al script de
  /// restauración: `npx tsx --env-file=.env scripts/restaurar-respaldo.ts --key <key>`.
  key    String?

  /// Tamaño del volcado SIN cifrar, en bytes (útil para ver crecer la base).
  tamanoDumpBytes   BigInt? @map("tamano_dump_bytes")
  /// Tamaño del objeto CIFRADO tal como lo confirmó R2 (HeadObject), en bytes.
  /// Es la prueba de que el objeto quedó: se compara contra el archivo local.
  tamanoSubidoBytes BigInt? @map("tamano_subido_bytes")

  /// SHA-256 (hex) del archivo CIFRADO tal como se subió. El tamaño que confirma R2 caza una
  /// subida TRUNCADA, pero no una corrupción del mismo largo; el cifrado GCM sí la caza, aunque
  /// sólo al descifrar —o sea, el día del desastre—. Con esta huella se puede comprobar un
  /// respaldo bajado de R2 ANTES de necesitarlo, y SIN la llave:
  /// `sha256sum respaldo.dump.enc`, o `restaurar-respaldo.ts --sha256 <hex>`.
  sha256 String? @db.VarChar(64)

  /// Cuántos respaldos viejos borró la retención en esta corrida (los que sobran del tope).
  objetosBorrados Int @default(0) @map("objetos_borrados")

  /// Cuánto tardó la corrida completa, en milisegundos.
  duracionMs Int? @map("duracion_ms")

  /// El error, en texto, cuando `estado = FALLO`. NULL si salió bien.
  error String?

  @@index([iniciadoEn])
  @@index([estado, iniciadoEn])
  @@map("respaldo_corrida")
}
