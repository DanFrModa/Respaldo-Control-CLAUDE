{
  "name": "backend",
  "version": "0.1.0",
  "description": "CONTROL v2 — Servicio de API (Fastify + REST + OpenAPI)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "scripts": {
    "dev": "tsx watch src/servidor.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/servidor.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.ts\" \"prisma/**/*.ts\" \"scripts/**/*.ts\"",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integracion": "vitest run --project integracion",
    "openapi": "tsx scripts/generar-openapi.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1065.0",
    "@aws-sdk/s3-request-presigner": "3.1065.0",
    "@fastify/swagger": "9.7.0",
    "@fastify/swagger-ui": "6.0.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "better-auth": "1.6.15",
    "dotenv": "17.4.2",
    "fastify": "5.8.5",
    "fastify-type-provider-zod": "6.1.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testcontainers/postgresql": "12.0.1",
    "@types/node": "22.19.20",
    "eslint": "10.4.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.4",
    "prisma": "7.8.0",
    "testcontainers": "12.0.1",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.61.0",
    "vitest": "4.1.8"
  }
}
