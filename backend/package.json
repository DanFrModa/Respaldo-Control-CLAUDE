{
  "name": "backend",
  "version": "0.1.0",
  "description": "CONTROL v2 — Servicio de API (Fastify + REST + OpenAPI)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/servidor.ts",
    "build": "tsc",
    "start": "node dist/servidor.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run"
  },
  "dependencies": {
    "fastify": "5.8.5",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.20",
    "eslint": "10.4.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.4",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.61.0",
    "vitest": "4.1.8"
  }
}
