# Backend CONTROL v2 — variables de entorno (copia a .env y ajusta)

# Puerto en el que escucha Fastify (host fijo "::" dual-stack).
PORT=3000

# Nivel de logs de pino: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Cadena de conexion a PostgreSQL (la usa Prisma via @prisma/adapter-pg).
# Formato: postgresql://USUARIO:CONTRASENA@HOST:PUERTO/BASE
DATABASE_URL=postgresql://control:control@postgres:5432/control_v2

# ── Autenticacion (better-auth, E3) ────────────────────────────────────────
# Secreto que firma cookies/tokens de sesion. OBLIGATORIO en produccion: genera
# uno largo y aleatorio (p. ej. `openssl rand -base64 32`) y NO lo subas al repo.
BETTER_AUTH_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# URL base publica del backend (para enlaces y validacion de origen).
BETTER_AUTH_URL=http://localhost:3000
# Origenes extra de confianza separados por coma (CORS/anti-CSRF). En local con
# el nginx del frontend proxando /api no suele hacer falta; en produccion se
# pone el dominio publico del frontend.
# BETTER_AUTH_TRUSTED_ORIGINS=https://control.tu-dominio.com

# ── Cloudflare R2 (archivos adjuntos, A5/R6) ───────────────────────────────
# Solo se necesitan cuando se usan adjuntos; el servicio de archivos las valida
# de forma perezosa (importar el dominio NO exige tenerlas configuradas).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=control-v2-prueba

# ── Segundo respaldo: copia cifrada a R2 (V1-E6a, plan §2.2 "respaldo doble") ─
# Una vez al mes el backend hace pg_dump de la base, lo cifra, lo sube a R2 y
# borra los que sobran del tope. Deja rastro de cada corrida en la tabla
# `respaldo_corrida` y en la bitacora (entidad `RespaldoBd`).
#
# Es MENSUAL porque los respaldos diarios de Railway ya cubren el dia a dia; esta
# copia cubre lo que ellos no pueden: que el problema SEA Railway (cuenta
# suspendida, servicio borrado, mudanza de proveedor).
#
# ⚠️ RESPALDO_LLAVE es la frase de la que sale la llave AES. SI SE PIERDE, LOS
# RESPALDOS SON IRRECUPERABLES: no hay puerta trasera. Generala con
# `openssl rand -base64 32` y guardala TAMBIEN fuera de Railway (gestor de
# contrasenas). Minimo 24 caracteres.
# RESPALDO_LLAVE=

# Cuantos respaldos se conservan en R2. Por defecto 12 = un ano de copias
# mensuales. Se cuentan RESPALDOS y no dias para que cambiar la frecuencia no
# cambie en silencio cuantas copias existen. Ademas, y esto no se configura,
# ninguno de los ultimos 35 dias se borra jamas (asi una tanda de corridas
# manuales de prueba no se lleva por delante el ano de historia).
# RESPALDO_RETENCION=12

# Cron de la corrida, en UTC (pg-boss evalua los cron en UTC). Por defecto
# "0 8 1 * *" = dia 1 de cada mes a las 08:00 UTC = 02:00 hora del centro de
# Mexico (UTC-6 todo el ano). Cambiala aqui si hace falta otra frecuencia; no
# hay nada de la periodicidad clavado en el codigo.
# RESPALDO_CRON=0 8 1 * *

# Carpeta logica dentro del bucket. Por defecto "respaldos/bd".
# RESPALDO_PREFIJO=respaldos/bd

# Minutos maximos que puede tardar el pg_dump antes de darlo por COLGADO (se mata
# el proceso y la corrida falla con su rastro). Por defecto 180. Una corrida
# colgada nunca falla sola: seria un respaldo inexistente que nadie ve fallar.
# RESPALDO_TIMEOUT_MIN=180

# Ruta del ejecutable pg_dump, si no esta en el PATH. Por defecto "pg_dump"
# (la imagen del backend instala postgresql-client-17).
# RESPALDO_PG_DUMP=pg_dump

# Apaga el respaldo a proposito (unico valor que apaga: "false"). Sin esto el
# backend intenta programarlo y, si le falta configuracion, lo deja anotado
# como fallo en vez de callarse.
# RESPALDO_ACTIVO=false
