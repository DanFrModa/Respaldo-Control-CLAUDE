# Backend CONTROL v2 — variables de entorno (copia a .env y ajusta)

# Puerto en el que escucha Fastify (host fijo "::" dual-stack).
PORT=3000

# Nivel de logs de pino: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Cadena de conexion a PostgreSQL (la usa Prisma via @prisma/adapter-pg).
# Formato: postgresql://USUARIO:CONTRASENA@HOST:PUERTO/BASE
DATABASE_URL=postgresql://control:control@postgres:5432/control_v2

# ── Autenticacion (better-auth, E3) ────────────────────────────────────────
# Secreto que firma cookies/tokens de sesion. OBLIGATORIO en produccion: genera
# uno largo y aleatorio (p. ej. `openssl rand -base64 32`) y NO lo subas al repo.
BETTER_AUTH_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# URL base publica del backend (para enlaces y validacion de origen).
BETTER_AUTH_URL=http://localhost:3000
# Origenes extra de confianza separados por coma (CORS/anti-CSRF). En local con
# el nginx del frontend proxando /api no suele hacer falta; en produccion se
# pone el dominio publico del frontend.
# BETTER_AUTH_TRUSTED_ORIGINS=https://control.tu-dominio.com

# ── Cloudflare R2 (archivos adjuntos, A5/R6) ───────────────────────────────
# Solo se necesitan cuando se usan adjuntos; el servicio de archivos las valida
# de forma perezosa (importar el dominio NO exige tenerlas configuradas).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=control-v2-prueba
