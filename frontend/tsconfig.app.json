{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,

    /* Vite hace el bundling; TypeScript solo verifica tipos. */
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    /* Alias `@` -> src (convencion de shadcn/ui); espejo del alias de Vite. */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Strict total */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,

    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src"],
  /* Las pruebas que leen archivos REALES del repo con `node:fs` viven en
     tsconfig.node.json, no aqui — el proyecto de la app NO trae los tipos de Node
     a proposito: el codigo del navegador no debe poder usar `process` ni `node:fs`
     sin que TypeScript lo note.
       - `src/version.test.ts`         lee HISTORIAL-DE-VERSIONES.md de la raiz.
       - `src/limite-cuerpo-api.test.ts` lee nginx.conf.template y el archivo de
         rutas del backend, para exigir que declaren el MISMO limite de cuerpo.
       - `src/cabeceras-seguridad-nginx.test.ts` lee nginx.conf.template e index.html
         para exigir que las cabeceras de seguridad sigan ahi (y que el hash del CSP
         siga cuadrando con el script en linea del tema).
       - `src/abreviatura-e2e.test.ts` lee frontend/openapi.json para exigir que la
         abreviatura que fabrica el e2e cumpla el patron REAL del contrato. */
  "exclude": [
    "src/version.test.ts",
    "src/limite-cuerpo-api.test.ts",
    "src/cabeceras-seguridad-nginx.test.ts",
    "src/abreviatura-e2e.test.ts"
  ]
}
