# Plantilla de nginx del frontend de CONTROL v2 (se procesa con envsubst).
#
# La imagen oficial `nginx` ejecuta envsubst sobre /etc/nginx/templates/*.template
# al arrancar y escribe el resultado en /etc/nginx/conf.d/ (quitando .template).
# Esta plantilla se copia como /etc/nginx/templates/default.conf.template -> genera
# /etc/nginx/conf.d/default.conf (sustituyendo el default que trae la imagen).
#
# Solo se sustituyen ${BACKEND_UPSTREAM} y ${DNS_RESOLVER} (ambas las fija el
# entrypoint: ver el script 16-resolver-default.envsh y el Dockerfile), gracias a
# NGINX_ENVSUBST_FILTER. Asi las variables propias de nginx ($host, $uri,
# $request_uri, $backend_upstream, ...) NO se tocan.
#
# El MISMO artefacto sirve en docker-compose y en Railway sin tocar codigo:
#   - docker-compose: BACKEND_UPSTREAM=backend:3000   (DNS_RESOLVER autodetectado: 127.0.0.11)
#   - Railway:        BACKEND_UPSTREAM=backend.railway.internal:3000 + DNS_RESOLVER=[fd12::10]
# (Railway usa red privada IPv6; el resolver interno fijo es fd12::10. Ver
#  docs/GUIA-RAILWAY-R2.md.)

server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Resolver DNS para resolver el upstream EN CADA request (no solo al arrancar).
    # Clave en Railway: la IP interna IPv6 del backend cambia en cada redeploy;
    # con `valid=` corto nginx refresca la resolucion y no cachea una IP vieja.
    # ${DNS_RESOLVER}: en docker-compose se autodetecta (127.0.0.11); en Railway se
    # fija a [fd12::10] (resolver interno de la red privada). Ver Dockerfile y el
    # script 16-resolver-default.envsh.
    resolver ${DNS_RESOLVER} valid=10s ipv6=on;
    resolver_timeout 5s;

    # No cachear el HTML de entrada: siempre debe traer el ultimo bundle.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Reverse-proxy de la API hacia el backend por la red interna (sin exponer el
    # backend a internet). El upstream es configurable por entorno.
    #
    # Se usa una VARIABLE en proxy_pass a proposito: con variable, nginx resuelve
    # el host en cada request usando el `resolver` de arriba (en vez de cachear la
    # IP al cargar la config). Como con variable nginx NO agrega solo la parte de
    # la location, se reenvia la URI original explicitamente con $request_uri
    # (patron oficial de nginx: `proxy_pass http://host$request_uri;`).
    location /api/ {
        set $backend_upstream ${BACKEND_UPSTREAM};
        proxy_pass http://$backend_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA: cualquier ruta desconocida devuelve index.html (ruteo en el cliente).
    location / {
        try_files $uri $uri/ /index.html;
    }
}
